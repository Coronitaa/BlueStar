<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BlueStar.Infrastructure</RootNamespace>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <!-- Per-build key for the encrypted API keys file (bluestar.dat). Passed only by build-release.ps1; never committed. -->
  <ItemGroup Condition="'$(BundledSecretsKey)' != ''">
    <AssemblyMetadata Include="BundledSecretsKey" Value="$(BundledSecretsKey)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.15" />
    <PackageReference Include="Newtonsoft.Json.Bson" Version="1.0.3" />
    <PackageReference Include="SharpCompress" Version="0.50.4" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.15" />
    <PackageReference Include="ZstdSharp.Port" Version="0.8.8" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\BlueStar.Core\BlueStar.Core.csproj" />
    <ProjectReference Include="..\BlueStar.DepotDownloader\DepotDownloader\DepotDownloaderMod.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="BlueStar.Infrastructure.Tests" />
  </ItemGroup>
</Project>
