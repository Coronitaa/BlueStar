<Application x:Class="BlueStar.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="Views/MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/BlueStar;component/Themes/Colors.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/BlueStar;component/Themes/Icons.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/BlueStar;component/Themes/Typography.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/BlueStar;component/Themes/Controls.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/BlueStar;component/Themes/DarkTheme.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/BlueStar;component/Themes/Strings.en.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
