<UserControl x:Class="BlueStar.App.Views.NexusBrowserPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══ HEADER: COMPACT CONTROL BAR & COLLAPSIBLE NOTICE ═══ -->
        <Border Grid.Row="0" Margin="0,0,0,6" Background="{StaticResource SurfaceCardBrush}"
                BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1"
                CornerRadius="{StaticResource RadiusMd}" Padding="10,6">
            <StackPanel>
                <!-- Compact Single-Line Toolbar -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Instructions Dropdown Toggle -->
                    <ToggleButton Grid.Column="0" IsChecked="{Binding IsInstructionsExpanded, Mode=TwoWay}"
                                  Style="{StaticResource SecondaryToggleButton}" Padding="10,5" Height="30"
                                  ToolTip="{DynamicResource String_NexusInstructionsToolTip}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconInfo}" Fill="{StaticResource AccentBrush}"
                                  Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource String_Instructions}" FontSize="11" FontWeight="SemiBold"/>
                            <Path Data="{StaticResource IconChevronDown}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                  Width="9" Height="9" Stretch="Uniform" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>

                    <!-- Manual NXM URL Input (Compact) -->
                    <Border Grid.Column="2" Background="{StaticResource SurfaceInputBrush}"
                            BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1"
                            CornerRadius="{StaticResource RadiusSm}" Padding="8,0" Height="30">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Data="{StaticResource IconLink}" Fill="{StaticResource MutedTextBrush}"
                                  Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <Grid Grid.Column="1">
                                <TextBlock Text="{DynamicResource String_PasteNxmPlaceholder}"
                                           Foreground="{StaticResource MutedTextBrush}" FontSize="11"
                                           VerticalAlignment="Center" IsHitTestVisible="False"
                                           Visibility="{Binding ManualInput, Converter={StaticResource InverseNullToVisibilityConverter}}"/>
                                <TextBox Text="{Binding ManualInput, UpdateSourceTrigger=PropertyChanged}"
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="{StaticResource PrimaryTextBrush}"
                                         CaretBrush="{StaticResource PrimaryTextBrush}"
                                         FontSize="11" Padding="0" VerticalContentAlignment="Center">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Return" Command="{Binding DownloadManualCommand}"/>
                                    </TextBox.InputBindings>
                                </TextBox>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Download NXM Button -->
                    <Button Grid.Column="4" Style="{StaticResource PrimaryButton}" Padding="10,5" Height="30"
                            Command="{Binding DownloadManualCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconDownload}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource String_InstallNxmBtn}" FontWeight="SemiBold" FontSize="11"/>
                        </StackPanel>
                    </Button>

                    <!-- Home / Root Mods of Game Button -->
                    <Button Grid.Column="6" Style="{StaticResource SecondaryButton}" Padding="10,5" Height="30"
                            Command="{Binding NavigateHomeCommand}" ToolTip="{DynamicResource String_NexusHomeToolTip}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconHome}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource String_Mods}" FontWeight="SemiBold" FontSize="11"/>
                        </StackPanel>
                    </Button>

                    <!-- External Browser Button -->
                    <Button Grid.Column="8" Style="{StaticResource SecondaryButton}" Padding="10,5" Height="30"
                            Command="{Binding OpenInBrowserCommand}" ToolTip="{DynamicResource String_ExternalBrowserToolTip}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconLink}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource String_ExternalBrowser}" FontSize="11" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Collapsible Instructions Card (Only visible when IsInstructionsExpanded == true) -->
                <Border Background="{StaticResource SurfaceInputBrush}" CornerRadius="{StaticResource RadiusSm}"
                        Padding="12,10" Margin="0,8,0,2" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1"
                        Visibility="{Binding IsInstructionsExpanded, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Data="{StaticResource IconCheck}" Fill="{StaticResource AccentBrush}"
                                  Width="12" Height="12" Stretch="Uniform" Margin="0,2,8,0" VerticalAlignment="Top"/>
                            <TextBlock Grid.Column="1" TextWrapping="Wrap" Style="{StaticResource BodySmall}" Foreground="{StaticResource SecondaryTextBrush}">
                                <Run Text="{DynamicResource String_NexusInstructionsTitle}" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/><LineBreak/>
                                <Run Text="• "/><Run Text="{DynamicResource String_NexusInstructionsManualTitle}" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/><Run Text="{DynamicResource String_NexusInstructionsManualDesc}"/><LineBreak/>
                                <Run Text="• "/><Run Text="{DynamicResource String_NexusInstructionsVortexTitle}" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/><Run Text="{DynamicResource String_NexusInstructionsVortexDesc}"/>
                            </TextBlock>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Data="{StaticResource IconShield}" Fill="{StaticResource AccentBrush}"
                                  Width="12" Height="12" Stretch="Uniform" Margin="0,2,8,0" VerticalAlignment="Top"/>
                            <TextBlock Grid.Column="1" TextWrapping="Wrap" Style="{StaticResource BodySmall}" Foreground="{StaticResource SecondaryTextBrush}">
                                <Run Text="{DynamicResource String_NexusProtectedNavigation}" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
                                <Run Text="{DynamicResource String_NexusProtectedNavDesc}"/>
                            </TextBlock>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- ═══ BROWSER VIEW (WEBVIEW2) ═══ -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceCardBrush}"
                BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1"
                CornerRadius="{StaticResource RadiusMd}" ClipToBounds="True">
            <Grid>
                <wv2:WebView2 x:Name="NexusWebView"/>

                <!-- Top Page Navigation Loading Bar -->
                <ProgressBar VerticalAlignment="Top" Height="3" IsIndeterminate="True"
                             Foreground="{StaticResource AccentBrush}"
                             Background="Transparent" BorderThickness="0"
                             Visibility="{Binding IsLoadingPage, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <!-- Fallback if WebView2 runtime is missing -->
                <Border x:Name="WebViewFallback" Visibility="Collapsed" Background="{StaticResource SurfaceCardBrush}" Padding="30">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="480">
                        <TextBlock Text="{DynamicResource String_NexusWebView2Title}" Style="{StaticResource H2}" Margin="0,0,0,8" HorizontalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource String_NexusWebView2Desc}"
                                   Style="{StaticResource BodySmall}" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,16"/>
                        <Button Style="{StaticResource PrimaryButton}" Content="Descargar WebView2" Click="OnInstallWebViewClicked" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Loading overlay during active nxm download -->
                <Border Background="#CC0F141C" Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ProgressBar Width="240" Height="6" Minimum="0" Maximum="100" Value="{Binding DownloadProgress}" Margin="0,0,0,12"/>
                        <TextBlock Text="{DynamicResource String_NexusDownloadingMod}" Style="{StaticResource BodyMedium}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding DownloadProgress, StringFormat={}{0:0}%}" Style="{StaticResource Caption}" Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
