<UserControl x:Class="BlueStar.App.Views.CurseForgeBrowserPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:BlueStar.App.Views">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ LEFT SIDEBAR: CATEGORIES ═══ -->
        <Border Grid.Column="0" Background="{StaticResource SurfaceCardBrush}"
                BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1"
                CornerRadius="{StaticResource RadiusMd}" Padding="12,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconTag}" Fill="{StaticResource AccentBrush}"
                              Stretch="Uniform" Width="12" Height="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource String_CurseForgeCategoriesTitle}" FontWeight="Bold" FontSize="13"
                                   Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button Grid.Column="1" Style="{StaticResource GhostButton}" Padding="4,2"
                            Command="{Binding ClearCategoryCommand}"
                            Visibility="{Binding HasActiveCategoryFilter, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{DynamicResource String_CurseForgeClearCategory}" FontSize="11" Foreground="{StaticResource AccentBrush}"/>
                    </Button>
                </Grid>

                <!-- Tag Search Box -->
                <Border Grid.Row="1" Margin="0,0,0,10"
                        Background="{StaticResource SurfaceInputBrush}"
                        BorderBrush="{StaticResource SubtleBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusSm}"
                        Padding="8,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Data="{StaticResource IconSearch}"
                              Fill="{StaticResource MutedTextBrush}"
                              Stretch="Uniform" Width="11" Height="11"
                              Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <Grid Grid.Column="1">
                            <TextBlock Text="{DynamicResource String_CurseForgeSearchCategoriesPlaceholder}"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="11" VerticalAlignment="Center" IsHitTestVisible="False"
                                       Visibility="{Binding TagSearchText, Converter={StaticResource InverseNullToVisibilityConverter}}"/>
                            <TextBox Text="{Binding TagSearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="{StaticResource PrimaryTextBrush}"
                                     CaretBrush="{StaticResource PrimaryTextBrush}"
                                     FontSize="11" Padding="0,6"
                                     VerticalContentAlignment="Center"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Categories list -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding FilteredCategories}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left"
                                        Padding="8,6" Margin="0,1"
                                        Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=local:CurseForgeBrowserPanel}}"
                                        CommandParameter="{Binding}">
                                    <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource SecondaryTextBrush}"/>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ═══ RIGHT COLUMN: TOOLBAR & MODS LIST ═══ -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Toolbar -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="200" MaxWidth="360"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search Input -->
                <Border Grid.Column="0"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusMd}"
                        Padding="12,0"
                        Background="{StaticResource SurfaceInputBrush}"
                        BorderBrush="{StaticResource SubtleBorderBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Data="{StaticResource IconSearch}"
                              Fill="{StaticResource MutedTextBrush}"
                              Stretch="Uniform" Width="13" Height="13"
                              Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <Grid Grid.Column="1">
                            <TextBlock Text="{DynamicResource String_CurseForgeSearchPlaceholder}"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="12" VerticalAlignment="Center" IsHitTestVisible="False"
                                       Visibility="{Binding SearchText, Converter={StaticResource InverseNullToVisibilityConverter}}"/>
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="{StaticResource PrimaryTextBrush}"
                                     CaretBrush="{StaticResource PrimaryTextBrush}"
                                     FontSize="12" Padding="0,8" VerticalContentAlignment="Center">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding ExecuteSearchCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                        </Grid>
                        <Button Grid.Column="2" Style="{StaticResource GhostButton}"
                                Command="{Binding ClearSearchCommand}"
                                Width="22" Height="22" Padding="0" Margin="4,0,-4,0"
                                VerticalAlignment="Center"
                                Visibility="{Binding SearchText, Converter={StaticResource NullToVisibilityConverter}}">
                            <Path Data="{StaticResource IconClose}" Fill="{StaticResource MutedTextBrush}"
                                  Stretch="Uniform" Width="9" Height="9"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Sort Selector -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource String_CurseForgeOrderBy}" Style="{StaticResource Caption}" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <ComboBox Width="130" Style="{StaticResource DarkComboBox}"
                              ItemsSource="{Binding SortOptions}"
                              SelectedItem="{Binding SelectedSort}"/>
                </StackPanel>
            </Grid>

            <!-- Content Area -->
            <Border Grid.Row="1" Background="{StaticResource SurfaceCardBrush}"
                    BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource RadiusMd}" Padding="10">
                <Grid>
                    <!-- Mods Scrollable List -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding Mods}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource SurfaceInputBrush}"
                                                BorderBrush="{StaticResource SubtleBorderBrush}"
                                                BorderThickness="1" CornerRadius="{StaticResource RadiusSm}"
                                                Padding="12" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Icon / Thumbnail -->
                                                <Border Grid.Column="0" Width="54" Height="54" CornerRadius="{StaticResource RadiusSm}"
                                                        Background="{StaticResource SurfaceCardElevatedBrush}"
                                                        BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1"
                                                        Margin="0,0,12,0" VerticalAlignment="Top" ClipToBounds="True">
                                                    <Grid>
                                                        <Path Data="{StaticResource IconFlame}" Fill="{StaticResource AccentBrush}" Width="20" Height="20"
                                                              Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        <Image Source="{Binding ThumbnailUrl, Converter={StaticResource CachedImageConverter}}"
                                                               Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                    </Grid>
                                                </Border>

                                                <!-- Mod Information -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource PrimaryTextBrush}"/>
                                                        <TextBlock Text="{Binding PrimaryAuthor, StringFormat='  por {0}'}" Style="{StaticResource Caption}" Foreground="{StaticResource SecondaryTextBrush}"/>
                                                        <TextBlock Text="{Binding FormattedDate, StringFormat='  ·  {0}'}" Style="{StaticResource Caption}" Foreground="{StaticResource MutedTextBrush}"/>
                                                    </StackPanel>

                                                    <TextBlock Text="{Binding Summary}" Style="{StaticResource BodySmall}" Foreground="{StaticResource SecondaryTextBrush}"
                                                               TextWrapping="Wrap" MaxHeight="34" TextTrimming="CharacterEllipsis" Margin="0,3,0,5"/>

                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Path Data="{StaticResource IconDownload}" Fill="{StaticResource MutedTextBrush}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding FormattedDownloads}" Style="{StaticResource CaptionBold}" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,12,0" VerticalAlignment="Center"/>

                                                        <ItemsControl ItemsSource="{Binding Categories}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <StackPanel Orientation="Horizontal"/>
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border CornerRadius="{StaticResource RadiusSm}" Background="{StaticResource SurfaceCardBrush}"
                                                                            BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1"
                                                                            Padding="6,1" Margin="0,0,4,0">
                                                                        <TextBlock Text="{Binding}" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}"/>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Version & Download Button -->
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" MinWidth="130" HorizontalAlignment="Right">
                                                    <ComboBox Width="130" Margin="0,0,0,6" Style="{StaticResource DarkComboBox}"
                                                              ItemsSource="{Binding AvailableFiles}"
                                                              SelectedItem="{Binding SelectedFile}">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"/>
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>

                                                    <Button Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch"
                                                            Command="{Binding InstallCommand}" IsEnabled="{Binding CanInstall}">
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                            <Path Data="{StaticResource IconCheck}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                                  Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"
                                                                  Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                            <Path Data="{StaticResource IconDownload}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                                  Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"
                                                                  Visibility="{Binding IsInstalled, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                                            <TextBlock Text="{Binding ButtonLabel}" FontWeight="SemiBold"/>
                                                        </StackPanel>
                                                    </Button>

                                                    <ProgressBar Height="3" Minimum="0" Maximum="100" Value="{Binding DownloadProgress}" Margin="0,4,0,0"
                                                                 Visibility="{Binding IsInstalling, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Load More Button -->
                            <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Center" Margin="0,10,0,10"
                                    Command="{Binding LoadMoreCommand}"
                                    Visibility="{Binding CanLoadMore, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="{DynamicResource String_CurseForgeLoadMore}"/>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Loading State -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{DynamicResource String_CurseForgeLoadingMods}" Style="{StaticResource BodyMedium}" Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <ProgressBar IsIndeterminate="True" Width="200" Height="4"/>
                    </StackPanel>

                    <!-- Empty State -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding HasNoResults, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Path Data="{StaticResource IconSearch}" Fill="{StaticResource MutedTextBrush}" Width="36" Height="36" Stretch="Uniform" Margin="0,0,0,12" HorizontalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource String_CurseForgeNoResults}" Style="{StaticResource BodyMedium}" Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>