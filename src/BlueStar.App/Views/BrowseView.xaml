<UserControl x:Class="BlueStar.App.Views.BrowseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:vm="clr-namespace:BlueStar.App.ViewModels"
             xmlns:ctrl="clr-namespace:BlueStar.App.Controls"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             d:DataContext="{d:DesignInstance vm:BrowseViewModel}"
             mc:Ignorable="d"
             Background="{StaticResource BaseBackgroundBrush}"
             Foreground="{StaticResource PrimaryTextBrush}"
             FontFamily="{StaticResource MainFontFamily}">

    <UserControl.Resources>

        <!-- How many placeholder cards a search shows while it waits. Enough to fill the fold
             at a normal window size; the real cards replace them wholesale. -->
        <x:Array x:Key="SkeletonSlots" Type="{x:Type sys:Int32}">
            <sys:Int32>0</sys:Int32>
            <sys:Int32>1</sys:Int32>
            <sys:Int32>2</sys:Int32>
            <sys:Int32>3</sys:Int32>
            <sys:Int32>4</sys:Int32>
            <sys:Int32>5</sys:Int32>
            <sys:Int32>6</sys:Int32>
            <sys:Int32>7</sys:Int32>
        </x:Array>

        <!-- ═══ FILTER BUBBLE ═══
             Neutral → Include → Exclude → Neutral on left click.
             Right click jumps straight to Exclude. -->
        <Style x:Key="FilterBubble" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,4,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{StaticResource SurfaceInputBrush}"
                                BorderBrush="{StaticResource SubtleBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="9"
                                Padding="7,3"
                                RenderTransformOrigin="0.5,0.5"
                                SnapsToDevicePixels="True">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="ChromeScale" ScaleX="1.0" ScaleY="1.0"/>
                            </Border.RenderTransform>
                            <StackPanel Orientation="Horizontal">
                                <Path x:Name="StateIcon"
                                      Data="{StaticResource IconCheck}"
                                      Fill="#4ADE9F"
                                      Stretch="Uniform" Width="9" Height="9"
                                      Margin="0,0,5,0"
                                      VerticalAlignment="Center"
                                      Visibility="Collapsed"/>
                                <TextBlock x:Name="Label"
                                           Text="{Binding DisplayName}"
                                           FontSize="11"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="168"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="Count"
                                           Text="{Binding CountText}"
                                           FontSize="9.5"
                                           FontWeight="SemiBold"
                                           Margin="5,0,0,0"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding CountText, Converter={StaticResource NullToVisibilityConverter}}"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource StrongBorderBrush}"/>
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource SurfaceInputFocusedBrush}"/>
                                <Setter TargetName="Label" Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
                            </Trigger>
                            <!-- Highlighted Tag Trigger (Selected >= 5 times with category decay) -->
                            <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource CyanBrush}"/>
                                <Setter TargetName="Chrome" Property="BorderThickness" Value="1.5"/>
                            </DataTrigger>
                            <!-- Category-specific Pastel Hover (Soft, low-glare) -->
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True"/>
                                    <Condition Binding="{Binding State}" Value="Neutral"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Chrome" Property="Background" Value="{Binding HoverBackgroundBrush}"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{Binding HoverBorderBrush}"/>
                                <Setter TargetName="Label" Property="Foreground" Value="{Binding HoverForegroundBrush}"/>
                            </MultiDataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="Include">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource SuccessBgBrush}"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource SuccessBorderBrush}"/>
                                <Setter TargetName="Label" Property="Foreground" Value="#4ADE9F"/>
                                <Setter TargetName="StateIcon" Property="Visibility" Value="Visible"/>
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ChromeScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             From="0.88" To="1.0"
                                                             Duration="0:0:0.25">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase Amplitude="0.3" EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="ChromeScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             From="0.88" To="1.0"
                                                             Duration="0:0:0.25">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase Amplitude="0.3" EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="Exclude">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource DangerBgBrush}"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource DangerBorderBrush}"/>
                                <Setter TargetName="Label" Property="Foreground" Value="#F87171"/>
                                <Setter TargetName="Label" Property="TextDecorations" Value="Strikethrough"/>
                                <Setter TargetName="StateIcon" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="StateIcon" Property="Data" Value="{StaticResource IconBan}"/>
                                <Setter TargetName="StateIcon" Property="Fill" Value="#F87171"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ STORE TAG ON A RESULT CARD ═══ -->
        <Style x:Key="CardTagBubble" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,4,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{StaticResource SurfaceInputBrush}"
                                BorderBrush="{StaticResource SubtleBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="9"
                                Padding="7,2">
                            <TextBlock x:Name="Label" Text="{Binding Name}" FontSize="10.5"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- The tag itself knows whether it is one the query is filtering by. -->
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource AccentTranslucentBrush}"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Label" Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Label" Property="FontWeight" Value="SemiBold"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Label" Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ ONE FILTER GROUP ═══ -->
        <DataTemplate x:Key="FilterGroupTemplate" DataType="{x:Type vm:FilterGroupViewModel}">
            <Border Background="{StaticResource SurfaceCardBrush}"
                    BorderBrush="{StaticResource SubtleBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusMd}"
                    Margin="0,0,0,8"
                    Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>

                    <!-- Header -->
                    <ToggleButton IsChecked="{Binding IsExpanded, Mode=TwoWay}" Cursor="Hand">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="Row" Background="Transparent" Padding="10,9">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Path x:Name="Chevron" Grid.Column="0"
                                              Data="{StaticResource IconChevronRight}"
                                              Fill="{StaticResource MutedTextBrush}"
                                              Stretch="Uniform" Width="9" Height="9"
                                              Margin="0,0,8,0" VerticalAlignment="Center"
                                              RenderTransformOrigin="0.5,0.5">
                                            <Path.RenderTransform>
                                                <RotateTransform Angle="0"/>
                                            </Path.RenderTransform>
                                        </Path>
                                        <Path Grid.Column="1"
                                              Data="{Binding IconKey, Converter={StaticResource ResourceKeyConverter}}"
                                              Fill="{StaticResource SecondaryTextBrush}"
                                              Stretch="Uniform" Width="13" Height="13"
                                              Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Title}"
                                                   FontSize="11.5" FontWeight="Bold"
                                                   Foreground="{StaticResource PrimaryTextBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"/>
                                        <Border Grid.Column="3"
                                                Background="{StaticResource AccentBrush}"
                                                CornerRadius="8" Padding="5,0" MinWidth="16" Height="16"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding SelectedCount, Converter={StaticResource NullToVisibilityConverter}}">
                                            <TextBlock Text="{Binding SelectedCount}" FontSize="10" FontWeight="Bold"
                                                       Foreground="{StaticResource InverseTextBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Row" Property="Background" Value="{StaticResource SurfaceCardHoverBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Chevron" Property="RenderTransform">
                                            <Setter.Value>
                                                <RotateTransform Angle="90"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>

                    <!-- Body -->
                    <StackPanel Margin="9,0,9,10"
                                Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibilityConverter}}">

                        <!-- Search box and random pick, shown for all categories with more than 20 tags -->
                        <Grid Margin="0,0,0,7"
                              Visibility="{Binding HasRandomPick, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="5"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    Background="{StaticResource SurfaceInputBrush}"
                                    BorderBrush="{StaticResource SubtleBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusSm}"
                                    Padding="7,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Data="{StaticResource IconSearch}"
                                          Fill="{StaticResource MutedTextBrush}"
                                          Stretch="Uniform" Width="10" Height="10"
                                          Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <Grid Grid.Column="1">
                                        <TextBlock Text="{DynamicResource String_FilterSearchPlaceholder}"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   FontSize="11.5" VerticalAlignment="Center"
                                                   IsHitTestVisible="False"
                                                   Visibility="{Binding SearchText, Converter={StaticResource InverseNullToVisibilityConverter}}"/>
                                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                                 Background="Transparent" BorderThickness="0"
                                                 Foreground="{StaticResource PrimaryTextBrush}"
                                                 CaretBrush="{StaticResource PrimaryTextBrush}"
                                                 FontSize="11.5" Padding="0,6"
                                                 VerticalContentAlignment="Center"/>
                                    </Grid>
                                </Grid>
                            </Border>
                            <Button Grid.Column="2" Width="28" Height="28" Cursor="Hand"
                                    Background="Transparent" BorderThickness="0"
                                    FocusVisualStyle="{x:Null}"
                                    ToolTip="{DynamicResource String_FilterRandomTooltip}"
                                    Click="OnDiceButtonClick"
                                    MouseEnter="OnDiceButtonMouseEnter"
                                    MouseLeave="OnDiceButtonMouseLeave">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Grid Background="Transparent">
                                            <!-- Subtle non-invasive pastel particle glow -->
                                            <Canvas IsHitTestVisible="False" Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Ellipse x:Name="DiceRing" Width="18" Height="18" Canvas.Left="5" Canvas.Top="5"
                                                         Stroke="#60A5B4FC" StrokeThickness="1.5" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                                    <Ellipse.RenderTransform>
                                                        <ScaleTransform x:Name="DiceRingScale" ScaleX="0.6" ScaleY="0.6"/>
                                                    </Ellipse.RenderTransform>
                                                </Ellipse>
                                                <Ellipse x:Name="Dot1" Width="3" Height="3" Canvas.Left="4" Canvas.Top="2"
                                                         Fill="#38BDF8" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                                    <Ellipse.RenderTransform>
                                                        <TranslateTransform x:Name="Dot1Trans"/>
                                                    </Ellipse.RenderTransform>
                                                </Ellipse>
                                                <Ellipse x:Name="Dot2" Width="3" Height="3" Canvas.Left="21" Canvas.Top="4"
                                                         Fill="#F472B6" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                                    <Ellipse.RenderTransform>
                                                        <TranslateTransform x:Name="Dot2Trans"/>
                                                    </Ellipse.RenderTransform>
                                                </Ellipse>
                                                <Ellipse x:Name="Dot3" Width="3" Height="3" Canvas.Left="19" Canvas.Top="21"
                                                         Fill="#34D399" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                                    <Ellipse.RenderTransform>
                                                        <TranslateTransform x:Name="Dot3Trans"/>
                                                    </Ellipse.RenderTransform>
                                                </Ellipse>
                                                <Ellipse x:Name="Dot4" Width="3" Height="3" Canvas.Left="4" Canvas.Top="19"
                                                         Fill="#FBBF24" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                                    <Ellipse.RenderTransform>
                                                        <TranslateTransform x:Name="Dot4Trans"/>
                                                    </Ellipse.RenderTransform>
                                                </Ellipse>
                                            </Canvas>

                                            <!-- Dice Container with Transforms (No outer blue border) -->
                                            <Border x:Name="Chrome"
                                                    Background="{StaticResource SurfaceInputBrush}"
                                                    BorderThickness="0"
                                                    CornerRadius="{StaticResource RadiusSm}"
                                                    RenderTransformOrigin="0.5,0.5">
                                                <Border.RenderTransform>
                                                    <TransformGroup>
                                                        <TranslateTransform x:Name="DiceJump"/>
                                                        <RotateTransform x:Name="DiceTilt" Angle="0"/>
                                                        <RotateTransform x:Name="DiceSpin" Angle="0"/>
                                                    </TransformGroup>
                                                </Border.RenderTransform>
                                                <Path x:Name="Glyph" Data="{StaticResource IconDice}"
                                                      Fill="{StaticResource SecondaryTextBrush}"
                                                      Stretch="Uniform" Width="13" Height="13"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource SurfaceCardHoverBrush}"/>
                                                <Setter TargetName="Glyph" Property="Fill" Value="{StaticResource PrimaryTextBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <!-- Bubbles -->
                        <ItemsControl ItemsSource="{Binding Items}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource FilterBubble}"
                                            IsEnabled="{Binding DataContext.IsAvailable, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="{DynamicResource String_FilterBubbleTooltip}">
                                        <Button.InputBindings>
                                            <MouseBinding MouseAction="RightClick"
                                                          Command="{Binding DataContext.ExcludeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                          CommandParameter="{Binding}"/>
                                        </Button.InputBindings>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- More tags expander button -->
                        <Button Style="{StaticResource GhostButton}" Padding="4,2" Margin="2,3,0,0"
                                HorizontalAlignment="Left" Cursor="Hand"
                                Command="{Binding ToggleExpandAllCommand}"
                                Visibility="{Binding HiddenCount, Converter={StaticResource NullToVisibilityConverter}}">
                            <TextBlock FontSize="10.5" Foreground="{StaticResource AccentBrush}">
                                <Run Text="+"/><Run Text="{Binding HiddenCount, Mode=OneWay}"/><Run Text=" más (Ver más)"/>
                            </TextBlock>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Padding="4,2" Margin="2,3,0,0"
                                HorizontalAlignment="Left" Cursor="Hand"
                                Command="{Binding ToggleExpandAllCommand}"
                                Visibility="{Binding IsExpandedAll, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock FontSize="10.5" Foreground="{StaticResource AccentBrush}" Text="(Ver menos)"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- ═══ SHARED CARD PIECES ═══ -->
        <DataTemplate x:Key="CardTagTemplate">
            <Button Style="{StaticResource CardTagBubble}"
                    Command="{Binding DataContext.FilterByTagCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding Name}"/>
        </DataTemplate>

        <!-- The artwork is the Border's own background, so it follows the corner radius instead
             of spilling over it. -->
        <ControlTemplate x:Key="CardArtworkTemplate" TargetType="ContentControl">
            <Border CornerRadius="9,9,0,0" Background="{StaticResource SurfaceCardHoverBrush}">
                <Grid>
                    <Border CornerRadius="9,9,0,0">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding HeaderImageUrl, Converter={StaticResource CachedImageConverter}}"
                                        Stretch="UniformToFill"
                                        RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border.Background>
                    </Border>

                    <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Margin="0,0,7,7" Padding="6,2"
                            Background="#DC09090B"
                            BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1"
                            CornerRadius="{StaticResource RadiusSm}"
                            Visibility="{Binding PriceText, Converter={StaticResource NullToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <Border Background="#4C6B22" CornerRadius="2" Padding="4,0" Margin="0,0,5,0"
                                    Visibility="{Binding DiscountPercent, Converter={StaticResource NullToVisibilityConverter}}">
                                <TextBlock Foreground="#A4D007" FontSize="10.5" FontWeight="Bold">
                                    <Run Text="-"/><Run Text="{Binding DiscountPercent, Mode=OneWay}"/><Run Text="%"/>
                                </TextBlock>
                            </Border>
                            <TextBlock Text="{Binding OriginalPriceText}" FontSize="10"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       TextDecorations="Strikethrough" Margin="0,0,5,0"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding OriginalPriceText, Converter={StaticResource NullToVisibilityConverter}}"/>
                            <TextBlock Text="{Binding PriceText}" FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </ControlTemplate>

        <DataTemplate x:Key="CardMetaTemplate">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding ReviewDisplayText}" FontSize="11" FontWeight="SemiBold"
                           Foreground="{Binding ReviewPercent, Converter={StaticResource ReviewScoreToBrushConverter}}" Margin="0,0,8,0"
                           TextTrimming="CharacterEllipsis" MaxWidth="220"
                           Visibility="{Binding ReviewDisplayText, Converter={StaticResource NullToVisibilityConverter}}"/>
                <TextBlock Text="{Binding ReleaseDateText}" FontSize="11"
                           Foreground="{StaticResource MutedTextBrush}" Margin="0,0,8,0"/>
                <Path Data="{StaticResource IconWindows}" Fill="{StaticResource MutedTextBrush}"
                           Stretch="Uniform" Width="11" Height="11" Margin="0,0,4,0" VerticalAlignment="Center"
                           Visibility="{Binding HasWindows, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <Path Data="{StaticResource IconApple}" Fill="{StaticResource MutedTextBrush}"
                           Stretch="Uniform" Width="11" Height="11" Margin="0,0,4,0" VerticalAlignment="Center"
                           Visibility="{Binding HasMac, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <Path Data="{StaticResource IconLinux}" Fill="{StaticResource MutedTextBrush}"
                           Stretch="Uniform" Width="11" Height="11" VerticalAlignment="Center"
                           Visibility="{Binding HasLinux, Converter={StaticResource BoolToVisibilityConverter}}"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="CardBadgesTemplate">
            <WrapPanel Orientation="Horizontal">

                <Border CornerRadius="{StaticResource RadiusXs}" Padding="6,2" Margin="0,0,4,4"
                        Background="{StaticResource WarningBgBrush}"
                        BorderBrush="{StaticResource WarningBorderBrush}" BorderThickness="1"
                        ToolTip="{Binding DrmNotice}"
                        Visibility="{Binding HasDrm, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconLock}" Fill="{StaticResource WarningBrush}"
                              Stretch="Uniform" Width="9" Height="9" Margin="0,0,4,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding DrmBadgeText}" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{StaticResource WarningBrush}"/>
                    </StackPanel>
                </Border>

                <Border CornerRadius="{StaticResource RadiusXs}" Padding="6,2" Margin="0,0,4,4"
                        Background="{StaticResource DangerBgBrush}"
                        BorderBrush="{StaticResource DangerBorderBrush}" BorderThickness="1"
                        ToolTip="{Binding AntiCheatNotice}"
                        Visibility="{Binding HasAntiCheat, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconShield}" Fill="{StaticResource DangerBrush}"
                              Stretch="Uniform" Width="9" Height="9" Margin="0,0,4,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding AntiCheatBadgeText}" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{StaticResource DangerBrush}"/>
                    </StackPanel>
                </Border>

                <Border CornerRadius="{StaticResource RadiusXs}" Padding="6,2" Margin="0,0,4,4"
                        Background="{StaticResource CyanBgBrush}"
                        BorderBrush="#4006B6D4" BorderThickness="1"
                        ToolTip="{Binding AccountNotice}"
                        Visibility="{Binding HasAccount, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconLink}" Fill="{StaticResource CyanBrush}"
                              Stretch="Uniform" Width="9" Height="9" Margin="0,0,4,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding AccountBadgeText}" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{StaticResource CyanBrush}"/>
                    </StackPanel>
                </Border>

                <Border CornerRadius="{StaticResource RadiusXs}" Padding="6,2" Margin="0,0,4,4"
                        Background="{StaticResource InfoBgBrush}"
                        BorderBrush="{StaticResource InfoBorderBrush}" BorderThickness="1"
                        ToolTip="{Binding EulaNotice}"
                        Visibility="{Binding HasEula, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconInfo}" Fill="{StaticResource InfoBrush}"
                              Stretch="Uniform" Width="9" Height="9" Margin="0,0,4,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding EulaBadgeText}" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{StaticResource InfoBrush}"/>
                    </StackPanel>
                </Border>

                <Border CornerRadius="{StaticResource RadiusXs}" Padding="6,2" Margin="0,0,4,4"
                        Background="{StaticResource PurpleBgBrush}"
                        BorderBrush="#60A855F7" BorderThickness="1"
                        Visibility="{Binding DlcBadgeText, Converter={StaticResource NullToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconGift}" Fill="#C78BFB"
                              Stretch="Uniform" Width="9" Height="9" Margin="0,0,4,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding DlcBadgeText}" FontSize="10" FontWeight="SemiBold" Foreground="#C78BFB"/>
                    </StackPanel>
                </Border>

                <Border CornerRadius="{StaticResource RadiusXs}" Padding="6,2" Margin="0,0,4,4"
                        Background="{StaticResource DangerBgBrush}"
                        BorderBrush="{StaticResource DangerBorderBrush}" BorderThickness="1"
                        Visibility="{Binding IsNsfw, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="18+" FontSize="10" FontWeight="Bold" Foreground="#F87171"/>
                </Border>
            </WrapPanel>
        </DataTemplate>

        <DataTemplate x:Key="CardActionsTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="7"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Style="{StaticResource PrimaryButton}" Padding="10,0" Height="34"
                        VerticalAlignment="Stretch" VerticalContentAlignment="Center"
                        Command="{Binding DataContext.AddToLibraryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}"
                        IsEnabled="{Binding IsCreating, Converter={StaticResource InverseBoolConverter}}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Path Data="{StaticResource IconPlus}" Fill="{StaticResource InverseTextBrush}"
                              Stretch="Uniform" Width="11" Height="11" Margin="0,0,6,0" VerticalAlignment="Center"
                              Visibility="{Binding IsCreating, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                        <TextBlock Text="{DynamicResource String_AddToInstances}" FontSize="12"
                                   Visibility="{Binding IsCreating, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                        <TextBlock Text="{Binding CreationStatus}" FontSize="12"
                                   Visibility="{Binding IsCreating, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Padding="10,0" Height="34"
                        VerticalAlignment="Stretch" VerticalContentAlignment="Center"
                        ToolTip="{DynamicResource String_ViewOnSteamDb}"
                        Command="{Binding DataContext.OpenSteamDbCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}">
                    <Path Data="{StaticResource IconSteamDb}" Fill="{StaticResource SecondaryTextBrush}"
                          Stretch="Uniform" Width="13" Height="13"/>
                </Button>
            </Grid>
        </DataTemplate>

        <!-- ═══ RESULT CARD — GRID ═══ -->
        <DataTemplate x:Key="ResultCardTemplate">
            <Border Style="{StaticResource Card}" Padding="0" Width="288" MinHeight="330"
                    Margin="0,0,12,12" Cursor="Hand">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick"
                                  Command="{Binding DataContext.OpenDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="{Binding}"/>
                </Border.InputBindings>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ContentControl Grid.Row="0" Height="130" Content="{Binding}"
                                    Template="{StaticResource CardArtworkTemplate}"/>

                    <StackPanel Grid.Row="1" Margin="12,10,12,0" VerticalAlignment="Top">
                        <TextBlock Text="{Binding Name}" Style="{StaticResource H3}"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource CardMetaTemplate}"
                                          Margin="0,3,0,0"/>
                        <ItemsControl ItemsSource="{Binding StoreTags}" Margin="0,7,0,0"
                                      ItemTemplate="{StaticResource CardTagTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource CardBadgesTemplate}"
                                          Margin="0,3,0,0"/>
                    </StackPanel>

                    <ContentPresenter Grid.Row="2" Content="{Binding}"
                                      ContentTemplate="{StaticResource CardActionsTemplate}"
                                      Margin="12,10,12,12" VerticalAlignment="Bottom"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- ═══ RESULT ROW — LIST ═══ -->
        <DataTemplate x:Key="ResultRowTemplate">
            <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,12,10" Cursor="Hand">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick"
                                  Command="{Binding DataContext.OpenDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="{Binding}"/>
                </Border.InputBindings>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ContentControl Grid.Column="0" Width="210" Height="98" Content="{Binding}"
                                    Template="{StaticResource CardArtworkTemplate}"/>

                    <StackPanel Grid.Column="1" Margin="14,10,14,10" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" Style="{StaticResource H3}"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource CardMetaTemplate}"
                                          Margin="0,3,0,0"/>
                        <ItemsControl ItemsSource="{Binding StoreTags}" Margin="0,6,0,0"
                                      ItemTemplate="{StaticResource CardTagTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource CardBadgesTemplate}"
                                          Margin="0,3,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="0,0,14,0" VerticalAlignment="Center" MinWidth="190">
                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource CardActionsTemplate}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

    </UserControl.Resources>

    <UserControl.RenderTransform>
        <TranslateTransform Y="0"/>
    </UserControl.RenderTransform>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     From="0.0" To="1.0" Duration="0:0:0.22">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                     From="12" To="0" Duration="0:0:0.22">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══ HEADER AND TYPE TABS ═══ -->
        <StackPanel Grid.Row="0" Margin="24,20,24,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{DynamicResource String_ExploreCatalogTitle}" Style="{StaticResource H1}"
                               Margin="0,0,10,0"/>
                    <Border Background="{StaticResource SurfaceInputBrush}"
                            CornerRadius="{StaticResource RadiusSm}" Padding="8,3"
                            VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Caption}" FontWeight="Medium"
                                   Foreground="{StaticResource AccentBrush}">
                            <Run Text="{Binding TotalResults, Mode=OneWay, StringFormat=N0}"/><Run Text=" "/><Run Text="{DynamicResource String_ResultsSuffix}"/>
                        </TextBlock>
                    </Border>
                </StackPanel>
                <TextBlock Text="{DynamicResource String_ExploreCatalogSubtitle}"
                           Style="{StaticResource Caption}" Margin="0,4,0,12"/>
                <StackPanel Orientation="Horizontal">
                    <RadioButton GroupName="ExploreAppType" Style="{StaticResource TabRadioButton}"
                                 Content="{DynamicResource String_FilterAll}"
                                 IsChecked="{Binding SelectedAppType, Mode=OneWay, Converter={StaticResource StringMatchConverter}, ConverterParameter=998\,994}"
                                 Command="{Binding SetAppTypeCommand}" CommandParameter="998,994"/>
                    <RadioButton GroupName="ExploreAppType" Style="{StaticResource TabRadioButton}"
                                 Content="{DynamicResource String_FilterGames}"
                                 IsChecked="{Binding SelectedAppType, Mode=OneWay, Converter={StaticResource StringMatchConverter}, ConverterParameter=998}"
                                 Command="{Binding SetAppTypeCommand}" CommandParameter="998"/>
                    <RadioButton GroupName="ExploreAppType" Style="{StaticResource TabRadioButton}"
                                 Content="{DynamicResource String_FilterSoftware}"
                                 IsChecked="{Binding SelectedAppType, Mode=OneWay, Converter={StaticResource StringMatchConverter}, ConverterParameter=994}"
                                 Command="{Binding SetAppTypeCommand}" CommandParameter="994"/>
                </StackPanel>
        </StackPanel>

        <!-- ═══ TOOLBAR ═══ -->
        <Grid Grid.Row="1" Margin="24,14,24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="180"/>
                <ColumnDefinition Width="9"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="9"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="9"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource SurfaceInputBrush}"
                    BorderBrush="{StaticResource SubtleBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusMd}"
                    Padding="12,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="0" Data="{StaticResource IconSearch}"
                          Fill="{StaticResource MutedTextBrush}"
                          Stretch="Uniform" Width="14" Height="14"
                          Margin="0,0,9,0" VerticalAlignment="Center"/>
                    <Grid Grid.Column="1">
                        <TextBlock Text="{DynamicResource String_SearchGamesPlaceholder}"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="13" VerticalAlignment="Center" IsHitTestVisible="False"
                                   Visibility="{Binding SearchQuery, Converter={StaticResource InverseNullToVisibilityConverter}}"/>
                        <TextBox AutomationProperties.AutomationId="CatalogSearchTextBox"
                                 AutomationProperties.Name="{DynamicResource String_SearchGamesPlaceholder}"
                                 Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="{StaticResource PrimaryTextBrush}"
                                 CaretBrush="{StaticResource PrimaryTextBrush}"
                                 FontSize="13" Padding="0,9" VerticalContentAlignment="Center">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding SearchCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                    </Grid>

                    <!-- Drops the search text on its own. "Clear all" next to the filters is
                         the one that also throws the chosen tags away. -->
                    <Button Grid.Column="2" Style="{StaticResource GhostButton}"
                            Command="{Binding ClearSearchCommand}"
                            AutomationProperties.Name="{DynamicResource String_ClearSearch}"
                            Width="24" Height="24" Padding="0" Margin="6,0,-4,0"
                            VerticalAlignment="Center"
                            ToolTip="{DynamicResource String_ClearSearch}"
                            Visibility="{Binding SearchQuery, Converter={StaticResource NullToVisibilityConverter}}">
                        <Path Data="{StaticResource IconClose}" Fill="{StaticResource MutedTextBrush}"
                              Stretch="Uniform" Width="10" Height="10"/>
                    </Button>
                </Grid>
            </Border>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource String_SortBy}" Style="{StaticResource Caption}"
                           VerticalAlignment="Center" Margin="0,0,7,0"/>
                <ComboBox Style="{StaticResource DarkComboBox}"
                          AutomationProperties.Name="{DynamicResource String_SortBy}"
                          ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort}"
                          DisplayMemberPath="DisplayName" MinWidth="152"
                          IsEnabled="{Binding CanChooseSort}">
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem" BasedOn="{StaticResource DarkComboBoxItem}">
                            <Setter Property="IsEnabled" Value="{Binding IsEnabled}"/>
                        </Style>
                    </ComboBox.ItemContainerStyle>
                </ComboBox>

                <!-- Direction. -->
                <Button Margin="6,0,0,0" Width="34" Height="34" Padding="0"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding ToggleSortDirectionCommand}"
                        IsEnabled="{Binding CanInvertSort}"
                        AutomationProperties.Name="{DynamicResource String_InvertOrder}">
                    <Button.ToolTip>
                        <TextBlock Text="{DynamicResource String_InvertOrder}"/>
                    </Button.ToolTip>
                    <Path x:Name="SortDirectionIcon" Stretch="Uniform" Width="14" Height="14"
                          Fill="{StaticResource SecondaryTextBrush}">
                        <Path.Style>
                            <Style TargetType="Path">
                                <Setter Property="Data" Value="{StaticResource IconSortAsc}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSortDescending}" Value="True">
                                        <Setter Property="Data" Value="{StaticResource IconSortDesc}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                </Button>
            </StackPanel>

            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource String_ShowList}" Style="{StaticResource Caption}"
                           VerticalAlignment="Center" Margin="0,0,7,0"/>
                <ComboBox Style="{StaticResource DarkComboBox}"
                          AutomationProperties.Name="{DynamicResource String_ShowList}"
                          ItemsSource="{Binding StoreListOptions}" SelectedItem="{Binding SelectedStoreList}"
                          DisplayMemberPath="DisplayName" MinWidth="178"/>
            </StackPanel>

            <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton GroupName="ViewMode" Style="{StaticResource FilterChipRadioButton}"
                             AutomationProperties.Name="{DynamicResource String_ViewGrid}"
                             IsChecked="{Binding IsGridView, Mode=OneWay}"
                             Command="{Binding SetViewCommand}" CommandParameter="grid"
                             ToolTip="{DynamicResource String_ViewGrid}">
                    <Path Data="{StaticResource IconGridView}" Fill="{StaticResource SecondaryTextBrush}"
                          Stretch="Uniform" Width="13" Height="13"/>
                </RadioButton>
                <RadioButton GroupName="ViewMode" Style="{StaticResource FilterChipRadioButton}"
                             AutomationProperties.Name="{DynamicResource String_ViewList}"
                             IsChecked="{Binding IsGridView, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}"
                             Command="{Binding SetViewCommand}" CommandParameter="list"
                             ToolTip="{DynamicResource String_ViewList}">
                    <Path Data="{StaticResource IconListView}" Fill="{StaticResource SecondaryTextBrush}"
                          Stretch="Uniform" Width="13" Height="13"/>
                </RadioButton>
            </StackPanel>
        </Grid>

        <!-- ═══ ACTIVE FILTER CHIPS ═══ -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="24,12,24,0"
                    Visibility="{Binding HasActiveFilters, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="{DynamicResource String_ActiveFilters}" Style="{StaticResource CaptionBold}"
                       Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>

            <ItemsControl ItemsSource="{Binding ActiveFilters}" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="Chip" CornerRadius="9" Padding="9,3" Margin="0,0,5,4"
                                Background="{StaticResource SuccessBgBrush}"
                                BorderBrush="{StaticResource SuccessBorderBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="ChipText" Text="{Binding DisplayName}" FontSize="11.5"
                                           FontWeight="SemiBold" Foreground="#4ADE9F" VerticalAlignment="Center"
                                           MaxWidth="180" TextTrimming="CharacterEllipsis"/>
                                <Button Style="{StaticResource GhostButton}" Padding="4,0" Margin="5,0,0,0"
                                        Command="{Binding DataContext.RemoveFilterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <Path x:Name="ChipClose" Data="{StaticResource IconClose}" Fill="#4ADE9F"
                                          Stretch="Uniform" Width="8" Height="8"/>
                                </Button>
                            </StackPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding State}" Value="Exclude">
                                <Setter TargetName="Chip" Property="Background" Value="{StaticResource DangerBgBrush}"/>
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource DangerBorderBrush}"/>
                                <Setter TargetName="ChipText" Property="Foreground" Value="#F87171"/>
                                <Setter TargetName="ChipText" Property="TextDecorations" Value="Strikethrough"/>
                                <Setter TargetName="ChipClose" Property="Fill" Value="#F87171"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Content="{DynamicResource String_ClearAllFilters}" Style="{StaticResource GhostButton}"
                    Foreground="{StaticResource MutedTextBrush}" Padding="6,2"
                    VerticalAlignment="Center"
                    Command="{Binding ClearAllFiltersCommand}"/>
        </StackPanel>

        <!-- ═══ RESULTS AND FILTER PANEL ═══ -->
        <Grid Grid.Row="3" Margin="24,12,24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="320"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="296"/>
            </Grid.ColumnDefinitions>

            <!-- ── Results column ── -->
            <ScrollViewer Grid.Column="0" x:Name="ResultsScroller"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,4,16">

                    <!-- Result count, enrichment progress, pager -->
                    <Grid Margin="0,0,0,10" MinHeight="28">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Padding="8,2" CornerRadius="9"
                                    Background="{StaticResource AccentTranslucentBrush}"
                                    BorderBrush="{StaticResource InfoBorderBrush}" BorderThickness="1"
                                    Visibility="{Binding IsShowingRelated, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock FontSize="11" Foreground="#7CC0FF">
                                    <Run Text="{Binding ExactMatchCount, Mode=OneWay, StringFormat=N0}"/><Run Text=" "/><Run Text="{DynamicResource String_ExactThenRelated}"/>
                                </TextBlock>
                            </Border>

                            <!-- The typed title matched nothing and autocomplete resolved it. -->
                            <Border Padding="8,2" CornerRadius="9" Margin="8,0,0,0"
                                    Background="{StaticResource SurfaceInputBrush}"
                                    BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1"
                                    Visibility="{Binding SuggestedTerm, Converter={StaticResource NullToVisibilityConverter}}">
                                <TextBlock FontSize="11" Foreground="{StaticResource MutedTextBrush}">
                                    <Run Text="{DynamicResource String_ShowingResultsFor}"/><Run Text=" "/><Run Text="{Binding SuggestedTerm, Mode=OneWay}" Foreground="{StaticResource PrimaryTextBrush}"/>
                                </TextBlock>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Margin="12,0,0,0" Padding="8,2" CornerRadius="9"
                                    Background="{StaticResource AccentTranslucentBrush}"
                                    BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"
                                    Visibility="{Binding SearchState, Converter={StaticResource StringMatchToVisibilityConverter}, ConverterParameter=Refreshing}">
                                <StackPanel Orientation="Horizontal">
                                    <Border Style="{StaticResource SkeletonBlock}" Width="9" Height="9" CornerRadius="4" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource String_LoadingMore}" FontSize="11" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"
                                    Visibility="{Binding HiddenByContentFilters, Converter={StaticResource NullToVisibilityConverter}}">
                            <TextBlock FontSize="11" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center">
                                <Run Text="{Binding HiddenByContentFilters, Mode=OneWay}"/><Run Text=" "/><Run Text="{DynamicResource String_HiddenByFilters}"/>
                            </TextBlock>
                        </StackPanel>
                    </Grid>

                    <!-- Error: shown only when SearchState == Error -->
                    <Border Background="{StaticResource DangerBgBrush}" BorderBrush="{StaticResource DangerBrush}"
                            BorderThickness="1" CornerRadius="{StaticResource RadiusMd}"
                            Padding="14,10" Margin="0,0,0,12"
                            Visibility="{Binding SearchState, Converter={StaticResource StringMatchToVisibilityConverter}, ConverterParameter=Error}">
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"
                                   Style="{StaticResource BodyMedium}" TextWrapping="Wrap"/>
                    </Border>

                    <!-- Viewport Container: Skeletons, Results, and Empty State share the same coordinate space, eliminating vertical flicker -->
                    <Grid>
                        <!-- Loading: skeletons shown only during LoadingInitial -->
                        <ItemsControl Visibility="{Binding SearchState, Converter={StaticResource StringMatchToVisibilityConverter}, ConverterParameter=LoadingInitial}"
                                      ItemsSource="{StaticResource SkeletonSlots}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource SkeletonCard}" Width="288" Height="330"
                                            Margin="0,0,12,12">
                                        <StackPanel>
                                            <Border Style="{StaticResource SkeletonBlock}" Height="134"
                                                    Margin="-16,-16,-16,14" CornerRadius="8,8,0,0"/>
                                            <Border Style="{StaticResource SkeletonBlock}" Height="17" Width="186"
                                                    HorizontalAlignment="Left" Margin="0,0,0,8"/>
                                            <Border Style="{StaticResource SkeletonBlock}" Height="11" Width="112"
                                                    HorizontalAlignment="Left" Margin="0,0,0,14"/>
                                            <WrapPanel Margin="0,0,0,16">
                                                <Border Style="{StaticResource SkeletonBlock}" Height="18" Width="64"
                                                        Margin="0,0,6,6" CornerRadius="9"/>
                                                <Border Style="{StaticResource SkeletonBlock}" Height="18" Width="52"
                                                        Margin="0,0,6,6" CornerRadius="9"/>
                                                <Border Style="{StaticResource SkeletonBlock}" Height="18" Width="76"
                                                        Margin="0,0,6,6" CornerRadius="9"/>
                                            </WrapPanel>
                                            <Grid VerticalAlignment="Bottom">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="74"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Style="{StaticResource SkeletonBlock}"
                                                        Height="34" CornerRadius="6"/>
                                                <Border Grid.Column="2" Style="{StaticResource SkeletonBlock}"
                                                        Height="34" CornerRadius="6"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Cards. The view toggle swaps both the panel and the item template. -->
                        <ItemsControl ItemsSource="{Binding Results}"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling">
                            <ItemsControl.Style>
                                <Style TargetType="ItemsControl">
                                    <Setter Property="ItemTemplate" Value="{StaticResource ResultCardTemplate}"/>
                                    <Setter Property="ItemsPanel">
                                        <Setter.Value>
                                            <ItemsPanelTemplate>
                                                <ctrl:VirtualizingWrapPanel ItemWidth="300" ItemHeight="350"/>
                                            </ItemsPanelTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsGridView}" Value="False">
                                            <Setter Property="ItemTemplate" Value="{StaticResource ResultRowTemplate}"/>
                                            <Setter Property="ItemsPanel">
                                                <Setter.Value>
                                                    <ItemsPanelTemplate>
                                                        <VirtualizingStackPanel Orientation="Vertical"/>
                                                    </ItemsPanelTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.Style>
                        </ItemsControl>

                        <!-- Empty. Shown ONLY when SearchState == Empty; completely eliminates flicker during Refreshing -->
                        <Border Background="{StaticResource SurfaceCardBrush}"
                                BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1"
                                CornerRadius="{StaticResource RadiusLg}" Padding="44,34" Margin="0,4,0,0"
                                Visibility="{Binding SearchState, Converter={StaticResource StringMatchToVisibilityConverter}, ConverterParameter=Empty}">
                            <StackPanel HorizontalAlignment="Center">
                                <Path Data="{StaticResource IconSearch}" Fill="{StaticResource MutedTextBrush}"
                                      Stretch="Uniform" Width="38" Height="38" Margin="0,0,0,14" HorizontalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource String_NoResultsFound}" Style="{StaticResource H3}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource String_NoResultsFoundDesc}" Style="{StaticResource Caption}"
                                           Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" Margin="0,6,0,14" TextWrapping="Wrap"
                                           MaxWidth="360" TextAlignment="Center"/>
                                <Button Content="{DynamicResource String_ClearAllFilters}" Style="{StaticResource SecondaryButton}"
                                        HorizontalAlignment="Center" Command="{Binding ClearAllFiltersCommand}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Bottom of the list. The scroll handler asks for the next page as this
                         comes into view; the row only says so while a page is on the wire. -->
                    <Border x:Name="LoadMoreSentinel" Height="56" Margin="0,4,0,0"
                            Visibility="{Binding HasMoreResults, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding IsLoadingMore, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Border Style="{StaticResource SkeletonBlock}" Width="13" Height="13"
                                    CornerRadius="7" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource String_LoadingMore}" FontSize="12"
                                       Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ── Filter panel ── -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding FilterGroups}"
                              ItemTemplate="{StaticResource FilterGroupTemplate}"
                              Margin="0,0,4,16"/>
            </ScrollViewer>
        </Grid>

        <!-- ═══ STORE PAGE MODAL ═══ -->
        <Grid Grid.Row="0" Grid.RowSpan="4"
              Visibility="{Binding IsDetailOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <!-- Modal backdrop overlay: click outside card closes the modal -->
            <Border Background="#C2040407" Cursor="Hand">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding CloseDetailCommand}"/>
                </Border.InputBindings>
            </Border>

            <!-- Modal dialog card -->
            <Border Background="{StaticResource SurfaceCardBrush}"
                    BorderBrush="{StaticResource StrongBorderBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource RadiusLg}"
                    MaxWidth="1120" Margin="28"
                    ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Modal header -->
                    <Border Grid.Row="0" Background="{StaticResource TopBarBackgroundBrush}"
                            BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="0,0,0,1"
                            CornerRadius="11,11,0,0"
                            Padding="14,9">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding DetailTarget.Name}" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding DetailUrl}" FontSize="10.5"
                                           FontFamily="{StaticResource MonospaceFontFamily}"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Padding="9,7"
                                    Command="{Binding CloseDetailCommand}">
                                <Path Data="{StaticResource IconClose}" Fill="{StaticResource SecondaryTextBrush}"
                                      Stretch="Uniform" Width="11" Height="11"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Embedded store page -->
                    <Grid Grid.Row="1" Background="#1B2838">
                        <wv2:WebView2 x:Name="StorePageView"/>
                    </Grid>

                    <!-- Modal actions -->
                    <Border Grid.Row="2" Background="{StaticResource TopBarBackgroundBrush}"
                            BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="0,1,0,0"
                            CornerRadius="0,0,11,11"
                            Padding="14,10">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource SecondaryButton}" Padding="12,8" Margin="0,0,8,0"
                                    Command="{Binding FindSimilarCommand}"
                                    CommandParameter="{Binding DetailTarget}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconSimilar}" Fill="{StaticResource SecondaryTextBrush}"
                                          Stretch="Uniform" Width="12" Height="12" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource String_SimilarGames}" FontSize="12"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SecondaryButton}" Padding="12,8" Margin="0,0,8,0"
                                    ToolTip="{DynamicResource String_ViewOnSteamDb}"
                                    Command="{Binding OpenSteamDbCommand}"
                                    CommandParameter="{Binding DetailTarget}">
                                <Path Data="{StaticResource IconSteamDb}" Fill="{StaticResource SecondaryTextBrush}"
                                      Stretch="Uniform" Width="14" Height="14"/>
                            </Button>
                            <Button Style="{StaticResource PrimaryButton}" Padding="14,8"
                                    Command="{Binding AddToLibraryCommand}"
                                    CommandParameter="{Binding DetailTarget}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconPlus}" Fill="{StaticResource InverseTextBrush}"
                                          Stretch="Uniform" Width="12" Height="12" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource String_AddToInstance}" FontSize="12"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══ EXPLORE FIRST LOAD OVERLAY SCREEN ═══ -->
        <Grid x:Name="ExploreLoadingOverlay"
              Grid.Row="0"
              Grid.RowSpan="4"
              Background="{StaticResource BaseBackgroundBrush}"
              Panel.ZIndex="200"
              Opacity="1"
              Visibility="Visible"
              IsHitTestVisible="True">

            <Grid.Resources>
                <!-- Continuous Smooth Spin in place -->
                <Storyboard x:Key="ExploreStarSpinStoryboard" RepeatBehavior="Forever">
                    <DoubleAnimation Storyboard.TargetName="ExploreStarRotate"
                                     Storyboard.TargetProperty="Angle"
                                     From="0" To="360"
                                     Duration="0:0:2.0"/>
                    <!-- Subtle Glow Breathing Pulse -->
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ExploreStarGlow"
                                                   Storyboard.TargetProperty="Opacity">
                        <SplineDoubleKeyFrame KeyTime="0:0:0.0" Value="0.5"/>
                        <SplineDoubleKeyFrame KeyTime="0:0:1.0" Value="0.95" KeySpline="0.4, 0.0, 0.6, 1.0"/>
                        <SplineDoubleKeyFrame KeyTime="0:0:2.0" Value="0.5" KeySpline="0.4, 0.0, 0.6, 1.0"/>
                    </DoubleAnimationUsingKeyFrames>
                </Storyboard>
            </Grid.Resources>

            <Grid.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard Storyboard="{StaticResource ExploreStarSpinStoryboard}"/>
                </EventTrigger>
            </Grid.Triggers>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- Spin & Glow Container -->
                <Grid Width="100" Height="100" HorizontalAlignment="Center" Margin="0,0,0,24">
                    <!-- Subtle Radial Glow behind Star -->
                    <Ellipse x:Name="ExploreStarGlow" Width="76" Height="76"
                             VerticalAlignment="Center" HorizontalAlignment="Center"
                             Fill="{StaticResource AccentTranslucentBrush}">
                        <Ellipse.Effect>
                            <BlurEffect Radius="28"/>
                        </Ellipse.Effect>
                    </Ellipse>

                    <!-- Animated Star Vector Graphic -->
                    <Viewbox Width="56" Height="56"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             RenderTransformOrigin="0.5,0.5">
                        <Viewbox.RenderTransform>
                            <RotateTransform x:Name="ExploreStarRotate"/>
                        </Viewbox.RenderTransform>
                        <Path Data="{StaticResource IconStar}"
                              Fill="{StaticResource AccentBrush}">
                            <Path.Effect>
                                <DropShadowEffect Color="#1B90FF" BlurRadius="18" ShadowDepth="0" Opacity="0.9"/>
                            </Path.Effect>
                        </Path>
                    </Viewbox>
                </Grid>

                <!-- Brand Name & Explore Tag -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                    <TextBlock Text="BlueStar"
                               FontSize="26" FontWeight="Bold"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               FontFamily="{StaticResource MainFontFamily}"
                               VerticalAlignment="Center"/>
                    <Border Background="{StaticResource AccentTranslucentBrush}"
                            CornerRadius="{StaticResource RadiusXs}"
                            Padding="6,2" Margin="10,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="EXPLORE" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}"/>
                    </Border>
                </StackPanel>

                <!-- Dynamic Status Text -->
                <TextBlock Text="{Binding LoadingStatusText}"
                           FontSize="13"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
