<UserControl x:Class="BlueStar.App.Views.BrowseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:vm="clr-namespace:BlueStar.App.ViewModels"
             xmlns:controls="clr-namespace:BlueStar.App.Controls"
             d:DataContext="{d:DesignInstance vm:BrowseViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{StaticResource BaseBackgroundBrush}"
             Foreground="{StaticResource PrimaryTextBrush}"
             FontFamily="{StaticResource MainFontFamily}">

    <UserControl.RenderTransform>
        <TranslateTransform Y="0"/>
    </UserControl.RenderTransform>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     From="0.0" To="1.0" Duration="0:0:0.22">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                     From="12" To="0" Duration="0:0:0.22">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <ScrollViewer x:Name="BrowseScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,24" MaxWidth="1180" HorizontalAlignment="Stretch">

            <!-- ═══ HEADER & EXPLORE HERO SEARCH BAR ═══ -->
            <Border Background="{StaticResource SurfaceCardBrush}"
                    BorderBrush="{StaticResource SubtleBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusLg}"
                    Padding="28,22"
                    Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Explore Catalog" Style="{StaticResource H1}" Margin="0,0,0,4"/>
                    <TextBlock Text="Search games, manifests, DLCs and tools directly across DepotBox."
                               Style="{StaticResource Subtitle}" Margin="0,0,0,18"/>

                    <!-- Search Input Box Row -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="{StaticResource SurfaceInputBrush}"
                                BorderBrush="{StaticResource SubtleBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusMd}"
                                Padding="12,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0" Data="{StaticResource IconSearch}"
                                      Fill="{StaticResource MutedTextBrush}"
                                      Stretch="Uniform" Width="16" Height="16"
                                      Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <Grid Grid.Column="1">
                                    <TextBlock Text="Search games, manifests, Steam AppID or keywords (e.g. Counter-Strike, Cyberpunk)..."
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="13" VerticalAlignment="Center" Margin="2,0,0,0"
                                               IsHitTestVisible="False"
                                               Visibility="{Binding SearchQuery, Converter={StaticResource InverseNullToVisibilityConverter}}"/>
                                    <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Foreground="{StaticResource PrimaryTextBrush}"
                                             CaretBrush="{StaticResource PrimaryTextBrush}"
                                             FontSize="13"
                                             Padding="0,10"
                                             VerticalContentAlignment="Center">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Return" Command="{Binding SearchCommand}"/>
                                        </TextBox.InputBindings>
                                    </TextBox>
                                </Grid>
                                <Button Grid.Column="2"
                                        Content="✕"
                                        Style="{StaticResource GhostButton}"
                                        Padding="6,2"
                                        FontSize="12"
                                        Foreground="{StaticResource MutedTextBrush}"
                                        Command="{Binding ClearSearchCommand}"
                                        Visibility="{Binding SearchQuery, Converter={StaticResource NullToVisibilityConverter}}"/>
                            </Grid>
                        </Border>

                        <Button Grid.Column="2" Content="Search Catalog"
                                Style="{StaticResource PrimaryButton}"
                                Padding="24,10"
                                FontSize="13"
                                Command="{Binding SearchCommand}"
                                IsEnabled="{Binding IsSearching, Converter={StaticResource InverseBoolConverter}}"/>
                    </Grid>

                    <!-- Dynamic Suggestion / Quick Search Chips -->
                    <WrapPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock Text="🔥" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="Trending:" Style="{StaticResource CaptionBold}" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding TrendingSuggestionChips}" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.QuickSearchCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding Name}"
                                            Cursor="Hand"
                                            Margin="0,2,8,2"
                                            VerticalAlignment="Center">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="ChipBorder"
                                                        Background="{Binding BackgroundBrush}"
                                                        BorderBrush="{Binding BorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="{StaticResource RadiusSm}"
                                                        Padding="8,4"
                                                        Opacity="{Binding Opacity}"
                                                        SnapsToDevicePixels="True">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border Background="{Binding RankBadgeBackgroundBrush}"
                                                                CornerRadius="{StaticResource RadiusXs}"
                                                                Padding="5,1"
                                                                Margin="0,0,7,0"
                                                                VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Rank}"
                                                                       FontSize="10"
                                                                       FontWeight="Bold"
                                                                       Foreground="{Binding RankBadgeTextBrush}"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{Binding TextBrush}"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ChipBorder" Property="Opacity" Value="1.0"/>
                                                        <Setter TargetName="ChipBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                        <Setter TargetName="ChipBorder" Property="Background" Value="{StaticResource AccentTranslucentBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="ChipBorder" Property="Opacity" Value="0.9"/>
                                                        <Setter TargetName="ChipBorder" Property="Background" Value="{StaticResource AccentGlowBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- ═══ ERROR BANNER ═══ -->
            <Border Background="{StaticResource DangerBgBrush}"
                    BorderBrush="{StaticResource DangerBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusMd}"
                    Padding="14,10"
                    Margin="0,0,0,16"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"
                           Style="{StaticResource BodyMedium}"/>
            </Border>

            <!-- ═══ SKELETON LOADING STATE (During search) ═══ -->
            <StackPanel Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,0,0,24">
                <Border Background="{StaticResource SurfaceCardBrush}"
                        BorderBrush="{StaticResource SubtleBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusMd}"
                        Padding="16,12"
                        Margin="0,0,0,20">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Path Data="{StaticResource IconExplore}" Fill="{StaticResource AccentBrush}"
                              Stretch="Uniform" Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Searching DepotBox catalog &amp; retrieving manifests..." Style="{StaticResource BodyMedium}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Skeleton Cards Grid -->
                <ItemsControl HorizontalAlignment="Center">
                    <ItemsControl.ItemsSource>
                        <x:Array Type="{x:Type sys:Int32}">
                            <sys:Int32>1</sys:Int32>
                            <sys:Int32>2</sys:Int32>
                            <sys:Int32>3</sys:Int32>
                            <sys:Int32>4</sys:Int32>
                            <sys:Int32>5</sys:Int32>
                            <sys:Int32>6</sys:Int32>
                        </x:Array>
                    </ItemsControl.ItemsSource>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource SkeletonCard}" Width="360" Margin="0,0,16,16">
                                <StackPanel>
                                    <Border Style="{StaticResource SkeletonBlock}" Height="168" Margin="-16,-16,-16,12" CornerRadius="8,8,0,0"/>
                                    <Border Style="{StaticResource SkeletonBlock}" Height="18" Width="180" HorizontalAlignment="Left" Margin="0,0,0,6"/>
                                    <Border Style="{StaticResource SkeletonBlock}" Height="12" Width="100" HorizontalAlignment="Left" Margin="0,0,0,12"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                        <Border Style="{StaticResource SkeletonBlock}" Height="20" Width="70" Margin="0,0,8,0" CornerRadius="4"/>
                                        <Border Style="{StaticResource SkeletonBlock}" Height="20" Width="60" CornerRadius="4"/>
                                    </StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Style="{StaticResource SkeletonBlock}" Height="34" CornerRadius="6"/>
                                        <Border Grid.Column="2" Style="{StaticResource SkeletonBlock}" Height="34" CornerRadius="6"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- ═══ INITIAL DISCOVERY HUB: 8 CATEGORY CAROUSELS (When NOT searched) ═══ -->
            <StackPanel Visibility="{Binding HasSearched, Converter={StaticResource InverseBoolToVisibilityConverter}}" Margin="0,4,0,0">
                <ItemsControl ItemsSource="{Binding Categories}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <controls:GameCategoryCarousel
                                Category="{Binding}"
                                IsExploreTab="True"
                                AddToLibraryCommand="{Binding DataContext.AddToLibraryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                OpenSteamDbCommand="{Binding DataContext.OpenSteamDbCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                ViewMoreCommand="{Binding DataContext.ToggleCategoryExpandCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                LoadMoreCommand="{Binding DataContext.LoadMoreCategoryItemsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- ═══ SEARCH RESULTS AREA (When Searched) ═══ -->
            <StackPanel Visibility="{Binding HasSearched, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Visibility="{Binding IsSearching, Converter={StaticResource InverseBoolToVisibilityConverter}}">

                    <!-- Results & Filter Toolbar -->
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Result count & query + Filter Chips -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding FilteredResults.Count, StringFormat='Found {0} items'}"
                                       FontWeight="Bold" FontSize="13" Foreground="{StaticResource PrimaryTextBrush}"
                                       VerticalAlignment="Center" Margin="0,0,12,0"/>

                            <!-- Type Filter Chips -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <RadioButton GroupName="BrowseTypeFilter" Style="{StaticResource FilterChipRadioButton}" Content="All"
                                             IsChecked="{Binding SelectedTypeFilter, Converter={StaticResource StringMatchConverter}, ConverterParameter=All}"
                                             Command="{Binding SelectTypeFilterCommand}" CommandParameter="All"/>
                                <RadioButton GroupName="BrowseTypeFilter" Style="{StaticResource FilterChipCyan}" Content="🎮 Games"
                                             IsChecked="{Binding SelectedTypeFilter, Converter={StaticResource StringMatchConverter}, ConverterParameter=Games}"
                                             Command="{Binding SelectTypeFilterCommand}" CommandParameter="Games"/>
                                <RadioButton GroupName="BrowseTypeFilter" Style="{StaticResource FilterChipPurple}" Content="🎁 DLCs"
                                             IsChecked="{Binding SelectedTypeFilter, Converter={StaticResource StringMatchConverter}, ConverterParameter=DLCs}"
                                             Command="{Binding SelectTypeFilterCommand}" CommandParameter="DLCs"/>
                                <RadioButton GroupName="BrowseTypeFilter" Style="{StaticResource FilterChipAmber}" Content="🛠️ Tools"
                                             IsChecked="{Binding SelectedTypeFilter, Converter={StaticResource StringMatchConverter}, ConverterParameter=Tools}"
                                             Command="{Binding SelectTypeFilterCommand}" CommandParameter="Tools"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Right: Reset / Clear search -->
                        <Button Grid.Column="1" Content="✕ Clear Search"
                                Style="{StaticResource GhostButton}"
                                Foreground="{StaticResource MutedTextBrush}"
                                Padding="8,4"
                                Command="{Binding ClearSearchCommand}"/>
                    </Grid>

                    <!-- Results Cards Grid -->
                    <ItemsControl ItemsSource="{Binding FilteredResults}" HorizontalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Width="360" Margin="0,0,16,16">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="168"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*" MinHeight="14"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Game Cover Header Artwork (Banner 460x215 aspect ratio, 360x168) -->
                                        <Border Grid.Row="0" CornerRadius="8,8,0,0"
                                                Background="{StaticResource SurfaceCardHoverBrush}"
                                                ClipToBounds="True"
                                                Margin="-16,-16,-16,12">
                                            <Grid>
                                                <Path Data="{StaticResource IconGamepad}" Fill="{StaticResource MutedTextBrush}"
                                                      Stretch="Uniform" Width="36" Height="36"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <Image Source="{Binding HeaderImageUrl, Converter={StaticResource CachedImageConverter}}"
                                                       Stretch="UniformToFill"
                                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                            </Grid>
                                        </Border>

                                        <!-- Title & Steam AppId -->
                                        <StackPanel Grid.Row="1">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource H3}"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                            <TextBlock Text="{Binding AppId, StringFormat='Steam AppID: {0}'}"
                                                       Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <!-- ═══ GLOBITOS / BADGES ROW 1 (App Type, Version, DLCs) ═══ -->
                                        <WrapPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                                            <!-- App Type Badge -->
                                            <Border CornerRadius="{StaticResource RadiusSm}"
                                                    Padding="7,2"
                                                    Margin="0,0,6,4"
                                                    Background="{StaticResource SurfaceInputBrush}"
                                                    BorderBrush="{StaticResource SubtleBorderBrush}"
                                                    BorderThickness="1">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="🎮 " FontSize="10" Visibility="{Binding AppType, Converter={StaticResource StringMatchToVisibilityConverter}, ConverterParameter='Game'}"/>
                                                    <TextBlock Text="💻 " FontSize="10" Visibility="{Binding AppType, Converter={StaticResource StringMatchToVisibilityConverter}, ConverterParameter='Application'}"/>
                                                    <TextBlock Text="🛠️ " FontSize="10" Visibility="{Binding AppType, Converter={StaticResource StringMatchToVisibilityConverter}, ConverterParameter='Tool'}"/>
                                                    <TextBlock Text="{Binding AppType}"
                                                               FontSize="11" FontWeight="Normal"
                                                               Foreground="{StaticResource SecondaryTextBrush}"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Steam Update Date / Version Badge -->
                                            <Border CornerRadius="{StaticResource RadiusSm}"
                                                    Padding="7,2"
                                                    Margin="0,0,6,4"
                                                    Background="{StaticResource SurfaceInputBrush}"
                                                    BorderBrush="{StaticResource SubtleBorderBrush}"
                                                    BorderThickness="1"
                                                    Visibility="{Binding Version, Converter={StaticResource NullToVisibilityConverter}}">
                                                <TextBlock Text="{Binding Version, StringFormat='📅 {0}'}"
                                                           FontSize="11" FontWeight="Normal"
                                                           Foreground="{StaticResource PrimaryTextBrush}"/>
                                            </Border>

                                            <!-- DLCs Badge (if game has DLCs) -->
                                            <Border CornerRadius="{StaticResource RadiusSm}"
                                                    Padding="7,2"
                                                    Margin="0,0,6,4"
                                                    Background="#258B5CF6"
                                                    BorderBrush="#608B5CF6"
                                                    BorderThickness="1"
                                                    Visibility="{Binding DlcCount, Converter={StaticResource NullToVisibilityConverter}}">
                                                <TextBlock Text="{Binding DlcCount, StringFormat='🎁 {0} DLCs'}"
                                                           FontSize="11" FontWeight="Normal"
                                                           Foreground="#A78BFA"/>
                                            </Border>

                                            <!-- NSFW Badge -->
                                            <Border CornerRadius="{StaticResource RadiusSm}"
                                                    Padding="7,2" Margin="0,0,6,4"
                                                    Background="#25EF4444" BorderBrush="#60EF4444" BorderThickness="1"
                                                    Visibility="{Binding IsNsfw, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    ToolTip="NSFW / Mature Content (18+)">
                                                <TextBlock Text="🔞 NSFW" FontSize="11" FontWeight="Normal" Foreground="#EF4444"/>
                                            </Border>

                                            <!-- DRM Badge -->
                                            <Border CornerRadius="{StaticResource RadiusSm}"
                                                    Padding="7,2" Margin="0,0,6,4"
                                                    Background="#25F59E0B" BorderBrush="#60F59E0B" BorderThickness="1"
                                                    Visibility="{Binding HasDrm, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    ToolTip="{Binding DrmNotice, FallbackValue='Requires 3rd-party DRM or account'}">
                                                <TextBlock Text="🔒 DRM" FontSize="11" FontWeight="Normal" Foreground="#F59E0B"/>
                                            </Border>
                                        </WrapPanel>

                                        <!-- ═══ GLOBITOS / BADGES ROW 2 (Supported OS Platforms) ═══ -->
                                        <WrapPanel Grid.Row="3" Orientation="Horizontal" Margin="0,2,0,0">
                                            <!-- Windows OS Badge -->
                                            <Border CornerRadius="{StaticResource RadiusSm}"
                                                    Padding="6,2"
                                                    Margin="0,0,5,4"
                                                    Background="#201B90FF"
                                                    BorderBrush="#501B90FF"
                                                    BorderThickness="1"
                                                    Visibility="{Binding HasWindows, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    ToolTip="Windows Compatible">
                                                <TextBlock Text="⊞ Windows" FontSize="10" FontWeight="Normal" Foreground="{StaticResource AccentBrush}"/>
                                            </Border>

                                            <!-- Linux / SteamOS Badge -->
                                            <Border CornerRadius="{StaticResource RadiusSm}"
                                                    Padding="6,2"
                                                    Margin="0,0,5,4"
                                                    Background="#20F59E0B"
                                                    BorderBrush="#50F59E0B"
                                                    BorderThickness="1"
                                                    Visibility="{Binding HasLinux, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    ToolTip="Linux / SteamOS Compatible">
                                                <TextBlock Text="🐧 Linux" FontSize="10" FontWeight="Normal" Foreground="{StaticResource WarningBrush}"/>
                                            </Border>

                                            <!-- macOS Badge -->
                                            <Border CornerRadius="{StaticResource RadiusSm}"
                                                    Padding="6,2"
                                                    Margin="0,0,5,4"
                                                    Background="#20A1A1AA"
                                                    BorderBrush="#50A1A1AA"
                                                    BorderThickness="1"
                                                    Visibility="{Binding HasMac, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    ToolTip="macOS Compatible">
                                                <TextBlock Text="🍎 macOS" FontSize="10" FontWeight="Normal" Foreground="{StaticResource SecondaryTextBrush}"/>
                                            </Border>
                                        </WrapPanel>

                                        <!-- ═══ ACTIONS ROW (Add to Instances & SteamDB synergy) ═══ -->
                                        <Grid Grid.Row="5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Button Grid.Column="0"
                                                    Style="{StaticResource PrimaryButton}"
                                                    Padding="12,8"
                                                    Command="{Binding DataContext.AddToLibraryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    IsEnabled="{Binding IsCreating, Converter={StaticResource InverseBoolConverter}}">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <TextBlock Text="⏳ " FontWeight="Normal" Visibility="{Binding IsCreating, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                    <TextBlock Text="{Binding CreationStatus}" FontWeight="Normal" Visibility="{Binding IsCreating, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                    <TextBlock Text="➕ Add to Instances" FontWeight="Normal" Visibility="{Binding IsCreating, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                                </StackPanel>
                                            </Button>

                                            <!-- SteamDB Synergy Button -->
                                            <Button Grid.Column="2"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Padding="10,8"
                                                    ToolTip="View depot &amp; app details on SteamDB.info"
                                                    Command="{Binding DataContext.OpenSteamDbCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <TextBlock Text="🌐 SteamDB" FontSize="11" FontWeight="Normal"/>
                                            </Button>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- ═══ NO RESULTS FOUND STATE ═══ -->
                    <Border Background="{StaticResource SurfaceCardBrush}"
                            BorderBrush="{StaticResource SubtleBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusLg}"
                            Padding="48,36"
                            Margin="0,8,0,0"
                            Visibility="{Binding FilteredResults.Count, Converter={StaticResource ZeroToVisibilityConverter}}">
                        <StackPanel HorizontalAlignment="Center">
                            <Path Data="{StaticResource IconSearch}" Fill="{StaticResource MutedTextBrush}"
                                  Stretch="Uniform" Width="44" Height="44" Margin="0,0,0,16" HorizontalAlignment="Center"/>
                            <TextBlock Text="No results found" Style="{StaticResource H2}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Try adjusting your search query, clearing filters, or checking spelling."
                                       Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,6,0,16"/>
                            <Button Content="✕ Reset Search" Style="{StaticResource SecondaryButton}"
                                    HorizontalAlignment="Center"
                                    Command="{Binding ClearSearchCommand}"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
