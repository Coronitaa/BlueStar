<UserControl x:Class="BlueStar.App.Views.BrowseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:BlueStar.App.ViewModels"
             d:DataContext="{d:DesignInstance vm:BrowseViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{StaticResource BaseBackgroundBrush}"
             Foreground="{StaticResource PrimaryTextBrush}"
             FontFamily="{StaticResource MainFontFamily}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,24" MaxWidth="1180" HorizontalAlignment="Stretch">

            <!-- ═══ HEADER & EXPLORE SEARCH BAR ═══ -->
            <Border Background="{StaticResource SurfaceCardBrush}"
                    BorderBrush="{StaticResource SubtleBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusLg}"
                    Padding="28,24"
                    Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="Explore Catalog" Style="{StaticResource H1}" Margin="0,0,0,6"/>
                    <TextBlock Text="Search games, manifests, and content packages from DepotBox."
                               Style="{StaticResource Subtitle}" Margin="0,0,0,20"/>

                    <!-- Search Input Box Row -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="{StaticResource SurfaceInputBrush}"
                                BorderBrush="{StaticResource SubtleBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusMd}"
                                Padding="12,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0" Data="{StaticResource IconSearch}"
                                      Fill="{StaticResource MutedTextBrush}"
                                      Stretch="Uniform" Width="16" Height="16"
                                      Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Foreground="{StaticResource PrimaryTextBrush}"
                                         CaretBrush="{StaticResource PrimaryTextBrush}"
                                         FontSize="14"
                                         Padding="0,10"
                                         VerticalContentAlignment="Center">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Return" Command="{Binding SearchCommand}"/>
                                    </TextBox.InputBindings>
                                </TextBox>
                            </Grid>
                        </Border>

                        <Button Grid.Column="2" Content="Search Catalog"
                                Style="{StaticResource PrimaryButton}"
                                Padding="22,10"
                                Command="{Binding SearchCommand}"
                                IsEnabled="{Binding IsSearching, Converter={StaticResource InverseBoolConverter}}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ═══ ERROR BANNER ═══ -->
            <Border Background="{StaticResource DangerBgBrush}"
                    BorderBrush="{StaticResource DangerBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusMd}"
                    Padding="14,10"
                    Margin="0,0,0,16"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"
                           Style="{StaticResource BodyMedium}"/>
            </Border>

            <!-- ═══ LOADING STATE ═══ -->
            <Border Background="{StaticResource SurfaceCardBrush}"
                    BorderBrush="{StaticResource SubtleBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusLg}"
                    Padding="48"
                    Margin="0,0,0,24"
                    Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center">
                    <Path Data="{StaticResource IconExplore}" Fill="{StaticResource AccentBrush}"
                          Stretch="Uniform" Width="40" Height="40" Margin="0,0,0,16" HorizontalAlignment="Center"/>
                    <TextBlock Text="Searching DepotBox catalog..." Style="{StaticResource H3}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- ═══ INITIAL EMPTY STATE (Before Search) ═══ -->
            <Border Background="{StaticResource SurfaceCardBrush}"
                    BorderBrush="{StaticResource SubtleBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusLg}"
                    Padding="48,36"
                    Visibility="{Binding HasSearched, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center">
                    <Path Data="{StaticResource IconExplore}" Fill="{StaticResource MutedTextBrush}"
                          Stretch="Uniform" Width="52" Height="52" Margin="0,0,0,16" HorizontalAlignment="Center"/>
                    <TextBlock Text="Discover Games &amp; Manifests" Style="{StaticResource H2}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Type a game title or keyword above to search through thousands of DepotBox packages."
                               Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- ═══ NO RESULTS STATE (After Search) ═══ -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding HasSearched}" Value="True"/>
                                    <Condition Binding="{Binding Results.Count}" Value="0"/>
                                    <Condition Binding="{Binding IsSearching}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Border Background="{StaticResource SurfaceCardBrush}"
                        BorderBrush="{StaticResource SubtleBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusLg}"
                        Padding="48,36">
                    <StackPanel HorizontalAlignment="Center">
                        <Path Data="{StaticResource IconSearch}" Fill="{StaticResource MutedTextBrush}"
                              Stretch="Uniform" Width="48" Height="48" Margin="0,0,0,16" HorizontalAlignment="Center"/>
                        <TextBlock Text="No results found" Style="{StaticResource H2}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Try adjusting your search query or check spelling."
                                   Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ═══ RESULTS GRID ═══ -->
            <ItemsControl ItemsSource="{Binding Results}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Width="360" Margin="0,0,20,20">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="145"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="14"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Game Cover Header Artwork (Banner) -->
                                <Border Grid.Row="0" CornerRadius="8"
                                        Background="{StaticResource SurfaceCardHoverBrush}"
                                        ClipToBounds="True"
                                        Margin="-16,-16,-16,12">
                                    <Grid>
                                        <Path Data="{StaticResource IconGamepad}" Fill="{StaticResource MutedTextBrush}"
                                              Stretch="Uniform" Width="36" Height="36"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Image Source="{Binding HeaderImageUrl}"
                                               Stretch="UniformToFill"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Grid>
                                </Border>

                                <!-- Title & Steam AppId -->
                                <StackPanel Grid.Row="1">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource H3}"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                    <TextBlock Text="{Binding AppId, StringFormat='Steam AppID: {0}'}"
                                               Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- ═══ GLOBITOS / BADGES ROW 1 (App Type, Version, DLCs) ═══ -->
                                <WrapPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                                    <!-- App Type Badge -->
                                    <Border CornerRadius="{StaticResource RadiusSm}"
                                            Padding="7,3"
                                            Margin="0,0,6,4"
                                            Background="{StaticResource SurfaceInputBrush}"
                                            BorderBrush="{StaticResource SubtleBorderBrush}"
                                            BorderThickness="1">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🎮 " FontSize="10" Visibility="{Binding AppType, Converter={StaticResource StringMatchToVisibilityConverter}, ConverterParameter='Game'}"/>
                                            <TextBlock Text="💻 " FontSize="10" Visibility="{Binding AppType, Converter={StaticResource StringMatchToVisibilityConverter}, ConverterParameter='Application'}"/>
                                            <TextBlock Text="🛠️ " FontSize="10" Visibility="{Binding AppType, Converter={StaticResource StringMatchToVisibilityConverter}, ConverterParameter='Tool'}"/>
                                            <TextBlock Text="{Binding AppType}"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{StaticResource SecondaryTextBrush}"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Version Badge (if available) -->
                                    <Border CornerRadius="{StaticResource RadiusSm}"
                                            Padding="7,3"
                                            Margin="0,0,6,4"
                                            Background="{StaticResource SurfaceInputBrush}"
                                            BorderBrush="{StaticResource SubtleBorderBrush}"
                                            BorderThickness="1"
                                            Visibility="{Binding Version, Converter={StaticResource NullToVisibilityConverter}}">
                                        <TextBlock Text="{Binding Version, StringFormat='🏷️ {0}'}"
                                                   FontSize="11" FontWeight="Medium"
                                                   Foreground="{StaticResource PrimaryTextBrush}"/>
                                    </Border>

                                    <!-- DLCs Badge (if game has DLCs) -->
                                    <Border CornerRadius="{StaticResource RadiusSm}"
                                            Padding="7,3"
                                            Margin="0,0,6,4"
                                            Background="#258B5CF6"
                                            BorderBrush="#608B5CF6"
                                            BorderThickness="1"
                                            Visibility="{Binding DlcCount, Converter={StaticResource NullToVisibilityConverter}}">
                                        <TextBlock Text="{Binding DlcCount, StringFormat='🎁 {0} DLCs'}"
                                                   FontSize="11" FontWeight="SemiBold"
                                                   Foreground="#A78BFA"/>
                                    </Border>
                                </WrapPanel>

                                <!-- ═══ GLOBITOS / BADGES ROW 2 (Supported OS & DepotBox Available) ═══ -->
                                <WrapPanel Grid.Row="3" Orientation="Horizontal" Margin="0,2,0,0">
                                    <!-- Windows OS Badge -->
                                    <Border CornerRadius="{StaticResource RadiusSm}"
                                            Padding="6,2"
                                            Margin="0,0,5,4"
                                            Background="#201B90FF"
                                            BorderBrush="#501B90FF"
                                            BorderThickness="1"
                                            Visibility="{Binding HasWindows, Converter={StaticResource BoolToVisibilityConverter}}"
                                            ToolTip="Windows Compatible">
                                        <TextBlock Text="🪟 Windows" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                                    </Border>

                                    <!-- Linux / SteamOS Badge -->
                                    <Border CornerRadius="{StaticResource RadiusSm}"
                                            Padding="6,2"
                                            Margin="0,0,5,4"
                                            Background="#20F59E0B"
                                            BorderBrush="#50F59E0B"
                                            BorderThickness="1"
                                            Visibility="{Binding HasLinux, Converter={StaticResource BoolToVisibilityConverter}}"
                                            ToolTip="Linux / SteamOS Compatible">
                                        <TextBlock Text="🐧 Linux" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}"/>
                                    </Border>

                                    <!-- macOS Badge -->
                                    <Border CornerRadius="{StaticResource RadiusSm}"
                                            Padding="6,2"
                                            Margin="0,0,5,4"
                                            Background="#20A1A1AA"
                                            BorderBrush="#50A1A1AA"
                                            BorderThickness="1"
                                            Visibility="{Binding HasMac, Converter={StaticResource BoolToVisibilityConverter}}"
                                            ToolTip="macOS Compatible">
                                        <TextBlock Text="🍎 macOS" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}"/>
                                    </Border>

                                    <!-- DepotBox Ready Badge -->
                                    <Border CornerRadius="{StaticResource RadiusSm}"
                                            Padding="6,2"
                                            Margin="0,0,5,4"
                                            Background="{StaticResource SuccessBgBrush}">
                                        <TextBlock Text="● DepotBox Ready"
                                                   FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{StaticResource SuccessBrush}"/>
                                    </Border>
                                </WrapPanel>

                                <!-- ═══ ACTIONS ROW (Add to Instances & SteamDB synergy) ═══ -->
                                <Grid Grid.Row="5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0"
                                            Style="{StaticResource PrimaryButton}"
                                            Command="{Binding DataContext.AddToLibraryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            IsEnabled="{Binding IsCreating, Converter={StaticResource InverseBoolConverter}}">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="⏳ " Visibility="{Binding IsCreating, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            <TextBlock Text="{Binding CreationStatus}" Visibility="{Binding IsCreating, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            <TextBlock Text="➕ Add to Instances" Visibility="{Binding IsCreating, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- SteamDB Synergy Button -->
                                    <Button Grid.Column="2"
                                            Style="{StaticResource SecondaryButton}"
                                            Padding="10,8"
                                            ToolTip="View depot &amp; app details on SteamDB.info"
                                            Command="{Binding DataContext.OpenSteamDbCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🌐 SteamDB" FontSize="12" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
