<Window x:Class="BlueStar.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:BlueStar.App.ViewModels"
        xmlns:local="clr-namespace:BlueStar.App.Views"
        xmlns:conv="clr-namespace:BlueStar.App.Converters"
        Title="BlueStar"
        Icon="pack://application:,,,/BlueStar;component/Assets/bluestar.ico"
        Width="1280" Height="840"
        MinWidth="860" MinHeight="580"
        Background="{StaticResource BaseBackgroundBrush}"
        Foreground="{StaticResource PrimaryTextBrush}"
        FontFamily="{StaticResource MainFontFamily}"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="6"
                      CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42"/>  <!-- Top Custom Title bar -->
            <RowDefinition Height="*"/>   <!-- Main Shell Content -->
            <RowDefinition Height="30"/>  <!-- Bottom Status Bar -->
        </Grid.RowDefinitions>

        <!-- ═══ TOP APP BAR / TITLE BAR ═══ -->
        <Border Grid.Row="0" Background="{StaticResource TopBarBackgroundBrush}" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="68"/>   <!-- Compact Sidebar Header width -->
                    <ColumnDefinition Width="*"/>    <!-- Center Title / Drag Area -->
                    <ColumnDefinition Width="Auto"/> <!-- Right Window Controls -->
                </Grid.ColumnDefinitions>

                <!-- App Brand Logo (Centered in 68px column) -->
                <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/BlueStar;component/Assets/bluestar.png"
                           Width="24" Height="24"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </StackPanel>

                <!-- Center Title / Breadcrumb -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
                    <TextBlock Text="BlueStar" FontSize="13" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,8,0"/>
                    <TextBlock Text="•" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,8,0"/>
                    <TextBlock Text="Dashboard" Style="{StaticResource Caption}"
                               Visibility="{Binding SelectedNavigation, Converter={StaticResource StringMatchToVisibilityConverter}, ConverterParameter=Home}"/>
                    <TextBlock Text="Explore Catalog" Style="{StaticResource Caption}"
                               Visibility="{Binding SelectedNavigation, Converter={StaticResource StringMatchToVisibilityConverter}, ConverterParameter=Explore}"/>
                    <TextBlock Text="Instance Library" Style="{StaticResource Caption}"
                               Visibility="{Binding SelectedNavigation, Converter={StaticResource StringMatchToVisibilityConverter}, ConverterParameter=Library}"/>
                    <TextBlock Text="Download Queue" Style="{StaticResource Caption}"
                               Visibility="{Binding SelectedNavigation, Converter={StaticResource StringMatchToVisibilityConverter}, ConverterParameter=Downloads}"/>
                    <TextBlock Text="Application Settings" Style="{StaticResource Caption}"
                               Visibility="{Binding SelectedNavigation, Converter={StaticResource StringMatchToVisibilityConverter}, ConverterParameter=Settings}"/>
                    <TextBlock Text="About &amp; Open-Source Credits" Style="{StaticResource Caption}"
                               Visibility="{Binding SelectedNavigation, Converter={StaticResource StringMatchToVisibilityConverter}, ConverterParameter=About}"/>
                </StackPanel>

                <!-- Steam Status Pill & Window Control Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            VerticalAlignment="Center">

                    <!-- Steam Status Indicator Pill -->
                    <Border Background="{StaticResource SurfaceInputBrush}"
                            BorderBrush="{StaticResource SubtleBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusMd}"
                            Padding="10,4"
                            Margin="0,0,14,0"
                            VerticalAlignment="Center"
                            ToolTip="{Binding SteamTooltipText}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Live Status Dot -->
                            <Ellipse Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource MutedTextBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSteamRunning}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>

                            <!-- Steam Label & Active Persona -->
                            <TextBlock Text="{Binding SteamStatusText}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Window Control Buttons (Minimize, Maximize, Close) -->
                    <Button x:Name="MinimizeButton" Click="MinimizeButton_Click"
                            Style="{StaticResource TitleBarButton}">
                        <TextBlock Text="─" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>
                    <Button x:Name="MaximizeButton" Click="MaximizeButton_Click"
                            Style="{StaticResource TitleBarButton}">
                        <TextBlock Text="☐" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>
                    <Button x:Name="CloseButton" Click="CloseButton_Click"
                            Style="{StaticResource TitleBarCloseButton}">
                        <TextBlock Text="✕" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ MAIN SHELL LAYOUT ═══ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="68"/>   <!-- Left Compact Sidebar (68px) -->
                <ColumnDefinition Width="1"/>    <!-- Border Separator -->
                <ColumnDefinition Width="*"/>    <!-- Dynamic View Content -->
            </Grid.ColumnDefinitions>

            <!-- ── LEFT NAVIGATION SIDEBAR ── -->
            <Border Grid.Column="0" Background="{StaticResource SidebarBackgroundBrush}">
                <DockPanel>
                    <Border DockPanel.Dock="Bottom" Padding="0,8" Margin="0,0,0,4">
                        <RadioButton Style="{StaticResource CompactSidebarNavButton}"
                                     Tag="{StaticResource IconSettings}" ToolTip="{DynamicResource String_NavSettings}"
                                     IsChecked="{Binding SelectedNavigation, Converter={StaticResource StringMatchConverter}, ConverterParameter=Settings}"
                                     Command="{Binding NavigateCommand}"
                                     CommandParameter="Settings"/>
                    </Border>

                    <!-- Dynamic Navigation Items & Shortcuts Stack -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,8,0,0" HorizontalAlignment="Center">
                            <!-- 1. Home Dashboard -->
                            <RadioButton Style="{StaticResource CompactSidebarNavButton}"
                                         Tag="{StaticResource IconHome}" ToolTip="{DynamicResource String_NavDashboard}"
                                         IsChecked="{Binding SelectedNavigation, Converter={StaticResource StringMatchConverter}, ConverterParameter=Home}"
                                         Command="{Binding NavigateCommand}"
                                         CommandParameter="Home"/>

                            <!-- 2. Explore Catalog -->
                            <RadioButton Style="{StaticResource CompactSidebarNavButton}"
                                         Tag="{StaticResource IconExplore}" ToolTip="{DynamicResource String_NavExplore}"
                                         IsChecked="{Binding SelectedNavigation, Converter={StaticResource StringMatchConverter}, ConverterParameter=Explore}"
                                         Command="{Binding NavigateCommand}"
                                         CommandParameter="Explore"/>

                            <!-- 3. Instances Library -->
                            <RadioButton Style="{StaticResource CompactSidebarNavButton}"
                                         Tag="{StaticResource IconGamepad}" ToolTip="{DynamicResource String_NavLibrary}"
                                         IsChecked="{Binding SelectedNavigation, Converter={StaticResource StringMatchConverter}, ConverterParameter=Library}"
                                         Command="{Binding NavigateCommand}"
                                         CommandParameter="Library"/>

                            <!-- Divider Line -->
                            <Border Height="1" Background="{StaticResource SubtleBorderBrush}" Width="36" Margin="0,6"/>

                            <!-- 4. Recent Instances Shortcuts (up to 5) -->
                            <ItemsControl ItemsSource="{Binding RecentShortcuts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource SidebarShortcutButton}"
                                                ToolTip="{Binding Name}"
                                                Command="{Binding DataContext.OpenRecentShortcutCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                            <Border Width="40" Height="36" CornerRadius="8" Background="#161822" ClipToBounds="True">
                                                <Grid>
                                                    <!-- Centered Fallback Initial Letter (behind image) -->
                                                    <TextBlock Text="{Binding Name[0]}"
                                                                FontWeight="Bold" FontSize="14"
                                                                Foreground="{StaticResource AccentBrush}"
                                                                HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                                    <!-- Centered Image (strictly clipped to rounded border) -->
                                                    <Border CornerRadius="8">
                                                        <Border.Background>
                                                            <ImageBrush ImageSource="{Binding HeaderImageUrl}" Stretch="UniformToFill"/>
                                                        </Border.Background>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Divider Line -->
                            <Border Height="1" Background="{StaticResource SubtleBorderBrush}" Width="36" Margin="0,6"/>

                            <!-- 5. "+" Add Instance Button with Right Flyout Popup -->
                            <Grid Margin="0,2">
                                <Button Width="40" Height="40"
                                        Style="{StaticResource GhostButton}"
                                        Command="{Binding ToggleSidebarImportMenuCommand}"
                                        ToolTip="{DynamicResource String_ImportGame}"
                                        Padding="0"
                                        HorizontalAlignment="Center">
                                    <Border Background="{StaticResource SurfaceCardBrush}"
                                            BorderBrush="{StaticResource SubtleBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="20"
                                            Width="40" Height="40">
                                        <Path Data="{StaticResource IconPlus}"
                                              Fill="{StaticResource PrimaryTextBrush}"
                                              Stretch="Uniform" Width="14" Height="14"
                                              RenderTransformOrigin="0.5,0.5"
                                              HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Path.RenderTransform>
                                                <RotateTransform Angle="0"/>
                                            </Path.RenderTransform>
                                            <Path.Style>
                                                <Style TargetType="Path">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DataContext.IsSidebarImportMenuOpen, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                            <DataTrigger.EnterActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                                         To="45" Duration="0:0:0.2"/>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.EnterActions>
                                                            <DataTrigger.ExitActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                                         To="0" Duration="0:0:0.2"/>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.ExitActions>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                    </Border>
                                </Button>
                                <!-- Right-Opening Popup Flyout -->
                                <Popup IsOpen="{Binding IsSidebarImportMenuOpen}"
                                       StaysOpen="False"
                                       Placement="Right"
                                       HorizontalOffset="12"
                                       AllowsTransparency="True"
                                       PopupAnimation="Fade">
                                    <Border Background="{StaticResource SurfaceCardElevatedBrush}"
                                            BorderBrush="{StaticResource SubtleBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource RadiusMd}"
                                            Padding="6"
                                            Width="220"
                                            SnapsToDevicePixels="True"
                                            UseLayoutRounding="True">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="4" Opacity="0.6"/>
                                        </Border.Effect>
                                        <StackPanel>
                                            <TextBlock Text="Import instance from"
                                                       Style="{StaticResource CaptionBold}"
                                                       Foreground="{StaticResource SecondaryTextBrush}"
                                                       Margin="8,4,8,8"/>

                                            <!-- Option 1: Steam -->
                                            <Button Style="{StaticResource GhostButton}"
                                                    HorizontalContentAlignment="Left"
                                                    Padding="8,8"
                                                    Margin="0,0,0,2"
                                                    Command="{Binding SidebarImportSteamCommand}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="22"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Path Grid.Column="0" Data="{StaticResource IconGamepad}" Fill="{StaticResource AccentBrush}"
                                                          Stretch="Uniform" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                        <TextBlock Text="Steam" FontWeight="SemiBold" FontSize="13"/>
                                                        <TextBlock Text="Import installed Steam game" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Button>

                                            <!-- Option 2: Depot ZIP -->
                                            <Button Style="{StaticResource GhostButton}"
                                                    HorizontalContentAlignment="Left"
                                                    Padding="8,8"
                                                    Margin="0,0,0,2"
                                                    Command="{Binding SidebarImportZipCommand}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="22"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Path Grid.Column="0" Data="{StaticResource IconDownload}" Fill="{StaticResource WarningBrush}"
                                                          Stretch="Uniform" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                        <TextBlock Text="Depot ZIP" FontWeight="SemiBold" FontSize="13"/>
                                                        <TextBlock Text="Import DepotBox archive" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Button>

                                            <!-- Option 3: Folder -->
                                            <Button Style="{StaticResource GhostButton}"
                                                    HorizontalContentAlignment="Left"
                                                    Padding="8,8"
                                                    Command="{Binding SidebarImportFolderCommand}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="22"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Path Grid.Column="0" Data="{StaticResource IconFolder}" Fill="{StaticResource SuccessBrush}"
                                                          Stretch="Uniform" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                        <TextBlock Text="Folder" FontWeight="SemiBold" FontSize="13"/>
                                                        <TextBlock Text="Import existing game folder" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Sidebar Separator Line -->
            <Border Grid.Column="1" Background="{StaticResource SubtleBorderBrush}"/>

            <!-- ── DYNAMIC MAIN CONTENT VIEW ── -->
            <ContentControl Grid.Column="2" Content="{Binding CurrentView}" Margin="0"/>
        </Grid>

        <!-- ═══ BOTTOM STATUS BAR (With Left Downloads Button) ═══ -->
        <Border Grid.Row="2"
                Background="{StaticResource TopBarBackgroundBrush}"
                BorderBrush="{StaticResource SubtleBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Corner Downloads Button with Active Animations & Realtime Status -->
                <Button Grid.Column="0"
                        ToolTip="Downloads Queue &amp; Speed"
                        Command="{Binding OpenDownloadsCommand}"
                        VerticalAlignment="Center"
                        Cursor="Hand"
                        Margin="0,0,0,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                            <Setter Property="Padding" Value="10,4"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="BorderBrush" Value="Transparent"/>
                            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasActiveDownloads}" Value="True">
                                    <Setter Property="Background" Value="#1a10B981"/>
                                    <Setter Property="BorderBrush" Value="#10B981"/>
                                    <Setter Property="Foreground" Value="#10B981"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasPausedDownloads}" Value="True">
                                    <Setter Property="Background" Value="#1aF59E0B"/>
                                    <Setter Property="BorderBrush" Value="#F59E0B"/>
                                    <Setter Property="Foreground" Value="#F59E0B"/>
                                </DataTrigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{StaticResource SurfaceCardHoverBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Download Vector Icon -->
                        <Border Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center">
                            <Path x:Name="downloadIcon"
                                  Data="{StaticResource IconDownload}"
                                  Stretch="Uniform" Width="12" Height="12"
                                  HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Fill" Value="{StaticResource SecondaryTextBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasActiveDownloads}" Value="True">
                                                <Setter Property="Fill" Value="#10B981"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding HasPausedDownloads}" Value="True">
                                                <Setter Property="Fill" Value="#F59E0B"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Border>

                        <!-- Dynamic Downloads Text -->
                        <TextBlock Text="{Binding DownloadsButtonText, FallbackValue='Downloads'}"
                                   FontSize="11" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>

                        <!-- Active / Pending / Paused Count Notification Badge -->
                        <Border CornerRadius="8"
                                Padding="6,1"
                                Margin="8,0,0,0"
                                Visibility="{Binding HasPendingOrActiveDownloads, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#10B981"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasActiveDownloads}" Value="False">
                                            <Setter Property="Background" Value="#F59E0B"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding TotalPendingDownloadsCount}"
                                       FontSize="10" FontWeight="Bold"
                                       Foreground="#042F2E"/>
                        </Border>
                    </StackPanel>
                </Button>

                <!-- Right Side: Background Tasks Indicator Button -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource GhostButton}"
                            Padding="8,4"
                            Cursor="Hand"
                            ToolTip="{DynamicResource String_TaskDrawerTooltip}"
                            Command="{Binding ToggleTasksFlyoutCommand}"
                            Visibility="{Binding HasActiveTasks, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⏳ " FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding BackgroundTaskStatusText}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ BACKGROUND TASKS DROPDOWN FLYOUT (Anchored Bottom-Right above tasks button) ═══ -->
        <Grid Grid.Row="0" Grid.RowSpan="3"
              Visibility="{Binding IsTasksFlyoutOpen, Converter={StaticResource BoolToVisibilityConverter}}"
              Panel.ZIndex="1001">
            <!-- Transparent backdrop click-outside to close -->
            <Border Background="Transparent">
                <Border.InputBindings>
                    <MouseBinding Gesture="LeftClick" Command="{Binding CloseTasksFlyoutCommand}"/>
                </Border.InputBindings>
            </Border>

            <!-- Dropdown Card anchored to bottom-right above the status bar -->
            <Border Width="430" MaxHeight="460"
                    Background="{StaticResource SurfaceCardElevatedBrush}"
                    BorderBrush="{StaticResource StrongBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusLg}"
                    Padding="16"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,16,42">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Opacity="0.45" Color="#000000"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource String_ActiveTasks}" Style="{StaticResource H3}"/>
                            <TextBlock Text="{Binding BackgroundTaskStatusText}" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="✕" Style="{StaticResource GhostButton}"
                                Padding="6,2"
                                Command="{Binding CloseTasksFlyoutCommand}"/>
                    </Grid>

                    <!-- Combined / Total Progress (Shown when multiple tasks active) -->
                    <Border Grid.Row="1"
                            Background="{StaticResource SurfaceInputBrush}"
                            BorderBrush="{StaticResource AccentBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusMd}"
                            Padding="12,10"
                            Margin="0,0,0,12"
                            Visibility="{Binding HasMultipleActiveTasks, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="{DynamicResource String_TotalProgress}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource PrimaryTextBrush}"/>
                                <TextBlock Text="{Binding TotalTasksProgressPercentage, StringFormat='{}{0:F0}%'}"
                                           FontWeight="Bold" FontSize="12" Foreground="{StaticResource AccentBrush}"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                            <ProgressBar Value="{Binding TotalTasksProgressPercentage}" Height="6"
                                         Foreground="{StaticResource AccentBrush}" Background="{StaticResource SurfaceCardBrush}"
                                         BorderThickness="0" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding ActiveTasksCount, StringFormat='{}{0} active operations running'}"
                                       Style="{StaticResource Caption}" Foreground="{StaticResource SecondaryTextBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Active Tasks List -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" MaxHeight="300">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource String_NoActiveTasks}"
                                       Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,20"
                                       Visibility="{Binding ActiveBackgroundTasks.Count, Converter={StaticResource ZeroToVisibilityConverter}}"/>

                            <ItemsControl ItemsSource="{Binding ActiveBackgroundTasks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource SurfaceCardBrush}"
                                                BorderBrush="{StaticResource SubtleBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="{StaticResource RadiusMd}"
                                                Padding="12,10"
                                                Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                     <RowDefinition Height="Auto"/>
                                                     <RowDefinition Height="Auto"/>
                                                     <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <!-- Top Row: Title, Progress % and Cancel -->
                                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    
                                                    <TextBlock Grid.Column="0" Text="{Binding Title}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource PrimaryTextBrush}" TextTrimming="CharacterEllipsis"/>
                                                    
                                                    <TextBlock Grid.Column="1" Text="{Binding ProgressPercentage, StringFormat='{}{0:F0}%'}"
                                                               FontWeight="Bold" FontSize="11" Foreground="{StaticResource AccentBrush}"
                                                               Margin="8,0,0,0" VerticalAlignment="Center"/>

                                                    <Button Grid.Column="2" Content="✕" Style="{StaticResource GhostButton}"
                                                            Padding="4,1" Margin="8,0,0,0" FontSize="10" Foreground="{StaticResource DangerBrush}"
                                                            ToolTip="{DynamicResource String_CancelTask}"
                                                            Visibility="{Binding CanCancel, Converter={StaticResource BoolToVisibilityConverter}}"
                                                            Command="{Binding DataContext.CancelBackgroundTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding Id}"/>
                                                </Grid>

                                                <!-- Individual Progress Bar -->
                                                <ProgressBar Grid.Row="1" Value="{Binding ProgressPercentage}" Height="5" Margin="0,0,0,6"
                                                             Foreground="{StaticResource AccentBrush}" Background="{StaticResource SurfaceInputBrush}"
                                                             BorderThickness="0"/>

                                                <!-- Step Message -->
                                                <TextBlock Grid.Row="2" Text="{Binding CurrentStepMessage}" Style="{StaticResource Caption}"
                                                           Foreground="{StaticResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══ TOAST NOTIFICATIONS POPUP CONTAINER (Bottom-Right Corner) ═══ -->
        <ItemsControl Grid.Row="0" Grid.RowSpan="3"
                      ItemsSource="{Binding Notifications}"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Bottom"
                      Margin="0,0,24,36"
                      Panel.ZIndex="999"
                      IsHitTestVisible="True">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{StaticResource SurfaceCardBrush}"
                            BorderBrush="{Binding Type, Converter={StaticResource NotificationTypeToBrushConverter}}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusMd}"
                            Padding="14,10"
                            Margin="0,0,0,10"
                            MinWidth="300"
                            MaxWidth="400">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Type Icon Dot / Badge -->
                            <Border Grid.Column="0"
                                    Background="{Binding Type, Converter={StaticResource NotificationTypeToBgBrushConverter}}"
                                    CornerRadius="14"
                                    Width="26" Height="26"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Top">
                                <TextBlock Text="{Binding Type, Converter={StaticResource NotificationTypeToIconTextConverter}}"
                                           Foreground="{Binding Type, Converter={StaticResource NotificationTypeToBrushConverter}}"
                                           FontWeight="Bold" FontSize="12"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <!-- Notification Message Body -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                <TextBlock Text="{Binding Title}"
                                           FontWeight="Bold" FontSize="12"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           Margin="0,0,0,2"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Message}"
                                           Style="{StaticResource BodySmall}"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           TextWrapping="Wrap"
                                           LineHeight="16"/>

                                <!-- Optional Interactive Action Button -->
                                <Button Content="{Binding ActionText}"
                                        Style="{StaticResource SecondaryButton}"
                                        FontSize="11"
                                        Padding="10,4"
                                        Margin="0,6,0,0"
                                        HorizontalAlignment="Left"
                                        Visibility="{Binding HasAction, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Command="{Binding ActionCommand}"/>
                            </StackPanel>

                            <!-- Close / Dismiss '✕' Button -->
                            <Button Grid.Column="2"
                                    Style="{StaticResource GhostButton}"
                                    Width="24" Height="24"
                                    Padding="0"
                                    Background="Transparent"
                                    VerticalAlignment="Top"
                                    Cursor="Hand"
                                    ToolTip="{DynamicResource String_Close}"
                                    Command="{Binding DismissCommand}">
                                <TextBlock Text="✕" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- ═══ STARTUP LOADING OVERLAY SCREEN ═══ -->
        <Grid x:Name="StartupLoadingOverlay"
              Grid.Row="0"
              Grid.RowSpan="3"
              Background="{StaticResource BaseBackgroundBrush}"
              Panel.ZIndex="1000"
              IsHitTestVisible="{Binding IsLoading}">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Opacity" Value="1"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsLoading}" Value="False">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.35">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility"
                                                                      BeginTime="0:0:0.36">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Collapsed}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Grid.Resources>
                <!-- Continuous Smooth Spin in place -->
                <Storyboard x:Key="StarSpinStoryboard" RepeatBehavior="Forever">
                    <DoubleAnimation Storyboard.TargetName="StarRotate"
                                     Storyboard.TargetProperty="Angle"
                                     From="0" To="360"
                                     Duration="0:0:2.0"/>
                    <!-- Subtle Glow Breathing Pulse -->
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="StarGlow"
                                                   Storyboard.TargetProperty="Opacity">
                        <SplineDoubleKeyFrame KeyTime="0:0:0.0" Value="0.5"/>
                        <SplineDoubleKeyFrame KeyTime="0:0:1.0" Value="0.95" KeySpline="0.4, 0.0, 0.6, 1.0"/>
                        <SplineDoubleKeyFrame KeyTime="0:0:2.0" Value="0.5" KeySpline="0.4, 0.0, 0.6, 1.0"/>
                    </DoubleAnimationUsingKeyFrames>
                </Storyboard>
            </Grid.Resources>

            <Grid.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard Storyboard="{StaticResource StarSpinStoryboard}"/>
                </EventTrigger>
            </Grid.Triggers>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- Spin & Glow Container (In-Place) -->
                <Grid Width="100" Height="100" HorizontalAlignment="Center" Margin="0,0,0,24">
                    <!-- Subtle Radial Glow behind Star -->
                    <Ellipse x:Name="StarGlow" Width="76" Height="76"
                             VerticalAlignment="Center" HorizontalAlignment="Center"
                             Fill="{StaticResource AccentTranslucentBrush}">
                        <Ellipse.Effect>
                            <BlurEffect Radius="28"/>
                        </Ellipse.Effect>
                    </Ellipse>

                    <!-- Animated Star Vector Graphic (Rotating around center) -->
                    <Viewbox Width="56" Height="56"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             RenderTransformOrigin="0.5,0.5">
                        <Viewbox.RenderTransform>
                            <RotateTransform x:Name="StarRotate"/>
                        </Viewbox.RenderTransform>
                        <Path Data="{StaticResource IconStar}"
                              Fill="{StaticResource AccentBrush}">
                            <Path.Effect>
                                <DropShadowEffect Color="#1B90FF" BlurRadius="18" ShadowDepth="0" Opacity="0.9"/>
                            </Path.Effect>
                        </Path>
                    </Viewbox>
                </Grid>

                <!-- Brand Name & Animated Status Text -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                    <TextBlock Text="BlueStar"
                               FontSize="26" FontWeight="Bold"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               FontFamily="{StaticResource MainFontFamily}"
                               VerticalAlignment="Center"/>
                    <Border Background="{StaticResource AccentTranslucentBrush}"
                            CornerRadius="{StaticResource RadiusXs}"
                            Padding="6,2" Margin="10,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="LAUNCHER" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}"/>
                    </Border>
                </StackPanel>

                <!-- Dynamic Status Text -->
                <TextBlock Text="{Binding StartupStatusText}"
                           FontSize="13"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- ═══ SYSTEM REQUIREMENTS MODAL OVERLAY ═══ -->
        <Grid Background="{StaticResource ModalOverlayBrush}"
              Grid.Row="0"
              Grid.RowSpan="3"
              Visibility="{Binding IsSystemRequirementsModalOpen, Converter={StaticResource BoolToVisibilityConverter}}"
              Panel.ZIndex="1005"
              SnapsToDevicePixels="True"
              UseLayoutRounding="True">

            <Border Background="#161822"
                    BorderBrush="#2E3748"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="24"
                    Width="720" MaxHeight="660"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="6" Opacity="0.7"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header -->
                        <RowDefinition Height="14"/>   <!-- Spacing -->
                        <RowDefinition Height="Auto"/> <!-- Status / Alert Banner -->
                        <RowDefinition Height="14"/>   <!-- Spacing -->
                        <RowDefinition Height="*"/>    <!-- Requirements Cards List -->
                        <RowDefinition Height="16"/>   <!-- Spacing -->
                        <RowDefinition Height="Auto"/> <!-- Bottom Actions / Checkbox -->
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="🛠️" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource String_SysReqTitle}" Style="{StaticResource H2}" Foreground="{StaticResource WhiteBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{DynamicResource String_SysReqSubtitle}"
                                       Style="{StaticResource Caption}" Foreground="{StaticResource SecondaryTextBrush}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="✕" Style="{StaticResource GhostButton}"
                                Command="{Binding CloseSystemRequirementsModalCommand}"
                                ToolTip="{DynamicResource String_ContinueToBlueStar}"/>
                    </Grid>

                    <!-- Status Alert Banner -->
                    <Border Grid.Row="2" CornerRadius="{StaticResource RadiusMd}" Padding="14,10" BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#1a10B981"/>
                                <Setter Property="BorderBrush" Value="#3010B981"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasMissingRequirements}" Value="True">
                                        <Setter Property="Background" Value="#1aF59E0B"/>
                                        <Setter Property="BorderBrush" Value="#40F59E0B"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="✅"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasMissingRequirements}" Value="True">
                                                <Setter Property="Text" Value="⚠️"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock FontWeight="SemiBold" FontSize="13">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{DynamicResource String_AllReqsVerified}"/>
                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasMissingRequirements}" Value="True">
                                                    <Setter Property="Text" Value="{Binding MissingPrerequisitesCount, StringFormat='{}Missing prerequisite components ({0})'}"/>
                                                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Margin="0,2,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
                                            <Setter Property="Text" Value="{DynamicResource String_AllReqsVerifiedDesc}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasMissingRequirements}" Value="True">
                                                    <Setter Property="Text" Value="{DynamicResource String_MissingReqsDesc}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Requirements List ScrollViewer -->
                    <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding SystemPrerequisites}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource SurfaceCardBrush}"
                                            BorderBrush="{StaticResource SubtleBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource RadiusMd}"
                                            Padding="14,10"
                                            Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="14"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Left details -->
                                            <StackPanel Grid.Column="0">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,10,0"/>
                                                    <Border CornerRadius="{StaticResource RadiusSm}"
                                                            Padding="8,2"
                                                            Background="{Binding Status, Converter={StaticResource PrerequisiteStatusToBgBrushConverter}}">
                                                        <TextBlock Text="{Binding Status, Converter={StaticResource PrerequisiteStatusToTextConverter}}"
                                                                   FontSize="10" FontWeight="SemiBold"
                                                                   Foreground="{Binding Status, Converter={StaticResource PrerequisiteStatusToBrushConverter}}"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Description}" Style="{StaticResource BodySmall}" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,4" TextWrapping="Wrap"/>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{DynamicResource String_Filter}" Style="{StaticResource Caption}" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,4,0"/>
                                                    <TextBlock Text="{Binding Category}" Style="{StaticResource CaptionBold}" Foreground="{StaticResource SecondaryTextBrush}"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Right Install action -->
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <Button Content="{DynamicResource String_Install}"
                                                        Style="{StaticResource SecondaryButton}"
                                                        Padding="14,6" FontSize="11"
                                                        Command="{Binding DataContext.InstallSystemPrerequisiteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        IsEnabled="{Binding DataContext.IsInstallingSystemPrerequisites, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource InverseBoolConverter}}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Bottom Bar (Progress + Actions) -->
                    <Grid Grid.Row="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Active Install Progress & Status Text -->
                        <Border Grid.Row="0" Margin="0,0,0,12"
                                Background="{StaticResource SurfaceInputBrush}"
                                CornerRadius="{StaticResource RadiusSm}"
                                Padding="12,8"
                                Visibility="{Binding IsInstallingSystemPrerequisites, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel>
                                <ProgressBar Height="4" IsIndeterminate="True"
                                             Foreground="{StaticResource AccentBrush}"
                                             Background="{StaticResource SurfaceCardBrush}"
                                             BorderThickness="0" Margin="0,0,0,6"/>
                                <TextBlock Text="{Binding SystemPrerequisitesInstallStatusText, FallbackValue='Installing component...'}"
                                           Style="{StaticResource Caption}" Foreground="{StaticResource AccentBrush}"/>
                            </StackPanel>
                        </Border>

                        <!-- Bottom Controls -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Checkbox: Check on startup -->
                            <CheckBox Grid.Column="0"
                                      Content="{DynamicResource String_CheckReqsSetting}"
                                      IsChecked="{Binding CheckRequirementsOnStartup, Mode=TwoWay}"
                                      Style="{StaticResource DarkCheckBox}"
                                      VerticalAlignment="Center"/>

                            <!-- Buttons -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button Content="{DynamicResource String_Rescan}"
                                        Style="{StaticResource SecondaryButton}"
                                        Padding="12,7" FontSize="12"
                                        Margin="0,0,8,0"
                                        Command="{Binding ScanSystemRequirementsCommand}"
                                        IsEnabled="{Binding IsInstallingSystemPrerequisites, Converter={StaticResource InverseBoolConverter}}"/>

                                <Button Content="{DynamicResource String_InstallMissing}"
                                        Style="{StaticResource PrimaryButton}"
                                        Padding="16,7" FontSize="12"
                                        Margin="0,0,8,0"
                                        Visibility="{Binding HasMissingRequirements, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Command="{Binding InstallAllSystemPrerequisitesCommand}"
                                        IsEnabled="{Binding IsInstallingSystemPrerequisites, Converter={StaticResource InverseBoolConverter}}"/>

                                <Button Content="{DynamicResource String_ContinueToBlueStar}"
                                        Style="{StaticResource SecondaryButton}"
                                        Padding="14,7" FontSize="12"
                                        Command="{Binding CloseSystemRequirementsModalCommand}"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
