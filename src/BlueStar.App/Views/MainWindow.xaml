<Window x:Class="BlueStar.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:BlueStar.App.ViewModels"
        xmlns:local="clr-namespace:BlueStar.App.Views"
        xmlns:conv="clr-namespace:BlueStar.App.Converters"
        Title="BlueStar"
        Icon="pack://application:,,,/BlueStar;component/Assets/bluestar.ico"
        Width="1320" Height="840"
        MinWidth="1000" MinHeight="640"
        Background="{StaticResource BaseBackgroundBrush}"
        Foreground="{StaticResource PrimaryTextBrush}"
        FontFamily="{StaticResource MainFontFamily}"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="6"
                      CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42"/>  <!-- Top Custom Title bar -->
            <RowDefinition Height="*"/>   <!-- Main Shell Content -->
        </Grid.RowDefinitions>

        <!-- ═══ TOP APP BAR / TITLE BAR ═══ -->
        <Border Grid.Row="0" Background="{StaticResource TopBarBackgroundBrush}" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>  <!-- Left Sidebar Header width -->
                    <ColumnDefinition Width="*"/>    <!-- Center Title / Drag Area -->
                    <ColumnDefinition Width="Auto"/> <!-- Right Window Controls -->
                </Grid.ColumnDefinitions>

                <!-- App Brand Logo & Name -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="18,0" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/BlueStar;component/Assets/bluestar.png"
                           Width="22" Height="22" Margin="0,0,8,0"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="BlueStar" FontSize="15" FontWeight="Bold"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               FontFamily="{StaticResource MainFontFamily}"
                               VerticalAlignment="Center"/>
                    <Border Background="{StaticResource AccentTranslucentBrush}"
                            CornerRadius="{StaticResource RadiusXs}"
                            Padding="5,1"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="v1.0.0" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBrush}"/>
                    </Border>
                </StackPanel>

                <!-- Center Title / Breadcrumb -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                    <TextBlock Text="Dashboard" Style="{StaticResource Caption}"
                               Visibility="{Binding SelectedNavigation, Converter={StaticResource StringMatchToVisibilityConverter}, ConverterParameter=Home}"/>
                    <TextBlock Text="Explore Catalog" Style="{StaticResource Caption}"
                               Visibility="{Binding SelectedNavigation, Converter={StaticResource StringMatchToVisibilityConverter}, ConverterParameter=Explore}"/>
                    <TextBlock Text="Instance Library" Style="{StaticResource Caption}"
                               Visibility="{Binding SelectedNavigation, Converter={StaticResource StringMatchToVisibilityConverter}, ConverterParameter=Library}"/>
                    <TextBlock Text="Download Queue" Style="{StaticResource Caption}"
                               Visibility="{Binding SelectedNavigation, Converter={StaticResource StringMatchToVisibilityConverter}, ConverterParameter=Downloads}"/>
                    <TextBlock Text="Application Settings" Style="{StaticResource Caption}"
                               Visibility="{Binding SelectedNavigation, Converter={StaticResource StringMatchToVisibilityConverter}, ConverterParameter=Settings}"/>
                    <TextBlock Text="About &amp; Open-Source Credits" Style="{StaticResource Caption}"
                               Visibility="{Binding SelectedNavigation, Converter={StaticResource StringMatchToVisibilityConverter}, ConverterParameter=About}"/>
                </StackPanel>

                <!-- Steam Status Pill & Window Control Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            VerticalAlignment="Center">

                    <!-- Steam Status Indicator Pill -->
                    <Border Background="{StaticResource SurfaceInputBrush}"
                            BorderBrush="{StaticResource SubtleBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusMd}"
                            Padding="10,4"
                            Margin="0,0,14,0"
                            VerticalAlignment="Center"
                            ToolTip="{Binding SteamTooltipText}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Live Status Dot -->
                            <Ellipse Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource MutedTextBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSteamRunning}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>

                            <!-- Steam Label & Active Persona -->
                            <TextBlock Text="{Binding SteamStatusText}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Window Control Buttons (Minimize, Maximize, Close) -->
                    <Button x:Name="MinimizeButton" Click="MinimizeButton_Click"
                            Style="{StaticResource TitleBarButton}">
                        <TextBlock Text="─" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>
                    <Button x:Name="MaximizeButton" Click="MaximizeButton_Click"
                            Style="{StaticResource TitleBarButton}">
                        <TextBlock Text="☐" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>
                    <Button x:Name="CloseButton" Click="CloseButton_Click"
                            Style="{StaticResource TitleBarCloseButton}">
                        <TextBlock Text="✕" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ MAIN SHELL LAYOUT ═══ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>  <!-- Left Sidebar -->
                <ColumnDefinition Width="1"/>    <!-- Border Separator -->
                <ColumnDefinition Width="*"/>    <!-- Dynamic View Content -->
            </Grid.ColumnDefinitions>

            <!-- ── LEFT NAVIGATION SIDEBAR ── -->
            <Border Grid.Column="0" Background="{StaticResource SidebarBackgroundBrush}">
                <DockPanel>
                    <!-- Bottom: System Status -->
                    <Border DockPanel.Dock="Bottom"
                            Background="{StaticResource SurfaceInputBrush}"
                            BorderBrush="{StaticResource SubtleBorderBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="14,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="8" Height="8" Margin="0,0,8,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasActiveDownloads}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource AccentBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Grid.Column="1" Text="{Binding StatusText}"
                                       Style="{StaticResource Caption}"
                                       TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </Border>

                    <!-- Navigation Items List -->
                    <StackPanel Margin="0,12,0,0">
                        <!-- Home Dashboard -->
                        <RadioButton Style="{StaticResource SidebarNavButton}"
                                     Tag="{StaticResource IconHome}" Content="Home"
                                     IsChecked="{Binding SelectedNavigation, Converter={StaticResource StringMatchConverter}, ConverterParameter=Home}"
                                     Command="{Binding NavigateCommand}"
                                     CommandParameter="Home"/>

                        <!-- Explore DepotBox -->
                        <RadioButton Style="{StaticResource SidebarNavButton}"
                                     Tag="{StaticResource IconExplore}" Content="Explore"
                                     IsChecked="{Binding SelectedNavigation, Converter={StaticResource StringMatchConverter}, ConverterParameter=Explore}"
                                     Command="{Binding NavigateCommand}"
                                     CommandParameter="Explore"/>

                        <!-- Instances Library -->
                        <RadioButton Style="{StaticResource SidebarNavButton}"
                                     Tag="{StaticResource IconGamepad}" Content="Instances"
                                     IsChecked="{Binding SelectedNavigation, Converter={StaticResource StringMatchConverter}, ConverterParameter=Library}"
                                     Command="{Binding NavigateCommand}"
                                     CommandParameter="Library"/>

                        <!-- Downloads Queue with Live Count Badge -->
                        <RadioButton Style="{StaticResource SidebarNavButton}"
                                     Tag="{StaticResource IconDownload}"
                                     IsChecked="{Binding SelectedNavigation, Converter={StaticResource StringMatchConverter}, ConverterParameter=Downloads}"
                                     Command="{Binding NavigateCommand}"
                                     CommandParameter="Downloads">
                            <RadioButton.Content>
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Downloads" VerticalAlignment="Center"/>
                                    <Border Grid.Column="1"
                                            Background="{StaticResource AccentBrush}"
                                            CornerRadius="10"
                                            Padding="6,1"
                                            Margin="8,0,0,0"
                                            Visibility="{Binding HasActiveDownloads, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="{Binding ActiveDownloadsCount}"
                                                   FontSize="11" FontWeight="Bold"
                                                   Foreground="{StaticResource InverseTextBrush}"/>
                                    </Border>
                                </Grid>
                            </RadioButton.Content>
                        </RadioButton>

                        <!-- Divider -->
                        <Border Height="1" Background="{StaticResource SubtleBorderBrush}"
                                Margin="16,14"/>

                        <!-- Settings -->
                        <RadioButton Style="{StaticResource SidebarNavButton}"
                                     Tag="{StaticResource IconSettings}" Content="Settings"
                                     IsChecked="{Binding SelectedNavigation, Converter={StaticResource StringMatchConverter}, ConverterParameter=Settings}"
                                     Command="{Binding NavigateCommand}"
                                     CommandParameter="Settings"/>

                        <!-- About / Credits -->
                        <RadioButton Style="{StaticResource SidebarNavButton}"
                                     Tag="{StaticResource IconInfo}" Content="About"
                                     IsChecked="{Binding SelectedNavigation, Converter={StaticResource StringMatchConverter}, ConverterParameter=About}"
                                     Command="{Binding NavigateCommand}"
                                     CommandParameter="About"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Sidebar Separator Line -->
            <Border Grid.Column="1" Background="{StaticResource SubtleBorderBrush}"/>

            <!-- ── DYNAMIC MAIN CONTENT VIEW ── -->
            <ContentControl Grid.Column="2" Content="{Binding CurrentView}" Margin="0"/>
        </Grid>

        <!-- ═══ TOAST NOTIFICATIONS POPUP CONTAINER (Bottom-Right Corner) ═══ -->
        <ItemsControl Grid.Row="0" Grid.RowSpan="2"
                      ItemsSource="{Binding Notifications}"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Bottom"
                      Margin="0,0,24,24"
                      Panel.ZIndex="999"
                      IsHitTestVisible="True">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{StaticResource SurfaceCardBrush}"
                            BorderBrush="{Binding Type, Converter={StaticResource NotificationTypeToBrushConverter}}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusMd}"
                            Padding="14,10"
                            Margin="0,0,0,10"
                            MinWidth="300"
                            MaxWidth="400">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Type Icon Dot / Badge -->
                            <Border Grid.Column="0"
                                    Background="{Binding Type, Converter={StaticResource NotificationTypeToBgBrushConverter}}"
                                    CornerRadius="14"
                                    Width="26" Height="26"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Top">
                                <TextBlock Text="{Binding Type, Converter={StaticResource NotificationTypeToIconTextConverter}}"
                                           Foreground="{Binding Type, Converter={StaticResource NotificationTypeToBrushConverter}}"
                                           FontWeight="Bold" FontSize="12"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <!-- Notification Message Body -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                <TextBlock Text="{Binding Title}"
                                           FontWeight="Bold" FontSize="12"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           Margin="0,0,0,2"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Message}"
                                           Style="{StaticResource BodySmall}"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           TextWrapping="Wrap"
                                           LineHeight="16"/>

                                <!-- Optional Interactive Action Button -->
                                <Button Content="{Binding ActionText}"
                                        Style="{StaticResource SecondaryButton}"
                                        FontSize="11"
                                        Padding="10,4"
                                        Margin="0,6,0,0"
                                        HorizontalAlignment="Left"
                                        Visibility="{Binding HasAction, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Command="{Binding ActionCommand}"/>
                            </StackPanel>

                            <!-- Close / Dismiss '✕' Button -->
                            <Button Grid.Column="2"
                                    Style="{StaticResource GhostButton}"
                                    Padding="4,2"
                                    VerticalAlignment="Top"
                                    ToolTip="Close notification"
                                    Command="{Binding DataContext.DismissNotificationCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding Id}">
                                <TextBlock Text="✕" FontSize="11" Foreground="{StaticResource MutedTextBrush}"/>
                            </Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- ═══ STARTUP LOADING OVERLAY SCREEN ═══ -->
        <Grid x:Name="StartupLoadingOverlay"
              Grid.RowSpan="2"
              Background="{StaticResource BaseBackgroundBrush}"
              Panel.ZIndex="1000"
              IsHitTestVisible="{Binding IsLoading}">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Opacity" Value="1"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsLoading}" Value="False">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.45"
                                                         DecelerationRatio="0.8"/>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility"
                                                                      BeginTime="0:0:0.46">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Collapsed}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Grid.Resources>
                <!-- Continuous Smooth Spin in place -->
                <Storyboard x:Key="StarSpinStoryboard" RepeatBehavior="Forever">
                    <DoubleAnimation Storyboard.TargetName="StarRotate"
                                     Storyboard.TargetProperty="Angle"
                                     From="0" To="360"
                                     Duration="0:0:1.8"/>
                    <!-- Subtle Glow Breathing Pulse -->
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="StarGlow"
                                                   Storyboard.TargetProperty="Opacity">
                        <SplineDoubleKeyFrame KeyTime="0:0:0.0" Value="0.6"/>
                        <SplineDoubleKeyFrame KeyTime="0:0:0.9" Value="1.0" KeySpline="0.4, 0.0, 0.6, 1.0"/>
                        <SplineDoubleKeyFrame KeyTime="0:0:1.8" Value="0.6" KeySpline="0.4, 0.0, 0.6, 1.0"/>
                    </DoubleAnimationUsingKeyFrames>
                </Storyboard>
            </Grid.Resources>

            <Grid.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard Storyboard="{StaticResource StarSpinStoryboard}"/>
                </EventTrigger>
            </Grid.Triggers>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- Spin & Glow Container (In-Place) -->
                <Grid Width="96" Height="96" HorizontalAlignment="Center" Margin="0,0,0,20">
                    <!-- Subtle Radial Glow behind Star -->
                    <Ellipse x:Name="StarGlow" Width="70" Height="70"
                             VerticalAlignment="Center" HorizontalAlignment="Center"
                             Fill="{StaticResource AccentTranslucentBrush}">
                        <Ellipse.Effect>
                            <BlurEffect Radius="24"/>
                        </Ellipse.Effect>
                    </Ellipse>

                    <!-- Animated Star Vector Graphic (Rotating around center) -->
                    <Viewbox Width="54" Height="54"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             RenderTransformOrigin="0.5,0.5">
                        <Viewbox.RenderTransform>
                            <RotateTransform x:Name="StarRotate"/>
                        </Viewbox.RenderTransform>
                        <Path Data="M12,17.27L18.18,21L16.54,13.97L22,9.24L14.81,8.62L12,2L9.19,8.62L2,9.24L7.45,13.97L5.82,21L12,17.27Z"
                              Fill="{StaticResource AccentBrush}">
                            <Path.Effect>
                                <DropShadowEffect Color="#00e5ff" BlurRadius="16" ShadowDepth="0" Opacity="0.85"/>
                            </Path.Effect>
                        </Path>
                    </Viewbox>
                </Grid>

                <!-- Brand Name & Animated Status Text -->
                <TextBlock Text="BlueStar"
                           FontSize="24" FontWeight="Bold"
                           Foreground="{StaticResource PrimaryTextBrush}"
                           FontFamily="{StaticResource MainFontFamily}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,6"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="Starting launcher &amp; loading catalog..."
                               Style="{StaticResource Caption}"
                               Foreground="{StaticResource SecondaryTextBrush}"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
