<UserControl x:Class="BlueStar.App.Views.ModBrowserPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:BlueStar.App.ViewModels"
             xmlns:local="clr-namespace:BlueStar.App.Views"
             d:DataContext="{d:DesignInstance vm:ModBrowserViewModel}"
             mc:Ignorable="d">
    <UserControl.Resources>
        <!-- Tag bubble style matching Explore / BrowseView -->
        <Style x:Key="ThunderstoreTagBubble" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,4,5"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{StaticResource SurfaceInputBrush}"
                                BorderBrush="{StaticResource SubtleBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="7,3"
                                SnapsToDevicePixels="True">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path x:Name="StateIcon"
                                      Data="{StaticResource IconCheck}"
                                      Fill="{StaticResource AccentBrush}"
                                      Stretch="Uniform" Width="8" Height="8"
                                      Margin="0,0,4,0"
                                      VerticalAlignment="Center"
                                      Visibility="Collapsed"/>
                                <TextBlock x:Name="Label"
                                           Text="{Binding DisplayName}"
                                           FontSize="11"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="140"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="Count"
                                           Text="{Binding CountText}"
                                           FontSize="9.5"
                                           FontWeight="SemiBold"
                                           Margin="5,0,0,0"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding CountText, Converter={StaticResource NullToVisibilityConverter}}"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource StrongBorderBrush}"/>
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource SurfaceInputFocusedBrush}"/>
                                <Setter TargetName="Label" Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding State}" Value="Include">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource SuccessBgBrush}"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource SuccessBorderBrush}"/>
                                <Setter TargetName="Label" Property="Foreground" Value="#4ADE9F"/>
                                <Setter TargetName="Label" Property="FontWeight" Value="SemiBold"/>
                                <Setter TargetName="Count" Property="Foreground" Value="#4ADE9F"/>
                                <Setter TargetName="StateIcon" Property="Data" Value="{StaticResource IconCheck}"/>
                                <Setter TargetName="StateIcon" Property="Fill" Value="#4ADE9F"/>
                                <Setter TargetName="StateIcon" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="Exclude">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource DangerBgBrush}"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource DangerBorderBrush}"/>
                                <Setter TargetName="Label" Property="Foreground" Value="#F87171"/>
                                <Setter TargetName="Label" Property="FontWeight" Value="SemiBold"/>
                                <Setter TargetName="Label" Property="TextDecorations" Value="Strikethrough"/>
                                <Setter TargetName="Count" Property="Foreground" Value="#F87171"/>
                                <Setter TargetName="StateIcon" Property="Data" Value="{StaticResource IconBan}"/>
                                <Setter TargetName="StateIcon" Property="Fill" Value="#F87171"/>
                                <Setter TargetName="StateIcon" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="{StaticResource SurfaceCardElevatedBrush}"
            BorderBrush="{StaticResource SubtleBorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusLg}"
            Padding="24,20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ═══ HEADER: TITLE, BADGE, TABS (MODRINTH & EXPLORE STYLE) ═══ -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource String_ModBrowserTitle}" Style="{StaticResource H1}" Margin="0,0,12,0"/>

                        <!-- Total Available Mods Badge -->
                        <Border Background="{StaticResource SurfaceInputBrush}"
                                CornerRadius="{StaticResource RadiusSm}" Padding="8,3"
                                VerticalAlignment="Center"
                                Visibility="{Binding TotalResultsText, Converter={StaticResource NullToVisibilityConverter}}">
                            <TextBlock Style="{StaticResource Caption}" FontWeight="Medium"
                                       Foreground="{StaticResource AccentBrush}"
                                       Text="{Binding TotalResultsText}"/>
                        </Border>
                    </StackPanel>

                    <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" Foreground="{StaticResource SecondaryTextBrush}">
                        <Run Text="{DynamicResource String_ModBrowserSubtitle}"/>
                        <Run Text=" ("/><Run Text="{Binding InstanceName}" FontWeight="SemiBold"/><Run Text=")"/>
                    </TextBlock>
                </StackPanel>

                <!-- ═══ PROVIDER TABS ON THE RIGHT (EXPLORE FORMAT) ═══ -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                    <!-- Thunderstore Provider Tab -->
                    <RadioButton GroupName="ModBrowserProvider" Style="{StaticResource TabRadioButton}"
                                 Visibility="{Binding HasThunderstoreSupport, Converter={StaticResource BoolToVisibilityConverter}}"
                                 IsChecked="{Binding SelectedProvider, Converter={StaticResource StringMatchConverter}, ConverterParameter=Thunderstore}"
                                 Command="{Binding SelectProviderCommand}" CommandParameter="Thunderstore">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconBolt}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,7,0"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            <TextBlock Text="{DynamicResource String_ModFilterThunderstore}" FontWeight="SemiBold"/>
                        </StackPanel>
                    </RadioButton>

                    <!-- Steam Workshop Provider Tab -->
                    <RadioButton GroupName="ModBrowserProvider" Style="{StaticResource TabRadioButton}"
                                 Visibility="{Binding HasWorkshopSupport, Converter={StaticResource BoolToVisibilityConverter}}"
                                 IsChecked="{Binding SelectedProvider, Converter={StaticResource StringMatchConverter}, ConverterParameter=Workshop}"
                                 Command="{Binding SelectProviderCommand}" CommandParameter="Workshop">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconSteam}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,7,0"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            <TextBlock Text="{DynamicResource String_ModFilterWorkshop}" FontWeight="SemiBold"/>
                        </StackPanel>
                    </RadioButton>

                    <!-- CurseForge Provider Tab -->
                    <RadioButton GroupName="ModBrowserProvider" Style="{StaticResource TabRadioButton}"
                                 Visibility="{Binding HasCurseForgeSupport, Converter={StaticResource BoolToVisibilityConverter}}"
                                 IsChecked="{Binding SelectedProvider, Converter={StaticResource StringMatchConverter}, ConverterParameter=CurseForge}"
                                 Command="{Binding SelectProviderCommand}" CommandParameter="CurseForge">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconFlame}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,7,0"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            <TextBlock Text="CurseForge" FontWeight="SemiBold"/>
                        </StackPanel>
                    </RadioButton>

                    <!-- Nexus Mods Provider Tab -->
                    <RadioButton GroupName="ModBrowserProvider" Style="{StaticResource TabRadioButton}"
                                 Visibility="{Binding HasNexusSupport, Converter={StaticResource BoolToVisibilityConverter}}"
                                 IsChecked="{Binding SelectedProvider, Converter={StaticResource StringMatchConverter}, ConverterParameter=Nexus}"
                                 Command="{Binding SelectProviderCommand}" CommandParameter="Nexus">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconMod}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,7,0"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            <TextBlock Text="Nexus Mods" FontWeight="SemiBold"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <!-- Close Button -->
                <Button Grid.Column="2" Content="✕" Style="{StaticResource GhostButton}" Width="34" Height="34" Padding="0"
                        VerticalAlignment="Center" Command="{Binding CloseCommand}" ToolTip="{DynamicResource String_Close}"/>
            </Grid>

            <!-- ═══ PROVIDER CONTENT CONTAINER ═══ -->
            <Grid Grid.Row="1">
                <!-- ── 1. THUNDERSTORE PROVIDER VIEW ── -->
                <Grid Visibility="{Binding SelectedProvider, Converter={StaticResource StringMatchToVisibilityConverter}, ConverterParameter=Thunderstore}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ═══ LEFT SIDEBAR: CATEGORIES / TAGS (EXPLORE BUBBLES STYLE) ═══ -->
                    <Border Grid.Column="0" Background="{StaticResource SurfaceCardBrush}"
                            BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1"
                            CornerRadius="{StaticResource RadiusMd}" Padding="12,14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Header: Title & Clear Button -->
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconTag}" Fill="{StaticResource AccentBrush}"
                                          Stretch="Uniform" Width="12" Height="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource String_Categories}" FontWeight="Bold" FontSize="13"
                                               Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                </StackPanel>

                                <Button Grid.Column="1" Style="{StaticResource GhostButton}" Padding="4,2"
                                        Command="{Binding Thunderstore.ClearCategoryCommand}"
                                        Visibility="{Binding Thunderstore.HasActiveCategoryFilter, Converter={StaticResource BoolToVisibilityConverter}}"
                                        ToolTip="{DynamicResource String_ClearCategoryFilterToolTip}">
                                    <TextBlock Text="{DynamicResource String_Clear}" FontSize="11" Foreground="{StaticResource AccentBrush}"/>
                                </Button>
                            </Grid>

                            <!-- Tag Search Box -->
                            <Border Grid.Row="1" Margin="0,0,0,10"
                                    Background="{StaticResource SurfaceInputBrush}"
                                    BorderBrush="{StaticResource SubtleBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusSm}"
                                    Padding="8,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Data="{StaticResource IconSearch}"
                                          Fill="{StaticResource MutedTextBrush}"
                                          Stretch="Uniform" Width="11" Height="11"
                                          Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <Grid Grid.Column="1">
                                        <TextBlock Text="{DynamicResource String_SearchTagsWatermark}"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   FontSize="11" VerticalAlignment="Center"
                                                   IsHitTestVisible="False"
                                                   Visibility="{Binding Thunderstore.TagSearchText, Converter={StaticResource InverseNullToVisibilityConverter}}"/>
                                        <TextBox Text="{Binding Thunderstore.TagSearchText, UpdateSourceTrigger=PropertyChanged}"
                                                 Background="Transparent" BorderThickness="0"
                                                 Foreground="{StaticResource PrimaryTextBrush}"
                                                 CaretBrush="{StaticResource PrimaryTextBrush}"
                                                 FontSize="11" Padding="0,6"
                                                 VerticalContentAlignment="Center"/>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- Bubbles list (Scrollable WrapPanel) -->
                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                          Focusable="False">
                                <ItemsControl ItemsSource="{Binding Thunderstore.FilteredTags}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource ThunderstoreTagBubble}"
                                                    Command="{Binding DataContext.Thunderstore.ToggleTagCommand, RelativeSource={RelativeSource AncestorType=local:ModBrowserPanel}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="{DynamicResource String_FilterBubbleTooltip}">
                                                <Button.InputBindings>
                                                    <MouseBinding MouseAction="RightClick"
                                                                  Command="{Binding DataContext.Thunderstore.ExcludeTagCommand, RelativeSource={RelativeSource AncestorType=local:ModBrowserPanel}}"
                                                                  CommandParameter="{Binding}"/>
                                                </Button.InputBindings>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- ═══ RIGHT COLUMN: TOOLBAR & PACKAGES LIST ═══ -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Toolbar: Search with clear, Sort ComboBox + Invert Direction (Reload button removed) -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="200" MaxWidth="360"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Search Input with Search Icon and Clear Button -->
                            <Border Grid.Column="0"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusMd}"
                                    Padding="12,0"
                                    Background="{StaticResource SurfaceInputBrush}"
                                    BorderBrush="{StaticResource SubtleBorderBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Data="{StaticResource IconSearch}"
                                          Fill="{StaticResource MutedTextBrush}"
                                          Stretch="Uniform" Width="13" Height="13"
                                          Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <Grid Grid.Column="1">
                                        <TextBlock Text="{DynamicResource String_ThunderstoreSearchPlaceholder}"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   FontSize="12" VerticalAlignment="Center" IsHitTestVisible="False"
                                                   Visibility="{Binding Thunderstore.SearchText, Converter={StaticResource InverseNullToVisibilityConverter}}"/>
                                        <TextBox Text="{Binding Thunderstore.SearchText, UpdateSourceTrigger=PropertyChanged}"
                                                 Background="Transparent" BorderThickness="0"
                                                 Foreground="{StaticResource PrimaryTextBrush}"
                                                 CaretBrush="{StaticResource PrimaryTextBrush}"
                                                 FontSize="12" Padding="0,8" VerticalContentAlignment="Center">
                                            <TextBox.InputBindings>
                                                <KeyBinding Key="Return" Command="{Binding Thunderstore.ExecuteSearchCommand}"/>
                                            </TextBox.InputBindings>
                                        </TextBox>
                                    </Grid>
                                    <Button Grid.Column="2" Style="{StaticResource GhostButton}"
                                            Command="{Binding Thunderstore.ClearSearchCommand}"
                                            Width="22" Height="22" Padding="0" Margin="4,0,-4,0"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding Thunderstore.SearchText, Converter={StaticResource NullToVisibilityConverter}}">
                                        <Path Data="{StaticResource IconClose}" Fill="{StaticResource MutedTextBrush}"
                                              Stretch="Uniform" Width="9" Height="9"/>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Sort Selector & Direction Toggle (Empty by default with "Ordenar" watermark) -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Grid Width="130">
                                    <ComboBox Width="130" Style="{StaticResource DarkComboBox}"
                                              ItemsSource="{Binding Thunderstore.SortOptions}"
                                              SelectedItem="{Binding Thunderstore.SelectedSort}"/>
                                    <TextBlock Text="{DynamicResource String_SortPlaceholder}"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="12"
                                               Margin="12,0,0,0"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False"
                                               Visibility="{Binding Thunderstore.HasActiveSort, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                </Grid>

                                <Button Margin="6,0,0,0" Width="34" Height="34" Padding="0"
                                        Style="{StaticResource SecondaryButton}"
                                        Command="{Binding Thunderstore.ToggleSortDirectionCommand}"
                                        AutomationProperties.Name="{DynamicResource String_InvertOrder}">
                                    <Button.ToolTip>
                                        <TextBlock Text="{DynamicResource String_InvertOrder}"/>
                                    </Button.ToolTip>
                                    <Path Stretch="Uniform" Width="14" Height="14"
                                          Fill="{StaticResource SecondaryTextBrush}">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Setter Property="Data" Value="{StaticResource IconSortAsc}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Thunderstore.IsSortDescending}" Value="True">
                                                        <Setter Property="Data" Value="{StaticResource IconSortDesc}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                </Button>

                                <Button Margin="4,0,0,0" Width="26" Height="26" Padding="0"
                                        Style="{StaticResource GhostButton}"
                                        Command="{Binding Thunderstore.ResetSortCommand}"
                                        ToolTip="{DynamicResource String_ResetSortToolTip}"
                                        Visibility="{Binding Thunderstore.HasActiveSort, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Path Data="{StaticResource IconClose}" Fill="{StaticResource MutedTextBrush}" Width="9" Height="9" Stretch="Uniform"/>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Content Area: Virtualized Packages List -->
                        <Border Grid.Row="1" Background="{StaticResource SurfaceCardBrush}"
                                BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1"
                                CornerRadius="{StaticResource RadiusMd}" Padding="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Sliding Virtual Window: displays visible items plus 3 buffer rows above and below -->
                                <ScrollViewer Grid.Row="0"
                                              x:Name="PackagesScroller"
                                              MinHeight="180"
                                              ScrollChanged="OnPackagesScrollChanged"
                                              HorizontalScrollBarVisibility="Disabled"
                                              VerticalScrollBarVisibility="Auto"
                                              Background="Transparent"
                                              Padding="0">
                                    <StackPanel>
                                        <!-- Spacer for unloaded rows above the active window -->
                                        <Border Height="{Binding Thunderstore.TopSpacerHeight, FallbackValue=0}" Background="Transparent"/>

                                        <ItemsControl ItemsSource="{Binding Thunderstore.Packages}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border CornerRadius="{StaticResource RadiusMd}" Background="{StaticResource SurfaceInputBrush}"
                                                            BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1"
                                                            Padding="14,12" Margin="0,0,0,10" MinHeight="102">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Clickable Mod Info & Thumbnail Area -->
                                                <Grid Grid.Column="0" Grid.ColumnSpan="2" Cursor="Hand" Background="Transparent">
                                                    <Grid.InputBindings>
                                                        <MouseBinding MouseAction="LeftClick"
                                                                      Command="{Binding DataContext.Thunderstore.OpenPackageDetailCommand, RelativeSource={RelativeSource AncestorType=local:ModBrowserPanel}}"
                                                                      CommandParameter="{Binding}"/>
                                                    </Grid.InputBindings>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Thumbnail / Icon -->
                                                    <Border Grid.Column="0" Width="60" Height="60" CornerRadius="{StaticResource RadiusMd}"
                                                            Background="{StaticResource AccentBgBrush}" BorderBrush="{StaticResource SubtleBorderBrush}"
                                                            BorderThickness="1" Margin="0,0,14,0" VerticalAlignment="Top" ClipToBounds="True">
                                                        <Grid>
                                                            <Path Data="{StaticResource IconBolt}" Fill="{StaticResource AccentBrush}" Width="24" Height="24"
                                                                  Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            <Image Source="{Binding IconUrl, Converter={StaticResource CachedImageConverter}}"
                                                                   Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                        </Grid>
                                                    </Border>

                                                    <!-- Info Column -->
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                                                        <!-- Title, author & date -->
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding Owner, StringFormat='  by {0}'}" Style="{StaticResource Caption}" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding FormattedDate, StringFormat='  ·  {0}'}" Style="{StaticResource Caption}" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/>
                                                        </StackPanel>

                                                        <!-- Description -->
                                                        <TextBlock Text="{Binding Description}" Style="{StaticResource BodySmall}" Foreground="{StaticResource SecondaryTextBrush}"
                                                                   TextWrapping="Wrap" MaxHeight="36" TextTrimming="CharacterEllipsis" Margin="0,4,0,6"/>

                                                        <!-- Categories Pills & Stats -->
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <!-- Downloads stat -->
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                                                <Path Data="{StaticResource IconDownload}" Fill="{StaticResource MutedTextBrush}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding FormattedDownloads}" Style="{StaticResource CaptionBold}" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                                            </StackPanel>

                                                            <!-- Rating score stat -->
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                                                <Path Data="{StaticResource IconStar}" Fill="{StaticResource WarningBrush}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding RatingScore}" Style="{StaticResource CaptionBold}" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                                            </StackPanel>

                                                            <!-- Category pills (clickable to filter) -->
                                                            <ItemsControl ItemsSource="{Binding Categories}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <StackPanel Orientation="Horizontal"/>
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Button Style="{StaticResource GhostButton}" Padding="0" Margin="0,0,4,0" VerticalAlignment="Center"
                                                                                Command="{Binding DataContext.Thunderstore.SelectCategoryTagCommand, RelativeSource={RelativeSource AncestorType=local:ModBrowserPanel}}"
                                                                                CommandParameter="{Binding}">
                                                                            <Border CornerRadius="{StaticResource RadiusSm}" Background="{StaticResource SurfaceCardBrush}"
                                                                                    BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1"
                                                                                    Padding="6,2">
                                                                                <TextBlock Text="{Binding}" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}"/>
                                                                            </Border>
                                                                        </Button>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Version Picker & Action Button -->
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" MinWidth="140" HorizontalAlignment="Right">
                                                    <!-- Version dropdown -->
                                                    <ComboBox Width="130" Margin="0,0,0,6" Style="{StaticResource DarkComboBox}"
                                                              ItemsSource="{Binding AvailableVersions}"
                                                              SelectedItem="{Binding SelectedVersion}">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding VersionNumber, StringFormat='v{0}'}"/>
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>

                                                    <!-- Install / Switch / Installed Button -->
                                                    <Button Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch"
                                                            Command="{Binding InstallCommand}" IsEnabled="{Binding CanInstall}">
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                            <Path Data="{StaticResource IconCheck}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                                  Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"
                                                                  Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                            <Path Data="{StaticResource IconDownload}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                                  Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"
                                                                  Visibility="{Binding IsInstalled, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                                            <TextBlock Text="{Binding ButtonLabel}" FontWeight="SemiBold"/>
                                                        </StackPanel>
                                                    </Button>

                                                    <!-- Download Progress Bar -->
                                                    <ProgressBar Height="3" Minimum="0" Maximum="100" Value="{Binding DownloadProgress}" Margin="0,4,0,0"
                                                                 Visibility="{Binding IsInstalling, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                                        <!-- Spacer for unloaded rows below the active window -->
                                        <Border Height="{Binding Thunderstore.BottomSpacerHeight, FallbackValue=0}" Background="Transparent"/>
                                    </StackPanel>
                                </ScrollViewer>

                                <!-- Dynamic Loading Indicator for Infinite Scroll (Manual button removed) -->
                                <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="2" Margin="0,4,0,0"
                                             Visibility="{Binding Thunderstore.IsLoadingMore, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                <!-- Loading State (initial) -->
                            <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center"
                                        Visibility="{Binding Thunderstore.IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="{DynamicResource String_ThunderstoreLoading}" Style="{StaticResource BodyMedium}" Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <ProgressBar IsIndeterminate="True" Width="200" Height="4"/>
                            </StackPanel>

                            <!-- Empty State -->
                            <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center"
                                        Visibility="{Binding Thunderstore.HasNoResults, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Path Data="{StaticResource IconSearch}" Fill="{StaticResource MutedTextBrush}" Width="36" Height="36" Stretch="Uniform" Margin="0,0,0,12" HorizontalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource String_ThunderstoreNoResults}" Style="{StaticResource BodyMedium}" Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ── 2. STEAM WORKSHOP PROVIDER VIEW ── -->
                <Grid Visibility="{Binding SelectedProvider, Converter={StaticResource StringMatchToVisibilityConverter}, ConverterParameter=Workshop}">
                    <local:WorkshopBrowserPanel DataContext="{Binding Workshop}" ShowHeader="False"/>
                </Grid>

                <!-- ── 3. CURSEFORGE PROVIDER VIEW ── -->
                <Grid Visibility="{Binding SelectedProvider, Converter={StaticResource StringMatchToVisibilityConverter}, ConverterParameter=CurseForge}">
                    <local:CurseForgeBrowserPanel DataContext="{Binding CurseForge}"/>
                </Grid>

                <!-- ── 4. NEXUS MODS PROVIDER VIEW ── -->
                <Grid Visibility="{Binding SelectedProvider, Converter={StaticResource StringMatchToVisibilityConverter}, ConverterParameter=Nexus}">
                    <local:NexusBrowserPanel DataContext="{Binding Nexus}"/>
                </Grid>
            </Grid>

            <!-- ═══ FOOTER: STATUS / NOTIFICATION BAR ═══ -->
            <StackPanel Grid.Row="2" Margin="0,12,0,0"
                        Visibility="{Binding ActiveStatusMessage, Converter={StaticResource NullToVisibilityConverter}}">
                <Border CornerRadius="{StaticResource RadiusMd}" Padding="14,10" BorderThickness="1.5"
                        SnapsToDevicePixels="True">
                    <Border.Style>
                        <Style TargetType="Border">
                            <!-- Default Info Style -->
                            <Setter Property="Background" Value="#1E2638"/>
                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            <Style.Triggers>
                                <!-- Progress / Activity State -->
                                <DataTrigger Binding="{Binding ActiveIsStatusProgress}" Value="True">
                                    <Setter Property="Background" Value="#132238"/>
                                    <Setter Property="BorderBrush" Value="#38BDF8"/>
                                </DataTrigger>
                                <!-- Success State -->
                                <DataTrigger Binding="{Binding ActiveIsStatusSuccess}" Value="True">
                                    <Setter Property="Background" Value="#0F2E1E"/>
                                    <Setter Property="BorderBrush" Value="#10B981"/>
                                </DataTrigger>
                                <!-- Error State -->
                                <DataTrigger Binding="{Binding ActiveIsStatusError}" Value="True">
                                    <Setter Property="Background" Value="#2A1215"/>
                                    <Setter Property="BorderBrush" Value="#EF4444"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Activity Icon Container -->
                        <Grid Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                            <!-- Error Icon -->
                            <Border Width="24" Height="24" CornerRadius="12" Background="#33EF4444"
                                    Visibility="{Binding ActiveIsStatusError, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Path Data="{StaticResource IconAlertTriangle}" Fill="#EF4444" Width="13" Height="13" Stretch="Uniform"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <!-- Success Icon -->
                            <Border Width="24" Height="24" CornerRadius="12" Background="#3310B981"
                                    Visibility="{Binding ActiveIsStatusSuccess, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Path Data="{StaticResource IconCheck}" Fill="#10B981" Width="12" Height="12" Stretch="Uniform"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <!-- Progress Icon -->
                            <Border Width="24" Height="24" CornerRadius="12" Background="#3338BDF8"
                                    Visibility="{Binding ActiveIsStatusProgress, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Path Data="{StaticResource IconDownload}" Fill="#38BDF8" Width="12" Height="12" Stretch="Uniform"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <!-- Default Info Icon (when none of error/success/progress) -->
                            <Border Width="24" Height="24" CornerRadius="12" Background="#2638BDF8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding ActiveIsStatusError}" Value="False"/>
                                                    <Condition Binding="{Binding ActiveIsStatusSuccess}" Value="False"/>
                                                    <Condition Binding="{Binding ActiveIsStatusProgress}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Path Data="{StaticResource IconInfo}" Fill="{StaticResource AccentBrush}" Width="13" Height="13" Stretch="Uniform"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>

                        <!-- Status Message Text -->
                        <TextBlock Grid.Column="1" Text="{Binding ActiveStatusMessage}"
                                   FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveIsStatusError}" Value="True">
                                            <Setter Property="Foreground" Value="#FCA5A5"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ActiveIsStatusSuccess}" Value="True">
                                            <Setter Property="Foreground" Value="#A7F3D0"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ActiveIsStatusProgress}" Value="True">
                                            <Setter Property="Foreground" Value="#BAE6FD"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
