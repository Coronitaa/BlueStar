<UserControl x:Class="BlueStar.App.Views.ModBrowserPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:BlueStar.App.ViewModels"
             xmlns:local="clr-namespace:BlueStar.App.Views"
             d:DataContext="{d:DesignInstance vm:ModBrowserViewModel}"
             mc:Ignorable="d">
    <Border Background="{StaticResource SurfaceCardElevatedBrush}"
            BorderBrush="{StaticResource SubtleBorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusLg}"
            Padding="24,20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ═══ HEADER: TITLE, BADGE, TABS (MODRINTH & EXPLORE STYLE) ═══ -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource String_ModBrowserTitle}" Style="{StaticResource H1}" Margin="0,0,12,0"/>

                        <!-- Total Available Mods Badge -->
                        <Border Background="{StaticResource SurfaceInputBrush}"
                                CornerRadius="{StaticResource RadiusSm}" Padding="8,3"
                                VerticalAlignment="Center"
                                Visibility="{Binding TotalResultsText, Converter={StaticResource NullToVisibilityConverter}}">
                            <TextBlock Style="{StaticResource Caption}" FontWeight="Medium"
                                       Foreground="{StaticResource AccentBrush}"
                                       Text="{Binding TotalResultsText}"/>
                        </Border>
                    </StackPanel>

                    <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,14" Foreground="{StaticResource SecondaryTextBrush}">
                        <Run Text="{DynamicResource String_ModBrowserSubtitle}"/>
                        <Run Text=" ("/><Run Text="{Binding InstanceName}" FontWeight="SemiBold"/><Run Text=")"/>
                    </TextBlock>

                    <!-- ═══ PROVIDER TABS (STRICTLY BY GAME AVAILABILITY) ═══ -->
                    <StackPanel Orientation="Horizontal">
                        <!-- Thunderstore Provider Tab -->
                        <RadioButton GroupName="ModBrowserProvider" Style="{StaticResource TabRadioButton}"
                                     Visibility="{Binding HasThunderstoreSupport, Converter={StaticResource BoolToVisibilityConverter}}"
                                     IsChecked="{Binding SelectedProvider, Converter={StaticResource StringMatchConverter}, ConverterParameter=Thunderstore}"
                                     Command="{Binding SelectProviderCommand}" CommandParameter="Thunderstore">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconBolt}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,7,0"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                <TextBlock Text="{DynamicResource String_ModFilterThunderstore}" FontWeight="SemiBold"/>
                            </StackPanel>
                        </RadioButton>

                        <!-- Steam Workshop Provider Tab -->
                        <RadioButton GroupName="ModBrowserProvider" Style="{StaticResource TabRadioButton}"
                                     Visibility="{Binding HasWorkshopSupport, Converter={StaticResource BoolToVisibilityConverter}}"
                                     IsChecked="{Binding SelectedProvider, Converter={StaticResource StringMatchConverter}, ConverterParameter=Workshop}"
                                     Command="{Binding SelectProviderCommand}" CommandParameter="Workshop">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconSteam}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,7,0"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                <TextBlock Text="{DynamicResource String_ModFilterWorkshop}" FontWeight="SemiBold"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </StackPanel>

                <!-- Close Button -->
                <Button Grid.Column="1" Content="✕" Style="{StaticResource GhostButton}" Width="34" Height="34" Padding="0"
                        VerticalAlignment="Top" Command="{Binding CloseCommand}" ToolTip="Cerrar"/>
            </Grid>

            <!-- ═══ PROVIDER CONTENT CONTAINER ═══ -->
            <Grid Grid.Row="1">
                <!-- ── 1. THUNDERSTORE PROVIDER VIEW ── -->
                <Grid Visibility="{Binding SelectedProvider, Converter={StaticResource StringMatchToVisibilityConverter}, ConverterParameter=Thunderstore}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Toolbar: Search with clear, Category, Sort, Refresh -->
                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="220" MaxWidth="360"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Search Input with Search Icon and Clear Button -->
                        <Border Grid.Column="0"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusMd}"
                                Padding="12,0"
                                Background="{StaticResource SurfaceInputBrush}"
                                BorderBrush="{StaticResource SubtleBorderBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0" Data="{StaticResource IconSearch}"
                                      Fill="{StaticResource MutedTextBrush}"
                                      Stretch="Uniform" Width="13" Height="13"
                                      Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <Grid Grid.Column="1">
                                    <TextBlock Text="{DynamicResource String_ThunderstoreSearchPlaceholder}"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="12" VerticalAlignment="Center" IsHitTestVisible="False"
                                               Visibility="{Binding Thunderstore.SearchText, Converter={StaticResource InverseNullToVisibilityConverter}}"/>
                                    <TextBox Text="{Binding Thunderstore.SearchText, UpdateSourceTrigger=PropertyChanged}"
                                             Background="Transparent" BorderThickness="0"
                                             Foreground="{StaticResource PrimaryTextBrush}"
                                             CaretBrush="{StaticResource PrimaryTextBrush}"
                                             FontSize="12" Padding="0,8" VerticalContentAlignment="Center"/>
                                </Grid>
                                <Button Grid.Column="2" Style="{StaticResource GhostButton}"
                                        Command="{Binding Thunderstore.ClearSearchCommand}"
                                        Width="22" Height="22" Padding="0" Margin="4,0,-4,0"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding Thunderstore.SearchText, Converter={StaticResource NullToVisibilityConverter}}">
                                    <Path Data="{StaticResource IconClose}" Fill="{StaticResource MutedTextBrush}"
                                          Stretch="Uniform" Width="9" Height="9"/>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Category Selector -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Categoría:" Style="{StaticResource CaptionBold}"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <ComboBox Width="160" Style="{StaticResource DarkComboBox}"
                                      ItemsSource="{Binding Thunderstore.AvailableCategories}"
                                      SelectedItem="{Binding Thunderstore.SelectedCategory}"/>
                        </StackPanel>

                        <!-- Sort Selector -->
                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource String_SortBy}" Style="{StaticResource CaptionBold}"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <ComboBox Width="140" Style="{StaticResource DarkComboBox}"
                                      ItemsSource="{Binding Thunderstore.SortOptions}"
                                      SelectedItem="{Binding Thunderstore.SelectedSort}"/>
                        </StackPanel>

                        <!-- Refresh Button -->
                        <Button Grid.Column="6" Style="{StaticResource SecondaryButton}" Width="36" Height="34" Padding="0"
                                Command="{Binding Thunderstore.LoadPackagesCommand}" ToolTip="Actualizar catálogo">
                            <Path Data="{StaticResource IconRefresh}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Button>
                    </Grid>

                    <!-- Content Area: Virtualized Packages List -->
                    <Border Grid.Row="1" Background="{StaticResource SurfaceCardBrush}"
                            BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1"
                            CornerRadius="{StaticResource RadiusMd}" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Virtualized ListBox: recycling virtualization, pixel scroll, zero freezes! -->
                            <ListBox Grid.Row="0"
                                     ItemsSource="{Binding Thunderstore.Packages}"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                     VirtualizingPanel.ScrollUnit="Pixel"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="0"
                                     Focusable="False">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0,0,0,10"/>
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <ContentPresenter/>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="{StaticResource RadiusMd}" Background="{StaticResource SurfaceInputBrush}"
                                                BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1"
                                                Padding="14,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Thumbnail / Icon -->
                                                <Border Grid.Column="0" Width="60" Height="60" CornerRadius="{StaticResource RadiusMd}"
                                                        Background="{StaticResource AccentBgBrush}" BorderBrush="{StaticResource SubtleBorderBrush}"
                                                        BorderThickness="1" Margin="0,0,14,0" VerticalAlignment="Top" ClipToBounds="True">
                                                    <Grid>
                                                        <Path Data="{StaticResource IconBolt}" Fill="{StaticResource AccentBrush}" Width="24" Height="24"
                                                              Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        <Image Source="{Binding IconUrl, Converter={StaticResource CachedImageConverter}}"
                                                               Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                    </Grid>
                                                </Border>

                                                <!-- Info Column -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                                                    <!-- Title, author & date -->
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Owner, StringFormat='  by {0}'}" Style="{StaticResource Caption}" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding FormattedDate, StringFormat='  ·  {0}'}" Style="{StaticResource Caption}" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/>
                                                    </StackPanel>

                                                    <!-- Description -->
                                                    <TextBlock Text="{Binding Description}" Style="{StaticResource BodySmall}" Foreground="{StaticResource SecondaryTextBrush}"
                                                               TextWrapping="Wrap" MaxHeight="36" TextTrimming="CharacterEllipsis" Margin="0,4,0,6"/>

                                                    <!-- Categories Pills & Stats -->
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <!-- Downloads stat -->
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                                            <Path Data="{StaticResource IconDownload}" Fill="{StaticResource MutedTextBrush}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding FormattedDownloads}" Style="{StaticResource CaptionBold}" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                                        </StackPanel>

                                                        <!-- Rating score stat -->
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                                            <Path Data="{StaticResource IconStar}" Fill="{StaticResource WarningBrush}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding RatingScore}" Style="{StaticResource CaptionBold}" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                                        </StackPanel>

                                                        <!-- Category pills -->
                                                        <ItemsControl ItemsSource="{Binding Categories}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <StackPanel Orientation="Horizontal"/>
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border CornerRadius="{StaticResource RadiusSm}" Background="{StaticResource SurfaceCardBrush}"
                                                                            BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1"
                                                                            Padding="6,2" Margin="0,0,4,0" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding}" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}"/>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Version Picker & Action Button -->
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" MinWidth="140" HorizontalAlignment="Right">
                                                    <!-- Version dropdown -->
                                                    <ComboBox Width="130" Margin="0,0,0,6" Style="{StaticResource DarkComboBox}"
                                                              ItemsSource="{Binding AvailableVersions}"
                                                              SelectedItem="{Binding SelectedVersion}">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding VersionNumber, StringFormat='v{0}'}"/>
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>

                                                    <!-- Install / Switch / Installed Button -->
                                                    <Button Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch"
                                                            Command="{Binding InstallCommand}" IsEnabled="{Binding CanInstall}">
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                            <Path Data="{StaticResource IconCheck}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                                  Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"
                                                                  Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                            <Path Data="{StaticResource IconDownload}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                                  Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"
                                                                  Visibility="{Binding IsInstalled, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                                            <TextBlock Text="{Binding ButtonLabel}" FontWeight="SemiBold"/>
                                                        </StackPanel>
                                                    </Button>

                                                    <!-- Download Progress Bar -->
                                                    <ProgressBar Height="3" Minimum="0" Maximum="100" Value="{Binding DownloadProgress}" Margin="0,4,0,0"
                                                                 Visibility="{Binding IsInstalling, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Pagination / Load More Button -->
                            <Border Grid.Row="1" Margin="0,8,0,0"
                                    Visibility="{Binding Thunderstore.HasMorePackages, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Button Style="{StaticResource SecondaryButton}"
                                        HorizontalAlignment="Center"
                                        Padding="20,7"
                                        Command="{Binding Thunderstore.LoadMoreCommand}"
                                        IsEnabled="{Binding Thunderstore.IsLoadingMore, Converter={StaticResource InverseBoolConverter}}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconDownload}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0"
                                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              Visibility="{Binding Thunderstore.IsLoadingMore, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                        <ProgressBar IsIndeterminate="True" Width="14" Height="14" Margin="0,0,8,0"
                                                     Visibility="{Binding Thunderstore.IsLoadingMore, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        <TextBlock Text="{DynamicResource String_ModLoadMore}" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                            </Border>

                            <!-- Loading State (initial) -->
                            <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center"
                                        Visibility="{Binding Thunderstore.IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="{DynamicResource String_ThunderstoreLoading}" Style="{StaticResource BodyMedium}" Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <ProgressBar IsIndeterminate="True" Width="200" Height="4"/>
                            </StackPanel>

                            <!-- Empty State -->
                            <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center"
                                        Visibility="{Binding Thunderstore.HasNoResults, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Path Data="{StaticResource IconSearch}" Fill="{StaticResource MutedTextBrush}" Width="36" Height="36" Stretch="Uniform" Margin="0,0,0,12" HorizontalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource String_ThunderstoreNoResults}" Style="{StaticResource BodyMedium}" Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ── 2. STEAM WORKSHOP PROVIDER VIEW ── -->
                <Grid Visibility="{Binding SelectedProvider, Converter={StaticResource StringMatchToVisibilityConverter}, ConverterParameter=Workshop}">
                    <local:WorkshopBrowserPanel DataContext="{Binding Workshop}" ShowHeader="False"/>
                </Grid>
            </Grid>

            <!-- ═══ FOOTER: STATUS / NOTIFICATION BAR ═══ -->
            <StackPanel Grid.Row="2" Margin="0,10,0,0">
                <Border CornerRadius="{StaticResource RadiusSm}" Padding="12,8" BorderThickness="1"
                        Visibility="{Binding Thunderstore.StatusMessage, Converter={StaticResource NullToVisibilityConverter}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource AccentBgBrush}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Thunderstore.IsStatusError}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource DangerBgBrush}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock TextWrapping="Wrap" Text="{Binding Thunderstore.StatusMessage}" Style="{StaticResource BodySmall}"/>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
