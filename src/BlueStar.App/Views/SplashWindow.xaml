<Window x:Class="BlueStar.App.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Starting BlueStar"
        Width="420" Height="250"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True">

    <Border CornerRadius="14"
            Background="#0E0E12"
            BorderBrush="#24242E"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.55" Color="#000000"/>
        </Border.Effect>

        <Grid Margin="30,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Mark -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center">
                <Border Width="34" Height="34" CornerRadius="8" Background="#1B90FF" Margin="0,0,12,0">
                    <TextBlock Text="★" FontSize="19" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="BlueStar" FontSize="25" FontWeight="Bold"
                           Foreground="#F2F3F6" VerticalAlignment="Center"
                           FontFamily="Segoe UI, Inter, Arial, sans-serif"/>
            </StackPanel>

            <TextBlock Grid.Row="1" x:Name="VersionText"
                       Text="1.3.0"
                       FontSize="11" Foreground="#5E5E6C"
                       HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8,0,0"
                       FontFamily="Consolas, Cascadia Code, monospace"/>

            <StackPanel Grid.Row="2">
                <TextBlock x:Name="StatusText"
                           Text="Starting up…"
                           FontSize="12" Foreground="#A1A1AA"
                           HorizontalAlignment="Center" Margin="0,0,0,12"
                           TextTrimming="CharacterEllipsis"
                           FontFamily="Segoe UI, Inter, Arial, sans-serif"/>

                <!-- Indeterminate sweep: startup has no measurable total -->
                <Border Height="4" CornerRadius="2" Background="#1B1B22" ClipToBounds="True">
                    <Border x:Name="Sweep" Width="120" Height="4" CornerRadius="2"
                            HorizontalAlignment="Left" Background="#1B90FF">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="SweepTransform" X="-120"/>
                        </Border.RenderTransform>
                        <Border.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="SweepTransform"
                                                         Storyboard.TargetProperty="X"
                                                         From="-130" To="360" Duration="0:0:1.15">
                                            <DoubleAnimation.EasingFunction>
                                                <SineEase EasingMode="EaseInOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Border.Triggers>
                    </Border>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</Window>
