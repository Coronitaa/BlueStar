    <!-- ═══ CLEAR APP CACHE CONFIRMATION MODAL ═══ -->
    <Grid Visibility="{Binding IsClearCacheModalOpen, Converter={StaticResource BoolToVisibilityConverter}}"
          Background="{StaticResource ModalOverlayBrush}"
          Panel.ZIndex="1000">
        <Border Background="{StaticResource SurfaceCardElevatedBrush}"
                BorderBrush="{StaticResource SubtleBorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusLg}"
                Padding="28" Width="480"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <!-- Modal Header -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{DynamicResource String_ClearCacheModalTitle}" Style="{StaticResource H2}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="✕" Style="{StaticResource GhostButton}" Width="24" Height="24" Padding="0"
                            IsEnabled="{Binding IsClearingCache, Converter={StaticResource InverseBoolConverter}}"
                            Command="{Binding CloseClearCacheModalCommand}"/>
                </Grid>

                <!-- Modal Description -->
                <TextBlock Text="{DynamicResource String_ClearCacheModalDesc}"
                           Style="{StaticResource BodyMedium}"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,18"/>

                <!-- Checkbox for Manifests of Previous Versions -->
                <Border Background="{StaticResource SurfaceInputBrush}"
                        BorderBrush="{StaticResource SubtleBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusMd}"
                        Padding="14,12" Margin="0,0,0,20">
                    <StackPanel>
                        <CheckBox IsChecked="{Binding IncludePreviousManifests}"
                                  IsEnabled="{Binding IsClearingCache, Converter={StaticResource InverseBoolConverter}}"
                                  VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource String_IncludePreviousManifestsCheckbox}"
                                       FontWeight="SemiBold"
                                       Style="{StaticResource BodyMedium}"
                                       Foreground="{StaticResource PrimaryTextBrush}"/>
                        </CheckBox>
                        <TextBlock Text="{DynamicResource String_IncludePreviousManifestsHelp}"
                                   Style="{StaticResource Caption}"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   TextWrapping="Wrap"
                                   Margin="24,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Progress Bar during cache clearing -->
                <ProgressBar IsIndeterminate="True" Height="4" Margin="0,0,0,16"
                             Visibility="{Binding IsClearingCache, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <!-- Modal Actions -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="{DynamicResource String_Cancel}"
                            Style="{StaticResource SecondaryButton}"
                            Padding="16,10"
                            IsEnabled="{Binding IsClearingCache, Converter={StaticResource InverseBoolConverter}}"
                            Command="{Binding CloseClearCacheModalCommand}"/>

                    <Button Grid.Column="2" Content="{DynamicResource String_ConfirmClearCacheBtn}"
                            Style="{StaticResource DangerButton}"
                            Padding="16,10"
                            IsEnabled="{Binding IsClearingCache, Converter={StaticResource InverseBoolConverter}}"
                            Command="{Binding ConfirmClearCacheCommand}"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Grid>
</UserControl>
