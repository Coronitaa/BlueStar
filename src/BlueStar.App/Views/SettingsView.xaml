                        <!-- 9. ManifestHub2 -->
                        <Border Grid.Row="8" Grid.Column="0" Background="{StaticResource SurfaceInputBrush}"
                                BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1"
