                                        <TextBlock Text="OnlineFix" FontWeight="Bold" FontSize="13" Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0"/>
                                        <Border Background="{StaticResource SurfaceCardBrush}" CornerRadius="4" Padding="5,1">
                                            <TextBlock Text="Community Service" FontSize="10" Foreground="{StaticResource MutedTextBrush}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Multiplayer and Steamworks online emulation fixes for cross-client co-op lobbies."
