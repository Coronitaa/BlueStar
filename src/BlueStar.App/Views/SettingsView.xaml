<UserControl x:Class="BlueStar.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:BlueStar.App.ViewModels"
             d:DataContext="{d:DesignInstance vm:SettingsViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{StaticResource BaseBackgroundBrush}"
             Foreground="{StaticResource PrimaryTextBrush}"
             FontFamily="{StaticResource MainFontFamily}">

    <UserControl.RenderTransform>
        <TranslateTransform Y="0"/>
    </UserControl.RenderTransform>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     From="0.0" To="1.0" Duration="0:0:0.22">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                     From="12" To="0" Duration="0:0:0.22">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,24" MaxWidth="950" HorizontalAlignment="Stretch">

            <TextBlock Text="{DynamicResource String_SettingsTitle}" Style="{StaticResource H1}" Margin="0,0,0,6"/>
            <TextBlock Text="{DynamicResource String_SettingsSubtitle}"
                       Style="{StaticResource Subtitle}" TextWrapping="Wrap" Margin="0,0,0,24"/>

            <!-- ═══ LANGUAGE & LOCALIZATION SECTION ═══ -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="{DynamicResource String_LanguageSetting}" Style="{StaticResource H2}" Margin="0,0,0,4"/>
                    <TextBlock Text="{DynamicResource String_LanguageSettingDesc}"
                               Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,14"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="320"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{Binding LanguageOptions}"
                                  SelectedItem="{Binding SelectedLanguageOption}"
                                  Height="36"
                                  FontSize="13"
                                  VerticalContentAlignment="Center"
                                  Style="{StaticResource DarkComboBox}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ═══ DEPOTBOX API SECTION ═══ -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="{DynamicResource String_ApiConfigHeader}" Style="{StaticResource H2}" Margin="0,0,0,4"/>
                    <TextBlock Text="{DynamicResource String_ApiConnectionDesc}"
                               Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,14"/>

                    <!-- Active status info banner -->
                    <Border Background="{StaticResource SurfaceInputBrush}"
                            BorderBrush="{StaticResource SubtleBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusSm}"
                            Padding="12,10" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="ℹ" FontSize="13" Foreground="{StaticResource AccentBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding AuthStatusMessage}" Style="{StaticResource BodySmall}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Personal Override API Key -->
                    <StackPanel Margin="0,4,0,0">
                        <TextBlock Text="{DynamicResource String_ApiKeyLabel}" Style="{StaticResource CaptionBold}" Margin="0,0,0,4"/>
                        <TextBlock Text="{DynamicResource String_ApiKeyHelp}"
                                   Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <TextBox Style="{StaticResource DarkTextBox}"
                                 Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,14"/>

                        <StackPanel Orientation="Horizontal">
                            <Button Content="{DynamicResource String_SavePersonalKeyBtn}"
                                    Style="{StaticResource PrimaryButton}"
                                    Command="{Binding SaveApiKeyCommand}"
                                    Margin="0,0,10,0"/>

                            <Button Content="{DynamicResource String_TestConnectionBtn}"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding TestConnectionCommand}"
                                    IsEnabled="{Binding IsTestingConnection, Converter={StaticResource InverseBoolConverter}}"
                                    Margin="0,0,10,0"/>

                            <Button Content="{DynamicResource String_ClearPersonalOverrideBtn}"
                                    Style="{StaticResource GhostButton}"
                                    Command="{Binding ClearApiKeyCommand}"
                                    Visibility="{Binding HasCustomKey, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </StackPanel>

                        <Border Background="{StaticResource SurfaceInputBrush}"
                                CornerRadius="{StaticResource RadiusMd}"
                                Padding="12,8" Margin="0,14,0,0"
                                Visibility="{Binding ConnectionTestResult, Converter={StaticResource NullToVisibilityConverter}}">
                            <TextBlock Text="{Binding ConnectionTestResult}" Style="{StaticResource Body}" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ═══ PATHS & STORAGE SECTION ═══ -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="{DynamicResource String_StorageDirectoriesTitle}" Style="{StaticResource H2}" Margin="0,0,0,4"/>
                    <TextBlock Text="{DynamicResource String_StorageDirectoriesDesc}"
                               Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,16"/>

                    <!-- Default Downloads / Installs Directory -->
                    <TextBlock Text="{DynamicResource String_DefaultDownloadsDirLabel}" Style="{StaticResource CaptionBold}" Margin="0,0,0,4"/>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Style="{StaticResource DarkTextBox}"
                                 Text="{Binding DefaultDownloadDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <Button Grid.Column="2"
                                Content="{DynamicResource String_BrowseDirBtn}"
                                Style="{StaticResource SecondaryButton}"
                                Padding="14,6"
                                Command="{Binding BrowseDownloadDirectoryCommand}"/>

                        <Button Grid.Column="4"
                                Content="{DynamicResource String_OpenDirBtn}"
                                Style="{StaticResource GhostButton}"
                                Padding="10,6"
                                Command="{Binding OpenDownloadDirectoryCommand}"/>
                    </Grid>

                    <!-- Instances Metadata Root -->
                    <TextBlock Text="{DynamicResource String_InstancesMetadataRootLabel}" Style="{StaticResource CaptionBold}" Margin="0,0,0,4"/>
                    <TextBox Style="{StaticResource DarkTextBox}" Text="{Binding InstanceRoot}" IsReadOnly="True"/>
                </StackPanel>
            </Border>

            <!-- ═══ DOWNLOADS & CLEANUP SECTION ═══ -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="{DynamicResource String_DownloadsCleanupTitle}" Style="{StaticResource H2}" Margin="0,0,0,4"/>
                    <TextBlock Text="{DynamicResource String_DownloadsCleanupDesc}"
                               Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,16"/>

                    <CheckBox Content="{DynamicResource String_AutoDeleteDepotsCheckbox}"
                              IsChecked="{Binding DeleteDepotsAfterInstall, Mode=TwoWay}"
                              Style="{StaticResource DarkCheckBox}"
                              Margin="0,0,0,8"/>
                    <TextBlock Text="{DynamicResource String_AutoDeleteDepotsHelp}"
                               Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- ═══ CATALOG & CONTENT FILTERS SECTION ═══ -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="{DynamicResource String_CatalogContentFiltersTitle}" Style="{StaticResource H2}" Margin="0,0,0,4"/>
                    <TextBlock Text="{DynamicResource String_CatalogContentFiltersDesc}"
                               Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,16"/>

                    <!-- NSFW Filter Toggle -->
                    <Border Background="{StaticResource SurfaceInputBrush}" CornerRadius="{StaticResource RadiusSm}" Padding="12,10" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource String_ShowNsfwContentLabel}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,2"/>
                                <TextBlock Text="{DynamicResource String_ShowNsfwContentDesc}"
                                           Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1"
                                      IsChecked="{Binding ShowNsfwContent, Mode=TwoWay}"
                                      Style="{StaticResource DarkCheckBox}"
                                      VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- DRM Filter Toggle -->
                    <Border Background="{StaticResource SurfaceInputBrush}" CornerRadius="{StaticResource RadiusSm}" Padding="12,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource String_ShowDrmContentLabel}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,2"/>
                                <TextBlock Text="{DynamicResource String_ShowDrmContentDesc}"
                                           Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1"
                                      IsChecked="{Binding ShowDrmContent, Mode=TwoWay}"
                                      Style="{StaticResource DarkCheckBox}"
                                      VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ═══ SYSTEM REQUIREMENTS & RUNTIMES SECTION ═══ -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                <StackPanel>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource String_SysReqRuntimesTitle}" Style="{StaticResource H2}" Margin="0,0,0,4"/>
                            <TextBlock Text="{DynamicResource String_SysReqRuntimesDesc}"
                                       Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="{DynamicResource String_ReScanBtn}"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="12,6" FontSize="11" Margin="0,0,8,0"
                                    Command="{Binding ScanRequirementsCommand}"
                                    IsEnabled="{Binding IsInstallingRequirements, Converter={StaticResource InverseBoolConverter}}"/>
                            <Button Content="{DynamicResource String_InstallAllMissingBtn}"
                                    Style="{StaticResource PrimaryButton}"
                                    Padding="14,6" FontSize="11"
                                    Visibility="{Binding HasMissingRequirements, Converter={StaticResource BoolToVisibilityConverter}}"
                                    Command="{Binding InstallAllRequirementsCommand}"
                                    IsEnabled="{Binding IsInstallingRequirements, Converter={StaticResource InverseBoolConverter}}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Auto check toggle -->
                    <Border Background="{StaticResource SurfaceInputBrush}" CornerRadius="{StaticResource RadiusSm}" Padding="12,10" Margin="0,12,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource String_CheckReqsOnStartupLabel}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,2"/>
                                <TextBlock Text="{DynamicResource String_CheckReqsOnStartupDesc}"
                                           Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1"
                                      IsChecked="{Binding CheckSystemRequirementsOnStartup, Mode=TwoWay}"
                                      Style="{StaticResource DarkCheckBox}"
                                      VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Progress bar when installing -->
                    <Border Background="{StaticResource SurfaceInputBrush}" CornerRadius="{StaticResource RadiusSm}" Padding="12,8" Margin="0,0,0,12"
                            Visibility="{Binding IsInstallingRequirements, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <ProgressBar Height="4" IsIndeterminate="True"
                                         Foreground="{StaticResource AccentBrush}"
                                         Background="{StaticResource SurfaceCardBrush}"
                                         BorderThickness="0" Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding InstallRequirementsStatusText}" Style="{StaticResource Caption}" Foreground="{StaticResource AccentBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Prerequisites List -->
                    <ItemsControl ItemsSource="{Binding SystemPrerequisites}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource SurfaceInputBrush}"
                                        BorderBrush="{StaticResource SubtleBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource RadiusSm}"
                                        Padding="12,10"
                                        Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="14"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,8,0"/>
                                                <Border CornerRadius="{StaticResource RadiusSm}"
                                                        Padding="6,1"
                                                        Background="{Binding Status, Converter={StaticResource PrerequisiteStatusToBgBrushConverter}}">
                                                    <TextBlock Text="{Binding Status, Converter={StaticResource PrerequisiteStatusToTextConverter}}"
                                                               FontSize="10" FontWeight="SemiBold"
                                                               Foreground="{Binding Status, Converter={StaticResource PrerequisiteStatusToBrushConverter}}"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <Button Content="{DynamicResource String_Install}"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Padding="12,5" FontSize="11"
                                                    Command="{Binding DataContext.InstallPrerequisiteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    IsEnabled="{Binding DataContext.IsInstallingRequirements, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource InverseBoolConverter}}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ═══ ADVANCED & EXPERIMENTAL FEATURES SECTION ═══ -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="{DynamicResource String_AdvancedExperimentalTitle}" Style="{StaticResource H2}" Margin="0,0,0,4"/>
                    <TextBlock Text="{DynamicResource String_AdvancedExperimentalDesc}"
                               Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,16"/>

                    <!-- Experimental Modding Tab Toggle -->
                    <Border Background="{StaticResource SurfaceInputBrush}" CornerRadius="{StaticResource RadiusSm}" Padding="12,10" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource String_ExperimentalModdingLabel}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,2"/>
                                <TextBlock Text="{DynamicResource String_ExperimentalModdingDesc}"
                                           Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1"
                                      IsChecked="{Binding EnableExperimentalMods, Mode=TwoWay}"
                                      Style="{StaticResource DarkCheckBox}"
                                      VerticalAlignment="Center"/>
                        </Grid>
                    </Border>


                </StackPanel>
            </Border>

            <!-- ═══ ENGINES & ECOSYSTEM REGISTRY SECTION ═══ -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="{DynamicResource String_EngineEcosystemTitle}" Style="{StaticResource H2}" Margin="0,0,0,4"/>
                    <TextBlock Text="{DynamicResource String_EngineEcosystemDesc}"
                               Style="{StaticResource Caption}" Margin="0,0,0,16"/>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Unreal Engine (4.x / 5.x):" Style="{StaticResource CaptionBold}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="~mods/Pak Manager, Shipping Executable Discovery, ReFix" Style="{StaticResource Caption}"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Unity Engine:" Style="{StaticResource CaptionBold}"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="UnityPlayer.dll Discovery, mods/ Folder Management" Style="{StaticResource Caption}"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Godot Engine:" Style="{StaticResource CaptionBold}"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text=".pck Package Signature Discovery" Style="{StaticResource Caption}"/>

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Emulators:" Style="{StaticResource CaptionBold}"/>
                        <TextBlock Grid.Row="6" Grid.Column="1" Text="SmokeAPI v4.x + cream_api.ini, ReFix Protocol Emulation" Style="{StaticResource Caption}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ═══ ABOUT & ECOSYSTEM CREDITS SECTION ═══ -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,24">
                <StackPanel>
                    <!-- BlueStar Identity Banner -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{StaticResource AccentTranslucentBrush}"
                                Width="52" Height="52"
                                CornerRadius="26"
                                BorderBrush="{StaticResource AccentBrush}"
                                BorderThickness="1.5"
                                Margin="0,0,16,0">
                            <TextBlock Text="★" FontSize="26" Foreground="{StaticResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                <TextBlock Text="{DynamicResource String_AboutTitle}" Style="{StaticResource H2}" Margin="0,0,10,0"/>
                                <Border Background="{StaticResource AccentTranslucentBrush}"
                                        BorderBrush="{StaticResource AccentBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource RadiusSm}"
                                        Padding="8,3"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding AppVersion, StringFormat='v{0} Stable'}" FontSize="11" FontWeight="Medium"
                                               Foreground="{StaticResource AccentBrush}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{DynamicResource String_AboutSubtitle}"
                                       Style="{StaticResource Caption}" Foreground="{StaticResource SecondaryTextBrush}"/>
                        </StackPanel>

                        <!-- Quick Repository Action Buttons -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="★ GitHub"
                                    Style="{StaticResource PrimaryButton}"
                                    Padding="14,8"
                                    FontSize="12"
                                    Margin="0,0,8,0"
                                    Command="{Binding OpenUrlCommand}"
                                    CommandParameter="https://github.com/Coronitaa/BlueStar"/>

                            <Button Content="🐞 Issues"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="12,8"
                                    FontSize="12"
                                    Command="{Binding OpenUrlCommand}"
                                    CommandParameter="https://github.com/Coronitaa/BlueStar/issues"/>
                        </StackPanel>
                    </Grid>

                    <Border Height="1" Background="{StaticResource SubtleBorderBrush}" Margin="0,0,0,18"/>

                    <!-- Community Ecosystem Header -->
                    <TextBlock Text="{DynamicResource String_CreditsTitle}" Style="{StaticResource H3}" Margin="0,0,0,4"/>
                    <TextBlock Text="{DynamicResource String_CreditsDesc}"
                               Style="{StaticResource Caption}" Margin="0,0,0,16"/>

                    <!-- Ecosystem Component Grid -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 1. ReFix -->
                        <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource SurfaceInputBrush}"
                                BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1"
                                CornerRadius="{StaticResource RadiusMd}" Padding="14,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                        <TextBlock Text="ReFix" FontWeight="Bold" FontSize="13" Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0"/>
                                        <Border Background="{StaticResource SurfaceCardBrush}" CornerRadius="4" Padding="5,1">
                                            <TextBlock Text="Mod &amp; Emulator Bridge" FontSize="10" Foreground="{StaticResource MutedTextBrush}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Modern lightweight mod bridge, automatic DLL proxy injection and engine translation layer."
                                               Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="GitHub ↗" Style="{StaticResource GhostButton}"
                                        Padding="8,4" FontSize="11" VerticalAlignment="Center"
                                        Command="{Binding OpenUrlCommand}"
                                        CommandParameter="https://github.com/Coronitaa/ReFix"/>
                            </Grid>
                        </Border>

                        <!-- 2. DepotDownloader -->
                        <Border Grid.Row="0" Grid.Column="2" Background="{StaticResource SurfaceInputBrush}"
                                BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1"
                                CornerRadius="{StaticResource RadiusMd}" Padding="14,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                        <TextBlock Text="DepotDownloader" FontWeight="Bold" FontSize="13" Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0"/>
                                        <Border Background="{StaticResource SurfaceCardBrush}" CornerRadius="4" Padding="5,1">
                                            <TextBlock Text="by SteamRE" FontSize="10" Foreground="{StaticResource MutedTextBrush}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="High-performance Steam depot download client, manifest deserialization, and CDN chunk manager."
                                               Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="GitHub ↗" Style="{StaticResource GhostButton}"
                                        Padding="8,4" FontSize="11" VerticalAlignment="Center"
                                        Command="{Binding OpenUrlCommand}"
                                        CommandParameter="https://github.com/SteamRE/DepotDownloader"/>
                            </Grid>
                        </Border>

                        <!-- 3. SmokeAPI -->
                        <Border Grid.Row="2" Grid.Column="0" Background="{StaticResource SurfaceInputBrush}"
                                BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1"
                                CornerRadius="{StaticResource RadiusMd}" Padding="14,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                        <TextBlock Text="SmokeAPI" FontWeight="Bold" FontSize="13" Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0"/>
                                        <Border Background="{StaticResource SurfaceCardBrush}" CornerRadius="4" Padding="5,1">
                                            <TextBlock Text="by acidicoala" FontSize="10" Foreground="{StaticResource MutedTextBrush}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Universal Steam API emulator for DLC unlocking, ticket generation, and overlay support."
                                               Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="GitHub ↗" Style="{StaticResource GhostButton}"
                                        Padding="8,4" FontSize="11" VerticalAlignment="Center"
                                        Command="{Binding OpenUrlCommand}"
                                        CommandParameter="https://github.com/acidicoala/SmokeAPI"/>
                            </Grid>
                        </Border>

                        <!-- 4. CreamInstaller -->
                        <Border Grid.Row="2" Grid.Column="2" Background="{StaticResource SurfaceInputBrush}"
                                BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1"
                                CornerRadius="{StaticResource RadiusMd}" Padding="14,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                        <TextBlock Text="CreamInstaller" FontWeight="Bold" FontSize="13" Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0"/>
                                        <Border Background="{StaticResource SurfaceCardBrush}" CornerRadius="4" Padding="5,1">
                                            <TextBlock Text="by pointfeev" FontSize="10" Foreground="{StaticResource MutedTextBrush}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Automated DLC unlocker, parser and multi-platform emulator deployment utility."
                                               Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="GitHub ↗" Style="{StaticResource GhostButton}"
                                        Padding="8,4" FontSize="11" VerticalAlignment="Center"
                                        Command="{Binding OpenUrlCommand}"
                                        CommandParameter="https://github.com/pointfeev/CreamInstaller"/>
                            </Grid>
                        </Border>

                        <!-- 5. Goldberg Emulator -->
                        <Border Grid.Row="4" Grid.Column="0" Background="{StaticResource SurfaceInputBrush}"
                                BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1"
                                CornerRadius="{StaticResource RadiusMd}" Padding="14,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                        <TextBlock Text="Goldberg Emulator" FontWeight="Bold" FontSize="13" Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0"/>
                                        <Border Background="{StaticResource SurfaceCardBrush}" CornerRadius="4" Padding="5,1">
                                            <TextBlock Text="by Mr_Goldberg" FontSize="10" Foreground="{StaticResource MutedTextBrush}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Open-source Steam client emulator designed for LAN co-op and offline standalone gameplay."
                                               Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="GitLab ↗" Style="{StaticResource GhostButton}"
                                        Padding="8,4" FontSize="11" VerticalAlignment="Center"
                                        Command="{Binding OpenUrlCommand}"
                                        CommandParameter="https://gitlab.com/Mr_Goldberg/goldberg_emulator"/>
                            </Grid>
                        </Border>

                        <!-- 6. SteamKit2 -->
                        <Border Grid.Row="4" Grid.Column="2" Background="{StaticResource SurfaceInputBrush}"
                                BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1"
                                CornerRadius="{StaticResource RadiusMd}" Padding="14,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                        <TextBlock Text="SteamKit2" FontWeight="Bold" FontSize="13" Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0"/>
                                        <Border Background="{StaticResource SurfaceCardBrush}" CornerRadius="4" Padding="5,1">
                                            <TextBlock Text="by SteamRE" FontSize="10" Foreground="{StaticResource MutedTextBrush}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text=".NET library providing core client protocols to the Steam network and protobuf services."
                                               Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="GitHub ↗" Style="{StaticResource GhostButton}"
                                        Padding="8,4" FontSize="11" VerticalAlignment="Center"
                                        Command="{Binding OpenUrlCommand}"
                                        CommandParameter="https://github.com/SteamRE/SteamKit"/>
                            </Grid>
                        </Border>

                        <!-- 7. CommunityToolkit.Mvvm -->
                        <Border Grid.Row="6" Grid.Column="0" Background="{StaticResource SurfaceInputBrush}"
                                BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1"
                                CornerRadius="{StaticResource RadiusMd}" Padding="14,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                        <TextBlock Text="CommunityToolkit.Mvvm" FontWeight="Bold" FontSize="13" Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0"/>
                                        <Border Background="{StaticResource SurfaceCardBrush}" CornerRadius="4" Padding="5,1">
                                            <TextBlock Text=".NET Foundation" FontSize="10" Foreground="{StaticResource MutedTextBrush}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Modern, ultra-fast MVVM framework leveraging source generators for clean decoupled architecture."
                                               Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="GitHub ↗" Style="{StaticResource GhostButton}"
                                        Padding="8,4" FontSize="11" VerticalAlignment="Center"
                                        Command="{Binding OpenUrlCommand}"
                                        CommandParameter="https://github.com/CommunityToolkit/dotnet"/>
                            </Grid>
                        </Border>

                        <!-- 8. Polly Resilient Pipeline -->
                        <Border Grid.Row="6" Grid.Column="2" Background="{StaticResource SurfaceInputBrush}"
                                BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1"
                                CornerRadius="{StaticResource RadiusMd}" Padding="14,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                        <TextBlock Text="Polly" FontWeight="Bold" FontSize="13" Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0"/>
                                        <Border Background="{StaticResource SurfaceCardBrush}" CornerRadius="4" Padding="5,1">
                                            <TextBlock Text=".NET Foundation" FontSize="10" Foreground="{StaticResource MutedTextBrush}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Resilience and transient fault-handling policies for robust DepotBox CDN requests."
                                               Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="GitHub ↗" Style="{StaticResource GhostButton}"
                                        Padding="8,4" FontSize="11" VerticalAlignment="Center"
                                        Command="{Binding OpenUrlCommand}"
                                        CommandParameter="https://github.com/App-vNext/Polly"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Architecture & Tech Stack Footer -->
                    <Border Background="{StaticResource SurfaceInputBrush}" CornerRadius="{StaticResource RadiusSm}"
                            Padding="14,10" Margin="0,18,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="⚙" FontSize="14" Foreground="{StaticResource AccentBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Built with .NET 8.0 LTS • Windows Presentation Foundation (WPF) • High-Performance System.Text.Json • MIT License"
                                       Style="{StaticResource BodySmall}" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
