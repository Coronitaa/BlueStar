<UserControl x:Class="BlueStar.App.Views.InstanceDetailView"
             x:Name="RootInstanceDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:BlueStar.App.ViewModels"
             xmlns:controls="clr-namespace:BlueStar.App.Controls"
             d:DataContext="{d:DesignInstance vm:InstanceDetailViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{StaticResource BaseBackgroundBrush}"
             Foreground="{StaticResource PrimaryTextBrush}"
             FontFamily="{StaticResource MainFontFamily}">

    <UserControl.RenderTransform>
        <TranslateTransform Y="0"/>
    </UserControl.RenderTransform>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     From="0.0" To="1.0" Duration="0:0:0.22">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                     From="12" To="0" Duration="0:0:0.22">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="32,24" MaxWidth="1180" HorizontalAlignment="Stretch">

                <!-- ═══ TOP BREADCRUMB & BACK BUTTON ═══ -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="{DynamicResource String_BackToInstances}"
                            Style="{StaticResource GhostButton}"
                            Foreground="{StaticResource SecondaryTextBrush}"
                            Command="{Binding GoBackCommand}"/>
                </Grid>

                <!-- ═══ HERO BANNER HEADER ═══ -->
                <Border Background="{StaticResource SurfaceCardBrush}"
                        BorderBrush="{StaticResource SubtleBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusLg}"
                        Padding="24"
                        Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="235"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Game Cover Image (Standard 460x215 aspect ratio: 235x110) -->
                        <Border Grid.Column="0" CornerRadius="8"
                                Background="{StaticResource SurfaceInputBrush}"
                                Width="235" Height="110" ClipToBounds="True">
                            <Grid>
                                <Path Data="{StaticResource IconGamepad}" Fill="{StaticResource MutedTextBrush}"
                                      Stretch="Uniform" Width="32" Height="32"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Image Source="{Binding Instance.HeaderImageUrl, Converter={StaticResource CachedImageConverter}}"
                                       Stretch="UniformToFill"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Grid>
                        </Border>

                        <!-- Game Info -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Instance.Name}" Style="{StaticResource H1}"
                                       TextTrimming="CharacterEllipsis" Margin="0,0,0,4"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="{Binding Instance.AppId, StringFormat='Steam AppID: {0}'}"
                                           Style="{StaticResource Caption}" Margin="0,0,14,0"/>
                                <TextBlock Text="{Binding Instance.TotalPlayTime, Converter={StaticResource PlayTimeToFormattedConverter}, StringFormat='Playtime: {0}'}"
                                           Style="{StaticResource Caption}"/>
                            </StackPanel>

                            <!-- Badges: Dynamic Tags from ITagsService -->
                            <ItemsControl ItemsSource="{Binding HeroTags}" Margin="0,4,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="{StaticResource RadiusSm}"
                                                Padding="7,2"
                                                Margin="0,0,6,4"
                                                Background="{Binding Type, Converter={StaticResource TagTypeToBgBrushConverter}}"
                                                BorderBrush="{Binding Type, Converter={StaticResource TagTypeToBorderBrushConverter}}"
                                                BorderThickness="1"
                                                ToolTip="{Binding Tooltip}">
                                            <TextBlock Text="{Binding Text}"
                                                       FontSize="11"
                                                       FontWeight="Normal"
                                                       Foreground="{Binding Type, Converter={StaticResource TagTypeToBrushConverter}}"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Primary Action Buttons (Play & Shortcut) -->
                        <StackPanel Grid.Column="3" VerticalAlignment="Center" Orientation="Horizontal">
                            <Button Style="{StaticResource IconButton}" Margin="0,0,8,0"
                                    ToolTip="{DynamicResource String_OpenGameDirTooltip}" Command="{Binding OpenFolderCommand}">
                                <Path Data="{StaticResource IconFolder}" Fill="{StaticResource SecondaryTextBrush}"
                                      Stretch="Uniform" Width="15" Height="15"/>
                            </Button>

                            <Button Style="{StaticResource IconButton}" Margin="0,0,12,0"
                                    ToolTip="{DynamicResource String_CreateShortcutsTooltip}" Command="{Binding OpenShortcutModalCommand}">
                                <Path Data="{StaticResource IconLink}" Fill="{StaticResource SecondaryTextBrush}"
                                      Stretch="Uniform" Width="15" Height="15"/>
                            </Button>

                            <!-- Play / Install / Stop Button -->
                            <Button Command="{Binding LaunchGameCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PlayHeroButton}">
                                        <Setter Property="Content" Value="{DynamicResource String_PlayGame}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Instance.Status}" Value="NotInstalled">
                                                <Setter Property="Content" Value="{DynamicResource String_InstallGame}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding HasActiveJob}" Value="True">
                                                <Setter Property="Content" Value="{Binding InstanceDownloadLabel, StringFormat='📥 Downloading {0}'}"/>
                                                <Setter Property="IsEnabled" Value="False"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsGameRunning}" Value="True">
                                                <Setter Property="Content" Value="{DynamicResource String_StopProcess}"/>
                                                <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>

                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ═══ STATUS FEEDBACK MESSAGE / PROGRESS ═══ -->
                <Border Background="{StaticResource SurfaceCardBrush}"
                        BorderBrush="{StaticResource AccentBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusMd}"
                        Padding="14,10" Margin="0,0,0,16"
                        Visibility="{Binding IsStatusMessageVisible, Converter={StaticResource BoolToVisibilityConverter}}">

                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" Style="{StaticResource BodyMedium}"
                                       TextWrapping="Wrap" Foreground="{StaticResource PrimaryTextBrush}"/>
                            <TextBlock Grid.Column="1" Text="{Binding GameFixDeployProgress, StringFormat='{}{0:F0}%'}"
                                       Style="{StaticResource CaptionBold}" Foreground="{StaticResource AccentBrush}" FontSize="13"
                                       Visibility="{Binding IsGameFixDeployProgressVisible, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </Grid>
                        <ProgressBar Margin="0,8,0,0" Value="{Binding GameFixDeployProgress}" Maximum="100" Height="6"
                                     Foreground="{StaticResource AccentBrush}"
                                     Background="{StaticResource SurfaceInputBrush}"
                                     BorderThickness="0"
                                     Visibility="{Binding IsGameFixDeployProgressVisible, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </StackPanel>
                </Border>

                <!-- ═══ ACTIVE DOWNLOAD PROGRESS CARD ═══ -->
                <Border Background="{StaticResource SurfaceCardBrush}"
                        BorderBrush="{StaticResource AccentBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusMd}"
                        Padding="16,12" Margin="0,0,0,16"
                        Visibility="{Binding HasActiveJob, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📥 " FontSize="14" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ActiveJob.StatusMessage, FallbackValue='Downloading game files...'}"
                                           FontWeight="SemiBold" FontSize="13"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ActiveJob.FormattedSpeed, StringFormat='  •  {0}'}"
                                           Style="{StaticResource Caption}"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding ActiveJob.IsDownloading, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <TextBlock Text="{Binding ActiveJob.FormattedEta, StringFormat='  •  ETA: {0}'}"
                                           Style="{StaticResource Caption}"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding ActiveJob.IsDownloading, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ActiveJob.Percentage, StringFormat='{}{0:F1}%'}"
                                           FontWeight="Bold" FontSize="14"
                                           Foreground="{StaticResource AccentBrush}"
                                           Margin="0,0,12,0" VerticalAlignment="Center"/>

                                <!-- Pause Button -->
                                <Button Content="⏸ Pause" Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="11" Margin="0,0,6,0"
                                        Command="{Binding PauseDownloadCommand}"
                                        Visibility="{Binding ActiveJob.CanPause, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                <!-- Resume Button -->
                                <Button Content="▶ Resume" Style="{StaticResource PrimaryButton}" Padding="10,4" FontSize="11" Margin="0,0,6,0"
                                        Command="{Binding ResumeDownloadCommand}"
                                        Visibility="{Binding ActiveJob.CanResume, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                <!-- Cancel Button -->
                                <Button Content="❌ Cancel" Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="11" Margin="0,0,6,0"
                                        Command="{Binding CancelDownloadCommand}"
                                        Visibility="{Binding ActiveJob.CanCancel, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                <!-- Retry Button -->
                                <Button Content="🔄 Retry" Style="{StaticResource PrimaryButton}" Padding="10,4" FontSize="11"
                                        Command="{Binding RetryDownloadCommand}"
                                        Visibility="{Binding ActiveJob.CanRetry, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </StackPanel>
                        </Grid>

                        <ProgressBar Value="{Binding ActiveJob.Percentage}" Maximum="100" Height="8"
                                     Foreground="{StaticResource AccentBrush}"
                                     Background="{StaticResource SurfaceInputBrush}"
                                     BorderThickness="0"/>
                    </StackPanel>
                </Border>

                <!-- ═══ MODRINTH-STYLE DYNAMIC TAB BAR ═══ -->
                <Border Background="{StaticResource SurfaceCardBrush}"
                        BorderBrush="{StaticResource SubtleBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusMd}"
                        Padding="8,4"
                        Margin="0,0,0,20">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource TabRadioButton}" Content="{DynamicResource String_TabOverview}"

                                     IsChecked="{Binding SelectedTab, Converter={StaticResource StringMatchConverter}, ConverterParameter=Overview}"
                                     Command="{Binding SwitchTabCommand}" CommandParameter="Overview"/>

                        <RadioButton Style="{StaticResource TabRadioButton}" Content="{DynamicResource String_TabFilesDepots}"
                                     Visibility="{Binding IsDepotBoxTabsVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                                     IsChecked="{Binding SelectedTab, Converter={StaticResource StringMatchConverter}, ConverterParameter=Files}"
                                     Command="{Binding SwitchTabCommand}" CommandParameter="Files"/>

                        <RadioButton Style="{StaticResource TabRadioButton}" Content="{DynamicResource String_TabDlcs}"
                                     Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibilityConverter}}"
                                     IsChecked="{Binding SelectedTab, Converter={StaticResource StringMatchConverter}, ConverterParameter=Dlcs}"
                                     Command="{Binding SwitchTabCommand}" CommandParameter="Dlcs"/>

                        <RadioButton Style="{StaticResource TabRadioButton}" Content="{DynamicResource String_TabMods}"
                                     Visibility="{Binding IsModsTabVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                                     IsChecked="{Binding SelectedTab, Converter={StaticResource StringMatchConverter}, ConverterParameter=Mods}"
                                     Command="{Binding SwitchTabCommand}" CommandParameter="Mods"/>

                        <RadioButton Style="{StaticResource TabRadioButton}" Content="{DynamicResource String_TabEmulator}"
                                     Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibilityConverter}}"
                                     IsChecked="{Binding SelectedTab, Converter={StaticResource StringMatchConverter}, ConverterParameter=Emulator}"
                                     Command="{Binding SwitchTabCommand}" CommandParameter="Emulator"/>

                        <RadioButton Style="{StaticResource TabRadioButton}" Content="{DynamicResource String_TabPrerequisites}"
                                     IsChecked="{Binding SelectedTab, Converter={StaticResource StringMatchConverter}, ConverterParameter=Prerequisites}"
                                     Command="{Binding SwitchTabCommand}" CommandParameter="Prerequisites"/>

                        <RadioButton Style="{StaticResource TabRadioButton}" Content="{DynamicResource String_TabSettings}"
                                     IsChecked="{Binding SelectedTab, Converter={StaticResource StringMatchConverter}, ConverterParameter=Settings}"
                                     Command="{Binding SwitchTabCommand}" CommandParameter="Settings"/>

                        <RadioButton Style="{StaticResource TabRadioButton}" Content="{DynamicResource String_TabLogs}"
                                     Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibilityConverter}}"
                                     IsChecked="{Binding SelectedTab, Converter={StaticResource StringMatchConverter}, ConverterParameter=Logs}"
                                     Command="{Binding SwitchTabCommand}" CommandParameter="Logs"/>
                    </StackPanel>
                </Border>

                <!-- ══════════════════════════════════════════════════════════════
                     TAB CONTENT PANELS
                     ══════════════════════════════════════════════════════════════ -->

                <!-- ── 1. OVERVIEW TAB ── -->
                <StackPanel Visibility="{Binding SelectedTab, Converter={StaticResource StringMatchToVisibilityConverter}, ConverterParameter=Overview}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left Column: Description & Metadata -->
                        <Border Grid.Column="0" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource String_AboutGame}" Style="{StaticResource H2}" Margin="0,0,0,12"/>
                                <TextBlock Text="{Binding Instance.Metadata.ShortDescription, FallbackValue='No description provided for this game instance.'}"
                                           Style="{StaticResource Body}" TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,16"/>

                                <Border Height="1" Background="{StaticResource SubtleBorderBrush}" Margin="0,0,0,16"/>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="10"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="10"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="10"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="10"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource String_Developer}" Style="{StaticResource CaptionBold}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Instance.Metadata.Developer, FallbackValue='Unknown'}" Style="{StaticResource Body}"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource String_Publisher}" Style="{StaticResource CaptionBold}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Instance.Metadata.Publisher, FallbackValue='Unknown'}" Style="{StaticResource Body}"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="{DynamicResource String_InstalledVersion}" Style="{StaticResource CaptionBold}"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding InstalledVersionText}" Style="{StaticResource Body}"/>

                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="{DynamicResource String_LatestOnSteam}" Style="{StaticResource CaptionBold}"/>
                                    <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding LatestVersionText}" Style="{StaticResource Body}" Foreground="{StaticResource AccentBrush}"/>

                                    <TextBlock Grid.Row="8" Grid.Column="0" Text="{DynamicResource String_ReleaseDate}" Style="{StaticResource CaptionBold}"/>
                                    <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding Instance.Metadata.ReleaseDate, FallbackValue='Unknown'}" Style="{StaticResource Body}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Right Column: System & Install Summary -->
                        <StackPanel Grid.Column="2">
                            <!-- Associate with DepotBox Card (For Imported Folder games without association) -->
                            <Border Style="{StaticResource Card}"
                                    BorderBrush="#38BDF8"
                                    BorderThickness="1"
                                    Margin="0,0,0,16"
                                    Visibility="{Binding IsImportedUnassociatedInstance, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="📦 " Style="{StaticResource H3}" Foreground="#38BDF8"/>
                                        <TextBlock Text="{DynamicResource String_AssociateDepotBoxTitle}" Style="{StaticResource H3}" Foreground="#38BDF8"/>
                                    </StackPanel>
                                    <TextBlock Text="{DynamicResource String_AssociateDepotBoxDesc}"
                                               Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                    <Button Style="{StaticResource PrimaryButton}"
                                            Background="#0284C7" BorderBrush="#0369A1"
                                            Command="{Binding OpenDepotAssociationModalCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🔍 "/>
                                            <TextBlock Text="{DynamicResource String_FindDepotsBtn}"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- Update Available Alert Card -->
                            <Border Style="{StaticResource Card}"
                                    BorderBrush="{StaticResource AccentBrush}"
                                    BorderThickness="1"
                                    Margin="0,0,0,16"
                                    Visibility="{Binding HasGameUpdateAvailable, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="🔄 " Style="{StaticResource H3}" Foreground="{StaticResource AccentBrush}"/>
                                        <TextBlock Text="{DynamicResource String_NewVersionDetectedTitle}" Style="{StaticResource H3}" Foreground="{StaticResource AccentBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="{DynamicResource String_NewVersionDetectedDesc}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                    <Button Content="{DynamicResource String_CheckDepotBoxUpdatesBtn}"
                                            Style="{StaticResource PrimaryButton}"
                                            Command="{Binding CheckAndOpenDepotUpdateModalCommand}"
                                            IsEnabled="{Binding IsCheckingGameUpdate, Converter={StaticResource InverseBoolConverter}}"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource String_InstanceInfoTitle}" Style="{StaticResource H3}" Margin="0,0,0,12"/>

                                    <TextBlock Text="{DynamicResource String_InstallationDirLabel}" Style="{StaticResource CaptionBold}" Margin="0,0,0,4"/>
                                    <Border Background="{StaticResource SurfaceInputBrush}" CornerRadius="{StaticResource RadiusSm}" Padding="10,6" Margin="0,0,0,12">
                                        <TextBlock Text="{Binding Instance.InstallPath}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"/>
                                    </Border>
                                    <Button Content="{DynamicResource String_ChangeDirBtn}" Style="{StaticResource SecondaryButton}" Command="{Binding ChangeInstallPathCommand}"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource String_QuickActionsTitle}" Style="{StaticResource H3}" Margin="0,0,12,0"/>
                                    <Button Style="{StaticResource SecondaryButton}" Margin="0,8,0,8" Command="{Binding OpenFolderCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📁 "/>
                                            <TextBlock Text="{DynamicResource String_OpenGameFolder}"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding OpenShortcutModalCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🔗 "/>
                                            <TextBlock Text="{DynamicResource String_CreatingShortcuts}"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- ReFix 1-Click Update Button when outdated -->
                                    <Button Content="{Binding ReFixUpdateButtonText}"
                                            Style="{StaticResource PrimaryButton}"
                                            Background="{StaticResource WarningBrush}"
                                            Margin="0,8,0,0"
                                            Visibility="{Binding IsReFixUpdateAvailableForInstance, Converter={StaticResource BoolToVisibilityConverter}}"
                                            Command="{Binding UpdateInstanceReFixCommand}"
                                            IsEnabled="{Binding IsDeployingEmulator, Converter={StaticResource InverseBoolConverter}}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- ── 2. FILES & DEPOTS TAB ── -->
                <StackPanel Visibility="{Binding SelectedTab, Converter={StaticResource StringMatchToVisibilityConverter}, ConverterParameter=Files}">
                    
                    <!-- ═══ SELECT GAME DEPOTS TO DOWNLOAD CARD ═══ -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{DynamicResource String_SelectDepotsTitle}" Style="{StaticResource H2}"/>
                                    <TextBlock Text="{DynamicResource String_SelectDepotsSubtitle}" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="{DynamicResource String_SelectAll}" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Command="{Binding SelectAllDepotsCommand}"/>
                                    <Button Content="{DynamicResource String_DeselectAll}" Style="{StaticResource GhostButton}" Command="{Binding DeselectAllDepotsCommand}"/>
                                </StackPanel>
                            </Grid>

                            <!-- Depots List -->
                            <ItemsControl ItemsSource="{Binding Depots}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource SurfaceInputBrush}" CornerRadius="{StaticResource RadiusMd}"
                                                Padding="14,10" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Checkbox -->
                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,12,0"/>

                                                <!-- DLC Thumbnail (only for DLC depots that have an image) -->
                                                <Border Grid.Column="1"
                                                        Width="52" Height="36"
                                                        CornerRadius="{StaticResource RadiusSm}"
                                                        ClipToBounds="True"
                                                        Margin="0,0,12,0"
                                                        Visibility="{Binding ImageUrl, Converter={StaticResource NullToVisibilityConverter}}">
                                                    <Image Source="{Binding ImageUrl}"
                                                           Stretch="UniformToFill"
                                                           VerticalAlignment="Center"/>
                                                </Border>

                                                <!-- Name + Subtitle -->
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                    <!-- Name row: star badge inline if recommended -->
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <!-- Recommended star badge -->
                                                        <Border Background="#1F3A1A" BorderBrush="#2D5A27" BorderThickness="1"
                                                                CornerRadius="{StaticResource RadiusSm}" Padding="5,1"
                                                                Margin="0,0,6,0" VerticalAlignment="Center"
                                                                Visibility="{Binding IsRecommended, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                ToolTip="{DynamicResource String_RecommendedBadgeTooltip}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="⭐ " FontSize="10" FontWeight="SemiBold" Foreground="#4ADE80"/>
                                                                <TextBlock Text="{DynamicResource String_RecommendedBadge}" FontSize="10" FontWeight="SemiBold" Foreground="#4ADE80"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <TextBlock Text="{Binding DisplayName}" Style="{StaticResource BodyMedium}" VerticalAlignment="Center"/>
                                                    </StackPanel>

                                                    <!-- Regular User Mode (Simple) -->
                                                    <TextBlock Text="{Binding Depot.DepotId, StringFormat='Depot ID: {0}'}" Style="{StaticResource Caption}"
                                                               Visibility="{Binding DataContext.EnableAdvancedBuildOptions, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>

                                                    <!-- Advanced User Mode (Manifest details & inline edit) -->
                                                    <StackPanel Visibility="{Binding DataContext.EnableAdvancedBuildOptions, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <!-- Normal Manifest View -->
                                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0"
                                                                    Visibility="{Binding IsEditingManifest, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                                            <TextBlock Text="{Binding Depot.DepotId, StringFormat='Depot: {0}'}" Style="{StaticResource Caption}"/>
                                                            <TextBlock Text=" • Manifest: " Style="{StaticResource Caption}" Margin="4,0,0,0"/>
                                                            <TextBlock Text="{Binding ManifestIdText}" Style="{StaticResource CaptionBold}" Foreground="{StaticResource AccentBrush}"/>
                                                            <Button Content="✏" ToolTip="{DynamicResource String_EditManifestTooltip}"
                                                                    Style="{StaticResource GhostButton}"
                                                                    Padding="5,0" Margin="6,0,0,0" FontSize="11"
                                                                    Command="{Binding StartEditManifestCommand}"/>
                                                        </StackPanel>

                                                        <!-- Inline Edit Mode -->
                                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0"
                                                                    Visibility="{Binding IsEditingManifest, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <TextBlock Text="Manifest ID:" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                            <TextBox Text="{Binding EditingManifestId, UpdateSourceTrigger=PropertyChanged}"
                                                                     Style="{StaticResource DarkTextBox}"
                                                                     Width="180" Height="24" Padding="4,2" FontSize="12"/>
                                                            <Button Content="✓" Style="{StaticResource PrimaryButton}"
                                                                    Padding="8,2" Margin="6,0,2,0" Height="24"
                                                                    Command="{Binding SaveEditManifestCommand}"/>
                                                            <Button Content="✕" Style="{StaticResource GhostButton}"
                                                                    Padding="6,2" Height="24"
                                                                    Command="{Binding CancelEditManifestCommand}"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Tags: Installed, Category, Platform, Architecture -->
                                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                                                    <Border Background="{StaticResource SuccessBgBrush}" BorderBrush="{StaticResource SuccessBorderBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusSm}" Padding="8,2" Margin="0,0,6,0"
                                                            Visibility="{Binding IsDownloaded, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="✓ " FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}"/>
                                                            <TextBlock Text="{DynamicResource String_Installed}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusSm}" Padding="8,2" Margin="0,0,6,0">
                                                        <TextBlock Text="{Binding CategoryTag}" Style="{StaticResource CaptionBold}"/>
                                                    </Border>
                                                    <Border Background="{StaticResource InfoBgBrush}" BorderBrush="{StaticResource InfoBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusSm}" Padding="8,2" Margin="0,0,6,0">
                                                        <TextBlock Text="{Binding PlatformTag}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource InfoBrush}"/>
                                                    </Border>
                                                    <Border Background="{StaticResource PurpleBgBrush}" BorderBrush="{StaticResource PurpleBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusSm}" Padding="6,2"
                                                            Visibility="{Binding ArchitectureTag, Converter={StaticResource NullToVisibilityConverter}}">
                                                        <TextBlock Text="{Binding ArchitectureTag}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource PurpleBrush}"/>
                                                    </Border>
                                                </StackPanel>

                                                <!-- Size -->
                                                <TextBlock Grid.Column="4" Text="{Binding FormattedSize}" Style="{StaticResource CaptionBold}" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Download Bottom Summary & Trigger -->
                            <Border Height="1" Background="{StaticResource SubtleBorderBrush}" Margin="0,16,0,16"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource BodyMedium}">
                                        <Run Text="{Binding SelectedDepotsCount, Mode=OneWay}"/>
                                        <Run Text=" depot(s) selected"/>
                                        <Run Text=" — "/>
                                        <Run Text="{Binding SelectedDepotsSize, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                                    </TextBlock>
                                    <TextBlock Text="{DynamicResource String_RequiresConnectionNotice}" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="{Binding DownloadButtonText}"
                                            Style="{StaticResource PrimaryButton}"
                                            Padding="16,10"
                                            Command="{Binding DownloadSelectedDepotsCommand}"
                                            IsEnabled="{Binding CanStartDownload}"/>
                                </StackPanel>

                            </Grid>

                        </StackPanel>
                    </Border>

                    <!-- ═══ GAME BUILD & VERSION SELECTOR (ADVANCED OPTIONS ENABLED) ═══ -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"
                            AllowDrop="True" Drop="DepotDropZone_Drop" DragOver="DepotDropZone_DragOver"
                            Visibility="{Binding EnableAdvancedBuildOptions, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="{DynamicResource String_GameBuildBranchTitle}" Style="{StaticResource H3}" Margin="0,0,8,0"/>
                                        <Border Background="{StaticResource AccentBgBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusSm}" Padding="8,2"
                                                Visibility="{Binding ActiveBuildBadgeText, Converter={StaticResource NullToVisibilityConverter}}">
                                            <TextBlock Text="{Binding ActiveBuildBadgeText}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{DynamicResource String_GameBuildBranchDesc}"
                                               Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,10"/>

                                    <ComboBox ItemsSource="{Binding AvailableBuilds}"
                                              SelectedItem="{Binding SelectedBuild, Mode=TwoWay}"
                                              Style="{StaticResource DarkComboBox}"
                                              HorizontalAlignment="Stretch">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
                                                        <TextBlock Text="{Binding Description, FallbackValue=''}" Style="{StaticResource Caption}" Foreground="{StaticResource MutedTextBrush}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                                        <TextBlock Text="{Binding FormattedDate}" Style="{StaticResource Caption}" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,8,0"/>
                                                        <Border Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusSm}" Padding="6,1">
                                                            <TextBlock Text="{Binding Source}" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}"/>
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <Button Content="{DynamicResource String_ImportZipPackageBtn}"
                                            Style="{StaticResource PrimaryButton}"
                                            Padding="14,8" Margin="0,0,0,6"
                                            Command="{Binding ImportDepotZipPackageCommand}"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="{DynamicResource String_ScanBuildsBtn}"
                                                Style="{StaticResource SecondaryButton}"
                                                Padding="8,6" Margin="0,0,6,0" FontSize="11"
                                                Command="{Binding LoadAvailableBuildsCommand}"
                                                IsEnabled="{Binding IsLoadingBuilds, Converter={StaticResource InverseBoolConverter}}"/>
                                        <Button Content="{DynamicResource String_CustomBuildBtn}"
                                                Style="{StaticResource SecondaryButton}"
                                                Padding="8,6" Margin="0,0,6,0" FontSize="11"
                                                Command="{Binding OpenAddCustomBuildModalCommand}"/>
                                        <Button Content="{DynamicResource String_SourcesMenuBtn}"
                                                Style="{StaticResource GhostButton}"
                                                Padding="8,6" FontSize="11"
                                                Command="{Binding ToggleCommunityLinksMenuCommand}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <!-- Community Manifest Sources Menu Popup / Card -->
                            <Border Grid.Row="1" Background="{StaticResource SurfaceInputBrush}"
                                    BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusMd}"
                                    Padding="14,10" Margin="0,12,0,0"
                                    Visibility="{Binding IsCommunityLinksMenuOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="{DynamicResource String_CommunitySourcesTitle}" Style="{StaticResource CaptionBold}"/>
                                        <Button Content="✕" Style="{StaticResource GhostButton}" HorizontalAlignment="Right"
                                                Padding="4,0" FontSize="11" Command="{Binding CloseCommunityLinksMenuCommand}"/>
                                    </Grid>
                                    <WrapPanel Orientation="Horizontal">
                                        <Button Content="{DynamicResource String_SteamDbDepotsBtn}"
                                                Style="{StaticResource SecondaryButton}"
                                                Padding="10,5" Margin="0,0,8,6" FontSize="11"
                                                Command="{Binding OpenCommunityLinkCommand}" CommandParameter="steamdb_depots"/>
                                        <Button Content="{DynamicResource String_SteamDbPatchesBtn}"
                                                Style="{StaticResource SecondaryButton}"
                                                Padding="10,5" Margin="0,0,8,6" FontSize="11"
                                                Command="{Binding OpenCommunityLinkCommand}" CommandParameter="steamdb_patches"/>
                                        <Button Content="{DynamicResource String_CsRinRuThreadBtn}"
                                                Style="{StaticResource SecondaryButton}"
                                                Padding="10,5" Margin="0,0,8,6" FontSize="11"
                                                Command="{Binding OpenCommunityLinkCommand}" CommandParameter="csrinru"/>
                                        <Button Content="{DynamicResource String_DepotBoxHubBtn}"
                                                Style="{StaticResource SecondaryButton}"
                                                Padding="10,5" Margin="0,0,8,6" FontSize="11"
                                                Command="{Binding OpenCommunityLinkCommand}" CommandParameter="depotbox"/>
                                        <Button Content="{DynamicResource String_OpenManifestsFolderBtn}"
                                                Style="{StaticResource GhostButton}"
                                                Padding="10,5" Margin="0,0,0,6" FontSize="11"
                                                Command="{Binding OpenCommunityLinkCommand}" CommandParameter="manifest_dir"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- ── 3. DLCS & UNLOCKER TAB ── -->
                <StackPanel Visibility="{Binding SelectedTab, Converter={StaticResource StringMatchToVisibilityConverter}, ConverterParameter=Dlcs}">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{DynamicResource String_DlcsHeaderTitle}" Style="{StaticResource H2}"/>
                                    <TextBlock Text="{DynamicResource String_DlcsHeaderDesc}" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                                </StackPanel>

                                <Button Grid.Column="1"
                                        Content="{Binding IsDlcUnlocked, Converter={StaticResource DlcUnlockButtonTextConverter}}"
                                        Style="{StaticResource PrimaryButton}"
                                        Padding="16,10"
                                        Command="{Binding UnlockDlcsCommand}"/>
                            </Grid>

                            <!-- DLCs List -->
                            <ItemsControl ItemsSource="{Binding Dlcs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource SurfaceInputBrush}" CornerRadius="{StaticResource RadiusMd}"
                                                Padding="14,10" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="77"/>
                                                    <ColumnDefinition Width="14"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,12,0"/>

                                                <!-- DLC Thumbnail (Standard 460:215 aspect ratio: 77x36) -->
                                                <Border Grid.Column="1" CornerRadius="4" ClipToBounds="True" Width="77" Height="36" Background="{StaticResource SurfaceCardBrush}">
                                                    <Image Source="{Binding HeaderImageUrl, Converter={StaticResource CachedImageConverter}}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                </Border>

                                                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayName}" Style="{StaticResource BodyMedium}"/>
                                                    <TextBlock Text="{Binding Dlc.AppId, StringFormat='DLC AppID: {0}'}" Style="{StaticResource Caption}"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Background="{StaticResource SuccessBgBrush}" BorderBrush="{StaticResource SuccessBorderBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusSm}" Padding="8,2" Margin="0,0,10,0"
                                                            Visibility="{Binding IsDownloaded, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <TextBlock Text="✓ Installed" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding FormattedSize}" Style="{StaticResource CaptionBold}" Foreground="{StaticResource PurpleBrush}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ── 4. MODS TAB ── -->
                <StackPanel Visibility="{Binding SelectedTab, Converter={StaticResource StringMatchToVisibilityConverter}, ConverterParameter=Mods}">
                    
                    <!-- ═══ BEPINEX MOD LOADER SECTION (FOR UNITY GAMES) ═══ -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,18"
                            Visibility="{Binding IsUnityEngine, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="{DynamicResource String_BepInExLoaderTitle}" Style="{StaticResource H2}"/>
                                        <Border Background="{StaticResource PurpleBgBrush}"
                                                BorderBrush="{StaticResource PurpleBrush}"
                                                BorderThickness="1"
                                                CornerRadius="{StaticResource RadiusXs}"
                                                Padding="6,2" Margin="10,0,0,0"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="Unity Engine" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource PurpleBrush}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{DynamicResource String_BepInExDesc}"
                                               Style="{StaticResource Caption}"/>
                                </StackPanel>

                                <!-- Installed Status Badge -->
                                <Border Grid.Column="1" VerticalAlignment="Center"
                                        Background="{StaticResource SurfaceInputBrush}"
                                        BorderBrush="{StaticResource SubtleBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource RadiusSm}"
                                        Padding="10,6">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{StaticResource MutedTextBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsBepInExInstalled}" Value="True">
                                                            <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Body}">
                                                    <Setter Property="Text" Value="Not Installed"/>
                                                    <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsBepInExInstalled}" Value="True">
                                                            <Setter Property="Text" Value="{Binding InstalledBepInExVersion, StringFormat='Installed ({0})', FallbackValue='Installed'}"/>
                                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- BepInEx Version Picker & Action Controls -->
                            <Grid Margin="0,4,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <ComboBox Grid.Column="0"
                                          Style="{StaticResource DarkComboBox}"
                                          ItemsSource="{Binding AvailableBepInExVersions}"
                                          SelectedItem="{Binding SelectedBepInExVersion}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding TagName}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,8,0"/>
                                                    <TextBlock Text="{Binding Version}" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                                </StackPanel>

                                                <!-- Architecture Badge: (x64) / (x86) -->
                                                <Border Grid.Column="1"
                                                        Background="{StaticResource SurfaceInputBrush}"
                                                        BorderBrush="{StaticResource SubtleBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="{StaticResource RadiusXs}"
                                                        Padding="6,1"
                                                        VerticalAlignment="Center"
                                                        Margin="8,0,0,0">
                                                    <TextBlock Text="{Binding Architecture}"
                                                               FontSize="10"
                                                               FontWeight="Bold"
                                                               FontFamily="Consolas, Segoe UI"
                                                               Foreground="{StaticResource AccentBrush}"/>
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <Button Grid.Column="2"
                                        Content="{DynamicResource String_InstallUpdateVersionBtn}"
                                        Style="{StaticResource PrimaryButton}"
                                        Command="{Binding InstallOrUpdateBepInExCommand}"
                                        IsEnabled="{Binding IsLoadingBepInEx, Converter={StaticResource InverseBoolConverter}}"/>

                                <Button Grid.Column="4"
                                        Content="{DynamicResource String_UninstallBepInExBtn}"
                                        Style="{StaticResource DangerButton}"
                                        Command="{Binding UninstallBepInExCommand}"
                                        IsEnabled="{Binding IsBepInExInstalled}"/>

                                <Button Grid.Column="6"
                                        Content="{DynamicResource String_OpenBepInExFolderBtn}"
                                        Style="{StaticResource SecondaryButton}"
                                        Command="{Binding OpenBepInExFolderCommand}"
                                        IsEnabled="{Binding IsBepInExInstalled}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ═══ STEAM WORKSHOP INTEGRATION BAR ═══ -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,18"
                            Visibility="{Binding HasWorkshopSupport, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                    <TextBlock Text="{DynamicResource String_WorkshopAvailableTitle}" Style="{StaticResource H3}"/>
                                    <Border Background="{StaticResource InfoBgBrush}" BorderBrush="{StaticResource InfoBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusXs}" Padding="5,1" Margin="8,0,0,0">
                                        <TextBlock Text="Community Hub" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource InfoBrush}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{DynamicResource String_WorkshopAvailableDesc}"
                                           Style="{StaticResource Caption}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="{DynamicResource String_BrowseWorkshopBtn}" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"
                                        Command="{Binding OpenSteamWorkshopInBrowserCommand}"/>
                                <Button Content="{DynamicResource String_DownloadWorkshopModBtn}" Style="{StaticResource PrimaryButton}"
                                        Command="{Binding OpenWorkshopModalCommand}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ═══ INSTALLED MODS & PACKAGES ═══ -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{DynamicResource String_InstalledModsTitle}" Style="{StaticResource H2}"/>
                                    <TextBlock Text="{Binding ModsDirectoryPath, StringFormat='Mods folder: {0}'}" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="{DynamicResource String_OpenFolder}" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Command="{Binding OpenModsFolderCommand}"/>
                                    <Button Content="{DynamicResource String_InstallModFileBtn}" Style="{StaticResource PrimaryButton}" Command="{Binding InstallModFileCommand}"/>
                                </StackPanel>
                            </Grid>

                            <!-- Empty Mods Notice -->
                            <Border Background="{StaticResource SurfaceInputBrush}" CornerRadius="{StaticResource RadiusMd}"
                                    Padding="24" Margin="0,0,0,0"
                                    Visibility="{Binding InstalledMods.Count, Converter={StaticResource ZeroToVisibilityConverter}}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="{DynamicResource String_NoModsInstalled}" Style="{StaticResource BodyMedium}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                    <TextBlock Text="{DynamicResource String_NoModsInstalledDesc}"
                                               Style="{StaticResource Caption}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Mods List -->
                            <ItemsControl ItemsSource="{Binding InstalledMods}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource SurfaceInputBrush}"
                                                BorderBrush="{StaticResource SubtleBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="{StaticResource RadiusMd}"
                                                Padding="16,12"
                                                Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="14"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Mod Title & Category -->
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource BodyMedium}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Category}" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                                                </StackPanel>

                                                <!-- Switch Toggle (Enable / Disable) -->
                                                <CheckBox Grid.Column="1"
                                                          Style="{StaticResource ToggleSwitch}"
                                                          IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                                          ToolTip="Enable / Disable mod"
                                                          Command="{Binding DataContext.ToggleModCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                          CommandParameter="{Binding}"/>

                                                <!-- Delete Button -->
                                                <Button Grid.Column="3"
                                                        Style="{StaticResource DangerButton}"
                                                        Width="34" Height="34" Padding="0"
                                                        ToolTip="Delete mod"
                                                        VerticalAlignment="Center"
                                                        HorizontalContentAlignment="Center"
                                                        VerticalContentAlignment="Center"
                                                        Command="{Binding DataContext.DeleteModCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                        CommandParameter="{Binding}">
                                                    <Path Data="{StaticResource IconTrash}"
                                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                          Stretch="Uniform"
                                                          Width="14" Height="14"
                                                          IsHitTestVisible="False"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                 </ItemsControl.ItemTemplate>
                             </ItemsControl>
                         </StackPanel>
                     </Border>
                 </StackPanel>

                 <!-- ── 5. EMULATOR TAB ── -->
                 <StackPanel Visibility="{Binding SelectedTab, Converter={StaticResource StringMatchToVisibilityConverter}, ConverterParameter=Emulator}">
                     
                     <!-- ═══ GAME NOT INSTALLED WARNING BANNER ═══ -->
                     <Border Margin="0,0,0,18" CornerRadius="{StaticResource RadiusMd}"
                             Background="{StaticResource WarningBgBrush}"
                             BorderBrush="{StaticResource WarningBrush}"
                             BorderThickness="1.5"
                             Padding="18,14"
                             Visibility="{Binding IsInstalled, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                         <Grid>
                             <Grid.ColumnDefinitions>
                                 <ColumnDefinition Width="Auto"/>
                                 <ColumnDefinition Width="*"/>
                             </Grid.ColumnDefinitions>
                             <TextBlock Grid.Column="0" Text="⚠" FontSize="22" Foreground="{StaticResource WarningBrush}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                             <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                 <TextBlock Text="{DynamicResource String_GameNotInstalledWarnTitle}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource WarningBrush}" Margin="0,0,0,2"/>
                                 <TextBlock Text="{DynamicResource String_GameNotInstalledWarnDesc}"
                                            Style="{StaticResource BodySmall}" Foreground="{StaticResource PrimaryTextBrush}"/>
                             </StackPanel>
                         </Grid>
                     </Border>

                    <!-- ═══ EMULATOR DEPLOYMENT PROGRESS BAR (NON-INSTANTANEOUS) ═══ -->
                    <Border Margin="0,0,0,18" CornerRadius="{StaticResource RadiusMd}"
                            Background="{StaticResource SurfaceCardElevatedBrush}"
                            BorderBrush="{StaticResource AccentBrush}"
                            BorderThickness="1.5"
                            Padding="18,14"
                            Visibility="{Binding IsDeployProgressVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="⏳ " FontSize="13"/>
                                    <TextBlock Text="{Binding DeployProgressMessage}" Style="{StaticResource BodyMedium}" FontWeight="SemiBold"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding DeployProgress, StringFormat='{}{0:F0}%'}" Style="{StaticResource CaptionBold}" Foreground="{StaticResource AccentBrush}" FontSize="13"/>
                            </Grid>
                            <ProgressBar Value="{Binding DeployProgress}" Maximum="100" Height="8"
                                         Foreground="{StaticResource AccentBrush}"
                                         Background="{StaticResource SurfaceInputBrush}"
                                         BorderThickness="0"/>
                        </StackPanel>
                    </Border>

                    <!-- ═══ REFIX UPDATE AVAILABLE BANNER ═══ -->
                    <Border Margin="0,0,0,18" CornerRadius="{StaticResource RadiusMd}"
                            Background="{StaticResource WarningBgBrush}"
                            BorderBrush="{StaticResource WarningBrush}"
                            BorderThickness="1.5"
                            Padding="18,14"
                            Visibility="{Binding IsReFixUpdateAvailableForInstance, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="{DynamicResource String_ReFixUpdateAvailableTitle}"
                                               FontWeight="Bold" FontSize="14"
                                               Foreground="{StaticResource WarningBrush}"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource BodySmall}" Foreground="{StaticResource PrimaryTextBrush}">
                                    <Run Text="The launcher's ReFix suite has been updated to v"/>
                                    <Run Text="{Binding CurrentGlobalReFixVersion}" FontWeight="Bold" Foreground="{StaticResource WarningBrush}"/>
                                    <Run Text=". This instance has version v"/>
                                    <Run Text="{Binding InstanceReFixVersion}" FontWeight="Bold"/>
                                    <Run Text=" installed. Click the button to apply the update with 1 click."/>
                                </TextBlock>
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Content="{Binding ReFixUpdateButtonText}"
                                    Style="{StaticResource PrimaryButton}"
                                    Background="{StaticResource WarningBrush}"
                                    Padding="16,10"
                                    VerticalAlignment="Center"
                                    Command="{Binding UpdateInstanceReFixCommand}"
                                    IsEnabled="{Binding CanDeployEmulator}"/>
                        </Grid>
                    </Border>

                    <!-- ═══ 1. CURRENTLY INSTALLED EMULATOR CARD (EMULATOR STATUS) ═══ -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,18"
                            BorderBrush="{StaticResource AccentBrush}" BorderThickness="1.5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="{DynamicResource String_EmulatorStatusTitle}" Style="{StaticResource H2}"/>
                                    <Border Margin="12,0,0,0" VerticalAlignment="Center" CornerRadius="{StaticResource RadiusXs}" Padding="8,3">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource SurfaceInputBrush}"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEmulatorInstalled}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource SuccessBgBrush}"/>
                                                        <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="12" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Body}">
                                                    <Setter Property="Text" Value="Not Installed"/>
                                                    <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEmulatorInstalled}" Value="True">
                                                            <Setter Property="Text" Value="{Binding InstalledEmulatorMode, StringFormat='Installed: {0}', FallbackValue='Installed'}"/>
                                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{DynamicResource String_EmulatorStatusDesc}"
                                           Style="{StaticResource Caption}"/>
                            </StackPanel>

                            <!-- Uninstall / Restore Action -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="{DynamicResource String_UninstallEmulatorBtn}"
                                        Style="{StaticResource DangerButton}"
                                        Padding="14,9"
                                        Command="{Binding UninstallEmulatorCommand}"
                                        IsEnabled="{Binding IsEmulatorInstalled}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ═══ 2. ACTIVE INSTALLED FIX LAYERS STACK (POSITIONED DIRECTLY BELOW EMULATOR STATUS) ═══ -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,18"
                            BorderBrush="#8B5CF6" BorderThickness="1.5"
                            Visibility="{Binding HasInstalledFixLayers, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="{DynamicResource String_ActiveFixLayersTitle}" Style="{StaticResource H2}"/>
                                <Border Background="{StaticResource SuccessBgBrush}" BorderBrush="{StaticResource SuccessBrush}" BorderThickness="1"
                                        CornerRadius="{StaticResource RadiusXs}" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding NonOnlineInstalledFixLayers.Count, StringFormat='{}{0} Stacked Layers'}"
                                               FontSize="11" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{DynamicResource String_ActiveFixLayersDesc}"
                                       Style="{StaticResource Caption}" Margin="0,0,0,16"/>

                            <ItemsControl ItemsSource="{Binding NonOnlineInstalledFixLayers}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource SurfaceInputBrush}"
                                                BorderBrush="{StaticResource SubtleBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="{StaticResource RadiusMd}"
                                                Padding="16,12" Margin="0,0,0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                        <TextBlock Text="{Binding DisplayName}" Style="{StaticResource BodyMedium}" FontWeight="Bold" Margin="0,0,10,0"/>
                                                        <Border Background="{StaticResource AccentBgBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusXs}" Padding="6,2" Margin="0,0,8,0">
                                                            <TextBlock Text="{Binding TagsSummary}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding DeployedFiles.Count, StringFormat='📁 {0} managed files'}" Style="{StaticResource Caption}" Margin="0,0,14,0"/>
                                                        <TextBlock Text="{Binding InstalledAt, StringFormat='🕒 Installed: {0:yyyy-MM-dd HH:mm}'}" Style="{StaticResource Caption}" Foreground="{StaticResource MutedTextBrush}"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Uninstall Layer Button -->
                                                <Button Grid.Column="1"
                                                        Content="{DynamicResource String_UninstallLayerBtn}"
                                                        Style="{StaticResource DangerButton}"
                                                        Padding="14,8"
                                                        VerticalAlignment="Center"
                                                        Command="{Binding DataContext.UninstallFixLayerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        IsEnabled="{Binding DataContext.IsDeployingGameFix, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource InverseBoolConverter}}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- ═══ 3. TOP COMMUNITY RECOMMENDED BLOCK (HIGHLIGHTED) ═══ -->
                    <Border Margin="0,0,0,18" CornerRadius="{StaticResource RadiusMd}"
                            Background="{StaticResource AccentBgBrush}"
                            BorderBrush="{StaticResource AccentBrush}"
                            BorderThickness="1.5"
                            Padding="20"
                            Visibility="{Binding RecommendedEmulatorOption, Converter={StaticResource NullToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Border Background="{StaticResource AccentBrush}" CornerRadius="{StaticResource RadiusXs}" Padding="8,3" Margin="0,0,10,0">
                                        <TextBlock Text="{DynamicResource String_CommunityRecommendedBadge}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource InverseTextBrush}"/>
                                    </Border>
                                    <Border Background="{StaticResource SuccessBgBrush}" BorderBrush="{StaticResource SuccessBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusXs}" Padding="8,3"
                                            Visibility="{Binding RecommendedEmulatorOption.HasEnoughVotesForScore, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="{Binding RecommendedEmulatorOption.ScorePercentage, StringFormat='{}{0:F0}% success rate'}"
                                                   FontSize="11" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"/>
                                    </Border>
                                </StackPanel>

                                <TextBlock Text="{Binding RecommendedEmulatorOption.Name}" Style="{StaticResource H2}" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding RecommendedEmulatorOption.Description}" Style="{StaticResource Body}" Margin="0,0,0,10"/>

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding RecommendedEmulatorOption.PositiveVotes, StringFormat='👍 {0} upvotes'}"
                                               FontSize="12" Foreground="{StaticResource SuccessBrush}" Margin="0,0,14,0"/>
                                    <TextBlock Text="{Binding RecommendedEmulatorOption.NegativeVotes, StringFormat='👎 {0} downvotes'}"
                                               FontSize="12" Foreground="{StaticResource DangerBrush}" Margin="0,0,14,0"/>
                                    <TextBlock Text="{Binding RecommendedEmulatorOption.TotalVotes, StringFormat='(Total: {0} global votes)'}"
                                               FontSize="12" Foreground="{StaticResource MutedTextBrush}"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Green Shield with Checkmark (Tick) - Standalone Icon -->
                                <Viewbox Width="24" Height="24" Margin="0,0,14,0" Cursor="Hand" ToolTipService.InitialShowDelay="50" VerticalAlignment="Center">
                                    <Path Fill="{StaticResource SuccessBrush}"
                                          Data="M12 2L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-3zm-2 15l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"/>
                                    <Viewbox.ToolTip>
                                        <ToolTip Background="{StaticResource SurfaceCardElevatedBrush}" BorderBrush="{StaticResource SuccessBrush}" BorderThickness="1.5" Padding="14,10">
                                            <StackPanel MaxWidth="340">
                                                <TextBlock Text="Safe &amp; Verified Emulator" FontWeight="Bold" FontSize="13" Foreground="{StaticResource SuccessBrush}" Margin="0,0,0,6" TextWrapping="Wrap"/>
                                                <TextBlock Text="• 100% Open-source codebase" Style="{StaticResource Caption}" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,3" TextWrapping="Wrap"/>
                                                <TextBlock Text="• Passed clean tests across major antivirus vendors" Style="{StaticResource Caption}" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,3" TextWrapping="Wrap"/>
                                                <TextBlock Text="• Rare to zero false-positive detections" Style="{StaticResource Caption}" Foreground="{StaticResource PrimaryTextBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </ToolTip>
                                    </Viewbox.ToolTip>
                                </Viewbox>

                                <Button Content="⚡ Install Recommended Option"
                                        Style="{StaticResource PrimaryButton}"
                                        Padding="18,12"
                                        Command="{Binding DeployEmulatorOptionCommand}"
                                        CommandParameter="{Binding RecommendedEmulatorOption}"
                                        IsEnabled="{Binding CanDeployEmulator}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ═══ 4. ALL REFIX EMULATOR OPTIONS LIST ═══ -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource String_AvailableEmulationOptionsTitle}" Style="{StaticResource H2}" Margin="0,0,0,4"/>
                            <TextBlock Text="{DynamicResource String_AvailableEmulationOptionsDesc}"
                                       Style="{StaticResource Caption}" Margin="0,0,0,16"/>

                            <ItemsControl ItemsSource="{Binding AvailableEmulatorOptions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource SurfaceInputBrush}"
                                                BorderBrush="{StaticResource SubtleBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="{StaticResource RadiusMd}"
                                                Padding="16,14" Margin="0,0,0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                        <TextBlock Text="{Binding Name}" Style="{StaticResource BodyMedium}" FontWeight="Bold" Margin="0,0,10,0"/>
                                                        <Border Background="{StaticResource InfoBgBrush}" BorderBrush="{StaticResource InfoBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusXs}" Padding="6,2" Margin="0,0,8,0">
                                                            <TextBlock Text="{Binding BadgeText}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource InfoBrush}"/>
                                                        </Border>
                                                        <Border Background="{StaticResource SurfaceCardBrush}" CornerRadius="{StaticResource RadiusXs}" Padding="6,2"
                                                                Visibility="{Binding HasEnoughVotesForScore, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <TextBlock Text="{Binding ScorePercentage, StringFormat='{}{0:F0}% Positive'}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"/>
                                                        </Border>
                                                    </StackPanel>

                                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" Margin="0,0,0,8" TextWrapping="Wrap"/>

                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding PositiveVotes, StringFormat='👍 {0}'}" FontSize="11" Foreground="{StaticResource SuccessBrush}" Margin="0,0,12,0"/>
                                                        <TextBlock Text="{Binding NegativeVotes, StringFormat='👎 {0}'}" FontSize="11" Foreground="{StaticResource DangerBrush}" Margin="0,0,12,0"/>
                                                        <TextBlock Text="{Binding TotalVotes, StringFormat='({0} ratings)'}" FontSize="11" Foreground="{StaticResource MutedTextBrush}"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Action Area: Standalone Green Shield Icon + Install Button -->
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <!-- Green Shield with Checkmark (Tick) - Standalone Icon -->
                                                    <Viewbox Width="20" Height="20" Margin="0,0,12,0" Cursor="Hand" ToolTipService.InitialShowDelay="50" VerticalAlignment="Center">
                                                        <Path Fill="{StaticResource SuccessBrush}"
                                                              Data="M12 2L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-3zm-2 15l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"/>
                                                        <Viewbox.ToolTip>
                                                            <ToolTip Background="{StaticResource SurfaceCardElevatedBrush}" BorderBrush="{StaticResource SuccessBrush}" BorderThickness="1.5" Padding="14,10">
                                                                <StackPanel MaxWidth="340">
                                                                    <TextBlock Text="Safe &amp; Verified Emulator" FontWeight="Bold" FontSize="13" Foreground="{StaticResource SuccessBrush}" Margin="0,0,0,6" TextWrapping="Wrap"/>
                                                                    <TextBlock Text="• 100% Open-source codebase" Style="{StaticResource Caption}" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,3" TextWrapping="Wrap"/>
                                                                    <TextBlock Text="• Passed clean tests across major antivirus vendors" Style="{StaticResource Caption}" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,3" TextWrapping="Wrap"/>
                                                                    <TextBlock Text="• Rare to zero false-positive detections" Style="{StaticResource Caption}" Foreground="{StaticResource PrimaryTextBrush}" TextWrapping="Wrap"/>
                                                                </StackPanel>
                                                            </ToolTip>
                                                        </Viewbox.ToolTip>
                                                    </Viewbox>

                                                    <Button Content="{DynamicResource String_Install}"
                                                            Style="{StaticResource SecondaryButton}"
                                                            Padding="16,9"
                                                            Command="{Binding DataContext.DeployEmulatorOptionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"
                                                            IsEnabled="{Binding DataContext.CanDeployEmulator, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- ═══ 5. SPECIFIC EMULATORS & GAME FIXES (CATEGORIZED: ONLINE, BYPASS, HYPERVISOR) ═══ -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,0"
                            Visibility="{Binding IsSpecificFixesSectionVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource String_GameSpecificFixesTitle}" Style="{StaticResource H2}"/>
                                    <TextBlock Text="{DynamicResource String_GameSpecificFixesDesc}"
                                               Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>

                            <Separator Margin="0,12,0,16" Background="{StaticResource SubtleBorderBrush}"/>

                            <!-- Loading State -->
                            <StackPanel Visibility="{Binding IsLoadingGameFixes, Converter={StaticResource BoolToVisibilityConverter}}"
                                        HorizontalAlignment="Center" Margin="0,16">
                                <TextBlock Text="{DynamicResource String_CheckingAvailableFixes}"
                                           Style="{StaticResource BodyMedium}" Foreground="{StaticResource MutedTextBrush}"/>
                            </StackPanel>

                            <!-- Error State -->
                            <Border Visibility="{Binding HasGameFixesError, Converter={StaticResource BoolToVisibilityConverter}}"
                                    Background="{StaticResource DangerBgBrush}" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusMd}" Padding="16,12" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{DynamicResource String_CouldNotLoadFixes}" FontWeight="Bold" Foreground="{StaticResource DangerBrush}"/>
                                        <TextBlock Text="{Binding GameFixesErrorMessage}" Style="{StaticResource Caption}" Foreground="{StaticResource PrimaryTextBrush}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="{DynamicResource String_RetryAction}" Style="{StaticResource SecondaryButton}"
                                            Padding="12,6" Command="{Binding LoadGameFixesCommand}"/>
                                </Grid>
                            </Border>

                            <!-- ── 5A. ONLINE MULTIPLAYER EMULATORS ── -->
                            <StackPanel Visibility="{Binding HasOnlineGameFixes, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,6,0,16">
                                <TextBlock Text="{DynamicResource String_OnlineMultiplayerEmulatorsTitle}" Style="{StaticResource BodyMedium}" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="{DynamicResource String_OnlineMultiplayerEmulatorsDesc}"
                                           Style="{StaticResource Caption}" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,10"/>

                                <ItemsControl ItemsSource="{Binding OnlineGameFixes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource SurfaceInputBrush}"
                                                    BorderBrush="{StaticResource SubtleBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="{StaticResource RadiusMd}"
                                                    Padding="16,14" Margin="0,0,0,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                            <TextBlock Text="{Binding Name}" Style="{StaticResource BodyMedium}" FontWeight="Bold" Margin="0,0,10,0"/>
                                                            <Border Background="{StaticResource AccentBgBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusXs}" Padding="6,2" Margin="0,0,8,0">
                                                                <TextBlock Text="ONLINE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                                            </Border>
                                                            <!-- Score Percentage Badge if enough votes -->
                                                            <Border Background="{StaticResource SurfaceCardBrush}" CornerRadius="{StaticResource RadiusXs}" Padding="6,2" Margin="0,0,8,0"
                                                                    Visibility="{Binding HasEnoughVotesForScore, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                <TextBlock Text="{Binding ScorePercentage, StringFormat='{}{0:F0}% Positive'}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"/>
                                                            </Border>
                                                        </StackPanel>

                                                        <TextBlock Text="{Binding Description, FallbackValue='Specific online multiplayer fix for this game.'}"
                                                                   Style="{StaticResource Caption}" Margin="0,0,0,6" TextWrapping="Wrap"/>

                                                        <!-- Community Ratings Stats (Read-Only on card; votes submitted via game exit feedback modal) -->
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding PositiveVotes, StringFormat='👍 {0}'}" FontSize="11" Foreground="{StaticResource SuccessBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding NegativeVotes, StringFormat='👎 {0}'}" FontSize="11" Foreground="{StaticResource DangerBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding TotalVotes, StringFormat='({0} ratings)'}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <!-- Action Area: Standalone Orange Shield Icon + Install Online Fix Button -->
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <!-- Orange Shield with Exclamation Mark (!) - Standalone Icon -->
                                                        <Viewbox Width="20" Height="20" Margin="0,0,12,0" Cursor="Hand" ToolTipService.InitialShowDelay="50" VerticalAlignment="Center">
                                                            <Path Fill="{StaticResource WarningBrush}"
                                                                  Data="M12 2L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-3zm1 14h-2v-2h2v2zm0-4h-2V7h2v5z"/>
                                                            <Viewbox.ToolTip>
                                                                <ToolTip Background="{StaticResource SurfaceCardElevatedBrush}" BorderBrush="{StaticResource WarningBrush}" BorderThickness="1.5" Padding="14,10">
                                                                    <StackPanel MaxWidth="340">
                                                                        <TextBlock Text="Third-Party Closed-Source Fix" FontWeight="Bold" FontSize="13" Foreground="{StaticResource WarningBrush}" Margin="0,0,0,6" TextWrapping="Wrap"/>
                                                                        <TextBlock Text="• Highly popular &amp; widely used by the community" Style="{StaticResource Caption}" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" Margin="0,0,0,3" TextWrapping="Wrap"/>
                                                                        <TextBlock Text="• Closed-source third-party binaries" Style="{StaticResource Caption}" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,3" TextWrapping="Wrap"/>
                                                                        <TextBlock Text="• Code is obfuscated / packed" Style="{StaticResource Caption}" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,3" TextWrapping="Wrap"/>
                                                                        <TextBlock Text="• Requires Windows Defender exclusion to function" Style="{StaticResource Caption}" Foreground="{StaticResource PrimaryTextBrush}" TextWrapping="Wrap"/>
                                                                    </StackPanel>
                                                                </ToolTip>
                                                            </Viewbox.ToolTip>
                                                        </Viewbox>

                                                        <Button Content="{DynamicResource String_InstallOnlineFixBtn}"
                                                                Style="{StaticResource PrimaryButton}"
                                                                Padding="16,9"
                                                                Command="{Binding DataContext.DeployGameFixCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}"
                                                                IsEnabled="{Binding DataContext.CanDeployEmulator, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- ── 5B. DRM & LICENSE BYPASS LAYERS ── -->
                            <StackPanel Visibility="{Binding HasBypassGameFixes, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,0,0,16">
                                <TextBlock Text="{DynamicResource String_DrmBypassLayersTitle}" Style="{StaticResource BodyMedium}" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="{DynamicResource String_DrmBypassLayersDesc}"
                                           Style="{StaticResource Caption}" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,10"/>

                                <ItemsControl ItemsSource="{Binding BypassGameFixes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource SurfaceInputBrush}"
                                                    BorderBrush="{StaticResource SubtleBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="{StaticResource RadiusMd}"
                                                    Padding="16,14" Margin="0,0,0,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                            <TextBlock Text="{Binding Name}" Style="{StaticResource BodyMedium}" FontWeight="Bold" Margin="0,0,10,0"/>
                                                            <Border Background="{StaticResource AccentBgBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusXs}" Padding="6,2" Margin="0,0,8,0">
                                                                <TextBlock Text="BYPASS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                                            </Border>
                                                        </StackPanel>

                                                        <TextBlock Text="{Binding Description, FallbackValue='DRM / license bypass layer for this game.'}"
                                                                   Style="{StaticResource Caption}" Margin="0,0,0,0" TextWrapping="Wrap"/>
                                                    </StackPanel>

                                                    <!-- Install Button -->
                                                    <Button Grid.Column="1"
                                                            Content="{DynamicResource String_InstallBypassBtn}"
                                                            Style="{StaticResource SecondaryButton}"
                                                            Padding="16,9"
                                                            VerticalAlignment="Center"
                                                            Command="{Binding DataContext.DeployGameFixCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"
                                                            IsEnabled="{Binding DataContext.CanDeployEmulator, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- ── 5C. HYPERVISOR & ANTI-CHEAT LAYERS ── -->
                            <StackPanel Visibility="{Binding HasHypervisorGameFixes, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,0,0,16">
                                <TextBlock Text="{DynamicResource String_HypervisorLayersTitle}" Style="{StaticResource BodyMedium}" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="{DynamicResource String_HypervisorLayersDesc}"
                                           Style="{StaticResource Caption}" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,10"/>

                                <ItemsControl ItemsSource="{Binding HypervisorGameFixes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource SurfaceInputBrush}"
                                                    BorderBrush="{StaticResource SubtleBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="{StaticResource RadiusMd}"
                                                    Padding="16,14" Margin="0,0,0,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                            <TextBlock Text="{Binding Name}" Style="{StaticResource BodyMedium}" FontWeight="Bold" Margin="0,0,10,0"/>
                                                            <Border Background="{StaticResource AccentBgBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusXs}" Padding="6,2" Margin="0,0,8,0">
                                                                <TextBlock Text="HYPERVISOR" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                                            </Border>
                                                        </StackPanel>

                                                        <TextBlock Text="{Binding Description, FallbackValue='Hypervisor-level fix layer for this game.'}"
                                                                   Style="{StaticResource Caption}" Margin="0,0,0,0" TextWrapping="Wrap"/>
                                                    </StackPanel>

                                                    <!-- Install Button -->
                                                    <Button Grid.Column="1"
                                                            Content="{DynamicResource String_InstallHypervisorBtn}"
                                                            Style="{StaticResource SecondaryButton}"
                                                            Padding="16,9"
                                                            VerticalAlignment="Center"
                                                            Command="{Binding DataContext.DeployGameFixCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"
                                                            IsEnabled="{Binding DataContext.CanDeployEmulator, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- ── 5D. OTHER CUSTOM FIXES ── -->
                            <StackPanel Visibility="{Binding HasOtherGameFixes, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="{DynamicResource String_OtherCustomFixesTitle}" Style="{StaticResource BodyMedium}" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,10"/>
                                <ItemsControl ItemsSource="{Binding OtherGameFixes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource SurfaceInputBrush}"
                                                    BorderBrush="{StaticResource SubtleBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="{StaticResource RadiusMd}"
                                                    Padding="16,14" Margin="0,0,0,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                            <TextBlock Text="{Binding Name}" Style="{StaticResource BodyMedium}" FontWeight="Bold" Margin="0,0,10,0"/>
                                                            <Border Background="{StaticResource AccentBgBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusXs}" Padding="6,2" Margin="0,0,8,0">
                                                                <TextBlock Text="{Binding TagsSummary}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                                            </Border>
                                                        </StackPanel>

                                                        <TextBlock Text="{Binding Description, FallbackValue='Custom game fix layer.'}"
                                                                   Style="{StaticResource Caption}" Margin="0,0,0,0" TextWrapping="Wrap"/>
                                                    </StackPanel>

                                                    <!-- Install Button -->
                                                    <Button Grid.Column="1"
                                                            Content="{DynamicResource String_InstallFixBtn}"
                                                            Style="{StaticResource SecondaryButton}"
                                                            Padding="16,9"
                                                            VerticalAlignment="Center"
                                                            Command="{Binding DataContext.DeployGameFixCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"
                                                            IsEnabled="{Binding DataContext.CanDeployEmulator, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ── 6. SETTINGS TAB ── -->
                <StackPanel Visibility="{Binding SelectedTab, Converter={StaticResource StringMatchToVisibilityConverter}, ConverterParameter=Settings}">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource String_InstanceConfigTitle}" Style="{StaticResource H2}" Margin="0,0,0,16"/>

                            <TextBlock Text="{DynamicResource String_InstanceAliasLabel}" Style="{StaticResource CaptionBold}" Margin="0,0,0,6"/>
                            <TextBox Style="{StaticResource DarkTextBox}" Text="{Binding InstanceAlias, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16"/>

                            <TextBlock Text="{DynamicResource String_PrimaryExecutableLabel}" Style="{StaticResource CaptionBold}" Margin="0,0,0,6"/>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Style="{StaticResource DarkTextBox}" Text="{Binding ConfiguredExecutablePath, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Grid.Column="2" Content="{DynamicResource String_BrowseDirBtn}" Style="{StaticResource SecondaryButton}" Command="{Binding BrowseExecutableCommand}"/>
                            </Grid>

                            <TextBlock Text="{DynamicResource String_CustomLaunchArgsLabel}" Style="{StaticResource CaptionBold}" Margin="0,0,0,6"/>
                            <TextBox Style="{StaticResource DarkTextBox}" Text="{Binding CustomLaunchArgs, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,20"/>

                            <Button Content="{DynamicResource String_SaveSettingsAliasBtn}" Style="{StaticResource PrimaryButton}" Padding="20,10" HorizontalAlignment="Left" Command="{Binding SaveSettingsCommand}"/>
                        </StackPanel>
                    </Border>

                    <!-- Danger Zone & Storage Management -->
                    <Border Style="{StaticResource Card}" Margin="0,20,0,0" BorderBrush="{StaticResource DangerBorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource String_DangerZoneTitle}" Style="{StaticResource H2}" Foreground="{StaticResource DangerBrush}" Margin="0,0,0,8"/>
                            <TextBlock Text="{DynamicResource String_DangerZoneDesc}"
                                       Style="{StaticResource BodySmall}" Margin="0,0,0,16"/>

                            <WrapPanel Orientation="Horizontal">
                                <!-- Uninstall Game Files (Keeps instance in BlueStar) -->
                                <Button Content="{DynamicResource String_UninstallGameFilesBtn}"
                                        Style="{StaticResource SecondaryButton}"
                                        BorderBrush="{StaticResource DangerBrush}"
                                        Foreground="{StaticResource DangerBrush}"
                                        Padding="18,10"
                                        Margin="0,0,12,8"
                                        Command="{Binding OpenUninstallModalCommand}"/>

                                <!-- Delete Instance Entirely -->
                                <Button Content="{DynamicResource String_DeleteInstanceEntirelyBtn}"
                                        Style="{StaticResource DangerButton}"
                                        Padding="18,10"
                                        Margin="0,0,0,8"
                                        Command="{Binding OpenDeleteModalCommand}"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ── 6. PREREQUISITES TAB ── -->
                <StackPanel Visibility="{Binding SelectedTab, Converter={StaticResource StringMatchToVisibilityConverter}, ConverterParameter=Prerequisites}">
                    <!-- Top Action / Info Banner -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{DynamicResource String_PrerequisitesInstallerTitle}" Style="{StaticResource H2}" Margin="0,0,0,4"/>
                                <TextBlock Text="{DynamicResource String_PrerequisitesInstallerDesc}"
                                           Style="{StaticResource Body}" Foreground="{StaticResource SecondaryTextBrush}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="{DynamicResource String_ReScanBtn}"
                                        Style="{StaticResource SecondaryButton}"
                                        Margin="0,0,10,0"
                                        Command="{Binding ScanPrerequisitesCommand}"
                                        IsEnabled="{Binding IsInstallingPrerequisites, Converter={StaticResource InverseBoolConverter}}"/>

                                <Button Content="{DynamicResource String_InstallAllPrerequisitesBtn}"
                                        Style="{StaticResource PrimaryButton}"
                                        Command="{Binding InstallAllPrerequisitesCommand}"
                                        IsEnabled="{Binding IsInstallingPrerequisites, Converter={StaticResource InverseBoolConverter}}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Prerequisites List -->
                    <ItemsControl ItemsSource="{Binding Prerequisites}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Left Info -->
                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource H3}" Margin="0,0,10,0"/>
                                                <Border CornerRadius="{StaticResource RadiusSm}"
                                                        Padding="8,2"
                                                        Background="{Binding Status, Converter={StaticResource PrerequisiteStatusToBgBrushConverter}}">
                                                    <TextBlock Text="{Binding Status, Converter={StaticResource PrerequisiteStatusToTextConverter}}"
                                                               FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{Binding Status, Converter={StaticResource PrerequisiteStatusToBrushConverter}}"/>
                                                </Border>
                                            </StackPanel>

                                            <TextBlock Text="{Binding Description}" Style="{StaticResource Body}" Margin="0,0,0,6"/>

                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{DynamicResource String_CategoryLabel}" Style="{StaticResource Caption}" Foreground="{StaticResource MutedTextBrush}"/>
                                                <TextBlock Text="{Binding Category}" Style="{StaticResource CaptionBold}" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,16,0"/>

                                                <TextBlock Text="{DynamicResource String_LocationLabel}" Style="{StaticResource Caption}" Foreground="{StaticResource MutedTextBrush}"/>
                                                <TextBlock Text="{Binding LocalInstallerPath, FallbackValue='Official Microsoft Direct Download', TargetNullValue='Official Microsoft Direct Download'}"
                                                           Style="{StaticResource Caption}" Foreground="{StaticResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Right Action Button -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <Button Content="{DynamicResource String_Install}"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Padding="16,8"
                                                    Command="{Binding DataContext.InstallPrerequisiteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    IsEnabled="{Binding DataContext.IsInstallingPrerequisites, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource InverseBoolConverter}}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- ── 7. LOGS TAB ── -->
                <StackPanel Visibility="{Binding SelectedTab, Converter={StaticResource StringMatchToVisibilityConverter}, ConverterParameter=Logs}">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource String_LiveLogsTitle}" Style="{StaticResource H2}"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="{DynamicResource String_CopyLogsBtn}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Command="{Binding CopyLogsCommand}"/>
                                    <Button Content="{DynamicResource String_ClearLogsBtn}" Style="{StaticResource GhostButton}" Command="{Binding ClearLogsCommand}"/>
                                </StackPanel>
                            </Grid>

                            <Border Background="{StaticResource SurfaceInputBrush}" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusMd}" Padding="12" Height="380">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding ConsoleLogs}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" Style="{StaticResource MonospaceText}" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- ═══ SHORTCUT MODAL DIALOG OVERLAY ═══ -->
        <Grid Visibility="{Binding IsShortcutModalOpen, Converter={StaticResource BoolToVisibilityConverter}}"
              Background="{StaticResource ModalOverlayBrush}">
            <Border Background="{StaticResource SurfaceCardElevatedBrush}"
                    BorderBrush="{StaticResource AccentBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusLg}"
                    Padding="28" Width="520"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource String_CreateShortcutsModalTitle}" Style="{StaticResource H2}"/>
                        <Button Grid.Column="1" Content="✕" Style="{StaticResource GhostButton}" Command="{Binding CloseShortcutModalCommand}"/>
                    </Grid>

                    <TextBlock Text="{DynamicResource String_ShortcutNameLabel}" Style="{StaticResource CaptionBold}" Margin="0,0,0,6"/>
                    <TextBox Style="{StaticResource DarkTextBox}" Text="{Binding ShortcutName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>

                    <TextBlock Text="{DynamicResource String_ExecutableFileLabel}" Style="{StaticResource CaptionBold}" Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" Style="{StaticResource DarkComboBox}" ItemsSource="{Binding AvailableExecutables}" SelectedItem="{Binding SelectedExecutable}"/>
                        <Button Grid.Column="2" Content="{DynamicResource String_BrowseDirBtn}" Style="{StaticResource SecondaryButton}" Command="{Binding BrowseExecutableCommand}"/>
                    </Grid>

                    <TextBlock Text="{DynamicResource String_ShortcutDestinationsLabel}" Style="{StaticResource CaptionBold}" Margin="0,0,0,8"/>
                    <CheckBox Content="{DynamicResource String_DesktopShortcutOption}" Style="{StaticResource DarkCheckBox}" IsChecked="{Binding CreateDesktopShortcut}" Margin="0,0,0,8"/>
                    <CheckBox Content="{DynamicResource String_StartMenuShortcutOption}" Style="{StaticResource DarkCheckBox}" IsChecked="{Binding CreateStartMenuShortcut}" Margin="0,0,0,8"/>
                    <CheckBox Content="{DynamicResource String_SteamLibraryShortcutOption}" Style="{StaticResource DarkCheckBox}" IsChecked="{Binding CreateSteamShortcut}" IsEnabled="{Binding IsSteamInstalled}" Margin="0,0,0,16"/>

                    <Border Background="{StaticResource SurfaceInputBrush}" CornerRadius="{StaticResource RadiusMd}" Padding="12,8" Margin="0,0,0,16" Visibility="{Binding ShortcutStatusMessage, Converter={StaticResource NullToVisibilityConverter}}">
                        <TextBlock Text="{Binding ShortcutStatusMessage}" Style="{StaticResource Caption}"/>
                    </Border>

                    <Button Content="{DynamicResource String_RestartSteamBtn}" Style="{StaticResource PrimaryButton}" Margin="0,0,0,14" Visibility="{Binding ShowRestartSteamButton, Converter={StaticResource BoolToVisibilityConverter}}" Command="{Binding RestartSteamCommand}"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="{DynamicResource String_Cancel}" Style="{StaticResource SecondaryButton}" Command="{Binding CloseShortcutModalCommand}"/>
                        <Button Grid.Column="2" Content="{DynamicResource String_CreatingShortcuts}" Style="{StaticResource PrimaryButton}" Command="{Binding CreateShortcutCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══ STEAM WORKSHOP DOWNLOAD MODAL OVERLAY ═══ -->
        <Grid Visibility="{Binding IsWorkshopModalOpen, Converter={StaticResource BoolToVisibilityConverter}}"
              Background="{StaticResource ModalOverlayBrush}">
            <Border Background="{StaticResource SurfaceCardElevatedBrush}"
                    BorderBrush="{StaticResource AccentBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusLg}"
                    Padding="28" Width="540"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <!-- Header -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🌐" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource String_WorkshopModalTitle}" Style="{StaticResource H2}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="✕" Style="{StaticResource GhostButton}" Command="{Binding CloseWorkshopModalCommand}"
                                IsEnabled="{Binding IsDownloadingWorkshopMod, Converter={StaticResource InverseBoolConverter}}"/>
                    </Grid>

                    <!-- Input Box -->
                    <TextBlock Text="{DynamicResource String_WorkshopUrlOrIdLabel}" Style="{StaticResource CaptionBold}" Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Style="{StaticResource DarkTextBox}"
                                 Text="{Binding WorkshopSearchInput, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="e.g. https://steamcommunity.com/sharedfiles/filedetails/?id=123456789"
                                 IsEnabled="{Binding IsDownloadingWorkshopMod, Converter={StaticResource InverseBoolConverter}}"/>
                        <Button Grid.Column="2" Content="{DynamicResource String_InspectBtn}"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding FetchWorkshopPreviewCommand}"
                                IsEnabled="{Binding IsLoadingWorkshopPreview, Converter={StaticResource InverseBoolConverter}}"/>
                    </Grid>

                    <!-- In-Modal Status / Error Notification Banner -->
                    <Border Background="{StaticResource DangerBgBrush}"
                            BorderBrush="{StaticResource DangerBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusSm}"
                            Padding="12,8" Margin="0,0,0,14"
                            Visibility="{Binding WorkshopStatusMessage, Converter={StaticResource NullToVisibilityConverter}}">
                        <TextBlock Text="{Binding WorkshopStatusMessage}"
                                   Foreground="{StaticResource DangerBrush}"
                                   FontSize="12"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <!-- Live Download Progress Section -->
                    <Border Background="{StaticResource SurfaceInputBrush}"
                            BorderBrush="{StaticResource AccentTranslucentBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusMd}"
                            Padding="14" Margin="0,0,0,16"
                            Visibility="{Binding IsDownloadingWorkshopMod, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding WorkshopDownloadStatusText}" Style="{StaticResource CaptionBold}" Foreground="{StaticResource AccentBrush}"/>
                                <TextBlock Grid.Column="1" Text="{Binding WorkshopDownloadProgress, StringFormat='{}{0:F0}%'}" Style="{StaticResource CaptionBold}" Foreground="{StaticResource AccentBrush}"/>
                            </Grid>
                            <ProgressBar Value="{Binding WorkshopDownloadProgress}" Maximum="100" Height="8" Style="{StaticResource DownloadProgressBar}"/>
                        </StackPanel>
                    </Border>

                    <!-- Preview Card -->
                    <Border Background="{StaticResource SurfaceInputBrush}"
                            BorderBrush="{StaticResource SubtleBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusMd}"
                            Padding="14" Margin="0,0,0,16"
                            Visibility="{Binding WorkshopPreviewItem, Converter={StaticResource NullToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="84"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Preview Image -->
                            <Border Grid.Column="0" CornerRadius="6" ClipToBounds="True" Height="84" Background="{StaticResource SurfaceCardBrush}">
                                <Image Source="{Binding WorkshopPreviewItem.PreviewUrl}" Stretch="UniformToFill"/>
                            </Border>

                            <!-- Details -->
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding WorkshopPreviewItem.Title}" Style="{StaticResource H3}" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding WorkshopPreviewItem.Author, StringFormat='Created by: {0}'}" Style="{StaticResource Caption}" Margin="0,0,0,2"/>
                                <TextBlock Text="{Binding WorkshopPreviewItem.PublishedFileId, StringFormat='Workshop ID: {0}'}" Style="{StaticResource Caption}" Foreground="{StaticResource SecondaryTextBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Action Buttons -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="{DynamicResource String_Cancel}" Style="{StaticResource SecondaryButton}" Command="{Binding CloseWorkshopModalCommand}"
                                IsEnabled="{Binding IsDownloadingWorkshopMod, Converter={StaticResource InverseBoolConverter}}"/>
                        <Button Grid.Column="2" Content="{DynamicResource String_DownloadInstallModBtn}"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding DownloadWorkshopModCommand}"
                                IsEnabled="{Binding WorkshopPreviewItem, Converter={StaticResource NullToVisibilityConverter}}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══ POST-GAME EMULATOR FEEDBACK MODAL OVERLAY ═══ -->
        <Grid Visibility="{Binding IsFeedbackModalOpen, Converter={StaticResource BoolToVisibilityConverter}}"
              Background="{StaticResource ModalOverlayBrush}">
            <Border Background="{StaticResource SurfaceCardElevatedBrush}"
                    BorderBrush="{StaticResource AccentBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusLg}"
                    Padding="28" Width="480"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource String_FeedbackModalTitle}" Style="{StaticResource H2}"/>
                            <TextBlock Text="BlueStar Community" Style="{StaticResource Caption}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="✕" Style="{StaticResource GhostButton}" Command="{Binding CloseFeedbackModalCommand}"/>
                    </Grid>

                    <!-- Feedback Question Block -->
                    <Border Background="{StaticResource SurfaceInputBrush}"
                            BorderBrush="{StaticResource SubtleBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusMd}"
                            Padding="16" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="{Binding FeedbackEmulatorName, StringFormat='Did the {0} emulator work properly for this game?'}"
                                       Style="{StaticResource BodyMedium}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <TextBlock Text="{DynamicResource String_FeedbackHelpCommunity}"
                                       Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Initial Yes / No Buttons (When uninstall prompt is not active) -->
                    <Grid Visibility="{Binding ShowFeedbackUninstallPrompt, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="{DynamicResource String_FeedbackYesWorked}"
                                Style="{StaticResource PrimaryButton}"
                                Padding="16,12"
                                Command="{Binding SubmitFeedbackPositiveCommand}"/>

                        <Button Grid.Column="2" Content="{DynamicResource String_FeedbackNoIssues}"
                                Style="{StaticResource DangerButton}"
                                Padding="16,12"
                                Command="{Binding SubmitFeedbackNegativeCommand}"/>
                    </Grid>

                    <!-- Negative Feedback Followup: Option to Uninstall & Try Another -->
                    <StackPanel Visibility="{Binding ShowFeedbackUninstallPrompt, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border Background="{StaticResource DangerBgBrush}"
                                BorderBrush="{StaticResource DangerBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusSm}"
                                Padding="12" Margin="0,0,0,16">
                            <TextBlock Text="{DynamicResource String_FeedbackFollowupDesc}"
                                       Foreground="{StaticResource DangerBrush}" FontSize="13" TextWrapping="Wrap"/>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Content="{DynamicResource String_FeedbackCancelKeep}"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="14,10"
                                    Command="{Binding CloseFeedbackModalCommand}"/>

                            <Button Grid.Column="2" Content="{DynamicResource String_FeedbackUninstallChange}"
                                    Style="{StaticResource DangerButton}"
                                    Padding="14,10"
                                    Command="{Binding UninstallFromFeedbackCommand}"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══ MODAL: INSTANCE DELETION CONFIRMATION ═══ -->
        <Grid Visibility="{Binding IsDeleteModalOpen, Converter={StaticResource BoolToVisibilityConverter}}"
              Background="{StaticResource ModalOverlayBrush}"
              HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border Background="{StaticResource SurfaceCardBrush}"
                    BorderBrush="{StaticResource SubtleBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusLg}"
                    Padding="28"
                    MaxWidth="540"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{DynamicResource String_DeleteModalTitle}" Style="{StaticResource H1}" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding Instance.Name, StringFormat='{}How would you like to delete {0}?'}"
                               Style="{StaticResource Body}" TextWrapping="Wrap" Margin="0,0,0,20"/>

                    <!-- Option 1: Only Unlink from BlueStar -->
                    <Border Background="{StaticResource SurfaceInputBrush}"
                            BorderBrush="{StaticResource SubtleBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusMd}"
                            Padding="16" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="{DynamicResource String_UnlinkFromBlueStarOnlyTitle}" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="{DynamicResource String_UnlinkFromBlueStarOnlyDesc}"
                                           Style="{StaticResource BodySmall}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="{DynamicResource String_UnlinkActionBtn}"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="16,9"
                                    VerticalAlignment="Center"
                                    Command="{Binding ConfirmDeleteInstanceCommand}"
                                    CommandParameter="false"
                                    IsEnabled="{Binding IsDeletingInstance, Converter={StaticResource InverseBoolConverter}}"/>
                        </Grid>
                    </Border>

                    <!-- Option 2: Delete Instance and Purge Data Files -->
                    <Border Background="{StaticResource DangerBgBrush}"
                            BorderBrush="{StaticResource DangerBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusMd}"
                            Padding="16" Margin="0,0,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="{DynamicResource String_DeleteInstanceAndPurgeTitle}" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource DangerBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="{DynamicResource String_DeleteInstanceAndPurgeDesc}"
                                           Style="{StaticResource BodySmall}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="{DynamicResource String_DeleteAllActionBtn}"
                                    Style="{StaticResource DangerButton}"
                                    Padding="16,9"
                                    VerticalAlignment="Center"
                                    Command="{Binding ConfirmDeleteInstanceCommand}"
                                    CommandParameter="true"
                                    IsEnabled="{Binding IsDeletingInstance, Converter={StaticResource InverseBoolConverter}}"/>
                        </Grid>
                    </Border>

                    <!-- Cancel Button -->
                    <Button Content="{DynamicResource String_Cancel}"
                            Style="{StaticResource GhostButton}"
                            HorizontalAlignment="Right"
                            Padding="18,8"
                            Command="{Binding CloseDeleteModalCommand}"
                            IsEnabled="{Binding IsDeletingInstance, Converter={StaticResource InverseBoolConverter}}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ══════════════════════════════════════════════════════════════
             UNINSTALL GAME FILES MODAL (Keeps instance in BlueStar)
             ══════════════════════════════════════════════════════════════ -->
        <Grid Visibility="{Binding IsUninstallModalOpen, Converter={StaticResource BoolToVisibilityConverter}}"
              Background="{StaticResource ModalOverlayBrush}"
              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
              Panel.ZIndex="110">
            <Border Background="{StaticResource SurfaceCardBrush}"
                    BorderBrush="{StaticResource SubtleBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusLg}"
                    Padding="28"
                    MaxWidth="520"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{DynamicResource String_UninstallGameFilesModalTitle}" Style="{StaticResource H1}" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding Instance.Name, StringFormat='{}Are you sure you want to uninstall game files for {0}?'}"
                               Style="{StaticResource Body}" TextWrapping="Wrap" Margin="0,0,0,16"/>

                    <Border Background="{StaticResource SurfaceInputBrush}"
                            BorderBrush="{StaticResource SubtleBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusMd}"
                            Padding="14" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource String_WhatWillHappenTitle}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,6"/>
                            <TextBlock Text="{DynamicResource String_UninstallDescBullet1}" Style="{StaticResource BodySmall}" Margin="0,0,0,3"/>
                            <TextBlock Text="{DynamicResource String_UninstallDescBullet2}" Style="{StaticResource BodySmall}" Margin="0,0,0,3"/>
                            <TextBlock Text="{DynamicResource String_UninstallDescBullet3}" Style="{StaticResource BodySmall}" Margin="0,0,0,3"/>
                            <TextBlock Text="{DynamicResource String_UninstallDescBullet4}" Style="{StaticResource BodySmall}"/>
                        </StackPanel>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="1" Content="{DynamicResource String_Cancel}"
                                Style="{StaticResource GhostButton}"
                                Padding="18,9"
                                Command="{Binding CloseUninstallModalCommand}"
                                IsEnabled="{Binding IsUninstallingGameFiles, Converter={StaticResource InverseBoolConverter}}"/>

                        <Button Grid.Column="3" Content="{DynamicResource String_UninstallGameFilesBtnAction}"
                                Style="{StaticResource DangerButton}"
                                Padding="20,9"
                                Command="{Binding ConfirmUninstallGameFilesCommand}"
                                IsEnabled="{Binding IsUninstallingGameFiles, Converter={StaticResource InverseBoolConverter}}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ══════════════════════════════════════════════════════════════
             CUSTOM BUILD & MANIFEST CONFIGURATION MODAL
             ══════════════════════════════════════════════════════════════ -->
        <Grid Visibility="{Binding IsCustomBuildModalOpen, Converter={StaticResource BoolToVisibilityConverter}}"
              Background="{StaticResource ModalOverlayBrush}"
              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
              Panel.ZIndex="115">
            <Border Background="{StaticResource SurfaceCardBrush}"
                    BorderBrush="{StaticResource SubtleBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusLg}"
                    Padding="26"
                    MaxWidth="580"
                    MaxHeight="620"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="{DynamicResource String_ConfigureCustomBuildModalTitle}" Style="{StaticResource H2}"/>
                            <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Command="{Binding CloseAddCustomBuildModalCommand}" Padding="8,4">
                                <TextBlock Text="✕" FontSize="14" Foreground="{StaticResource MutedTextBrush}"/>
                            </Button>
                        </Grid>
                        <TextBlock Text="{DynamicResource String_ConfigureCustomBuildDesc}"
                                   Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,16"/>

                        <!-- Target Build ID & Name Inputs -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{DynamicResource String_TargetBuildIdLabel}" Style="{StaticResource CaptionBold}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding CustomBuildIdInput, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource DarkTextBox}"
                                         Height="32" Padding="8,4"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{DynamicResource String_BuildNameNoteLabel}" Style="{StaticResource CaptionBold}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding CustomBuildNameInput, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource DarkTextBox}"
                                         Height="32" Padding="8,4"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="{DynamicResource String_DepotManifestIdsLabel}" Style="{StaticResource CaptionBold}"/>
                            <Button Content="{DynamicResource String_ImportFromManifestFilesBtn}"
                                    Style="{StaticResource GhostButton}"
                                    HorizontalAlignment="Right"
                                    FontSize="11" Padding="6,2"
                                    Command="{Binding ImportManifestFilesForCustomBuildCommand}"/>
                        </Grid>
                    </StackPanel>

                    <!-- Scrollable Depots List -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
                        <ItemsControl ItemsSource="{Binding CustomBuildDepots}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource SurfaceInputBrush}" CornerRadius="{StaticResource RadiusSm}"
                                            Padding="12,8" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="180"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding DepotName}" Style="{StaticResource BodySmall}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding DepotId, StringFormat='Depot ID: {0}'}" Style="{StaticResource Caption}" Foreground="{StaticResource MutedTextBrush}"/>
                                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" Foreground="{StaticResource SuccessBrush}"
                                                           Visibility="{Binding StatusText, Converter={StaticResource NullToVisibilityConverter}}"/>
                                            </StackPanel>

                                            <TextBox Grid.Column="1" Text="{Binding ManifestIdText, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource DarkTextBox}"
                                                     VerticalAlignment="Center" Height="28" Padding="6,2" FontSize="12"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Action Buttons -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="1" Content="{DynamicResource String_Cancel}"
                                Style="{StaticResource GhostButton}"
                                Padding="16,8"
                                Command="{Binding CloseAddCustomBuildModalCommand}"/>

                        <Button Grid.Column="3" Content="{DynamicResource String_SaveSwitchBuildBtn}"
                                Style="{StaticResource PrimaryButton}"
                                Padding="18,8"
                                Command="{Binding SaveCustomBuildCommand}"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ══════════════════════════════════════════════════════════════
             UPDATE DEPOTS MODAL
             ══════════════════════════════════════════════════════════════ -->
        <Grid Background="#B0000000"
              Visibility="{Binding IsUpdateModalOpen, Converter={StaticResource BoolToVisibilityConverter}}"
              Panel.ZIndex="120">
            <Border Style="{StaticResource Card}"
                    Width="620"
                    MaxHeight="650"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    BorderBrush="{StaticResource AccentBrush}"
                    BorderThickness="1"
                    Padding="24">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource String_DepotUpdatesModalTitle}" Style="{StaticResource H2}"/>
                            <TextBlock Text="{DynamicResource String_DepotUpdatesModalDesc}"
                                       Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Command="{Binding CloseUpdateModalCommand}" Padding="8,4">
                            <TextBlock Text="✕" FontSize="14" Foreground="{StaticResource MutedTextBrush}"/>
                        </Button>
                    </Grid>

                    <TextBlock Text="{DynamicResource String_SelectDepotsToUpdateLabel}" Style="{StaticResource CaptionBold}" Margin="0,0,0,10"/>

                    <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
                        <ItemsControl ItemsSource="{Binding UpdateAvailableDepots}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource SurfaceInputBrush}"
                                            BorderBrush="{StaticResource SubtleBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource RadiusSm}"
                                            Padding="12,10"
                                            Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,12,0"/>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource PrimaryTextBrush}"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <TextBlock Text="{Binding DepotId, StringFormat='Depot ID: {0}'}" Style="{StaticResource Muted}" Margin="0,0,12,0"/>
                                                    <TextBlock Text="{Binding DisplayCurrentManifest, StringFormat='Current: {0}'}" Style="{StaticResource Muted}" Margin="0,0,12,0"/>
                                                    <TextBlock Text="{Binding DisplayNewManifest, StringFormat='New: {0}'}" Style="{StaticResource Muted}" Foreground="{StaticResource AccentBrush}"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Same metadata badges as Files & Depots -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                                                <Border Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusSm}" Padding="8,2" Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding CategoryTag}" Style="{StaticResource CaptionBold}"/>
                                                </Border>
                                                <Border Background="{StaticResource InfoBgBrush}" BorderBrush="{StaticResource InfoBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusSm}" Padding="8,2" Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding PlatformTag}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource InfoBrush}"/>
                                                </Border>
                                                <Border Background="{StaticResource PurpleBgBrush}" BorderBrush="{StaticResource PurpleBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusSm}" Padding="6,2"
                                                        Visibility="{Binding ArchitectureTag, Converter={StaticResource NullToVisibilityConverter}}">
                                                    <TextBlock Text="{Binding ArchitectureTag}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource PurpleBrush}"/>
                                                </Border>
                                            </StackPanel>

                                            <TextBlock Grid.Column="3" Text="{Binding FormattedSize}"
                                                       Style="{StaticResource CaptionBold}"
                                                       Foreground="{StaticResource AccentBrush}"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Border Background="{StaticResource WarningBgBrush}"
                            BorderBrush="{StaticResource WarningBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusSm}"
                            Padding="12,8" Margin="0,0,0,16"
                            Visibility="{Binding IsGameRunning, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{DynamicResource String_GameRunningUpdateWarn}"
                                   Style="{StaticResource BodySmall}" Foreground="{StaticResource WarningBrush}"/>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="{DynamicResource String_Cancel}"
                                Style="{StaticResource GhostButton}"
                                Command="{Binding CloseUpdateModalCommand}"
                                Margin="0,0,10,0"/>

                        <Button Content="{DynamicResource String_DownloadInstallBtn}"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding ConfirmApplyDepotUpdateCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══ DEPOTBOX ASSOCIATION MODAL OVERLAY ═══ -->
        <Grid Visibility="{Binding IsAssociationModalOpen, Converter={StaticResource BoolToVisibilityConverter}}"
              Background="{StaticResource ModalOverlayBrush}"
              Panel.ZIndex="1000">
            <Border Width="560"
                    Background="{StaticResource SurfaceCardElevatedBrush}"
                    BorderBrush="{StaticResource StrongBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusLg}"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{DynamicResource String_AssociateWithDepotBoxModalTitle}" Style="{StaticResource H2}" Margin="0,0,0,6"/>
                    <TextBlock Text="{DynamicResource String_AssociateWithDepotBoxModalDesc}"
                               Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,16"/>

                    <!-- Search Box -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding AssociationSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource DarkTextBox}"/>
                        <Button Grid.Column="2" Content="{DynamicResource String_SearchButton}" Style="{StaticResource SecondaryButton}"
                                Command="{Binding SearchDepotBoxManuallyCommand}"/>
                    </Grid>

                    <!-- Searching Spinner -->
                    <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,12"
                                 Visibility="{Binding IsSearchingDepotBoxCandidate, Converter={StaticResource BoolToVisibilityConverter}}"/>

                    <!-- Best Candidate Match Card -->
                    <Border Background="{StaticResource SurfaceInputBrush}"
                            BorderBrush="#0284C7"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusMd}"
                            Padding="14,10" Margin="0,0,0,12"
                            Visibility="{Binding DepotBoxCandidate, Converter={StaticResource NullToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                    <TextBlock Text="{DynamicResource String_BestMatchPrefix}" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding DepotBoxCandidate.Name}" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding DepotBoxCandidate.AppId, StringFormat='Steam AppID: {0}'}" Style="{StaticResource Muted}"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="{DynamicResource String_SelectBtn}" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding ConfirmAssociationWithCandidateCommand}"/>
                        </Grid>
                    </Border>

                    <!-- Search Results List -->
                    <ScrollViewer MaxHeight="200" Margin="0,0,0,16" VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding AssociationSearchResults.Count, Converter={StaticResource NullToVisibilityConverter}}">
                        <ItemsControl ItemsSource="{Binding AssociationSearchResults}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource SurfaceCardBrush}"
                                            BorderBrush="{StaticResource SubtleBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource RadiusSm}"
                                            Padding="10,8" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Style="{StaticResource BodySmall}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding AppId, StringFormat='AppID: {0}'}" Style="{StaticResource Muted}"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="{DynamicResource String_AssociateBtn}"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Padding="12,4" FontSize="11"
                                                    Command="{Binding DataContext.AssociateWithCandidateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Bottom Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="{DynamicResource String_Cancel}" Style="{StaticResource GhostButton}"
                                Command="{Binding CloseAssociationModalCommand}" Margin="0,0,10,0"/>
                        <Button Content="{DynamicResource String_ConfirmAssociationBtn}" Style="{StaticResource PrimaryButton}"
                                Background="#0284C7" BorderBrush="#0369A1"
                                Command="{Binding ConfirmAssociationWithCandidateCommand}"
                                IsEnabled="{Binding DepotBoxCandidate, Converter={StaticResource NullToBoolConverter}}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══ DLC WARNING MODAL OVERLAY ═══ -->
        <Grid Visibility="{Binding IsDlcWarningModalOpen, Converter={StaticResource BoolToVisibilityConverter}}"
              Background="{StaticResource ModalOverlayBrush}"
              Panel.ZIndex="1000">
            <Border Width="500"
                    Background="{StaticResource SurfaceCardElevatedBrush}"
                    BorderBrush="{StaticResource StrongBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusLg}"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{DynamicResource String_DlcWarningModalTitle}" Style="{StaticResource H2}" Margin="0,0,0,8"/>
                    <TextBlock Text="{DynamicResource String_NoDlcsRegisteredTitle}"
                               FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,6"/>
                    <TextBlock Text="{DynamicResource String_NoDlcsRegisteredDesc}"
                               Style="{StaticResource Body}" TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,20"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="{DynamicResource String_Cancel}" Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                                Command="{Binding CancelUnlockDlcsCommand}"/>
                        <Button Content="{DynamicResource String_InstallAnywayBtn}" Style="{StaticResource PrimaryButton}"
                                Command="{Binding ConfirmUnlockDlcsCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══ STEAM REQUIRED FOR ONLINE FEATURES MODAL OVERLAY ═══ -->
        <Grid Visibility="{Binding IsSteamRequiredModalOpen, Converter={StaticResource BoolToVisibilityConverter}}"
              Background="{StaticResource ModalOverlayBrush}"
              Panel.ZIndex="1000">
            <Border Width="480"
                    Background="{StaticResource SurfaceCardElevatedBrush}"
                    BorderBrush="{StaticResource StrongBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusLg}"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{DynamicResource String_SteamRequiredModalTitle}" Style="{StaticResource H2}" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding Instance.Name, StringFormat='{}Launching {0} with ReFix Online (Spacewar 480).'}"
                               FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,6"/>
                    <TextBlock Text="{DynamicResource String_SteamRequiredModalDesc}"
                               Style="{StaticResource Body}" TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,16"/>

                    <!-- Loading / Waiting for Steam indicator -->
                    <Border Background="{StaticResource SurfaceInputBrush}"
                            BorderBrush="{StaticResource AccentBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusMd}"
                            Padding="12,10" Margin="0,0,0,16"
                            Visibility="{Binding IsStartingSteam, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ProgressBar IsIndeterminate="True" Width="16" Height="16" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding SteamLaunchStatusText, FallbackValue='Starting Steam and waiting for user profile to load...'}"
                                       Style="{StaticResource CaptionBold}" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="{DynamicResource String_Cancel}" Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                                Command="{Binding CloseSteamRequiredModalCommand}"
                                IsEnabled="{Binding IsStartingSteam, Converter={StaticResource InverseBoolConverter}}"/>
                        <Button Content="{DynamicResource String_LaunchAnywayBtn}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                                Command="{Binding LaunchAnywayCommand}"
                                IsEnabled="{Binding IsStartingSteam, Converter={StaticResource InverseBoolConverter}}"/>
                        <Button Content="{DynamicResource String_StartSteamAndPlayBtn}" Style="{StaticResource PrimaryButton}"
                                Command="{Binding StartSteamAndLaunchCommand}"
                                IsEnabled="{Binding IsStartingSteam, Converter={StaticResource InverseBoolConverter}}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══ ONLINE FIX WARNING & ANTIVIRUS EXCLUSION MODAL OVERLAY ═══ -->
        <Grid Visibility="{Binding IsOnlineFixWarningModalOpen, Converter={StaticResource BoolToVisibilityConverter}}"
              Background="{StaticResource ModalOverlayBrush}"
              Panel.ZIndex="1001">
            <Border Width="520" Background="{StaticResource SurfaceCardElevatedBrush}"
                    BorderBrush="{StaticResource WarningBrush}" BorderThickness="1.5"
                    CornerRadius="{StaticResource RadiusLg}" Padding="28,24"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <!-- Header with Warning Icon -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{StaticResource WarningBgBrush}"
                                BorderBrush="{StaticResource WarningBrush}" BorderThickness="1"
                                CornerRadius="{StaticResource RadiusSm}" Width="40" Height="40"
                                Margin="0,0,14,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="⚠️" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource String_OnlineFixWarningModalTitle}" Style="{StaticResource H2}" Foreground="{StaticResource WarningBrush}"/>
                            <TextBlock Text="{DynamicResource String_OnlineFixWarningModalSubtitle}" Style="{StaticResource Caption}"/>
                        </StackPanel>

                        <Button Grid.Column="2" Content="✕" Style="{StaticResource GhostButton}" Command="{Binding CloseOnlineFixWarningModalCommand}"/>
                    </Grid>

                    <Separator Margin="0,0,0,16" Background="{StaticResource SubtleBorderBrush}"/>

                    <!-- Description -->
                    <TextBlock Style="{StaticResource Body}" Margin="0,0,0,12" TextWrapping="Wrap">
                        <Run Text="{DynamicResource String_AboutToInstallPrefix}"/>
                        <Run Text="{Binding PendingOnlineFixToInstall.Name}" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}"/>
                    </TextBlock>

                    <!-- Bullet points notice box -->
                    <Border Background="{StaticResource SurfaceInputBrush}" BorderBrush="{StaticResource SubtleBorderBrush}"
                            BorderThickness="1" CornerRadius="{StaticResource RadiusMd}" Padding="16,12" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource String_OnlineFixSecurityDetailsTitle}" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,8" Foreground="{StaticResource WarningBrush}"/>
                            <TextBlock Text="{DynamicResource String_OnlineFixBullet1}" Style="{StaticResource Caption}" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" Margin="0,0,0,4" TextWrapping="Wrap"/>
                            <TextBlock Text="{DynamicResource String_OnlineFixBullet2}" Style="{StaticResource Caption}" Margin="0,0,0,4" TextWrapping="Wrap"/>
                            <TextBlock Text="{DynamicResource String_OnlineFixBullet3}" Style="{StaticResource Caption}" Margin="0,0,0,4" TextWrapping="Wrap"/>
                            <TextBlock Text="{DynamicResource String_OnlineFixBullet4}" Style="{StaticResource Caption}" Margin="0,0,0,4" TextWrapping="Wrap"/>
                            <TextBlock Text="{DynamicResource String_OnlineFixBullet5}" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{DynamicResource String_OnlineFixConfirmPrompt}"
                               Style="{StaticResource BodySmall}" FontWeight="SemiBold" Margin="0,0,0,20"/>

                    <!-- Action Buttons -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="{DynamicResource String_Cancel}" Style="{StaticResource SecondaryButton}" Command="{Binding CloseOnlineFixWarningModalCommand}" Margin="0,0,10,0"/>
                        <Button Grid.Column="1" Content="{DynamicResource String_ProceedAddExclusionBtn}" Style="{StaticResource PrimaryButton}"
                                Background="{StaticResource WarningBrush}"
                                Command="{Binding ConfirmInstallOnlineFixCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
