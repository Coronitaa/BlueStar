<UserControl x:Class="BlueStar.App.Views.InstanceDetailView"
             x:Name="RootInstanceDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:BlueStar.App.ViewModels"
             xmlns:controls="clr-namespace:BlueStar.App.Controls"
             d:DataContext="{d:DesignInstance vm:InstanceDetailViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{StaticResource BaseBackgroundBrush}"
             Foreground="{StaticResource PrimaryTextBrush}"
             FontFamily="{StaticResource MainFontFamily}">

    <UserControl.RenderTransform>
        <TranslateTransform Y="0"/>
    </UserControl.RenderTransform>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     From="0.0" To="1.0" Duration="0:0:0.22">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                     From="12" To="0" Duration="0:0:0.22">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

        <!-- ═══ FIXED HEADER: breadcrumb, hero banner and active download ═══ -->
        <StackPanel Grid.Row="0" Margin="32,20,32,0" MaxWidth="1180" HorizontalAlignment="Stretch">

                <!-- ═══ TOP BREADCRUMB & BACK BUTTON ═══ -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="{DynamicResource String_BackToInstances}"
                            Style="{StaticResource GhostButton}"
                            Foreground="{StaticResource SecondaryTextBrush}"
                            Command="{Binding GoBackCommand}"/>
                </Grid>

                <!-- ═══ HERO BANNER HEADER ═══ -->
                <Border Background="{StaticResource SurfaceCardBrush}"
                        BorderBrush="{StaticResource SubtleBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusLg}"
                        Padding="24"
                        Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="235"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Game Cover Image (Standard 460x215 aspect ratio: 235x110) -->
                        <Border Grid.Column="0" CornerRadius="8"
                                Background="{StaticResource SurfaceInputBrush}"
                                Width="235" Height="110" ClipToBounds="True">
                            <Grid>
                                <Path Data="{StaticResource IconGamepad}" Fill="{StaticResource MutedTextBrush}"
                                      Stretch="Uniform" Width="32" Height="32"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Image Source="{Binding Instance.HeaderImageUrl, Converter={StaticResource CachedImageConverter}}"
                                       Stretch="UniformToFill"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Grid>
                        </Border>

                        <!-- Game Info -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Instance.Name}" Style="{StaticResource H1}"
                                       TextTrimming="CharacterEllipsis" Margin="0,0,0,4"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="{Binding Instance.AppId, StringFormat='Steam AppID: {0}'}"
                                           Style="{StaticResource Caption}" Margin="0,0,14,0"/>
                                <TextBlock Text="{Binding Instance.TotalPlayTime, Converter={StaticResource PlayTimeToFormattedConverter}, StringFormat='Playtime: {0}'}"
                                           Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                            </StackPanel>

                            <!-- Badges: Dynamic Tags from ITagsService -->
                            <ItemsControl ItemsSource="{Binding HeroTags}" Margin="0,4,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Cursor="Hand"
                                                Command="{Binding DataContext.OpenTagInExploreCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding Text}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="border"
                                                            CornerRadius="{StaticResource RadiusSm}"
                                                            Padding="7,2"
                                                            Margin="0,0,6,4"
                                                            Background="{Binding Type, Converter={StaticResource TagTypeToBgBrushConverter}}"
                                                            BorderBrush="{Binding Type, Converter={StaticResource TagTypeToBorderBrushConverter}}"
                                                            BorderThickness="1"
                                                            ToolTip="{Binding Tooltip}">
                                                        <TextBlock Text="{Binding Text}"
                                                                   FontSize="11"
                                                                   FontWeight="Normal"
                                                                   Foreground="{Binding Type, Converter={StaticResource TagTypeToBrushConverter}}"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Primary Action Buttons (Play & Shortcut) -->
                        <StackPanel Grid.Column="3" VerticalAlignment="Center" Orientation="Horizontal">
                            <Button Style="{StaticResource IconButton}" Margin="0,0,8,0"
                                    ToolTip="{DynamicResource String_SimilarGames}" Command="{Binding FindSimilarGamesCommand}">
                                <Path Data="{StaticResource IconSimilar}" Fill="{StaticResource SecondaryTextBrush}"
                                      Stretch="Uniform" Width="15" Height="15"/>
                            </Button>

                            <Button Style="{StaticResource IconButton}" Margin="0,0,8,0"
                                    ToolTip="{DynamicResource String_OpenGameDirTooltip}" Command="{Binding OpenFolderCommand}">
                                <Path Data="{StaticResource IconFolder}" Fill="{StaticResource SecondaryTextBrush}"
                                      Stretch="Uniform" Width="15" Height="15"/>
                            </Button>

                            <Button Style="{StaticResource IconButton}" Margin="0,0,12,0"
                                    ToolTip="{DynamicResource String_CreateShortcutsTooltip}" Command="{Binding OpenShortcutModalCommand}">
                                <Path Data="{StaticResource IconLink}" Fill="{StaticResource SecondaryTextBrush}"
                                      Stretch="Uniform" Width="15" Height="15"/>
                            </Button>

                            <!-- Play / Install / Stop Button -->
                            <Button Command="{Binding LaunchGameCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PlayHeroButton}">
                                        <Setter Property="Content" Value="{DynamicResource String_PlayGame}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Instance.Status}" Value="NotInstalled">
                                                <Setter Property="Content" Value="{DynamicResource String_InstallGame}"/>
                                                <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding HasActiveJob}" Value="True">
                                                <Setter Property="Content" Value="{Binding InstanceDownloadLabel, StringFormat='📥 Downloading {0}'}"/>
                                                <Setter Property="IsEnabled" Value="False"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsGameRunning}" Value="True">
                                                <Setter Property="Content" Value="{DynamicResource String_StopProcess}"/>
                                                <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>

                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ═══ STATUS FEEDBACK MESSAGE / PROGRESS ═══ -->
                <Border Background="{StaticResource SurfaceCardBrush}"
                        BorderBrush="{StaticResource AccentBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusMd}"
                        Padding="14,10" Margin="0,0,0,16"
                        Visibility="{Binding IsStatusMessageVisible, Converter={StaticResource BoolToVisibilityConverter}}">

                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" Style="{StaticResource BodyMedium}"
                                       TextWrapping="Wrap" Foreground="{StaticResource PrimaryTextBrush}"/>
                            <TextBlock Grid.Column="1" Text="{Binding GameFixDeployProgress, StringFormat='{}{0:F0}%'}"
                                       Style="{StaticResource CaptionBold}" Foreground="{StaticResource AccentBrush}" FontSize="13"
                                       Visibility="{Binding IsGameFixDeployProgressVisible, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </Grid>
                        <ProgressBar Margin="0,8,0,0" Value="{Binding GameFixDeployProgress}" Maximum="100" Height="6"
                                     Foreground="{StaticResource AccentBrush}"
                                     Background="{StaticResource SurfaceInputBrush}"
                                     BorderThickness="0"
                                     Visibility="{Binding IsGameFixDeployProgressVisible, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </StackPanel>
                </Border>

                <!-- ═══ ACTIVE DOWNLOAD PROGRESS CARD ═══ -->
                <Border Background="{StaticResource SurfaceCardBrush}"
                        BorderBrush="{StaticResource AccentBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusMd}"
                        Padding="16,12" Margin="0,0,0,16"
                        Visibility="{Binding HasActiveJob, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <!-- Line 1: what stage the job is at, plus live rate and ETA -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ActiveJob.PhaseGlyph}" FontSize="14" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                    <TextBlock Text="{Binding ActiveJob.FriendlyPhase, FallbackValue='Working'}"
                                               FontWeight="SemiBold" FontSize="13"
                                               Foreground="{StaticResource PrimaryTextBrush}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding ActiveJob.FormattedSpeed, StringFormat='  •  {0}'}"
                                               Style="{StaticResource Caption}"
                                               Foreground="{StaticResource AccentBrush}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding ActiveJob.IsDownloading, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    <TextBlock Text="{Binding ActiveJob.FormattedEta, StringFormat='  •  {0} left'}"
                                               Style="{StaticResource Caption}"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding ActiveJob.IsDownloading, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </StackPanel>

                                <!-- Line 2: bytes so far, depot counter, chunks, disk write rate -->
                                <TextBlock Text="{Binding ActiveJob.FormattedProgress}"
                                           Style="{StaticResource Caption}"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           Margin="21,5,0,0"/>
                                <TextBlock Text="{Binding ActiveJob.StageDetail}"
                                           Style="{StaticResource Caption}"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="21,3,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ActiveJob.Percentage, StringFormat='{}{0:F1}%'}"
                                           FontWeight="Bold" FontSize="14"
                                           Foreground="{StaticResource AccentBrush}"
                                           Margin="0,0,12,0" VerticalAlignment="Center"/>

                                <!-- Pause Button (⏸) -->
                                <Button Style="{StaticResource SecondaryButton}" Padding="6" Width="28" Height="28" Margin="0,0,6,0"
                                        ToolTip="{DynamicResource String_Pause}"
                                        Command="{Binding PauseDownloadCommand}"
                                        Visibility="{Binding ActiveJob.CanPause, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Path Data="{StaticResource IconPause}" Fill="{StaticResource PrimaryTextBrush}" Width="10" Height="10" Stretch="Uniform"/>
                                </Button>

                                <!-- Resume Button (▶) -->
                                <Button Style="{StaticResource PrimaryButton}" Padding="6" Width="28" Height="28" Margin="0,0,6,0"
                                        ToolTip="{DynamicResource String_Resume}"
                                        Command="{Binding ResumeDownloadCommand}"
                                        Visibility="{Binding ActiveJob.CanResume, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Path Data="{StaticResource IconPlay}" Fill="White" Width="10" Height="10" Stretch="Uniform" Margin="1,0,0,0"/>
                                </Button>

                                <!-- Cancel / Stop Button (⏹) -->
                                <Button Style="{StaticResource DangerButton}" Padding="6" Width="28" Height="28" Margin="0,0,6,0"
                                        ToolTip="{DynamicResource String_CancelAction}"
                                        Command="{Binding CancelDownloadCommand}"
                                        Visibility="{Binding ActiveJob.CanCancel, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Path Data="{StaticResource IconStop}" Fill="{StaticResource DangerBrush}" Width="9" Height="9" Stretch="Uniform"/>
                                </Button>

                                <!-- Retry Button (🔄) -->
                                <Button Style="{StaticResource PrimaryButton}" Padding="6" Width="28" Height="28"
                                        ToolTip="{DynamicResource String_RetryAction}"
                                        Command="{Binding RetryDownloadCommand}"
                                        Visibility="{Binding ActiveJob.CanRetry, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Path Data="{StaticResource IconRefresh}" Fill="White" Width="11" Height="11" Stretch="Uniform"/>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Indeterminate until a real total is known, so "0%" never reads as a hang -->
                        <ProgressBar Value="{Binding ActiveJob.Percentage}" Maximum="100" Height="8"
                                     IsIndeterminate="{Binding ActiveJob.IsIndeterminate}"
                                     Foreground="{StaticResource AccentBrush}"
                                     Background="{StaticResource SurfaceInputBrush}"
                                     BorderThickness="0"/>
                    </StackPanel>
                </Border>

        </StackPanel>

        <!-- ═══════════════════════════════════════════════════════════════
             COMPACT NAVIGATION RAIL + SCROLLING CONTENT
             The rail lives OUTSIDE the content ScrollViewer, so navigation and
             the Play button stay reachable no matter how long a section is.
             ═══════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1" Margin="32,4,32,0" MaxWidth="1180" HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource SurfaceCardBrush}"
                    BorderBrush="{StaticResource SubtleBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusMd}"
                    Padding="6,8"
                    VerticalAlignment="Top">
                <StackPanel>
                    <RadioButton Style="{StaticResource RailNavButton}"
                                 ToolTip="{DynamicResource String_TabOverview}"
                                 IsChecked="{Binding SelectedTab, Converter={StaticResource StringMatchConverter}, ConverterParameter=Overview}"
                                 Command="{Binding SwitchTabCommand}" CommandParameter="Overview">
                        <StackPanel>
                            <Path Data="{StaticResource IconInfo}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  Width="17" Height="17" Stretch="Uniform" HorizontalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource String_RailOverview}" FontSize="9" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource RailNavButton}"
                                 ToolTip="{DynamicResource String_TabVersion}"
                                 Visibility="{Binding IsDepotBoxTabsVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                                 IsChecked="{Binding SelectedTab, Converter={StaticResource StringMatchConverter}, ConverterParameter=Files}"
                                 Command="{Binding SwitchTabCommand}" CommandParameter="Files">
                        <Grid>
                            <StackPanel>
                                <Path Data="{StaticResource IconDownload}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      Width="17" Height="17" Stretch="Uniform" HorizontalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource String_RailVersion}" FontSize="9" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <!-- Amber dot: a newer build exists -->
                            <Ellipse Width="7" Height="7" Fill="{StaticResource WarningBrush}"
                                     HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,1,2,0"
                                     ToolTip="{DynamicResource String_RailBadgeUpdate}"
                                     Visibility="{Binding HasGameUpdateAvailable, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </Grid>
                    </RadioButton>

                    <RadioButton Style="{StaticResource RailNavButton}"
                                 ToolTip="{DynamicResource String_TabDlcs}"
                                 Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibilityConverter}}"
                                 IsChecked="{Binding SelectedTab, Converter={StaticResource StringMatchConverter}, ConverterParameter=Dlcs}"
                                 Command="{Binding SwitchTabCommand}" CommandParameter="Dlcs">
                        <StackPanel>
                            <Path Data="{StaticResource IconPackage}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  Width="17" Height="17" Stretch="Uniform" HorizontalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource String_RailDlcs}" FontSize="9" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource RailNavButton}"
                                 ToolTip="{DynamicResource String_TabMods}"
                                 Visibility="{Binding IsModsTabVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                                 IsChecked="{Binding SelectedTab, Converter={StaticResource StringMatchConverter}, ConverterParameter=Mods}"
                                 Command="{Binding SwitchTabCommand}" CommandParameter="Mods">
                        <StackPanel>
                            <Path Data="{StaticResource IconMod}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  Width="17" Height="17" Stretch="Uniform" HorizontalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource String_RailMods}" FontSize="9" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource RailNavButton}"
                                 ToolTip="{DynamicResource String_TabEmulator}"
                                 Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibilityConverter}}"
                                 IsChecked="{Binding SelectedTab, Converter={StaticResource StringMatchConverter}, ConverterParameter=Emulator}"
                                 Command="{Binding SwitchTabCommand}" CommandParameter="Emulator">
                        <Grid>
                            <StackPanel>
                                <Path Data="{StaticResource IconEmulator}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      Width="17" Height="17" Stretch="Uniform" HorizontalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource String_RailEmulator}" FontSize="9" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <!-- Green dot: an emulation layer is active -->
                            <Ellipse Width="7" Height="7" Fill="{StaticResource SuccessBrush}"
                                     HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,1,2,0"
                                     ToolTip="{DynamicResource String_RailBadgeEmulator}"
                                     Visibility="{Binding IsEmulatorInstalled, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </Grid>
                    </RadioButton>

                    <Border Height="1" Background="{StaticResource SubtleBorderBrush}" Margin="6,7,6,7"/>

                    <RadioButton Style="{StaticResource RailNavButton}"
                                 ToolTip="{DynamicResource String_TabPrerequisites}"
                                 IsChecked="{Binding SelectedTab, Converter={StaticResource StringMatchConverter}, ConverterParameter=Prerequisites}"
                                 Command="{Binding SwitchTabCommand}" CommandParameter="Prerequisites">
                        <StackPanel>
                            <Path Data="{StaticResource IconLayers}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  Width="17" Height="17" Stretch="Uniform" HorizontalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource String_RailPrereq}" FontSize="9" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource RailNavButton}"
                                 ToolTip="{DynamicResource String_TabSettings}"
                                 IsChecked="{Binding SelectedTab, Converter={StaticResource StringMatchConverter}, ConverterParameter=Settings}"
                                 Command="{Binding SwitchTabCommand}" CommandParameter="Settings">
                        <StackPanel>
                            <Path Data="{StaticResource IconSettings}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  Width="17" Height="17" Stretch="Uniform" HorizontalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource String_RailSettings}" FontSize="9" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource RailNavButton}"
                                 ToolTip="{DynamicResource String_TabLogs}"
                                 Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibilityConverter}}"
                                 IsChecked="{Binding SelectedTab, Converter={StaticResource StringMatchConverter}, ConverterParameter=Logs}"
                                 Command="{Binding SwitchTabCommand}" CommandParameter="Logs">
                        <StackPanel>
                            <Path Data="{StaticResource IconTerminal}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  Width="17" Height="17" Stretch="Uniform" HorizontalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource String_RailLogs}" FontSize="9" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Border>

            <Grid Grid.Column="1" Margin="16,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Section breadcrumb: names the short rail label in full -->
                <Border Grid.Row="0"
                        Background="{StaticResource SurfaceCardBrush}"
                        BorderBrush="{StaticResource SubtleBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusMd}"
                        Padding="14,8">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Instance.Name}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,4,0,0"/>
                        <TextBlock Text=" › " Style="{StaticResource Caption}" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding SelectedTab, Converter={StaticResource TabNameConverter}}"
                                   Style="{StaticResource BodyMedium}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Margin="0,14,0,0"
                              Padding="0,0,10,24">
                    <StackPanel>

                <!-- ══════════════════════════════════════════════════════════════
                     TAB CONTENT PANELS
                     ══════════════════════════════════════════════════════════════ -->

                <!-- ── 1. OVERVIEW TAB ── -->
                <StackPanel Visibility="{Binding SelectedTab, Converter={StaticResource StringMatchToVisibilityConverter}, ConverterParameter=Overview}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" MinWidth="380"/>
                            <ColumnDefinition Width="22"/>
                            <ColumnDefinition Width="*" MinWidth="260"/>
                        </Grid.ColumnDefinitions>

                        <!-- ═══════════════ LEFT: the game itself ═══════════════ -->
                        <StackPanel Grid.Column="0">

                            <!-- About -->
                            <Border Style="{StaticResource Card}" Margin="0,0,0,18">
                                <StackPanel>
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource String_AboutGame}" Style="{StaticResource H2}"/>
                                            <TextBlock Text="{Binding GenresText}" Style="{StaticResource Caption}"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       TextTrimming="CharacterEllipsis" Margin="0,5,12,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Background="{StaticResource SuccessBgBrush}" BorderBrush="{StaticResource SuccessBorderBrush}"
                                                    BorderThickness="1" CornerRadius="{StaticResource RadiusSm}" Padding="10,5" Margin="0,0,8,0"
                                                    ToolTip="{DynamicResource String_OverviewMetacriticTooltip}"
                                                    Visibility="{Binding HasMetacriticScore, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding MetacriticText}" FontSize="15" FontWeight="Bold"
                                                               Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{DynamicResource String_OverviewMetacriticLabel}" FontSize="9"
                                                               Foreground="{StaticResource SuccessBrush}" Opacity="0.75"
                                                               VerticalAlignment="Center" Margin="6,1,0,0"/>
                                                </StackPanel>
                                            </Border>
                                            <Button Content="{DynamicResource String_OverviewStorePageBtn}" Style="{StaticResource SecondaryButton}"
                                                    Padding="13,7" FontSize="11" Command="{Binding OpenStorePageCommand}"/>
                                        </StackPanel>
                                    </Grid>

                                    <ScrollViewer MaxHeight="230" VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,18">
                                        <TextBlock Text="{Binding AboutGameText}" Style="{StaticResource Body}" TextWrapping="Wrap"
                                                   LineHeight="23" MaxWidth="640" HorizontalAlignment="Left" Margin="0,0,10,0"/>
                                    </ScrollViewer>

                                    <!-- Facts: label / value rows split by hairlines -->
                                    <Border Background="{StaticResource SurfaceInputBrush}" CornerRadius="{StaticResource RadiusMd}" Padding="0">
                                        <StackPanel>
                                            <Grid Margin="14,11">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" MinWidth="94" MaxWidth="150"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{DynamicResource String_Developer}" Style="{StaticResource CaptionBold}"
                                                           Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
                                                <TextBlock Grid.Column="1" Text="{Binding DeveloperText}" Style="{StaticResource Body}" TextWrapping="Wrap"/>
                                            </Grid>
                                            <Border Height="1" Background="{StaticResource SubtleBorderBrush}"/>
                                            <Grid Margin="14,11">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" MinWidth="94" MaxWidth="150"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{DynamicResource String_Publisher}" Style="{StaticResource CaptionBold}"
                                                           Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
                                                <TextBlock Grid.Column="1" Text="{Binding PublisherText}" Style="{StaticResource Body}" TextWrapping="Wrap"/>
                                            </Grid>
                                            <Border Height="1" Background="{StaticResource SubtleBorderBrush}"/>
                                            <Grid Margin="14,11">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" MinWidth="94" MaxWidth="150"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{DynamicResource String_ReleaseDate}" Style="{StaticResource CaptionBold}"
                                                           Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
                                                <TextBlock Grid.Column="1" Text="{Binding ReleaseDateText}" Style="{StaticResource Body}" TextWrapping="Wrap"/>
                                            </Grid>
                                            <Border Height="1" Background="{StaticResource SubtleBorderBrush}"/>
                                            <Grid Margin="14,11">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" MinWidth="94" MaxWidth="150"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{DynamicResource String_OverviewEngineLabel}" Style="{StaticResource CaptionBold}"
                                                           Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
                                                <TextBlock Grid.Column="1" Text="{Binding EngineText}" Style="{StaticResource Body}" TextWrapping="Wrap"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Screenshots: one large frame, the rest as thumbnails -->
                            <Border Style="{StaticResource Card}" Margin="0,0,0,18"
                                    Visibility="{Binding HasScreenshots, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource String_OverviewMediaTitle}" Style="{StaticResource H2}"/>
                                    <TextBlock Text="{DynamicResource String_OverviewMediaDesc}" Style="{StaticResource Caption}"
                                               TextWrapping="Wrap" Margin="0,5,0,14"/>

                                    <Border CornerRadius="{StaticResource RadiusMd}" ClipToBounds="True"
                                            Background="{StaticResource SurfaceInputBrush}"
                                            BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1"
                                            MaxHeight="360" Margin="0,0,0,10">
                                        <Image Source="{Binding LeadScreenshot, Converter={StaticResource CachedImageConverter}}"
                                               Stretch="Uniform" StretchDirection="DownOnly"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Border>

                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                                  Visibility="{Binding HasThumbScreenshots, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <ItemsControl ItemsSource="{Binding ThumbScreenshots}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource GhostButton}" Padding="0" Margin="0,0,8,4"
                                                            Cursor="Hand"
                                                            ToolTip="{DynamicResource String_OverviewScreenshotTooltip}"
                                                            Command="{Binding DataContext.ShowScreenshotCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}">
                                                        <Border Width="150" Height="84" CornerRadius="{StaticResource RadiusSm}"
                                                                ClipToBounds="True" Background="{StaticResource SurfaceInputBrush}"
                                                                BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1">
                                                            <Image Source="{Binding Converter={StaticResource CachedImageConverter}}"
                                                                   Stretch="UniformToFill"
                                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                                        </Border>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>

                            <!-- Store tags, split by where they come from -->
                            <Border Style="{StaticResource Card}" Margin="0,0,0,18"
                                    Visibility="{Binding HasAnyTags, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{DynamicResource String_OverviewTagsTitle}" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Padding="10,5"
                                                Command="{Binding FindSimilarGamesCommand}"
                                                ToolTip="{DynamicResource String_SimilarGames}">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource IconSimilar}" Fill="{StaticResource SecondaryTextBrush}"
                                                      Stretch="Uniform" Width="12" Height="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{DynamicResource String_SimilarGames}" FontSize="12"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    <TextBlock Text="{DynamicResource String_OverviewTagsDesc}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,5,0,14"/>

                                    <StackPanel Margin="0,0,0,14" Visibility="{Binding HasGenreTags, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="{DynamicResource String_OverviewTagsGenres}" Style="{StaticResource CaptionBold}"
                                                   Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,8"/>
                                        <ItemsControl ItemsSource="{Binding GenreTags}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Cursor="Hand"
                                                            Command="{Binding DataContext.OpenTagInExploreCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="border" Style="{StaticResource StoreTagChip}"
                                                                        Background="{StaticResource AccentBgBrush}" BorderBrush="{StaticResource AccentBrush}">
                                                                    <TextBlock Text="{Binding}" Style="{StaticResource StoreTagChipText}" Foreground="{StaticResource AccentBrush}"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <StackPanel Margin="0,0,0,14" Visibility="{Binding HasFeatureTags, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="{DynamicResource String_OverviewTagsFeatures}" Style="{StaticResource CaptionBold}"
                                                   Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,8"/>
                                        <ItemsControl ItemsSource="{Binding FeatureTags}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Cursor="Hand"
                                                            Command="{Binding DataContext.OpenTagInExploreCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="border" Style="{StaticResource StoreTagChip}"
                                                                        Background="{StaticResource InfoBgBrush}" BorderBrush="{StaticResource InfoBrush}">
                                                                    <TextBlock Text="{Binding}" Style="{StaticResource StoreTagChipText}" Foreground="{StaticResource InfoBrush}"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <StackPanel Visibility="{Binding HasCommunityTags, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="{DynamicResource String_OverviewTagsCommunity}" Style="{StaticResource CaptionBold}"
                                                   Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,8"/>
                                        <ItemsControl ItemsSource="{Binding CommunityTags}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Cursor="Hand"
                                                            Command="{Binding DataContext.OpenTagInExploreCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="border" Style="{StaticResource StoreTagChip}">
                                                                    <TextBlock Text="{Binding}" Style="{StaticResource StoreTagChipText}"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Steam patch notes -->
                            <Border Style="{StaticResource Card}"
                                    Visibility="{Binding HasNewsItems, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource String_OverviewNewsTitle}" Style="{StaticResource H2}"/>
                                    <TextBlock Text="{DynamicResource String_OverviewNewsDesc}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,5,0,14"/>
                                    <ItemsControl ItemsSource="{Binding NewsItems}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource SurfaceInputBrush}" CornerRadius="{StaticResource RadiusMd}"
                                                        Padding="15,13" Margin="0,0,0,9">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" MinWidth="78"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Date rail keeps the timeline scannable -->
                                                        <StackPanel Grid.Column="0" Margin="0,1,16,0">
                                                            <TextBlock Text="{Binding FormattedDate}" Style="{StaticResource CaptionBold}"
                                                                       Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                                                            <Border Background="{StaticResource AccentBgBrush}" BorderBrush="{StaticResource AccentBrush}"
                                                                    BorderThickness="1" CornerRadius="{StaticResource RadiusSm}" Padding="6,1"
                                                                    HorizontalAlignment="Left" Margin="0,7,0,0"
                                                                    Visibility="{Binding IsPatchNote, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                <TextBlock Text="{DynamicResource String_OverviewPatchNoteBadge}" FontSize="9"
                                                                           FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                                                            </Border>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="{Binding Title}" Style="{StaticResource BodyMedium}" FontWeight="SemiBold"
                                                                       TextWrapping="Wrap"/>
                                                            <ScrollViewer MaxHeight="88" VerticalScrollBarVisibility="Auto"
                                                                          HorizontalScrollBarVisibility="Disabled" Margin="0,7,0,0">
                                                                <TextBlock Text="{Binding Contents}" Style="{StaticResource Caption}"
                                                                           TextWrapping="Wrap" LineHeight="18" Margin="0,0,8,0"/>
                                                            </ScrollViewer>
                                                            <Button Content="{DynamicResource String_OverviewReadOnSteamBtn}"
                                                                    Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
                                                                    Padding="0,8,0,0" FontSize="11" Foreground="{StaticResource AccentBrush}"
                                                                    Command="{Binding DataContext.OpenNewsItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ═══════════════ RIGHT: this instance ═══════════════ -->
                        <StackPanel Grid.Column="2">

                            <Border Style="{StaticResource Card}" Margin="0,0,0,18" BorderBrush="#38BDF8" BorderThickness="1"
                                    Visibility="{Binding IsImportedUnassociatedInstance, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource String_AssociateDepotBoxTitle}" Style="{StaticResource H3}" Foreground="#38BDF8" TextWrapping="Wrap"/>
                                    <TextBlock Text="{DynamicResource String_AssociateDepotBoxDesc}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,12"/>
                                    <Button Style="{StaticResource PrimaryButton}" Padding="14,9" Command="{Binding OpenDepotAssociationModalCommand}">
                                        <TextBlock Text="{DynamicResource String_FindDepotsBtn}"/>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" BorderBrush="{StaticResource WarningBrush}" BorderThickness="1" Margin="0,0,0,18"
                                    Visibility="{Binding HasGameUpdateAvailable, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource String_NewVersionDetectedTitle}" Style="{StaticResource H3}"
                                               Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{DynamicResource String_NewVersionDetectedDesc}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,12"/>
                                    <Button Content="{DynamicResource String_CheckForUpdatesBtn}"
                                            Style="{StaticResource UpdateButton}" Padding="14,9"
                                            Command="{Binding CheckAndOpenDepotUpdateModalCommand}"
                                            IsEnabled="{Binding IsCheckingGameUpdate, Converter={StaticResource InverseBoolConverter}}"/>
                                </StackPanel>
                            </Border>

                            <!-- Current state: one card, hairline-separated rows -->
                            <Border Style="{StaticResource Card}" Margin="0,0,0,18" Padding="0">
                                <StackPanel>
                                    <StackPanel Margin="18,16,18,12">
                                        <TextBlock Text="{DynamicResource String_OverviewStatusTitle}" Style="{StaticResource H3}"/>
                                        <TextBlock Text="{DynamicResource String_OverviewStatusDesc}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                    </StackPanel>
                                    <Border Height="1" Background="{StaticResource SubtleBorderBrush}"/>

                                    <Grid Margin="18,13">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                            <TextBlock Text="{DynamicResource String_InstalledVersion}" Style="{StaticResource CaptionBold}"
                                                       Foreground="{StaticResource MutedTextBrush}"/>
                                            <TextBlock Text="{Binding InstalledVersionText}" Style="{StaticResource BodyMedium}"
                                                       TextWrapping="Wrap" Margin="0,5,0,0"/>
                                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,3,0,0">
                                                <Run Text="{DynamicResource String_LatestOnSteam}"/>
                                                <Run Text=" "/>
                                                <Run Text="{Binding LatestVersionText, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="{StaticResource WarningBgBrush}" BorderBrush="{StaticResource WarningBrush}"
                                                BorderThickness="1" CornerRadius="{StaticResource RadiusSm}" Padding="8,3" VerticalAlignment="Top"
                                                Visibility="{Binding HasGameUpdateAvailable, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="{DynamicResource String_OverviewUpdateBadge}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}"/>
                                        </Border>
                                    </Grid>
                                    <Border Height="1" Background="{StaticResource SubtleBorderBrush}"/>

                                    <Grid Margin="18,13">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                            <TextBlock Text="{DynamicResource String_TabEmulator}" Style="{StaticResource CaptionBold}"
                                                       Foreground="{StaticResource MutedTextBrush}"/>
                                            <TextBlock Text="{Binding EmulatorSummaryText}" Style="{StaticResource BodyMedium}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="{StaticResource SuccessBgBrush}" BorderBrush="{StaticResource SuccessBorderBrush}"
                                                BorderThickness="1" CornerRadius="{StaticResource RadiusSm}" Padding="8,3" VerticalAlignment="Top"
                                                Visibility="{Binding IsEmulatorInstalled, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="{DynamicResource String_OverviewActiveBadge}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}"/>
                                        </Border>
                                    </Grid>
                                    <Border Height="1" Background="{StaticResource SubtleBorderBrush}"/>

                                    <Grid Margin="18,13">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                            <TextBlock Text="{DynamicResource String_OverviewUnlockerLabel}" Style="{StaticResource CaptionBold}"
                                                       Foreground="{StaticResource MutedTextBrush}"/>
                                            <TextBlock Text="{Binding DlcUnlockerSummaryText}" Style="{StaticResource BodyMedium}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="{StaticResource AccentBgBrush}" BorderBrush="{StaticResource AccentBrush}"
                                                BorderThickness="1" CornerRadius="{StaticResource RadiusSm}" Padding="8,3" VerticalAlignment="Top"
                                                Visibility="{Binding IsDlcUnlocked, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="{DynamicResource String_OverviewActiveBadge}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                                        </Border>
                                    </Grid>
                                    <Border Height="1" Background="{StaticResource SubtleBorderBrush}"/>

                                    <StackPanel Margin="18,13">
                                        <TextBlock Text="{DynamicResource String_TabMods}" Style="{StaticResource CaptionBold}"
                                                   Foreground="{StaticResource MutedTextBrush}"/>
                                        <TextBlock Text="{Binding ModsSummaryText}" Style="{StaticResource BodyMedium}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Storage -->
                            <Border Style="{StaticResource Card}" Margin="0,0,0,18">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource String_OverviewStorageTitle}" Style="{StaticResource H3}" Margin="0,0,0,14"/>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{DynamicResource String_OverviewSizeLabel}" Style="{StaticResource CaptionBold}"
                                                   Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Bottom"
                                                   TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding InstalledSizeText}" Style="{StaticResource H3}"
                                                   Foreground="{StaticResource AccentBrush}" VerticalAlignment="Bottom"/>
                                    </Grid>

                                    <!-- Drive meter: this game / everything else / free -->
                                    <StackPanel Visibility="{Binding HasStorageMeter, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Border CornerRadius="{StaticResource RadiusXs}" Height="10" ClipToBounds="True"
                                                Background="{StaticResource SurfaceInputBrush}" Margin="0,0,0,9">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="{Binding GameSharePercent, Converter={StaticResource PercentToStarLengthConverter}}"/>
                                                    <ColumnDefinition Width="{Binding DriveOtherPercent, Converter={StaticResource PercentToStarLengthConverter}}"/>
                                                    <ColumnDefinition Width="{Binding DriveFreePercent, Converter={StaticResource PercentToStarLengthConverter}}"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="{StaticResource AccentBrush}" MinWidth="3"/>
                                                <Border Grid.Column="1" Background="{StaticResource StrongBorderBrush}"/>
                                                <Border Grid.Column="2" Background="Transparent"/>
                                            </Grid>
                                        </Border>

                                        <WrapPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,14,4">
                                                <Ellipse Width="7" Height="7" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock Text="{DynamicResource String_OverviewMeterThisGame}" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,14,4">
                                                <Ellipse Width="7" Height="7" Fill="{StaticResource StrongBorderBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock Text="{DynamicResource String_OverviewMeterOther}" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </WrapPanel>

                                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,14"
                                                   Foreground="{StaticResource MutedTextBrush}">
                                            <Run Text="{Binding DriveLabel, Mode=OneWay}"/>
                                            <Run Text=" · "/>
                                            <Run Text="{Binding DriveFreeText, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>

                                    <TextBlock Text="{DynamicResource String_InstallationDirLabel}" Style="{StaticResource CaptionBold}"
                                               Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,6"/>
                                    <Border Background="{StaticResource SurfaceInputBrush}" CornerRadius="{StaticResource RadiusSm}" Padding="11,8" Margin="0,0,0,12">
                                        <TextBlock Text="{Binding Instance.InstallPath}" Style="{StaticResource Caption}"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Instance.InstallPath}"/>
                                    </Border>

                                    <TextBlock Text="{DynamicResource String_PrimaryExecutableLabel}" Style="{StaticResource CaptionBold}"
                                               Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,6"/>
                                    <Border Background="{StaticResource SurfaceInputBrush}" CornerRadius="{StaticResource RadiusSm}" Padding="11,8" Margin="0,0,0,14">
                                        <TextBlock Text="{Binding ConfiguredExecutablePath}" Style="{StaticResource Caption}"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding ConfiguredExecutablePath}"/>
                                    </Border>

                                    <Button Content="{DynamicResource String_ChangeDirBtn}" Style="{StaticResource SecondaryButton}"
                                            Padding="14,9" Command="{Binding ChangeInstallPathCommand}"/>
                                </StackPanel>
                            </Border>

                            <!-- Quick actions -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource String_QuickActionsTitle}" Style="{StaticResource H3}" Margin="0,0,0,12"/>
                                    <Button Style="{StaticResource SecondaryButton}" Padding="14,9" Margin="0,0,0,8" Command="{Binding OpenFolderCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📁 "/>
                                            <TextBlock Text="{DynamicResource String_OpenGameFolder}"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource SecondaryButton}" Padding="14,9" Margin="0,0,0,8" Command="{Binding OpenShortcutModalCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🔗 "/>
                                            <TextBlock Text="{DynamicResource String_CreatingShortcuts}"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Content="{Binding ReFixUpdateButtonText}"
                                            Style="{StaticResource PrimaryButton}" Padding="14,9"
                                            Command="{Binding UpdateInstanceReFixCommand}"
                                            IsEnabled="{Binding CanDeployEmulator}"
                                            Visibility="{Binding IsReFixUpdateAvailableForInstance, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </StackPanel>
                <!-- ── 2. VERSION TAB (four intent-based download modes) ── -->
                <StackPanel Visibility="{Binding SelectedTab, Converter={StaticResource StringMatchToVisibilityConverter}, ConverterParameter=Files}">

                    <TextBlock Text="{DynamicResource String_VersionPaneTitle}" Style="{StaticResource H2}"/>
                    <TextBlock Text="{DynamicResource String_VersionPaneDesc}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,5,0,14"/>

                    <!-- ═══ MODE PICKER ═══ -->
                    <UniformGrid Rows="1" Margin="0,0,0,16">
                        <RadioButton Style="{StaticResource VersionModeCard}"
                                     GroupName="VersionModes"
                                     IsChecked="{Binding IsVersionModeLatest, Mode=OneWay}"
                                     Command="{Binding SelectVersionModeCommand}" CommandParameter="Latest">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                    <Path Data="{StaticResource IconRefresh}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                    <TextBlock Text="{DynamicResource String_VersionModeLatest}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{DynamicResource String_VersionModeLatestDesc}" Style="{StaticResource Caption}"
                                           TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </RadioButton>

                        <!-- Only rendered when a curated build actually exists for this AppID -->
                        <RadioButton Style="{StaticResource VersionModeCard}"
                                     GroupName="VersionModes"
                                     Visibility="{Binding HasCurationRecommendation, Converter={StaticResource BoolToVisibilityConverter}}"
                                     IsChecked="{Binding IsVersionModeCurated, Mode=OneWay}"
                                     Command="{Binding SelectVersionModeCommand}" CommandParameter="Curated">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                    <Path Data="{StaticResource IconStar}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                    <TextBlock Text="{DynamicResource String_VersionModeCurated}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{DynamicResource String_VersionModeCuratedDesc}" Style="{StaticResource Caption}"
                                           TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource VersionModeCard}"
                                     GroupName="VersionModes"
                                     IsChecked="{Binding IsVersionModeRollback, Mode=OneWay}"
                                     Command="{Binding SelectVersionModeCommand}" CommandParameter="Rollback">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                    <Path Data="{StaticResource IconArrowLeft}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                    <TextBlock Text="{DynamicResource String_VersionModeRollback}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{DynamicResource String_VersionModeRollbackDesc}" Style="{StaticResource Caption}"
                                           TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource VersionModeCard}"
                                     GroupName="VersionModes"
                                     IsChecked="{Binding IsVersionModeCustom, Mode=OneWay}"
                                     Command="{Binding SelectVersionModeCommand}" CommandParameter="Custom">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                    <Path Data="{StaticResource IconFilter}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                    <TextBlock Text="{DynamicResource String_VersionModeCustom}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{DynamicResource String_VersionModeCustomDesc}" Style="{StaticResource Caption}"
                                           TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </RadioButton>
                    </UniformGrid>

                    <!-- ═══════════ MODE 1 · LATEST ═══════════ -->
                    <StackPanel Visibility="{Binding IsVersionModeLatest, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border Style="{StaticResource Card}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding LatestBuildIdText, StringFormat='Build {0}'}" Style="{StaticResource H3}" VerticalAlignment="Center"/>
                                            <Border Background="{StaticResource AccentBgBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"
                                                    CornerRadius="{StaticResource RadiusSm}" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding LatestBuildBranchText}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding LatestBuildDateText}" Style="{StaticResource Caption}" Margin="0,5,0,0"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedDepotsSize}" Style="{StaticResource H3}"
                                               Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                                </Grid>

                                <Border Background="{StaticResource SurfaceInputBrush}" CornerRadius="{StaticResource RadiusMd}" Padding="14,11">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="{StaticResource SuccessBgBrush}" BorderBrush="{StaticResource SuccessBorderBrush}"
                                                BorderThickness="1" CornerRadius="{StaticResource RadiusSm}" Padding="8,2" Margin="0,0,12,0" VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource String_VersionAutoBadge}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding AutoSelectionSummary}" Style="{StaticResource BodyMedium}"/>
                                            <TextBlock Text="{Binding AutoSelectionSkippedSummary}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="{DynamicResource String_VersionToggleDetail}"
                                                Style="{StaticResource GhostButton}" Padding="10,5" FontSize="11"
                                                Command="{Binding ToggleLatestDepotDetailCommand}"/>
                                    </Grid>
                                </Border>

                                <!-- Depot-by-depot detail, folded away by default -->
                                <ItemsControl ItemsSource="{Binding Depots}" Margin="0,8,0,0"
                                              Visibility="{Binding IsLatestDepotDetailExpanded, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource SurfaceInputBrush}" CornerRadius="{StaticResource RadiusMd}"
                                                    Padding="14,10" Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DisplayName}" Style="{StaticResource BodyMedium}"/>
                                                        <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0">
                                                            <Run Text="{Binding Depot.DepotId, Mode=OneWay, StringFormat='Depot {0}'}"/>
                                                            <Run Text=" · "/>
                                                            <Run Text="{Binding ManifestIdText, Mode=OneWay}"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                                                        <Border Background="{StaticResource InfoBgBrush}" BorderBrush="{StaticResource InfoBrush}" BorderThickness="1"
                                                                CornerRadius="{StaticResource RadiusSm}" Padding="8,2" Margin="0,0,6,0">
                                                            <TextBlock Text="{Binding PlatformTag}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource InfoBrush}"/>
                                                        </Border>
                                                        <Border Background="{StaticResource PurpleBgBrush}" BorderBrush="{StaticResource PurpleBrush}" BorderThickness="1"
                                                                CornerRadius="{StaticResource RadiusSm}" Padding="6,2"
                                                                Visibility="{Binding ArchitectureTag, Converter={StaticResource NullToVisibilityConverter}}">
                                                            <TextBlock Text="{Binding ArchitectureTag}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource PurpleBrush}"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="3" Text="{Binding FormattedSize}" Style="{StaticResource CaptionBold}"
                                                               VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border Background="{StaticResource SurfaceInputBrush}" CornerRadius="{StaticResource RadiusMd}" Padding="14,11" Margin="0,8,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{DynamicResource String_VersionUpdatesLabel}" Style="{StaticResource CaptionBold}"
                                                   VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <TextBlock Grid.Column="1" Text="{DynamicResource String_VersionUpdatesOnDesc}" Style="{StaticResource Caption}"
                                                   TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,4,0,0"/>
                                        <Border Grid.Column="2" Background="{StaticResource SuccessBgBrush}" BorderBrush="{StaticResource SuccessBorderBrush}"
                                                BorderThickness="1" CornerRadius="{StaticResource RadiusSm}" Padding="8,2" VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource String_VersionUpdatesOnBadge}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource BodyMedium}">
                                        <Run Text="{Binding SelectedDepotsCount, Mode=OneWay}"/>
                                        <Run Text="{DynamicResource String_VersionDepotsSelectedSuffix}"/>
                                        <Run Text=" — "/>
                                        <Run Text="{Binding SelectedDepotsSize, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                                    </TextBlock>
                                    <TextBlock Text="{DynamicResource String_VersionLayersNotice}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="{Binding DownloadButtonText}"
                                        Style="{StaticResource PrimaryButton}" Padding="18,11"
                                        Command="{Binding DownloadSelectedDepotsCommand}"
                                        IsEnabled="{Binding CanStartDownload}"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- ═══════════ MODE 2 · CURATED ═══════════ -->
                    <StackPanel Visibility="{Binding IsVersionModeCurated, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border Style="{StaticResource Card}" BorderBrush="{StaticResource PurpleBrush}" BorderThickness="1" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding CuratedBuildIdText, StringFormat='Build {0}'}" Style="{StaticResource H3}" VerticalAlignment="Center"/>
                                            <Border Background="{StaticResource PurpleBgBrush}" BorderBrush="{StaticResource PurpleBrush}" BorderThickness="1"
                                                    CornerRadius="{StaticResource RadiusSm}" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{DynamicResource String_VersionCuratedBadge}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource PurpleBrush}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding CuratedSourceText}" Style="{StaticResource Caption}" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="{Binding CuratedSummaryText}" Style="{StaticResource Body}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                                <Border Background="{StaticResource WarningBgBrush}" BorderBrush="{StaticResource WarningBrush}" BorderThickness="1"
                                        CornerRadius="{StaticResource RadiusMd}" Padding="12,9" Margin="0,0,0,12"
                                        Visibility="{Binding HasCuratedNotes, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="{Binding CuratedNotesText}" Style="{StaticResource Caption}" TextWrapping="Wrap"
                                               Foreground="{StaticResource WarningBrush}" Margin="0,4,0,0"/>
                                </Border>

                                <Border Background="{StaticResource SurfaceInputBrush}" CornerRadius="{StaticResource RadiusMd}" Padding="14,10" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{DynamicResource String_VersionCuratedEmulatorLabel}" Style="{StaticResource CaptionBold}"
                                                   VerticalAlignment="Center" Margin="0,0,12,0" MinWidth="120"/>
                                        <TextBlock Grid.Column="1" Text="{Binding CuratedEmulatorText}" Style="{StaticResource Body}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <Border Background="{StaticResource SurfaceInputBrush}" CornerRadius="{StaticResource RadiusMd}" Padding="14,10" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{DynamicResource String_VersionCuratedPinnedLabel}" Style="{StaticResource CaptionBold}"
                                                   VerticalAlignment="Center" Margin="0,0,12,0" MinWidth="120"/>
                                        <TextBlock Grid.Column="1" Text="{Binding CuratedPinnedCountText}" Style="{StaticResource Body}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <Border Background="{StaticResource SurfaceInputBrush}" CornerRadius="{StaticResource RadiusMd}" Padding="14,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{DynamicResource String_VersionUpdatesLabel}" Style="{StaticResource CaptionBold}"
                                                   VerticalAlignment="Center" Margin="0,0,12,0" MinWidth="120"/>
                                        <TextBlock Grid.Column="1" Text="{DynamicResource String_VersionUpdatesOffDesc}" Style="{StaticResource Caption}"
                                                   TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,4,0,0"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{DynamicResource String_VersionCuratedApplyTitle}" Style="{StaticResource BodyMedium}"/>
                                    <TextBlock Text="{DynamicResource String_VersionCuratedApplyDesc}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="{DynamicResource String_VersionCuratedApplyBtn}"
                                        Style="{StaticResource PrimaryButton}" Padding="18,11"
                                        Command="{Binding ApplyCuratedBuildCommand}"
                                        IsEnabled="{Binding IsApplyingGameUpdate, Converter={StaticResource InverseBoolConverter}}"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- ═══════════ MODE 3 · ROLLBACK ═══════════ -->
                    <StackPanel Visibility="{Binding IsVersionModeRollback, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{DynamicResource String_VersionRollbackDesc}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,12"
                                Visibility="{Binding HasRollbackBuilds, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource String_VersionRollbackEmptyTitle}" Style="{StaticResource BodyMedium}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource String_VersionRollbackEmptyDesc}" Style="{StaticResource Caption}"
                                           TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <ItemsControl ItemsSource="{Binding RollbackBuilds}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource SurfaceInputBrush}"
                                            BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1"
                                            CornerRadius="{StaticResource RadiusMd}" Padding="14,11" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" CornerRadius="{StaticResource RadiusSm}" Padding="8,2" Margin="0,0,12,0"
                                                    VerticalAlignment="Center" BorderThickness="1">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{StaticResource SuccessBgBrush}"/>
                                                        <Setter Property="BorderBrush" Value="{StaticResource SuccessBorderBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCurrentBuild}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource AccentBgBrush}"/>
                                                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsFullyCached}" Value="False">
                                                                <Setter Property="Background" Value="{StaticResource DangerBgBrush}"/>
                                                                <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding CacheBadgeText}" FontSize="11" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource BadgeText}">
                                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCurrentBuild}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsFullyCached}" Value="False">
                                                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding TitleText}" Style="{StaticResource BodyMedium}"/>
                                                <TextBlock Text="{Binding DetailText}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                            </StackPanel>

                                            <TextBlock Grid.Column="2" Text="{Binding SizeText}" Style="{StaticResource CaptionBold}"
                                                       VerticalAlignment="Center" Margin="12,0,14,0" Foreground="{StaticResource AccentBrush}"/>

                                            <Button Grid.Column="3" Content="{DynamicResource String_VersionRollbackBtn}"
                                                    Style="{StaticResource SecondaryButton}" Padding="14,7" FontSize="12"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding IsCurrentBuild, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                                                    IsEnabled="{Binding CanRestore}"
                                                    Command="{Binding DataContext.RollbackToBuildCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Background="{StaticResource SurfaceInputBrush}" CornerRadius="{StaticResource RadiusMd}" Padding="14,11" Margin="0,6,0,0">
                            <TextBlock Text="{DynamicResource String_VersionRollbackHint}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </Border>
                    </StackPanel>

                    <!-- ═══════════ MODE 4 · CUSTOM MANIFESTS ═══════════ -->
                    <StackPanel Visibility="{Binding IsVersionModeCustom, Converter={StaticResource BoolToVisibilityConverter}}"
                                AllowDrop="True" Drop="DepotDropZone_Drop" DragOver="DepotDropZone_DragOver">

                        <!-- ═══ SAVED CUSTOM BUILDS ═══
                             Manifest sets the user kept, as chips. Click one to fill the table. -->
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12"
                                Visibility="{Binding HasSavedCustomBuilds, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource String_VersionPresetsTitle}" Style="{StaticResource H3}"/>
                                <TextBlock Text="{DynamicResource String_VersionPresetsDesc}" Style="{StaticResource Caption}"
                                           TextWrapping="Wrap" Margin="0,5,0,12"/>
                                <ItemsControl ItemsSource="{Binding SavedCustomBuilds}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource SurfaceInputBrush}"
                                                    BorderBrush="{StaticResource StrongBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="{StaticResource RadiusMd}"
                                                    Padding="4,4,6,4" Margin="0,0,8,8">
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Style="{StaticResource GhostButton}"
                                                            Padding="10,5"
                                                            ToolTip="{DynamicResource String_VersionPresetApplyTooltip}"
                                                            Command="{Binding DataContext.ApplyCustomBuildPresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding PresetTitle}" Style="{StaticResource BodyMedium}"
                                                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="230"/>
                                                            <TextBlock Text="{Binding PresetDetail}" Style="{StaticResource Caption}"
                                                                       Foreground="{StaticResource MutedTextBrush}"
                                                                       TextTrimming="CharacterEllipsis" MaxWidth="230" Margin="0,4,0,0"/>
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Style="{StaticResource GhostButton}"
                                                            Content="✕" FontSize="11" Padding="7,0"
                                                            VerticalAlignment="Center"
                                                            Foreground="{StaticResource MutedTextBrush}"
                                                            ToolTip="{DynamicResource String_VersionPresetDeleteTooltip}"
                                                            Command="{Binding DataContext.DeleteCustomBuildPresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,0,0,12">
                            <!-- Proportional, not fixed: a 180px column clipped the Spanish label
                                 and left the name field cramped on a narrow window. -->
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="120"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="2*" MinWidth="160"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{DynamicResource String_VersionCustomBuildIdLabel}" Style="{StaticResource CaptionBold}"
                                           TextTrimming="CharacterEllipsis" Margin="0,0,0,6"/>
                                <!-- No fixed Height: the style's padding plus the line box decide it.
                                     A hard 34px clipped descenders on both of these fields. -->
                                <TextBox Style="{StaticResource DarkTextBox}" MinHeight="36"
                                         VerticalContentAlignment="Center"
                                         Text="{Binding CustomVersionBuildId, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{DynamicResource String_VersionCustomBuildNameLabel}" Style="{StaticResource CaptionBold}"
                                           TextTrimming="CharacterEllipsis" Margin="0,0,0,6"/>
                                <TextBox Style="{StaticResource DarkTextBox}" MinHeight="36"
                                         VerticalContentAlignment="Center"
                                         Text="{Binding CustomVersionBuildName, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4" VerticalAlignment="Bottom">
                                <Button Content="{DynamicResource String_ImportFromManifestFilesBtn}"
                                        Style="{StaticResource SecondaryButton}" Padding="14,9" MinHeight="36"
                                        Command="{Binding ImportManifestFilesDirectlyCommand}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Manifest table: one editable row per depot, with provenance and key state -->
                        <Border Background="{StaticResource SurfaceInputBrush}" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1"
                                CornerRadius="{StaticResource RadiusMd}" Margin="0,0,0,10">
                            <StackPanel>
                                <Border Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource SubtleBorderBrush}"
                                        BorderThickness="0,0,0,1" Padding="14,8" CornerRadius="6,6,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.4*"/>
                                            <ColumnDefinition Width="1.7*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{DynamicResource String_VersionCustomColDepot}" Style="{StaticResource CaptionBold}" Foreground="{StaticResource MutedTextBrush}"/>
                                        <TextBlock Grid.Column="1" Text="{DynamicResource String_VersionCustomColManifest}" Style="{StaticResource CaptionBold}" Foreground="{StaticResource MutedTextBrush}" Margin="12,0,0,0"/>
                                        <TextBlock Grid.Column="2" Text="{DynamicResource String_VersionCustomColState}" Style="{StaticResource CaptionBold}" Foreground="{StaticResource MutedTextBrush}" Margin="12,0,0,0"/>
                                    </Grid>
                                </Border>

                                <ItemsControl ItemsSource="{Binding Depots}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="0,0,0,1" Padding="14,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="1.4*"/>
                                                        <ColumnDefinition Width="1.7*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                                        <TextBlock Text="{Binding DisplayName}" Style="{StaticResource BodyMedium}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0">
                                                            <Run Text="{Binding Depot.DepotId, Mode=OneWay}"/>
                                                            <Run Text=" · "/>
                                                            <Run Text="{Binding PlatformTag, Mode=OneWay}"/>
                                                        </TextBlock>
                                                    </StackPanel>

                                                    <!-- TextSearch.TextPath is what keeps the editable text box showing the bare
                                                         manifest id. Without it WPF falls back to the item's ToString(), which is the
                                                         full label ("123… (Current - Steam)") — and that text is what got written back
                                                         into ManifestInputText, so every depot read as an invalid id. -->
                                                    <ComboBox Grid.Column="1" Style="{StaticResource CompactDarkComboBox}"
                                                              IsEditable="True" Margin="0,0,12,0" VerticalAlignment="Center"
                                                              ItemsSource="{Binding KnownManifestVersions}"
                                                              SelectedItem="{Binding SelectedManifestOption}"
                                                              TextSearch.TextPath="ManifestIdString"
                                                              Text="{Binding ManifestInputText, UpdateSourceTrigger=PropertyChanged}"
                                                              ToolTip="{DynamicResource String_SelectManifestVersion}">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Margin="0,2">
                                                                    <TextBlock Text="{Binding ManifestIdString}" FontSize="11"
                                                                               FontFamily="{StaticResource MonospaceFontFamily}"
                                                                               Foreground="{StaticResource PrimaryTextBrush}"
                                                                               TextTrimming="CharacterEllipsis"/>
                                                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                                        <TextBlock Text="{Binding DisplayText}" FontSize="10"
                                                                                   Foreground="{StaticResource MutedTextBrush}"
                                                                                   TextTrimming="CharacterEllipsis" MaxWidth="220"/>
                                                                        <Border CornerRadius="{StaticResource RadiusSm}" Padding="5,0" Margin="6,0,0,0"
                                                                                Background="{StaticResource DangerBgBrush}"
                                                                                Visibility="{Binding IsBacked, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                                                            <TextBlock Text="{DynamicResource String_ManifestNeedsFetch}" FontSize="9"
                                                                                       FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}"/>
                                                                        </Border>
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>

                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                                        <Border Background="{StaticResource SurfaceCardBrush}" BorderBrush="{Binding AvailabilityBadgeColor}"
                                                                BorderThickness="1" CornerRadius="{StaticResource RadiusSm}" Padding="8,3" Margin="0,0,6,0">
                                                            <TextBlock Text="{Binding AvailabilityStatus}" FontSize="10" FontWeight="SemiBold"
                                                                       Foreground="{Binding AvailabilityBadgeColor}"/>
                                                        </Border>
                                                        <Border Background="{StaticResource SurfaceCardBrush}" BorderThickness="1"
                                                                CornerRadius="{StaticResource RadiusSm}" Padding="8,3">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="BorderBrush" Value="{StaticResource SuccessBorderBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsKeyAvailable}" Value="False">
                                                                            <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding KeyStatusBadge}" FontSize="10" FontWeight="SemiBold">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource BadgeText}">
                                                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsKeyAvailable}" Value="False">
                                                                                <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Content="🔍" Style="{StaticResource GhostButton}" Padding="7,3" Height="28" FontSize="11"
                                                                ToolTip="{DynamicResource String_VerifyManifestAvailabilityTooltip}"
                                                                Command="{Binding VerifyAvailabilityCommand}"/>
                                                        <Button Content="{Binding LockIcon}" Style="{StaticResource GhostButton}" Padding="7,3" Height="28" FontSize="11"
                                                                Margin="3,0,0,0" ToolTip="{Binding LockTooltip}"
                                                                Command="{Binding ToggleManifestLockCommand}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border BorderBrush="{StaticResource StrongBorderBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusMd}"
                                Padding="16,13" Margin="0,0,0,10" Background="Transparent">
                            <TextBlock Text="{DynamicResource String_VersionCustomDropHint}" Style="{StaticResource Caption}"
                                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </Border>

                        <!-- Validation strip: names the actual problem and gates the button -->
                        <Border CornerRadius="{StaticResource RadiusMd}" Padding="14,11" Margin="0,0,0,10" BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource DangerBgBrush}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource DangerBorderBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCustomBuildValid}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource SuccessBgBrush}"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource SuccessBorderBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding CustomBuildValidationMessage}" TextWrapping="Wrap" FontSize="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Body}">
                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCustomBuildValid}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{Binding CustomBuildReadySummary}" Style="{StaticResource BodyMedium}"/>
                                    <TextBlock Text="{DynamicResource String_VersionCustomFooterDesc}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="{DynamicResource String_VersionCustomSaveBtn}"
                                        Style="{StaticResource SecondaryButton}" Padding="14,10"
                                        Command="{Binding SaveCustomBuildCommand}"/>
                                <Button Grid.Column="3" Content="{DynamicResource String_VersionCustomDownloadBtn}"
                                        Style="{StaticResource PrimaryButton}" Padding="18,10"
                                        Command="{Binding DownloadCustomBuildCommand}"
                                        IsEnabled="{Binding IsCustomBuildValid}"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- ═══ IMPORT / BUILD SOURCES (shared across modes) ═══ -->
                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource String_GameBuildBranchTitle}" Style="{StaticResource H3}"/>
                            <TextBlock Text="{DynamicResource String_GameBuildBranchDesc}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,5,0,12"/>

                            <ComboBox ItemsSource="{Binding AvailableBuilds}"
                                      SelectedItem="{Binding SelectedBuild, Mode=TwoWay}"
                                      Style="{StaticResource DarkComboBox}"
                                      HorizontalAlignment="Stretch" Margin="0,0,0,12">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
                                                <TextBlock Text="{Binding Description, FallbackValue=''}" Style="{StaticResource Caption}" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                                <TextBlock Text="{Binding FormattedDate}" Style="{StaticResource Caption}" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,8,0"/>
                                                <Border Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusSm}" Padding="6,1">
                                                    <TextBlock Text="{Binding Source}" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}"/>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <WrapPanel Orientation="Horizontal">
                                <Button Content="{DynamicResource String_ImportZipPackageBtn}" Style="{StaticResource PrimaryButton}"
                                        Padding="14,8" Margin="0,0,8,6" Command="{Binding ImportDepotZipPackageCommand}"/>
                                <Button Content="{DynamicResource String_ScanBuildsBtn}" Style="{StaticResource SecondaryButton}"
                                        Padding="12,8" Margin="0,0,8,6" FontSize="11"
                                        Command="{Binding LoadAvailableBuildsCommand}"
                                        IsEnabled="{Binding IsLoadingBuilds, Converter={StaticResource InverseBoolConverter}}"/>
                                <Button Content="{DynamicResource String_SourcesMenuBtn}" Style="{StaticResource GhostButton}"
                                        Padding="12,8" Margin="0,0,0,6" FontSize="11"
                                        Command="{Binding ToggleCommunityLinksMenuCommand}"/>
                            </WrapPanel>

                            <Border Background="{StaticResource SurfaceInputBrush}" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusMd}" Padding="14,10" Margin="0,10,0,0"
                                    Visibility="{Binding IsCommunityLinksMenuOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="{DynamicResource String_CommunitySourcesTitle}" Style="{StaticResource CaptionBold}"/>
                                        <Button Content="✕" Style="{StaticResource GhostButton}" HorizontalAlignment="Right"
                                                Padding="4,0" FontSize="11" Command="{Binding CloseCommunityLinksMenuCommand}"/>
                                    </Grid>
                                    <WrapPanel Orientation="Horizontal">
                                        <Button Content="{DynamicResource String_SteamDbDepotsBtn}" Style="{StaticResource SecondaryButton}"
                                                Padding="10,5" Margin="0,0,8,6" FontSize="11"
                                                Command="{Binding OpenCommunityLinkCommand}" CommandParameter="steamdb_depots"/>
                                        <Button Content="{DynamicResource String_SteamDbPatchesBtn}" Style="{StaticResource SecondaryButton}"
                                                Padding="10,5" Margin="0,0,8,6" FontSize="11"
                                                Command="{Binding OpenCommunityLinkCommand}" CommandParameter="steamdb_patches"/>
                                        <Button Content="{DynamicResource String_CsRinRuThreadBtn}" Style="{StaticResource SecondaryButton}"
                                                Padding="10,5" Margin="0,0,8,6" FontSize="11"
                                                Command="{Binding OpenCommunityLinkCommand}" CommandParameter="csrinru"/>
                                        <Button Content="{DynamicResource String_DepotBoxHubBtn}" Style="{StaticResource SecondaryButton}"
                                                Padding="10,5" Margin="0,0,8,6" FontSize="11"
                                                Command="{Binding OpenCommunityLinkCommand}" CommandParameter="depotbox"/>
                                        <Button Content="{DynamicResource String_OpenManifestsFolderBtn}" Style="{StaticResource GhostButton}"
                                                Padding="10,5" Margin="0,0,0,6" FontSize="11"
                                                Command="{Binding OpenCommunityLinkCommand}" CommandParameter="manifest_dir"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <!-- ── 3. DLCS & UNLOCKER TAB ── -->
                <StackPanel Visibility="{Binding SelectedTab, Converter={StaticResource StringMatchToVisibilityConverter}, ConverterParameter=Dlcs}">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <!-- DLC Header & Selection Controls -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{DynamicResource String_DlcsHeaderTitle}" Style="{StaticResource H2}"/>
                                    <TextBlock Text="{DynamicResource String_DlcsHeaderDesc}" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="{DynamicResource String_SelectAllDlcs}"
                                            Style="{StaticResource SecondaryButton}"
                                            Padding="10,6" Margin="0,0,6,0" FontSize="11"
                                            Command="{Binding SelectAllDlcsCommand}"/>
                                    <Button Content="{DynamicResource String_DeselectAllDlcs}"
                                            Style="{StaticResource SecondaryButton}"
                                            Padding="10,6" Margin="0,0,8,0" FontSize="11"
                                            Command="{Binding DeselectAllDlcsCommand}"/>
                                    <Button Content="{Binding DlcActionButtonText}"
                                            Style="{StaticResource PrimaryButton}"
                                            Padding="14,6" FontSize="11"
                                            Command="{Binding DownloadAndInstallDlcsCommand}"
                                            IsEnabled="{Binding CanDownloadAndInstallDlcs}"
                                            Visibility="{Binding IsDlcUnlocked, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                    <Button Content="{DynamicResource String_Uninstall}"
                                            Style="{StaticResource DangerButton}"
                                            Padding="14,6" FontSize="11"
                                            Command="{Binding UninstallDlcUnlockerCommand}"
                                            IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBoolConverter}}"
                                            Visibility="{Binding IsDlcUnlocked, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </StackPanel>
                            </Grid>

                            <!-- DLC Unlocker Method Selector -->
                            <Border Background="{StaticResource SurfaceInputBrush}" CornerRadius="{StaticResource RadiusMd}"
                                    Padding="14,10" Margin="0,0,0,16" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource String_DlcMethodSettingTitle}" Style="{StaticResource CaptionBold}"/>
                                        <TextBlock Text="{DynamicResource String_DlcMethodSettingDesc}" Style="{StaticResource Caption}" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <RadioButton Content="CreamAPI"
                                                     GroupName="TabDlcsUnlockerMethodGroup"
                                                     IsChecked="{Binding IsCreamApiSelected}"
                                                     Foreground="{StaticResource PrimaryTextBrush}"
                                                     FontSize="12"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,16,0"
                                                     ToolTip="{DynamicResource String_InstallModalCreamApiDesc}"/>
                                        <RadioButton Content="SmokeAPI"
                                                     GroupName="TabDlcsUnlockerMethodGroup"
                                                     IsChecked="{Binding IsSmokeApiSelected}"
                                                     Foreground="{StaticResource PrimaryTextBrush}"
                                                     FontSize="12"
                                                     VerticalAlignment="Center"
                                                     ToolTip="{DynamicResource String_InstallModalSmokeApiDesc}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- DLCs List -->
                            <ItemsControl ItemsSource="{Binding Dlcs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource SurfaceInputBrush}" CornerRadius="{StaticResource RadiusMd}"
                                                Padding="14,10" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="77"/>
                                                    <ColumnDefinition Width="14"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,12,0"/>

                                                <!-- DLC Thumbnail (Standard 460:215 aspect ratio: 77x36) -->
                                                <Border Grid.Column="1" CornerRadius="4" ClipToBounds="True" Width="77" Height="36" Background="{StaticResource SurfaceCardBrush}">
                                                    <Image Source="{Binding HeaderImageUrl, Converter={StaticResource CachedImageConverter}}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                </Border>

                                                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayName}" Style="{StaticResource BodyMedium}"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                        <TextBlock Text="{Binding Dlc.AppId, StringFormat='DLC AppID: {0}'}" Style="{StaticResource Caption}" Margin="0,0,10,0"/>
                                                        <Border Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusXs}" Padding="6,1" Margin="0,0,6,0">
                                                            <TextBlock Text="{Binding CategoryTag}" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}"/>
                                                        </Border>
                                                    </StackPanel>
                                                </StackPanel>

                                                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <!-- Installed Status Badge -->
                                                    <Border Background="{StaticResource SuccessBgBrush}" BorderBrush="{StaticResource SuccessBorderBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusSm}" Padding="8,2" Margin="0,0,8,0"
                                                            Visibility="{Binding IsDownloaded, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <TextBlock Text="✓ Installed" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}"/>
                                                    </Border>
                                                    <!-- Unlocked Status Badge -->
                                                    <Border Background="{StaticResource AccentBgBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusSm}" Padding="8,2" Margin="0,0,10,0"
                                                            Visibility="{Binding IsUnlocked, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <TextBlock Text="{DynamicResource String_DlcUnlockedBadge}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding FormattedSize}" Style="{StaticResource CaptionBold}" Foreground="{StaticResource PurpleBrush}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- DLC Bottom Summary & Primary Action -->
                            <Border Height="1" Background="{StaticResource SubtleBorderBrush}" Margin="0,16,0,16"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource BodyMedium}">
                                        <Run Text="{Binding SelectedDlcsCount, Mode=OneWay}"/>
                                        <Run Text=" DLC(s) selected — "/>
                                        <Run Text="{Binding SelectedDlcsSize, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                                    </TextBlock>
                                    <TextBlock Text="{DynamicResource String_DlcsBottomNotice}" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="{Binding DlcActionButtonText}"
                                            Style="{StaticResource PrimaryButton}"
                                            Padding="18,10"
                                            Command="{Binding DownloadAndInstallDlcsCommand}"
                                            IsEnabled="{Binding CanDownloadAndInstallDlcs}"
                                            Visibility="{Binding IsDlcUnlocked, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                    <Button Content="{DynamicResource String_Uninstall}"
                                            Style="{StaticResource DangerButton}"
                                            Padding="18,10"
                                            Command="{Binding UninstallDlcUnlockerCommand}"
                                            IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBoolConverter}}"
                                            Visibility="{Binding IsDlcUnlocked, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ── 4. MODS TAB ── -->
                <StackPanel Visibility="{Binding SelectedTab, Converter={StaticResource StringMatchToVisibilityConverter}, ConverterParameter=Mods}">
                    
                    <!-- ═══ BEPINEX MOD LOADER SECTION (FOR UNITY GAMES) ═══ -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,18"
                            Visibility="{Binding IsUnityEngine, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="{DynamicResource String_BepInExLoaderTitle}" Style="{StaticResource H2}"/>
                                        <Border Background="{StaticResource PurpleBgBrush}"
                                                BorderBrush="{StaticResource PurpleBrush}"
                                                BorderThickness="1"
                                                CornerRadius="{StaticResource RadiusXs}"
                                                Padding="6,2" Margin="10,0,0,0"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="Unity Engine" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource PurpleBrush}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{DynamicResource String_BepInExDesc}"
                                               Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                                </StackPanel>

                                <!-- Installed Status Badge -->
                                <Border Grid.Column="1" VerticalAlignment="Center"
                                        Background="{StaticResource SurfaceInputBrush}"
                                        BorderBrush="{StaticResource SubtleBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource RadiusSm}"
                                        Padding="10,6">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{StaticResource MutedTextBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsBepInExInstalled}" Value="True">
                                                            <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Body}">
                                                    <Setter Property="Text" Value="Not Installed"/>
                                                    <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsBepInExInstalled}" Value="True">
                                                            <Setter Property="Text" Value="{Binding InstalledBepInExVersion, StringFormat='Installed ({0})', FallbackValue='Installed'}"/>
                                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- BepInEx Version Picker & Action Controls -->
                            <Grid Margin="0,4,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <ComboBox Grid.Column="0"
                                          Style="{StaticResource DarkComboBox}"
                                          ItemsSource="{Binding AvailableBepInExVersions}"
                                          SelectedItem="{Binding SelectedBepInExVersion}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding TagName}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,8,0"/>
                                                    <TextBlock Text="{Binding Version}" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                                </StackPanel>

                                                <!-- Architecture Badge: (x64) / (x86) -->
                                                <Border Grid.Column="1"
                                                        Background="{StaticResource SurfaceInputBrush}"
                                                        BorderBrush="{StaticResource SubtleBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="{StaticResource RadiusXs}"
                                                        Padding="6,1"
                                                        VerticalAlignment="Center"
                                                        Margin="8,0,0,0">
                                                    <TextBlock Text="{Binding Architecture}"
                                                               FontSize="10"
                                                               FontWeight="Bold"
                                                               FontFamily="Consolas, Segoe UI"
                                                               Foreground="{StaticResource AccentBrush}"/>
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <Button Grid.Column="2"
                                        Content="{DynamicResource String_InstallUpdateVersionBtn}"
                                        Style="{StaticResource PrimaryButton}"
                                        Command="{Binding InstallOrUpdateBepInExCommand}"
                                        IsEnabled="{Binding IsLoadingBepInEx, Converter={StaticResource InverseBoolConverter}}"/>

                                <Button Grid.Column="4"
                                        Content="{DynamicResource String_UninstallBepInExBtn}"
                                        Style="{StaticResource DangerButton}"
                                        Command="{Binding UninstallBepInExCommand}"
                                        IsEnabled="{Binding IsBepInExInstalled}"/>

                                <Button Grid.Column="6"
                                        Content="{DynamicResource String_OpenBepInExFolderBtn}"
                                        Style="{StaticResource SecondaryButton}"
                                        Command="{Binding OpenBepInExFolderCommand}"
                                        IsEnabled="{Binding IsBepInExInstalled}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ═══ STEAM WORKSHOP INTEGRATION BAR ═══ -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,18"
                            Visibility="{Binding HasWorkshopSupport, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                    <TextBlock Text="{DynamicResource String_WorkshopAvailableTitle}" Style="{StaticResource H3}"/>
                                    <Border Background="{StaticResource InfoBgBrush}" BorderBrush="{StaticResource InfoBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusXs}" Padding="5,1" Margin="8,0,0,0">
                                        <TextBlock Text="Community Hub" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource InfoBrush}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{DynamicResource String_WorkshopAvailableDesc}"
                                           Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="{DynamicResource String_BrowseWorkshopBtn}" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"
                                        Command="{Binding OpenSteamWorkshopInBrowserCommand}"/>
                                <Button Content="{DynamicResource String_DownloadWorkshopModBtn}" Style="{StaticResource PrimaryButton}"
                                        Command="{Binding OpenWorkshopModalCommand}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ═══ INSTALLED MODS & PACKAGES ═══ -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{DynamicResource String_InstalledModsTitle}" Style="{StaticResource H2}"/>
                                    <TextBlock Text="{Binding ModsDirectoryPath, StringFormat='Mods folder: {0}'}" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="{DynamicResource String_OpenFolder}" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Command="{Binding OpenModsFolderCommand}"/>
                                    <Button Content="{DynamicResource String_InstallModFileBtn}" Style="{StaticResource PrimaryButton}" Command="{Binding InstallModFileCommand}"/>
                                </StackPanel>
                            </Grid>

                            <!-- Empty Mods Notice -->
                            <Border Background="{StaticResource SurfaceInputBrush}" CornerRadius="{StaticResource RadiusMd}"
                                    Padding="24" Margin="0,0,0,0"
                                    Visibility="{Binding InstalledMods.Count, Converter={StaticResource ZeroToVisibilityConverter}}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="{DynamicResource String_NoModsInstalled}" Style="{StaticResource BodyMedium}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                    <TextBlock Text="{DynamicResource String_NoModsInstalledDesc}"
                                               Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Mods List -->
                            <ItemsControl ItemsSource="{Binding InstalledMods}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource SurfaceInputBrush}"
                                                BorderBrush="{StaticResource SubtleBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="{StaticResource RadiusMd}"
                                                Padding="16,12"
                                                Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="14"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Mod Title & Category -->
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource BodyMedium}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Category}" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                                                </StackPanel>

                                                <!-- Switch Toggle (Enable / Disable) -->
                                                <CheckBox Grid.Column="1"
                                                          Style="{StaticResource ToggleSwitch}"
                                                          IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                                          ToolTip="Enable / Disable mod"
                                                          Command="{Binding DataContext.ToggleModCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                          CommandParameter="{Binding}"/>

                                                <!-- Delete Button -->
                                                <Button Grid.Column="3"
                                                        Style="{StaticResource DangerButton}"
                                                        Width="34" Height="34" Padding="0"
                                                        ToolTip="Delete mod"
                                                        VerticalAlignment="Center"
                                                        HorizontalContentAlignment="Center"
                                                        VerticalContentAlignment="Center"
                                                        Command="{Binding DataContext.DeleteModCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                        CommandParameter="{Binding}">
                                                    <Path Data="{StaticResource IconTrash}"
                                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                          Stretch="Uniform"
                                                          Width="14" Height="14"
                                                          IsHitTestVisible="False"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                 </ItemsControl.ItemTemplate>
                             </ItemsControl>
                         </StackPanel>
                     </Border>
                 </StackPanel>

                 <!-- ── 5. EMULATOR TAB ── -->
                 <StackPanel Visibility="{Binding SelectedTab, Converter={StaticResource StringMatchToVisibilityConverter}, ConverterParameter=Emulator}">
                     
                     <!-- ═══ GAME NOT INSTALLED WARNING BANNER ═══ -->
                     <Border Margin="0,0,0,18" CornerRadius="{StaticResource RadiusMd}"
                             Background="{StaticResource WarningBgBrush}"
                             BorderBrush="{StaticResource WarningBrush}"
                             BorderThickness="1.5"
                             Padding="18,14"
                             Visibility="{Binding IsInstalled, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                         <Grid>
                             <Grid.ColumnDefinitions>
                                 <ColumnDefinition Width="Auto"/>
                                 <ColumnDefinition Width="*"/>
                             </Grid.ColumnDefinitions>
                             <TextBlock Grid.Column="0" Text="⚠" FontSize="22" Foreground="{StaticResource WarningBrush}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                             <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                 <TextBlock Text="{DynamicResource String_GameNotInstalledWarnTitle}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource WarningBrush}" Margin="0,0,0,2"/>
                                 <TextBlock Text="{DynamicResource String_GameNotInstalledWarnDesc}"
                                            Style="{StaticResource BodySmall}" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,4,0,0"/>
                             </StackPanel>
                         </Grid>
                     </Border>

                    <!-- ═══ EMULATOR DEPLOYMENT PROGRESS BAR (NON-INSTANTANEOUS) ═══ -->
                    <Border Margin="0,0,0,18" CornerRadius="{StaticResource RadiusMd}"
                            Background="{StaticResource SurfaceCardElevatedBrush}"
                            BorderBrush="{StaticResource AccentBrush}"
                            BorderThickness="1.5"
                            Padding="18,14"
                            Visibility="{Binding IsDeployProgressVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="⏳ " FontSize="13"/>
                                    <TextBlock Text="{Binding DeployProgressMessage}" Style="{StaticResource BodyMedium}" FontWeight="SemiBold"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding DeployProgress, StringFormat='{}{0:F0}%'}" Style="{StaticResource CaptionBold}" Foreground="{StaticResource AccentBrush}" FontSize="13"/>
                            </Grid>
                            <ProgressBar Value="{Binding DeployProgress}" Maximum="100" Height="8"
                                         Foreground="{StaticResource AccentBrush}"
                                         Background="{StaticResource SurfaceInputBrush}"
                                         BorderThickness="0"/>
                        </StackPanel>
                    </Border>

                    <!-- ═══ REFIX UPDATE AVAILABLE BANNER ═══ -->
                    <Border Margin="0,0,0,18" CornerRadius="{StaticResource RadiusMd}"
                            Background="{StaticResource WarningBgBrush}"
                            BorderBrush="{StaticResource WarningBrush}"
                            BorderThickness="1.5"
                            Padding="18,14"
                            Visibility="{Binding IsReFixUpdateAvailableForInstance, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="{DynamicResource String_ReFixUpdateAvailableTitle}"
                                               FontWeight="Bold" FontSize="14"
                                               Foreground="{StaticResource WarningBrush}"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource BodySmall}" Foreground="{StaticResource PrimaryTextBrush}">
                                    <Run Text="The launcher's ReFix suite has been updated to v"/>
                                    <Run Text="{Binding CurrentGlobalReFixVersion}" FontWeight="Bold" Foreground="{StaticResource WarningBrush}"/>
                                    <Run Text=". This instance has version v"/>
                                    <Run Text="{Binding InstanceReFixVersion}" FontWeight="Bold"/>
                                    <Run Text=" installed. Click the button to apply the update with 1 click."/>
                                </TextBlock>
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Content="{Binding ReFixUpdateButtonText}"
                                    Style="{StaticResource PrimaryButton}"
                                    Background="{StaticResource WarningBrush}"
                                    Padding="16,10"
                                    VerticalAlignment="Center"
                                    Command="{Binding UpdateInstanceReFixCommand}"
                                    IsEnabled="{Binding CanDeployEmulator}"/>
                        </Grid>
                    </Border>

                    <!-- ═══ 1. CURRENTLY INSTALLED EMULATOR CARD (EMULATOR STATUS) ═══ -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,18"
                            BorderBrush="{StaticResource AccentBrush}" BorderThickness="1.5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="{DynamicResource String_EmulatorStatusTitle}" Style="{StaticResource H2}"/>
                                    <Border Margin="12,0,0,0" VerticalAlignment="Center" CornerRadius="{StaticResource RadiusXs}" Padding="8,3">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource SurfaceInputBrush}"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEmulatorInstalled}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource SuccessBgBrush}"/>
                                                        <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="12" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Body}">
                                                    <Setter Property="Text" Value="Not Installed"/>
                                                    <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEmulatorInstalled}" Value="True">
                                                            <Setter Property="Text" Value="{Binding InstalledEmulatorMode, StringFormat='Installed: {0}', FallbackValue='Installed'}"/>
                                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{DynamicResource String_EmulatorStatusDesc}"
                                           Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                            </StackPanel>

                            <!-- Uninstall / Restore Action -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="{DynamicResource String_UninstallEmulatorBtn}"
                                        Style="{StaticResource DangerButton}"
                                        Padding="14,9"
                                        Command="{Binding UninstallEmulatorCommand}"
                                        IsEnabled="{Binding IsEmulatorInstalled}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ═══ 2. ACTIVE INSTALLED FIX LAYERS STACK (POSITIONED DIRECTLY BELOW EMULATOR STATUS) ═══ -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,18"
                            BorderBrush="#8B5CF6" BorderThickness="1.5"
                            Visibility="{Binding HasInstalledFixLayers, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="{DynamicResource String_ActiveFixLayersTitle}" Style="{StaticResource H2}"/>
                                <Border Background="{StaticResource SuccessBgBrush}" BorderBrush="{StaticResource SuccessBrush}" BorderThickness="1"
                                        CornerRadius="{StaticResource RadiusXs}" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding NonOnlineInstalledFixLayers.Count, StringFormat='{}{0} Stacked Layers'}"
                                               FontSize="11" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{DynamicResource String_ActiveFixLayersDesc}"
                                       Style="{StaticResource Caption}" Margin="0,0,0,16"/>

                            <ItemsControl ItemsSource="{Binding NonOnlineInstalledFixLayers}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource SurfaceInputBrush}"
                                                BorderBrush="{StaticResource SubtleBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="{StaticResource RadiusMd}"
                                                Padding="16,12" Margin="0,0,0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                        <TextBlock Text="{Binding DisplayName}" Style="{StaticResource BodyMedium}" FontWeight="Bold" Margin="0,0,10,0"/>
                                                        <Border Background="{StaticResource AccentBgBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusXs}" Padding="6,2" Margin="0,0,8,0">
                                                            <TextBlock Text="{Binding TagsSummary}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding DeployedFiles.Count, StringFormat='📁 {0} managed files'}" Style="{StaticResource Caption}" Margin="0,0,14,0"/>
                                                        <TextBlock Text="{Binding InstalledAt, StringFormat='🕒 Installed: {0:yyyy-MM-dd HH:mm}'}" Style="{StaticResource Caption}" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Uninstall Layer Button -->
                                                <Button Grid.Column="1"
                                                        Content="{DynamicResource String_UninstallLayerBtn}"
                                                        Style="{StaticResource DangerButton}"
                                                        Padding="14,8"
                                                        VerticalAlignment="Center"
                                                        Command="{Binding DataContext.UninstallFixLayerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        IsEnabled="{Binding DataContext.IsDeployingGameFix, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource InverseBoolConverter}}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- ═══ 3. TOP COMMUNITY RECOMMENDED BLOCK (HIGHLIGHTED) ═══ -->
                    <Border Margin="0,0,0,18" CornerRadius="{StaticResource RadiusMd}"
                            Background="{StaticResource AccentBgBrush}"
                            BorderBrush="{StaticResource AccentBrush}"
                            BorderThickness="1.5"
                            Padding="20"
                            Visibility="{Binding RecommendedEmulatorOption, Converter={StaticResource NullToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Border Background="{StaticResource AccentBrush}" CornerRadius="{StaticResource RadiusXs}" Padding="8,3" Margin="0,0,10,0">
                                        <TextBlock Text="{DynamicResource String_CommunityRecommendedBadge}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource InverseTextBrush}"/>
                                    </Border>
                                    <Border Background="{StaticResource SuccessBgBrush}" BorderBrush="{StaticResource SuccessBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusXs}" Padding="8,3"
                                            Visibility="{Binding RecommendedEmulatorOption.HasEnoughVotesForScore, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="{Binding RecommendedEmulatorOption.ScorePercentage, StringFormat='{}{0:F0}% success rate'}"
                                                   FontSize="11" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"/>
                                    </Border>
                                </StackPanel>

                                <TextBlock Text="{Binding RecommendedEmulatorOption.Name}" Style="{StaticResource H2}" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding RecommendedEmulatorOption.Description}" Style="{StaticResource Body}" Margin="0,0,0,10"/>

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding RecommendedEmulatorOption.PositiveVotes, StringFormat='👍 {0} upvotes'}"
                                               FontSize="12" Foreground="{StaticResource SuccessBrush}" Margin="0,0,14,0"/>
                                    <TextBlock Text="{Binding RecommendedEmulatorOption.NegativeVotes, StringFormat='👎 {0} downvotes'}"
                                               FontSize="12" Foreground="{StaticResource DangerBrush}" Margin="0,0,14,0"/>
                                    <TextBlock Text="{Binding RecommendedEmulatorOption.TotalVotes, StringFormat='(Total: {0} global votes)'}"
                                               FontSize="12" Foreground="{StaticResource MutedTextBrush}"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Green Shield with Checkmark (Tick) - Standalone Icon -->
                                <Viewbox Width="24" Height="24" Margin="0,0,14,0" Cursor="Hand" ToolTipService.InitialShowDelay="50" VerticalAlignment="Center">
                                    <Path Fill="{StaticResource SuccessBrush}"
                                          Data="M12 2L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-3zm-2 15l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"/>
                                    <Viewbox.ToolTip>
                                        <ToolTip Background="{StaticResource SurfaceCardElevatedBrush}" BorderBrush="{StaticResource SuccessBrush}" BorderThickness="1.5" Padding="14,10">
                                            <StackPanel MaxWidth="340">
                                                <TextBlock Text="{DynamicResource String_ShieldSafeTitle}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource SuccessBrush}" Margin="0,0,0,6" TextWrapping="Wrap"/>
                                                <TextBlock Text="{DynamicResource String_ShieldSafeB1}" Style="{StaticResource Caption}" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,3" TextWrapping="Wrap"/>
                                                <TextBlock Text="{DynamicResource String_ShieldSafeB2}" Style="{StaticResource Caption}" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,3" TextWrapping="Wrap"/>
                                                <TextBlock Text="{DynamicResource String_ShieldSafeB3}" Style="{StaticResource Caption}" Foreground="{StaticResource PrimaryTextBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </ToolTip>
                                    </Viewbox.ToolTip>
                                </Viewbox>

                                <Button Content="{DynamicResource String_InstallRecommendedOptionBtn}"
                                        Style="{StaticResource PrimaryButton}"
                                        Padding="18,12"
                                        Command="{Binding DeployEmulatorOptionCommand}"
                                        CommandParameter="{Binding RecommendedEmulatorOption}"
                                        IsEnabled="{Binding CanDeployEmulator}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ═══ 4. ALL REFIX EMULATOR OPTIONS LIST ═══ -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource String_AvailableEmulationOptionsTitle}" Style="{StaticResource H2}" Margin="0,0,0,4"/>
                            <TextBlock Text="{DynamicResource String_AvailableEmulationOptionsDesc}"
                                       Style="{StaticResource Caption}" Margin="0,0,0,16"/>

                            <ItemsControl ItemsSource="{Binding AvailableEmulatorOptions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource SurfaceInputBrush}"
                                                BorderBrush="{StaticResource SubtleBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="{StaticResource RadiusMd}"
                                                Padding="16,14" Margin="0,0,0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                        <TextBlock Text="{Binding Name}" Style="{StaticResource BodyMedium}" FontWeight="Bold" Margin="0,0,10,0"/>
                                                        <Border Background="{StaticResource InfoBgBrush}" BorderBrush="{StaticResource InfoBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusXs}" Padding="6,2" Margin="0,0,8,0">
                                                            <TextBlock Text="{Binding BadgeText}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource InfoBrush}"/>
                                                        </Border>
                                                        <Border Background="{StaticResource SurfaceCardBrush}" CornerRadius="{StaticResource RadiusXs}" Padding="6,2"
                                                                Visibility="{Binding HasEnoughVotesForScore, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <TextBlock Text="{Binding ScorePercentage, StringFormat='{}{0:F0}% Positive'}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"/>
                                                        </Border>
                                                    </StackPanel>

                                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" Margin="0,0,0,8" TextWrapping="Wrap"/>

                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding PositiveVotes, StringFormat='👍 {0}'}" FontSize="11" Foreground="{StaticResource SuccessBrush}" Margin="0,0,12,0"/>
                                                        <TextBlock Text="{Binding NegativeVotes, StringFormat='👎 {0}'}" FontSize="11" Foreground="{StaticResource DangerBrush}" Margin="0,0,12,0"/>
                                                        <TextBlock Text="{Binding TotalVotes, StringFormat='({0} ratings)'}" FontSize="11" Foreground="{StaticResource MutedTextBrush}"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Action Area: Standalone Green Shield Icon + Install Button -->
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <!-- Green Shield with Checkmark (Tick) - Standalone Icon -->
                                                    <Viewbox Width="20" Height="20" Margin="0,0,12,0" Cursor="Hand" ToolTipService.InitialShowDelay="50" VerticalAlignment="Center">
                                                        <Path Fill="{StaticResource SuccessBrush}"
                                                              Data="M12 2L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-3zm-2 15l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"/>
                                                        <Viewbox.ToolTip>
                                                            <ToolTip Background="{StaticResource SurfaceCardElevatedBrush}" BorderBrush="{StaticResource SuccessBrush}" BorderThickness="1.5" Padding="14,10">
                                                                <StackPanel MaxWidth="340">
                                                                    <TextBlock Text="{DynamicResource String_ShieldSafeTitle}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource SuccessBrush}" Margin="0,0,0,6" TextWrapping="Wrap"/>
                                                                    <TextBlock Text="{DynamicResource String_ShieldSafeB1}" Style="{StaticResource Caption}" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,3" TextWrapping="Wrap"/>
                                                                    <TextBlock Text="{DynamicResource String_ShieldSafeB2}" Style="{StaticResource Caption}" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,3" TextWrapping="Wrap"/>
                                                                    <TextBlock Text="{DynamicResource String_ShieldSafeB3}" Style="{StaticResource Caption}" Foreground="{StaticResource PrimaryTextBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                                </StackPanel>
                                                            </ToolTip>
                                                        </Viewbox.ToolTip>
                                                    </Viewbox>

                                                    <Button Content="{DynamicResource String_Install}"
                                                            Style="{StaticResource SecondaryButton}"
                                                            Padding="16,9"
                                                            Command="{Binding DataContext.DeployEmulatorOptionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"
                                                            IsEnabled="{Binding DataContext.CanDeployEmulator, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- ═══ 5. SPECIFIC EMULATORS & GAME FIXES (CATEGORIZED: ONLINE, BYPASS, HYPERVISOR) ═══ -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,0"
                            Visibility="{Binding IsSpecificFixesSectionVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource String_GameSpecificFixesTitle}" Style="{StaticResource H2}"/>
                                    <TextBlock Text="{DynamicResource String_GameSpecificFixesDesc}"
                                               Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>

                            <Separator Margin="0,12,0,16" Background="{StaticResource SubtleBorderBrush}"/>

                            <!-- Loading State -->
                            <StackPanel Visibility="{Binding IsLoadingGameFixes, Converter={StaticResource BoolToVisibilityConverter}}"
                                        HorizontalAlignment="Center" Margin="0,16">
                                <TextBlock Text="{DynamicResource String_CheckingAvailableFixes}"
                                           Style="{StaticResource BodyMedium}" Foreground="{StaticResource MutedTextBrush}"/>
                            </StackPanel>

                            <!-- Error State -->
                            <Border Visibility="{Binding HasGameFixesError, Converter={StaticResource BoolToVisibilityConverter}}"
                                    Background="{StaticResource DangerBgBrush}" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusMd}" Padding="16,12" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{DynamicResource String_CouldNotLoadFixes}" FontWeight="Bold" Foreground="{StaticResource DangerBrush}"/>
                                        <TextBlock Text="{Binding GameFixesErrorMessage}" Style="{StaticResource Caption}" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="{DynamicResource String_RetryAction}" Style="{StaticResource SecondaryButton}"
                                            Padding="12,6" Command="{Binding LoadGameFixesCommand}"/>
                                </Grid>
                            </Border>

                            <!-- ── 5A. ONLINE MULTIPLAYER EMULATORS ── -->
                            <StackPanel Visibility="{Binding HasOnlineGameFixes, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,6,0,16">
                                <TextBlock Text="{DynamicResource String_OnlineMultiplayerEmulatorsTitle}" Style="{StaticResource BodyMedium}" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="{DynamicResource String_OnlineMultiplayerEmulatorsDesc}"
                                           Style="{StaticResource Caption}" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,10"/>

                                <ItemsControl ItemsSource="{Binding OnlineGameFixes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource SurfaceInputBrush}"
                                                    BorderBrush="{StaticResource SubtleBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="{StaticResource RadiusMd}"
                                                    Padding="16,14" Margin="0,0,0,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                            <TextBlock Text="{Binding Name}" Style="{StaticResource BodyMedium}" FontWeight="Bold" Margin="0,0,10,0"/>
                                                            <Border Background="{StaticResource AccentBgBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusXs}" Padding="6,2" Margin="0,0,8,0">
                                                                <TextBlock Text="ONLINE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                                            </Border>
                                                            <!-- Score Percentage Badge if enough votes -->
                                                            <Border Background="{StaticResource SurfaceCardBrush}" CornerRadius="{StaticResource RadiusXs}" Padding="6,2" Margin="0,0,8,0"
                                                                    Visibility="{Binding HasEnoughVotesForScore, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                <TextBlock Text="{Binding ScorePercentage, StringFormat='{}{0:F0}% Positive'}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"/>
                                                            </Border>
                                                        </StackPanel>

                                                        <TextBlock Text="{Binding Description, FallbackValue='Specific online multiplayer fix for this game.'}"
                                                                   Style="{StaticResource Caption}" Margin="0,0,0,6" TextWrapping="Wrap"/>

                                                        <!-- Community Ratings Stats (Read-Only on card; votes submitted via game exit feedback modal) -->
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding PositiveVotes, StringFormat='👍 {0}'}" FontSize="11" Foreground="{StaticResource SuccessBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding NegativeVotes, StringFormat='👎 {0}'}" FontSize="11" Foreground="{StaticResource DangerBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding TotalVotes, StringFormat='({0} ratings)'}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <!-- Action Area: Standalone Orange Shield Icon + Install Online Fix Button -->
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <!-- Orange Shield with Exclamation Mark (!) - Standalone Icon -->
                                                        <Viewbox Width="20" Height="20" Margin="0,0,12,0" Cursor="Hand" ToolTipService.InitialShowDelay="50" VerticalAlignment="Center">
                                                            <Path Fill="{StaticResource WarningBrush}"
                                                                  Data="M12 2L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-3zm1 14h-2v-2h2v2zm0-4h-2V7h2v5z"/>
                                                            <Viewbox.ToolTip>
                                                                <ToolTip Background="{StaticResource SurfaceCardElevatedBrush}" BorderBrush="{StaticResource WarningBrush}" BorderThickness="1.5" Padding="14,10">
                                                                    <StackPanel MaxWidth="340">
                                                                        <TextBlock Text="{DynamicResource String_ShieldWarnTitle}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource WarningBrush}" Margin="0,0,0,6" TextWrapping="Wrap"/>
                                                                        <TextBlock Text="{DynamicResource String_ShieldWarnB1}" Style="{StaticResource Caption}" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" Margin="0,0,0,3" TextWrapping="Wrap"/>
                                                                        <TextBlock Text="{DynamicResource String_ShieldWarnB2}" Style="{StaticResource Caption}" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,3" TextWrapping="Wrap"/>
                                                                        <TextBlock Text="{DynamicResource String_ShieldWarnB3}" Style="{StaticResource Caption}" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,3" TextWrapping="Wrap"/>
                                                                        <TextBlock Text="{DynamicResource String_ShieldWarnB4}" Style="{StaticResource Caption}" Foreground="{StaticResource PrimaryTextBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                                    </StackPanel>
                                                                </ToolTip>
                                                            </Viewbox.ToolTip>
                                                        </Viewbox>

                                                        <Button Content="{DynamicResource String_InstallOnlineFixBtn}"
                                                                Style="{StaticResource PrimaryButton}"
                                                                Padding="16,9"
                                                                Command="{Binding DataContext.DeployGameFixCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}"
                                                                IsEnabled="{Binding DataContext.CanDeployEmulator, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- ── 5B. DRM & LICENSE BYPASS LAYERS ── -->
                            <StackPanel Visibility="{Binding HasBypassGameFixes, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,0,0,16">
                                <TextBlock Text="{DynamicResource String_DrmBypassLayersTitle}" Style="{StaticResource BodyMedium}" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="{DynamicResource String_DrmBypassLayersDesc}"
                                           Style="{StaticResource Caption}" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,10"/>

                                <ItemsControl ItemsSource="{Binding BypassGameFixes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource SurfaceInputBrush}"
                                                    BorderBrush="{StaticResource SubtleBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="{StaticResource RadiusMd}"
                                                    Padding="16,14" Margin="0,0,0,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                            <TextBlock Text="{Binding Name}" Style="{StaticResource BodyMedium}" FontWeight="Bold" Margin="0,0,10,0"/>
                                                            <Border Background="{StaticResource AccentBgBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusXs}" Padding="6,2" Margin="0,0,8,0">
                                                                <TextBlock Text="BYPASS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                                            </Border>
                                                        </StackPanel>

                                                        <TextBlock Text="{Binding Description, FallbackValue='DRM / license bypass layer for this game.'}"
                                                                   Style="{StaticResource Caption}" Margin="0,0,0,0" TextWrapping="Wrap"/>
                                                    </StackPanel>

                                                    <!-- Install Button -->
                                                    <Button Grid.Column="1"
                                                            Content="{DynamicResource String_InstallBypassBtn}"
                                                            Style="{StaticResource SecondaryButton}"
                                                            Padding="16,9"
                                                            VerticalAlignment="Center"
                                                            Command="{Binding DataContext.DeployGameFixCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"
                                                            IsEnabled="{Binding DataContext.CanDeployEmulator, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- ── 5C. HYPERVISOR & ANTI-CHEAT LAYERS ── -->
                            <StackPanel Visibility="{Binding HasHypervisorGameFixes, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,0,0,16">
                                <TextBlock Text="{DynamicResource String_HypervisorLayersTitle}" Style="{StaticResource BodyMedium}" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="{DynamicResource String_HypervisorLayersDesc}"
                                           Style="{StaticResource Caption}" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,10"/>

                                <ItemsControl ItemsSource="{Binding HypervisorGameFixes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource SurfaceInputBrush}"
                                                    BorderBrush="{StaticResource SubtleBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="{StaticResource RadiusMd}"
                                                    Padding="16,14" Margin="0,0,0,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                            <TextBlock Text="{Binding Name}" Style="{StaticResource BodyMedium}" FontWeight="Bold" Margin="0,0,10,0"/>
                                                            <Border Background="{StaticResource AccentBgBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusXs}" Padding="6,2" Margin="0,0,8,0">
                                                                <TextBlock Text="HYPERVISOR" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                                            </Border>
                                                        </StackPanel>

                                                        <TextBlock Text="{Binding Description, FallbackValue='Hypervisor-level fix layer for this game.'}"
                                                                   Style="{StaticResource Caption}" Margin="0,0,0,0" TextWrapping="Wrap"/>
                                                    </StackPanel>

                                                    <!-- Install Button -->
                                                    <Button Grid.Column="1"
                                                            Content="{DynamicResource String_InstallHypervisorBtn}"
                                                            Style="{StaticResource SecondaryButton}"
                                                            Padding="16,9"
                                                            VerticalAlignment="Center"
                                                            Command="{Binding DataContext.DeployGameFixCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"
                                                            IsEnabled="{Binding DataContext.CanDeployEmulator, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- ── 5D. OTHER CUSTOM FIXES ── -->
                            <StackPanel Visibility="{Binding HasOtherGameFixes, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="{DynamicResource String_OtherCustomFixesTitle}" Style="{StaticResource BodyMedium}" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,10"/>
                                <ItemsControl ItemsSource="{Binding OtherGameFixes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource SurfaceInputBrush}"
                                                    BorderBrush="{StaticResource SubtleBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="{StaticResource RadiusMd}"
                                                    Padding="16,14" Margin="0,0,0,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                            <TextBlock Text="{Binding Name}" Style="{StaticResource BodyMedium}" FontWeight="Bold" Margin="0,0,10,0"/>
                                                            <Border Background="{StaticResource AccentBgBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusXs}" Padding="6,2" Margin="0,0,8,0">
                                                                <TextBlock Text="{Binding TagsSummary}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                                            </Border>
                                                        </StackPanel>

                                                        <TextBlock Text="{Binding Description, FallbackValue='Custom game fix layer.'}"
                                                                   Style="{StaticResource Caption}" Margin="0,0,0,0" TextWrapping="Wrap"/>
                                                    </StackPanel>

                                                    <!-- Install Button -->
                                                    <Button Grid.Column="1"
                                                            Content="{DynamicResource String_InstallFixBtn}"
                                                            Style="{StaticResource SecondaryButton}"
                                                            Padding="16,9"
                                                            VerticalAlignment="Center"
                                                            Command="{Binding DataContext.DeployGameFixCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"
                                                            IsEnabled="{Binding DataContext.CanDeployEmulator, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ── 6. SETTINGS TAB ── -->
                <StackPanel Visibility="{Binding SelectedTab, Converter={StaticResource StringMatchToVisibilityConverter}, ConverterParameter=Settings}">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource String_InstanceConfigTitle}" Style="{StaticResource H2}" Margin="0,0,0,16"/>

                            <TextBlock Text="{DynamicResource String_InstanceAliasLabel}" Style="{StaticResource CaptionBold}" Margin="0,0,0,6"/>
                            <TextBox Style="{StaticResource DarkTextBox}" Text="{Binding InstanceAlias, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16"/>

                            <TextBlock Text="{DynamicResource String_PrimaryExecutableLabel}" Style="{StaticResource CaptionBold}" Margin="0,0,0,6"/>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Style="{StaticResource DarkTextBox}" Text="{Binding ConfiguredExecutablePath, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Grid.Column="2" Content="{DynamicResource String_BrowseDirBtn}" Style="{StaticResource SecondaryButton}" Command="{Binding BrowseExecutableCommand}"/>
                            </Grid>

                            <TextBlock Text="{DynamicResource String_CustomLaunchArgsLabel}" Style="{StaticResource CaptionBold}" Margin="0,0,0,6"/>
                            <TextBox Style="{StaticResource DarkTextBox}" Text="{Binding CustomLaunchArgs, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,20"/>

                            <Button Content="{DynamicResource String_SaveSettingsAliasBtn}" Style="{StaticResource PrimaryButton}" Padding="20,10" HorizontalAlignment="Left" Command="{Binding SaveSettingsCommand}"/>
                        </StackPanel>
                    </Border>

                    <!-- ═══ PER-INSTANCE UPDATE POLICY ═══ -->
                    <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource String_InstanceDisableUpdatesTitle}" Style="{StaticResource H2}" Margin="0,0,0,4"/>
                                <TextBlock Text="{DynamicResource String_InstanceDisableUpdatesDesc}"
                                           Style="{StaticResource BodySmall}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1"
                                      IsChecked="{Binding DisableUpdateChecks, Mode=TwoWay}"
                                      Style="{StaticResource DarkCheckBox}"
                                      VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- ═══ PER-INSTANCE DLC UNLOCKER METHOD ═══ -->
                    <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource String_DlcMethodSettingTitle}" Style="{StaticResource H2}" Margin="0,0,0,4"/>
                            <TextBlock Text="{DynamicResource String_DlcMethodSettingDesc}"
                                       Style="{StaticResource BodySmall}" TextWrapping="Wrap" Margin="0,0,0,14"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <RadioButton Grid.Column="0"
                                             GroupName="TabSettingsDlcMethodGroup"
                                             IsChecked="{Binding IsCreamApiSelected}"
                                             Style="{StaticResource VersionModeCard}"
                                             Margin="0,0,8,0">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="CreamAPI" FontWeight="Bold" FontSize="13" Foreground="{StaticResource PrimaryTextBrush}"/>
                                            <Border Background="{StaticResource AccentTranslucentBrush}" CornerRadius="{StaticResource RadiusXs}" Padding="6,1" Margin="8,0,0,0">
                                                <TextBlock Text="Default" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{DynamicResource String_InstallModalCreamApiDesc}"
                                                   FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Grid.Column="1"
                                             GroupName="TabSettingsDlcMethodGroup"
                                             IsChecked="{Binding IsSmokeApiSelected}"
                                             Style="{StaticResource VersionModeCard}"
                                             Margin="8,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="SmokeAPI" FontWeight="Bold" FontSize="13" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                                        <TextBlock Text="{DynamicResource String_InstallModalSmokeApiDesc}"
                                                   FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </RadioButton>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Danger Zone & Storage Management -->
                    <Border Style="{StaticResource Card}" Margin="0,20,0,0" BorderBrush="{StaticResource DangerBorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource String_DangerZoneTitle}" Style="{StaticResource H2}" Foreground="{StaticResource DangerBrush}" Margin="0,0,0,8"/>
                            <TextBlock Text="{DynamicResource String_DangerZoneDesc}"
                                       Style="{StaticResource BodySmall}" Margin="0,0,0,16"/>

                            <WrapPanel Orientation="Horizontal">
                                <!-- Uninstall Game Files (Keeps instance in BlueStar) -->
                                <Button Content="{DynamicResource String_UninstallGameFilesBtn}"
                                        Style="{StaticResource SecondaryButton}"
                                        BorderBrush="{StaticResource DangerBrush}"
                                        Foreground="{StaticResource DangerBrush}"
                                        Padding="18,10"
                                        Margin="0,0,12,8"
                                        Command="{Binding OpenUninstallModalCommand}"/>

                                <!-- Delete Instance Entirely -->
                                <Button Content="{DynamicResource String_DeleteInstanceEntirelyBtn}"
                                        Style="{StaticResource DangerButton}"
                                        Padding="18,10"
                                        Margin="0,0,0,8"
                                        Command="{Binding OpenDeleteModalCommand}"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ── 6. PREREQUISITES TAB ── -->
                <StackPanel Visibility="{Binding SelectedTab, Converter={StaticResource StringMatchToVisibilityConverter}, ConverterParameter=Prerequisites}">
                    <!-- Top Action / Info Banner -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{DynamicResource String_PrerequisitesInstallerTitle}" Style="{StaticResource H2}" Margin="0,0,0,4"/>
                                <TextBlock Text="{DynamicResource String_PrerequisitesInstallerDesc}"
                                           Style="{StaticResource Body}" Foreground="{StaticResource SecondaryTextBrush}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="{DynamicResource String_ReScanBtn}"
                                        Style="{StaticResource SecondaryButton}"
                                        Margin="0,0,10,0"
                                        Command="{Binding ScanPrerequisitesCommand}"
                                        IsEnabled="{Binding IsInstallingPrerequisites, Converter={StaticResource InverseBoolConverter}}"/>

                                <Button Content="{DynamicResource String_InstallAllPrerequisitesBtn}"
                                        Style="{StaticResource PrimaryButton}"
                                        Command="{Binding InstallAllPrerequisitesCommand}"
                                        IsEnabled="{Binding IsInstallingPrerequisites, Converter={StaticResource InverseBoolConverter}}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Prerequisites List -->
                    <ItemsControl ItemsSource="{Binding Prerequisites}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Left Info -->
                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource H3}" Margin="0,0,10,0"/>
                                                <Border CornerRadius="{StaticResource RadiusSm}"
                                                        Padding="8,2"
                                                        Background="{Binding Status, Converter={StaticResource PrerequisiteStatusToBgBrushConverter}}">
                                                    <TextBlock Text="{Binding Status, Converter={StaticResource PrerequisiteStatusToTextConverter}}"
                                                               FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{Binding Status, Converter={StaticResource PrerequisiteStatusToBrushConverter}}"/>
                                                </Border>
                                            </StackPanel>

                                            <TextBlock Text="{Binding Description}" Style="{StaticResource Body}" Margin="0,0,0,6"/>

                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{DynamicResource String_CategoryLabel}" Style="{StaticResource Caption}" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0"/>
                                                <TextBlock Text="{Binding Category}" Style="{StaticResource CaptionBold}" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,16,0"/>

                                                <TextBlock Text="{DynamicResource String_LocationLabel}" Style="{StaticResource Caption}" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0"/>
                                                <TextBlock Text="{Binding LocalInstallerPath, FallbackValue='Official Microsoft Direct Download', TargetNullValue='Official Microsoft Direct Download'}"
                                                           Style="{StaticResource Caption}" Foreground="{StaticResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Right Action Button -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <Button Content="{DynamicResource String_Install}"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Padding="16,8"
                                                    Command="{Binding DataContext.InstallPrerequisiteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    IsEnabled="{Binding DataContext.IsInstallingPrerequisites, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource InverseBoolConverter}}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- ── 7. LOGS TAB ── -->
                <StackPanel Visibility="{Binding SelectedTab, Converter={StaticResource StringMatchToVisibilityConverter}, ConverterParameter=Logs}">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource String_LiveLogsTitle}" Style="{StaticResource H2}"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="{DynamicResource String_CopyLogsBtn}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Command="{Binding CopyLogsCommand}"/>
                                    <Button Content="{DynamicResource String_ClearLogsBtn}" Style="{StaticResource GhostButton}" Command="{Binding ClearLogsCommand}"/>
                                </StackPanel>
                            </Grid>

                            <Border Background="{StaticResource SurfaceInputBrush}" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusMd}" Padding="12" Height="380">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding ConsoleLogs}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" Style="{StaticResource MonospaceText}" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
        </Grid>

        <!-- ═══ SHORTCUT MODAL DIALOG OVERLAY ═══ -->
        <Grid Visibility="{Binding IsShortcutModalOpen, Converter={StaticResource BoolToVisibilityConverter}}"
              Background="{StaticResource ModalOverlayBrush}"
              Panel.ZIndex="1000">
            <Border Background="{StaticResource SurfaceCardElevatedBrush}"
                    BorderBrush="{StaticResource AccentBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusLg}"
                    Padding="28" Width="520"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource String_CreateShortcutsModalTitle}" Style="{StaticResource H2}"/>
                        <Button Grid.Column="1" Content="✕" Style="{StaticResource GhostButton}" Command="{Binding CloseShortcutModalCommand}"/>
                    </Grid>

                    <TextBlock Text="{DynamicResource String_ShortcutNameLabel}" Style="{StaticResource CaptionBold}" Margin="0,0,0,6"/>
                    <TextBox Style="{StaticResource DarkTextBox}" Text="{Binding ShortcutName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>

                    <TextBlock Text="{DynamicResource String_ExecutableFileLabel}" Style="{StaticResource CaptionBold}" Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" Style="{StaticResource DarkComboBox}" ItemsSource="{Binding AvailableExecutables}" SelectedItem="{Binding SelectedExecutable}"/>
                        <Button Grid.Column="2" Content="{DynamicResource String_BrowseDirBtn}" Style="{StaticResource SecondaryButton}" Command="{Binding BrowseExecutableCommand}"/>
                    </Grid>

                    <TextBlock Text="{DynamicResource String_ShortcutDestinationsLabel}" Style="{StaticResource CaptionBold}" Margin="0,0,0,8"/>
                    <CheckBox Content="{DynamicResource String_DesktopShortcutOption}" Style="{StaticResource DarkCheckBox}" IsChecked="{Binding CreateDesktopShortcut}" Margin="0,0,0,8"/>
                    <CheckBox Content="{DynamicResource String_StartMenuShortcutOption}" Style="{StaticResource DarkCheckBox}" IsChecked="{Binding CreateStartMenuShortcut}" Margin="0,0,0,8"/>
                    <CheckBox Content="{DynamicResource String_SteamLibraryShortcutOption}" Style="{StaticResource DarkCheckBox}" IsChecked="{Binding CreateSteamShortcut}" IsEnabled="{Binding IsSteamInstalled}" Margin="0,0,0,16"/>

                    <Border Background="{StaticResource SurfaceInputBrush}" CornerRadius="{StaticResource RadiusMd}" Padding="12,8" Margin="0,0,0,16" Visibility="{Binding ShortcutStatusMessage, Converter={StaticResource NullToVisibilityConverter}}">
                        <TextBlock Text="{Binding ShortcutStatusMessage}" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                    </Border>

                    <Button Content="{DynamicResource String_RestartSteamBtn}" Style="{StaticResource PrimaryButton}" Margin="0,0,0,14" Visibility="{Binding ShowRestartSteamButton, Converter={StaticResource BoolToVisibilityConverter}}" Command="{Binding RestartSteamCommand}"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="{DynamicResource String_Cancel}" Style="{StaticResource SecondaryButton}" Command="{Binding CloseShortcutModalCommand}"/>
                        <Button Grid.Column="2" Content="{DynamicResource String_CreatingShortcuts}" Style="{StaticResource PrimaryButton}" Command="{Binding CreateShortcutCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══ STEAM WORKSHOP DOWNLOAD MODAL OVERLAY ═══ -->
        <Grid Visibility="{Binding IsWorkshopModalOpen, Converter={StaticResource BoolToVisibilityConverter}}"
              Background="{StaticResource ModalOverlayBrush}"
              Panel.ZIndex="1000">
            <Border Background="{StaticResource SurfaceCardElevatedBrush}"
                    BorderBrush="{StaticResource AccentBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusLg}"
                    Padding="28" Width="540"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <!-- Header -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🌐" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource String_WorkshopModalTitle}" Style="{StaticResource H2}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="✕" Style="{StaticResource GhostButton}" Command="{Binding CloseWorkshopModalCommand}"
                                IsEnabled="{Binding IsDownloadingWorkshopMod, Converter={StaticResource InverseBoolConverter}}"/>
                    </Grid>

                    <!-- Input Box -->
                    <TextBlock Text="{DynamicResource String_WorkshopUrlOrIdLabel}" Style="{StaticResource CaptionBold}" Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Style="{StaticResource DarkTextBox}"
                                 Text="{Binding WorkshopSearchInput, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="e.g. https://steamcommunity.com/sharedfiles/filedetails/?id=123456789"
                                 IsEnabled="{Binding IsDownloadingWorkshopMod, Converter={StaticResource InverseBoolConverter}}"/>
                        <Button Grid.Column="2" Content="{DynamicResource String_InspectBtn}"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding FetchWorkshopPreviewCommand}"
                                IsEnabled="{Binding IsLoadingWorkshopPreview, Converter={StaticResource InverseBoolConverter}}"/>
                    </Grid>

                    <!-- In-Modal Status / Error Notification Banner -->
                    <Border Background="{StaticResource DangerBgBrush}"
                            BorderBrush="{StaticResource DangerBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusSm}"
                            Padding="12,8" Margin="0,0,0,14"
                            Visibility="{Binding WorkshopStatusMessage, Converter={StaticResource NullToVisibilityConverter}}">
                        <TextBlock Text="{Binding WorkshopStatusMessage}"
                                   Foreground="{StaticResource DangerBrush}"
                                   FontSize="12"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <!-- Live Download Progress Section -->
                    <Border Background="{StaticResource SurfaceInputBrush}"
                            BorderBrush="{StaticResource AccentTranslucentBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusMd}"
                            Padding="14" Margin="0,0,0,16"
                            Visibility="{Binding IsDownloadingWorkshopMod, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding WorkshopDownloadStatusText}" Style="{StaticResource CaptionBold}" Foreground="{StaticResource AccentBrush}"/>
                                <TextBlock Grid.Column="1" Text="{Binding WorkshopDownloadProgress, StringFormat='{}{0:F0}%'}" Style="{StaticResource CaptionBold}" Foreground="{StaticResource AccentBrush}"/>
                            </Grid>
                            <ProgressBar Value="{Binding WorkshopDownloadProgress}" Maximum="100" Height="8" Style="{StaticResource DownloadProgressBar}"/>
                        </StackPanel>
                    </Border>

                    <!-- Preview Card -->
                    <Border Background="{StaticResource SurfaceInputBrush}"
                            BorderBrush="{StaticResource SubtleBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusMd}"
                            Padding="14" Margin="0,0,0,16"
                            Visibility="{Binding WorkshopPreviewItem, Converter={StaticResource NullToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="84"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Preview Image -->
                            <Border Grid.Column="0" CornerRadius="6" ClipToBounds="True" Height="84" Background="{StaticResource SurfaceCardBrush}">
                                <Image Source="{Binding WorkshopPreviewItem.PreviewUrl}" Stretch="UniformToFill"/>
                            </Border>

                            <!-- Details -->
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding WorkshopPreviewItem.Title}" Style="{StaticResource H3}" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding WorkshopPreviewItem.Author, StringFormat='Created by: {0}'}" Style="{StaticResource Caption}" Margin="0,0,0,2"/>
                                <TextBlock Text="{Binding WorkshopPreviewItem.PublishedFileId, StringFormat='Workshop ID: {0}'}" Style="{StaticResource Caption}" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Action Buttons -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="{DynamicResource String_Cancel}" Style="{StaticResource SecondaryButton}" Command="{Binding CloseWorkshopModalCommand}"
                                IsEnabled="{Binding IsDownloadingWorkshopMod, Converter={StaticResource InverseBoolConverter}}"/>
                        <Button Grid.Column="2" Content="{DynamicResource String_DownloadInstallModBtn}"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding DownloadWorkshopModCommand}"
                                IsEnabled="{Binding WorkshopPreviewItem, Converter={StaticResource NullToVisibilityConverter}}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══ POST-GAME EMULATOR FEEDBACK MODAL OVERLAY ═══ -->
        <Grid Visibility="{Binding IsFeedbackModalOpen, Converter={StaticResource BoolToVisibilityConverter}}"
              Background="{StaticResource ModalOverlayBrush}"
              Panel.ZIndex="1000">
            <Border Background="{StaticResource SurfaceCardElevatedBrush}"
                    BorderBrush="{StaticResource AccentBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusLg}"
                    Padding="28" Width="480"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource String_FeedbackModalTitle}" Style="{StaticResource H2}"/>
                            <TextBlock Text="BlueStar Community" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="✕" Style="{StaticResource GhostButton}" Command="{Binding CloseFeedbackModalCommand}"/>
                    </Grid>

                    <!-- Feedback Question Block -->
                    <Border Background="{StaticResource SurfaceInputBrush}"
                            BorderBrush="{StaticResource SubtleBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusMd}"
                            Padding="16" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="{Binding FeedbackEmulatorName, StringFormat='Did the {0} emulator work properly for this game?'}"
                                       Style="{StaticResource BodyMedium}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <TextBlock Text="{DynamicResource String_FeedbackHelpCommunity}"
                                       Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Initial Yes / No Buttons (When uninstall prompt is not active) -->
                    <Grid Visibility="{Binding ShowFeedbackUninstallPrompt, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Style="{StaticResource PrimaryButton}"
                                Padding="16,12"
                                Command="{Binding SubmitFeedbackPositiveCommand}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Path Data="{StaticResource IconThumbUp}" Fill="White" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource String_FeedbackYesWorked}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="2"
                                Style="{StaticResource DangerButton}"
                                Padding="16,12"
                                Command="{Binding SubmitFeedbackNegativeCommand}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Path Data="{StaticResource IconThumbDown}" Fill="White" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource String_FeedbackNoIssues}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Negative Feedback Followup: Option to Uninstall & Try Another -->
                    <StackPanel Visibility="{Binding ShowFeedbackUninstallPrompt, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border Background="{StaticResource DangerBgBrush}"
                                BorderBrush="{StaticResource DangerBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusSm}"
                                Padding="12" Margin="0,0,0,16">
                            <TextBlock Text="{DynamicResource String_FeedbackFollowupDesc}"
                                       Foreground="{StaticResource DangerBrush}" FontSize="13" TextWrapping="Wrap"/>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Content="{DynamicResource String_FeedbackCancelKeep}"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="14,10"
                                    Command="{Binding CloseFeedbackModalCommand}"/>

                            <Button Grid.Column="2" Content="{DynamicResource String_FeedbackUninstallChange}"
                                    Style="{StaticResource DangerButton}"
                                    Padding="14,10"
                                    Command="{Binding UninstallFromFeedbackCommand}"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══ MODAL: INSTANCE DELETION CONFIRMATION ═══ -->
        <Grid Visibility="{Binding IsDeleteModalOpen, Converter={StaticResource BoolToVisibilityConverter}}"
              Background="{StaticResource ModalOverlayBrush}"
              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
              Panel.ZIndex="1000">
            <Border Background="{StaticResource SurfaceCardBrush}"
                    BorderBrush="{StaticResource SubtleBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusLg}"
                    Padding="28"
                    MaxWidth="540"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{DynamicResource String_DeleteModalTitle}" Style="{StaticResource H1}" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding Instance.Name, StringFormat='{}How would you like to delete {0}?'}"
                               Style="{StaticResource Body}" TextWrapping="Wrap" Margin="0,0,0,20"/>

                    <!-- Option 1: Only Unlink from BlueStar -->
                    <Border Background="{StaticResource SurfaceInputBrush}"
                            BorderBrush="{StaticResource SubtleBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusMd}"
                            Padding="16" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="{DynamicResource String_UnlinkFromBlueStarOnlyTitle}" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="{DynamicResource String_UnlinkFromBlueStarOnlyDesc}"
                                           Style="{StaticResource BodySmall}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="{DynamicResource String_UnlinkActionBtn}"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="16,9"
                                    VerticalAlignment="Center"
                                    Command="{Binding ConfirmDeleteInstanceCommand}"
                                    CommandParameter="false"
                                    IsEnabled="{Binding IsDeletingInstance, Converter={StaticResource InverseBoolConverter}}"/>
                        </Grid>
                    </Border>

                    <!-- Option 2: Delete Instance and Purge Data Files -->
                    <Border Background="{StaticResource DangerBgBrush}"
                            BorderBrush="{StaticResource DangerBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusMd}"
                            Padding="16" Margin="0,0,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="{DynamicResource String_DeleteInstanceAndPurgeTitle}" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource DangerBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="{DynamicResource String_DeleteInstanceAndPurgeDesc}"
                                           Style="{StaticResource BodySmall}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="{DynamicResource String_DeleteAllActionBtn}"
                                    Style="{StaticResource DangerButton}"
                                    Padding="16,9"
                                    VerticalAlignment="Center"
                                    Command="{Binding ConfirmDeleteInstanceCommand}"
                                    CommandParameter="true"
                                    IsEnabled="{Binding IsDeletingInstance, Converter={StaticResource InverseBoolConverter}}"/>
                        </Grid>
                    </Border>

                    <!-- Cancel Button -->
                    <Button Content="{DynamicResource String_Cancel}"
                            Style="{StaticResource GhostButton}"
                            HorizontalAlignment="Right"
                            Padding="18,8"
                            Command="{Binding CloseDeleteModalCommand}"
                            IsEnabled="{Binding IsDeletingInstance, Converter={StaticResource InverseBoolConverter}}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ══════════════════════════════════════════════════════════════
             UNINSTALL GAME FILES MODAL (Keeps instance in BlueStar)
             ══════════════════════════════════════════════════════════════ -->
        <Grid Visibility="{Binding IsUninstallModalOpen, Converter={StaticResource BoolToVisibilityConverter}}"
              Background="{StaticResource ModalOverlayBrush}"
              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
              Panel.ZIndex="1000">
            <Border Background="{StaticResource SurfaceCardBrush}"
                    BorderBrush="{StaticResource SubtleBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusLg}"
                    Padding="28"
                    MaxWidth="520"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{DynamicResource String_UninstallGameFilesModalTitle}" Style="{StaticResource H1}" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding Instance.Name, StringFormat='{}Are you sure you want to uninstall game files for {0}?'}"
                               Style="{StaticResource Body}" TextWrapping="Wrap" Margin="0,0,0,16"/>

                    <Border Background="{StaticResource SurfaceInputBrush}"
                            BorderBrush="{StaticResource SubtleBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusMd}"
                            Padding="14" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource String_WhatWillHappenTitle}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,6"/>
                            <TextBlock Text="{DynamicResource String_UninstallDescBullet1}" Style="{StaticResource BodySmall}" Margin="0,0,0,3"/>
                            <TextBlock Text="{DynamicResource String_UninstallDescBullet2}" Style="{StaticResource BodySmall}" Margin="0,0,0,3"/>
                            <TextBlock Text="{DynamicResource String_UninstallDescBullet3}" Style="{StaticResource BodySmall}" Margin="0,0,0,3"/>
                            <TextBlock Text="{DynamicResource String_UninstallDescBullet4}" Style="{StaticResource BodySmall}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="1" Content="{DynamicResource String_Cancel}"
                                Style="{StaticResource GhostButton}"
                                Padding="18,9"
                                Command="{Binding CloseUninstallModalCommand}"
                                IsEnabled="{Binding IsUninstallingGameFiles, Converter={StaticResource InverseBoolConverter}}"/>

                        <Button Grid.Column="3" Content="{DynamicResource String_UninstallGameFilesBtnAction}"
                                Style="{StaticResource DangerButton}"
                                Padding="20,9"
                                Command="{Binding ConfirmUninstallGameFilesCommand}"
                                IsEnabled="{Binding IsUninstallingGameFiles, Converter={StaticResource InverseBoolConverter}}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ══════════════════════════════════════════════════════════════
             CUSTOM BUILD & MANIFEST CONFIGURATION MODAL
             ══════════════════════════════════════════════════════════════ -->
        <Grid Visibility="{Binding IsCustomBuildModalOpen, Converter={StaticResource BoolToVisibilityConverter}}"
              Background="{StaticResource ModalOverlayBrush}"
              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
              Panel.ZIndex="1000">
            <Border Background="{StaticResource SurfaceCardBrush}"
                    BorderBrush="{StaticResource SubtleBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusLg}"
                    Padding="26"
                    MaxWidth="580"
                    MaxHeight="620"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="{DynamicResource String_ConfigureCustomBuildModalTitle}" Style="{StaticResource H2}"/>
                            <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Command="{Binding CloseAddCustomBuildModalCommand}" Padding="8,4">
                                <TextBlock Text="✕" FontSize="14" Foreground="{StaticResource MutedTextBrush}"/>
                            </Button>
                        </Grid>
                        <TextBlock Text="{DynamicResource String_ConfigureCustomBuildDesc}"
                                   Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,16"/>

                        <!-- Target Build ID & Name Inputs -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{DynamicResource String_TargetBuildIdLabel}" Style="{StaticResource CaptionBold}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding CustomBuildIdInput, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource DarkTextBox}"
                                         Height="32" Padding="8,4"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{DynamicResource String_BuildNameNoteLabel}" Style="{StaticResource CaptionBold}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding CustomBuildNameInput, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource DarkTextBox}"
                                         Height="32" Padding="8,4"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="{DynamicResource String_DepotManifestIdsLabel}" Style="{StaticResource CaptionBold}"/>
                            <Button Content="{DynamicResource String_ImportFromManifestFilesBtn}"
                                    Style="{StaticResource GhostButton}"
                                    HorizontalAlignment="Right"
                                    FontSize="11" Padding="6,2"
                                    Command="{Binding ImportManifestFilesForCustomBuildCommand}"/>
                        </Grid>
                    </StackPanel>

                    <!-- Scrollable Depots List -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
                        <ItemsControl ItemsSource="{Binding CustomBuildDepots}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource SurfaceInputBrush}" CornerRadius="{StaticResource RadiusSm}"
                                            Padding="12,8" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="180"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding DepotName}" Style="{StaticResource BodySmall}" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                                <TextBlock Text="{Binding DepotId, StringFormat='Depot ID: {0}'}" Style="{StaticResource Caption}" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0"/>
                                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" Foreground="{StaticResource SuccessBrush}"
                                                           Visibility="{Binding StatusText, Converter={StaticResource NullToVisibilityConverter}}" Margin="0,4,0,0"/>
                                            </StackPanel>

                                            <TextBox Grid.Column="1" Text="{Binding ManifestIdText, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource DarkTextBox}"
                                                     VerticalAlignment="Center" Height="28" Padding="6,2" FontSize="12"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Action Buttons -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="1" Content="{DynamicResource String_Cancel}"
                                Style="{StaticResource GhostButton}"
                                Padding="16,8"
                                Command="{Binding CloseAddCustomBuildModalCommand}"/>

                        <Button Grid.Column="3" Content="{DynamicResource String_SaveSwitchBuildBtn}"
                                Style="{StaticResource PrimaryButton}"
                                Padding="18,8"
                                Command="{Binding SaveCustomBuildCommand}"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ══════════════════════════════════════════════════════════════
             UPDATE DEPOTS MODAL
             ══════════════════════════════════════════════════════════════ -->
        <Grid Background="#B0000000"
              Visibility="{Binding IsUpdateModalOpen, Converter={StaticResource BoolToVisibilityConverter}}"
              Panel.ZIndex="1000">
            <Border Style="{StaticResource Card}"
                    Width="700"
                    MaxHeight="680"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    BorderBrush="{StaticResource AccentBrush}"
                    BorderThickness="1"
                    Padding="24">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource String_DepotUpdatesModalTitle}" Style="{StaticResource H2}"/>
                            <TextBlock Text="{DynamicResource String_DepotUpdatesModalDesc}"
                                       Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Command="{Binding CloseUpdateModalCommand}" Padding="8,4">
                            <TextBlock Text="✕" FontSize="14" Foreground="{StaticResource MutedTextBrush}"/>
                        </Button>
                    </Grid>

                    <TextBlock Text="{DynamicResource String_SelectDepotsToUpdateLabel}" Style="{StaticResource CaptionBold}" Margin="0,0,0,10"/>

                    <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
                        <ItemsControl ItemsSource="{Binding UpdateAvailableDepots}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource SurfaceInputBrush}"
                                            BorderBrush="{StaticResource SubtleBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource RadiusSm}"
                                            Padding="12,10"
                                            Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Top" Margin="0,2,12,0"/>

                                            <!-- Stacked, not a single horizontal run: two 19-digit
                                                 manifest ids plus badges never fit on one line, and
                                                 the overflow was silently clipping the new id. -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                                                           Foreground="{StaticResource PrimaryTextBrush}" TextWrapping="Wrap"/>

                                                <WrapPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                    <TextBlock Text="{Binding DepotId, StringFormat='Depot {0}'}" Style="{StaticResource Muted}" Margin="0,0,10,4"/>
                                                    <Border Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource SubtleBorderBrush}"
                                                            BorderThickness="1" CornerRadius="{StaticResource RadiusSm}" Padding="7,1" Margin="0,0,6,4">
                                                        <TextBlock Text="{Binding CategoryTag}" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}"/>
                                                    </Border>
                                                    <Border Background="{StaticResource InfoBgBrush}" BorderBrush="{StaticResource InfoBrush}"
                                                            BorderThickness="1" CornerRadius="{StaticResource RadiusSm}" Padding="7,1" Margin="0,0,6,4">
                                                        <TextBlock Text="{Binding PlatformTag}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource InfoBrush}"/>
                                                    </Border>
                                                    <Border Background="{StaticResource PurpleBgBrush}" BorderBrush="{StaticResource PurpleBrush}"
                                                            BorderThickness="1" CornerRadius="{StaticResource RadiusSm}" Padding="7,1" Margin="0,0,6,4"
                                                            Visibility="{Binding ArchitectureTag, Converter={StaticResource NullToVisibilityConverter}}">
                                                        <TextBlock Text="{Binding ArchitectureTag}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource PurpleBrush}"/>
                                                    </Border>
                                                    <Border Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource SubtleBorderBrush}"
                                                            BorderThickness="1" CornerRadius="{StaticResource RadiusSm}" Padding="7,1" Margin="0,0,0,4">
                                                        <TextBlock Text="{Binding SourceProvider}" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}"/>
                                                    </Border>
                                                </WrapPanel>

                                                <!-- The manifest change, on its own rows so both ids stay readable -->
                                                <Grid Margin="0,8,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" MinWidth="62"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource String_DepotUpdateCurrentLabel}"
                                                               Style="{StaticResource Muted}" Margin="0,0,10,0"/>
                                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DisplayCurrentManifest}"
                                                               Style="{StaticResource MonospaceText}" FontSize="11"
                                                               Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap"/>

                                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource String_DepotUpdateNewLabel}"
                                                               Style="{StaticResource Muted}" Margin="0,4,10,0"/>
                                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DisplayNewManifest}"
                                                               Style="{StaticResource MonospaceText}" FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                </Grid>
                                            </StackPanel>

                                            <TextBlock Grid.Column="2" Text="{Binding FormattedSize}"
                                                       Style="{StaticResource CaptionBold}"
                                                       Foreground="{StaticResource AccentBrush}"
                                                       VerticalAlignment="Top" Margin="0,1,0,0"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Border Background="{StaticResource WarningBgBrush}"
                            BorderBrush="{StaticResource WarningBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusSm}"
                            Padding="12,8" Margin="0,0,0,16"
                            Visibility="{Binding IsGameRunning, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{DynamicResource String_GameRunningUpdateWarn}"
                                   Style="{StaticResource BodySmall}" Foreground="{StaticResource WarningBrush}" Margin="0,4,0,0"/>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="{DynamicResource String_Cancel}"
                                Style="{StaticResource GhostButton}"
                                Command="{Binding CloseUpdateModalCommand}"
                                Margin="0,0,10,0"/>

                        <Button Content="{DynamicResource String_DownloadInstallBtn}"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding ConfirmApplyDepotUpdateCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══ DEPOTBOX ASSOCIATION MODAL OVERLAY ═══ -->
        <Grid Visibility="{Binding IsAssociationModalOpen, Converter={StaticResource BoolToVisibilityConverter}}"
              Background="{StaticResource ModalOverlayBrush}"
              Panel.ZIndex="1000">
            <Border Width="560"
                    Background="{StaticResource SurfaceCardElevatedBrush}"
                    BorderBrush="{StaticResource StrongBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusLg}"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{DynamicResource String_AssociateWithDepotBoxModalTitle}" Style="{StaticResource H2}" Margin="0,0,0,6"/>
                    <TextBlock Text="{DynamicResource String_AssociateWithDepotBoxModalDesc}"
                               Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,16"/>

                    <!-- Search Box -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding AssociationSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource DarkTextBox}"/>
                        <Button Grid.Column="2" Content="{DynamicResource String_SearchButton}" Style="{StaticResource SecondaryButton}"
                                Command="{Binding SearchDepotBoxManuallyCommand}"/>
                    </Grid>

                    <!-- Searching Spinner -->
                    <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,12"
                                 Visibility="{Binding IsSearchingDepotBoxCandidate, Converter={StaticResource BoolToVisibilityConverter}}"/>

                    <!-- Best Candidate Match Card -->
                    <Border Background="{StaticResource SurfaceInputBrush}"
                            BorderBrush="#0284C7"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusMd}"
                            Padding="14,10" Margin="0,0,0,12"
                            Visibility="{Binding DepotBoxCandidate, Converter={StaticResource NullToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                    <TextBlock Text="{DynamicResource String_BestMatchPrefix}" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding DepotBoxCandidate.Name}" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding DepotBoxCandidate.AppId, StringFormat='Steam AppID: {0}'}" Style="{StaticResource Muted}"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="{DynamicResource String_SelectBtn}" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding ConfirmAssociationWithCandidateCommand}"/>
                        </Grid>
                    </Border>

                    <!-- Search Results List -->
                    <ScrollViewer MaxHeight="200" Margin="0,0,0,16" VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding AssociationSearchResults.Count, Converter={StaticResource NullToVisibilityConverter}}">
                        <ItemsControl ItemsSource="{Binding AssociationSearchResults}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource SurfaceCardBrush}"
                                            BorderBrush="{StaticResource SubtleBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource RadiusSm}"
                                            Padding="10,8" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Style="{StaticResource BodySmall}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                                                <TextBlock Text="{Binding AppId, StringFormat='AppID: {0}'}" Style="{StaticResource Muted}"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="{DynamicResource String_AssociateBtn}"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Padding="12,4" FontSize="11"
                                                    Command="{Binding DataContext.AssociateWithCandidateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Bottom Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="{DynamicResource String_Cancel}" Style="{StaticResource GhostButton}"
                                Command="{Binding CloseAssociationModalCommand}" Margin="0,0,10,0"/>
                        <Button Content="{DynamicResource String_ConfirmAssociationBtn}" Style="{StaticResource PrimaryButton}"
                                Background="#0284C7" BorderBrush="#0369A1"
                                Command="{Binding ConfirmAssociationWithCandidateCommand}"
                                IsEnabled="{Binding DepotBoxCandidate, Converter={StaticResource NullToBoolConverter}}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══ DLC WARNING MODAL OVERLAY ═══ -->
        <Grid Visibility="{Binding IsDlcWarningModalOpen, Converter={StaticResource BoolToVisibilityConverter}}"
              Background="{StaticResource ModalOverlayBrush}"
              Panel.ZIndex="1000">
            <Border Width="500"
                    Background="{StaticResource SurfaceCardElevatedBrush}"
                    BorderBrush="{StaticResource StrongBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusLg}"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{DynamicResource String_DlcWarningModalTitle}" Style="{StaticResource H2}" Margin="0,0,0,8"/>
                    <TextBlock Text="{DynamicResource String_NoDlcsRegisteredTitle}"
                               FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,6"/>
                    <TextBlock Text="{DynamicResource String_NoDlcsRegisteredDesc}"
                               Style="{StaticResource Body}" TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,20"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="{DynamicResource String_Cancel}" Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                                Command="{Binding CancelUnlockDlcsCommand}"/>
                        <Button Content="{DynamicResource String_InstallAnywayBtn}" Style="{StaticResource PrimaryButton}"
                                Command="{Binding ConfirmUnlockDlcsCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══ STEAM REQUIRED FOR ONLINE FEATURES MODAL OVERLAY ═══ -->
        <Grid Visibility="{Binding IsSteamRequiredModalOpen, Converter={StaticResource BoolToVisibilityConverter}}"
              Background="{StaticResource ModalOverlayBrush}"
              Panel.ZIndex="1000">
            <Border Width="480"
                    Background="{StaticResource SurfaceCardElevatedBrush}"
                    BorderBrush="{StaticResource StrongBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusLg}"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{DynamicResource String_SteamRequiredModalTitle}" Style="{StaticResource H2}" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding Instance.Name, StringFormat='{}Launching {0} with ReFix Online (Spacewar 480).'}"
                               FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,6"/>
                    <TextBlock Text="{DynamicResource String_SteamRequiredModalDesc}"
                               Style="{StaticResource Body}" TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,16"/>

                    <!-- Loading / Waiting for Steam indicator -->
                    <Border Background="{StaticResource SurfaceInputBrush}"
                            BorderBrush="{StaticResource AccentBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusMd}"
                            Padding="12,10" Margin="0,0,0,16"
                            Visibility="{Binding IsStartingSteam, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ProgressBar IsIndeterminate="True" Width="16" Height="16" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding SteamLaunchStatusText, FallbackValue='Starting Steam and waiting for user profile to load...'}"
                                       Style="{StaticResource CaptionBold}" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="{DynamicResource String_Cancel}" Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                                Command="{Binding CloseSteamRequiredModalCommand}"
                                IsEnabled="{Binding IsStartingSteam, Converter={StaticResource InverseBoolConverter}}"/>
                        <Button Content="{DynamicResource String_LaunchAnywayBtn}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                                Command="{Binding LaunchAnywayCommand}"
                                IsEnabled="{Binding IsStartingSteam, Converter={StaticResource InverseBoolConverter}}"/>
                        <Button Content="{DynamicResource String_StartSteamAndPlayBtn}" Style="{StaticResource PrimaryButton}"
                                Command="{Binding StartSteamAndLaunchCommand}"
                                IsEnabled="{Binding IsStartingSteam, Converter={StaticResource InverseBoolConverter}}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══ ONLINE FIX WARNING & ANTIVIRUS EXCLUSION MODAL OVERLAY ═══ -->
        <Grid Visibility="{Binding IsOnlineFixWarningModalOpen, Converter={StaticResource BoolToVisibilityConverter}}"
              Background="{StaticResource ModalOverlayBrush}"
              Panel.ZIndex="1001">
            <Border Width="520" Background="{StaticResource SurfaceCardElevatedBrush}"
                    BorderBrush="{StaticResource WarningBrush}" BorderThickness="1.5"
                    CornerRadius="{StaticResource RadiusLg}" Padding="28,24"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <!-- Header with Warning Icon -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{StaticResource WarningBgBrush}"
                                BorderBrush="{StaticResource WarningBrush}" BorderThickness="1"
                                CornerRadius="{StaticResource RadiusSm}" Width="40" Height="40"
                                Margin="0,0,14,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="⚠️" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource String_OnlineFixWarningModalTitle}" Style="{StaticResource H2}" Foreground="{StaticResource WarningBrush}"/>
                            <TextBlock Text="{DynamicResource String_OnlineFixWarningModalSubtitle}" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                        </StackPanel>

                        <Button Grid.Column="2" Content="✕" Style="{StaticResource GhostButton}" Command="{Binding CloseOnlineFixWarningModalCommand}"/>
                    </Grid>

                    <Separator Margin="0,0,0,16" Background="{StaticResource SubtleBorderBrush}"/>

                    <!-- Description -->
                    <TextBlock Style="{StaticResource Body}" Margin="0,0,0,12" TextWrapping="Wrap">
                        <Run Text="{DynamicResource String_AboutToInstallPrefix}"/>
                        <Run Text="{Binding PendingOnlineFixToInstall.Name}" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}"/>
                    </TextBlock>

                    <!-- Bullet points notice box -->
                    <Border Background="{StaticResource SurfaceInputBrush}" BorderBrush="{StaticResource SubtleBorderBrush}"
                            BorderThickness="1" CornerRadius="{StaticResource RadiusMd}" Padding="16,12" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource String_OnlineFixSecurityDetailsTitle}" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,8" Foreground="{StaticResource WarningBrush}"/>
                            <TextBlock Text="{DynamicResource String_OnlineFixBullet1}" Style="{StaticResource Caption}" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" Margin="0,0,0,4" TextWrapping="Wrap"/>
                            <TextBlock Text="{DynamicResource String_OnlineFixBullet2}" Style="{StaticResource Caption}" Margin="0,0,0,4" TextWrapping="Wrap"/>
                            <TextBlock Text="{DynamicResource String_OnlineFixBullet3}" Style="{StaticResource Caption}" Margin="0,0,0,4" TextWrapping="Wrap"/>
                            <TextBlock Text="{DynamicResource String_OnlineFixBullet4}" Style="{StaticResource Caption}" Margin="0,0,0,4" TextWrapping="Wrap"/>
                            <TextBlock Text="{DynamicResource String_OnlineFixBullet5}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{DynamicResource String_OnlineFixConfirmPrompt}"
                               Style="{StaticResource BodySmall}" FontWeight="SemiBold" Margin="0,0,0,20"/>

                    <!-- Action Buttons -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="{DynamicResource String_Cancel}" Style="{StaticResource SecondaryButton}" Command="{Binding CloseOnlineFixWarningModalCommand}" Margin="0,0,10,0"/>
                        <Button Grid.Column="1" Content="{DynamicResource String_ProceedAddExclusionBtn}" Style="{StaticResource PrimaryButton}"
                                Background="{StaticResource WarningBrush}"
                                Command="{Binding ConfirmInstallOnlineFixCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══ ONE-CLICK INSTALL MODAL OVERLAY ═══ -->
        <Grid Visibility="{Binding IsInstallModalOpen, Converter={StaticResource BoolToVisibilityConverter}}"
              Background="{StaticResource ModalOverlayBrush}"
              Panel.ZIndex="1100">
            <Border Background="{StaticResource SurfaceCardElevatedBrush}"
                    BorderBrush="{StaticResource AccentBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusLg}"
                    Width="780" MaxHeight="840"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- HEADER BANNER & TITLE -->
                    <Border Grid.Row="0" CornerRadius="12,12,0,0" ClipToBounds="True">
                        <Grid>
                            <!-- Banner Image with subtle gradient overlay -->
                            <Grid Height="120" Visibility="{Binding InstallModalHeaderImage, Converter={StaticResource NullToVisibilityConverter}}">
                                <Image Source="{Binding InstallModalHeaderImage, Converter={StaticResource CachedImageConverter}}"
                                       Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <Border Background="#D8111622"/>
                            </Grid>

                            <Grid Margin="24,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Border Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusXs}" Padding="8,2">
                                            <TextBlock Text="{Binding InstallModalRequiredSpaceText, StringFormat='📦 {0}'}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding InstallModalGameTitle}" Style="{StaticResource H2}" FontSize="20" Margin="0,0,0,4"
                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding InstallModalGameTitle}"/>
                                    <TextBlock Text="{Binding InstallModalShortDescription}" Style="{StaticResource Caption}" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" MaxHeight="34" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <Button Grid.Column="2" Content="✕" Style="{StaticResource GhostButton}" VerticalAlignment="Top" Command="{Binding CloseInstallModalCommand}"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- SCROLLABLE BODY OPTIONS -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,14,24,14">
                        <StackPanel>
                            <!-- 1. Installation Directory -->
                            <TextBlock Text="{DynamicResource String_InstallModalLocationTitle}" Style="{StaticResource CaptionBold}" Margin="0,0,0,6"/>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Style="{StaticResource DarkTextBox}" Text="{Binding InstallModalPath, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Grid.Column="2" Content="{DynamicResource String_BrowseDirBtn}" Style="{StaticResource SecondaryButton}" Command="{Binding BrowseInstallModalPathCommand}"/>
                            </Grid>

                            <!-- Free space badge / warning -->
                            <TextBlock Text="{Binding InstallModalFreeSpaceText}" Style="{StaticResource Caption}" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,6"/>
                            <Border Background="{StaticResource DangerBgBrush}" BorderBrush="{StaticResource DangerBorderBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusMd}" Padding="10,6" Margin="0,0,0,12"
                                    Visibility="{Binding InstallModalHasEnoughSpace, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                <TextBlock Text="{Binding InstallModalRequiredSpaceText, StringFormat={StaticResource String_InstallModalDiskWarning}}"
                                           Style="{StaticResource Caption}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"/>
                            </Border>

                            <Separator Margin="0,4,0,14" Background="{StaticResource SubtleBorderBrush}"/>

                            <!-- 2. Target Version (Recommended [only if available], Latest, Custom) -->
                            <TextBlock Text="{DynamicResource String_InstallModalVersionTitle}" Style="{StaticResource CaptionBold}" Margin="0,0,0,8"/>

                            <UniformGrid Rows="1" Margin="0,0,0,8">
                                <!-- Option 1: Recommended (Curated) - Only visible if available for this game -->
                                <RadioButton Style="{StaticResource VersionModeCard}"
                                             GroupName="InstallModalVersionGroup"
                                             controls:ToggleableRadio.AllowUncheck="True"
                                             Visibility="{Binding InstallModalHasRecommendedVersion, Converter={StaticResource BoolToVisibilityConverter}}"
                                             IsChecked="{Binding IsInstallModalVersionRecommended, Mode=TwoWay}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                            <Path Data="{StaticResource IconStar}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                  Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="{DynamicResource String_InstallModalVersionRecommended}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                            <Border Background="{StaticResource AccentTranslucentBrush}" CornerRadius="{StaticResource RadiusXs}" Padding="4,1" Margin="6,0,0,0">
                                                <TextBlock Text="Verified" FontSize="8" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{DynamicResource String_InstallModalVersionRecommendedDesc}"
                                                   Style="{StaticResource Caption}" Foreground="{StaticResource SecondaryTextBrush}"
                                                   TextWrapping="Wrap" MinHeight="28" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </RadioButton>

                                <!-- Option 2: Latest -->
                                <RadioButton Style="{StaticResource VersionModeCard}"
                                             GroupName="InstallModalVersionGroup"
                                             controls:ToggleableRadio.AllowUncheck="True"
                                             IsChecked="{Binding IsInstallModalVersionLatest, Mode=TwoWay}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                            <Path Data="{StaticResource IconRefresh}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                  Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="{DynamicResource String_InstallModalVersionLatest}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                            <Border Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusXs}" Padding="4,1" Margin="6,0,0,0">
                                                <TextBlock Text="Steam" FontSize="8" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{DynamicResource String_InstallModalVersionLatestDesc}"
                                                   Style="{StaticResource Caption}" Foreground="{StaticResource SecondaryTextBrush}"
                                                   TextWrapping="Wrap" MinHeight="28" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </RadioButton>

                                <!-- Option 3: Custom -->
                                <RadioButton Style="{StaticResource VersionModeCard}"
                                             GroupName="InstallModalVersionGroup"
                                             controls:ToggleableRadio.AllowUncheck="True"
                                             IsChecked="{Binding IsInstallModalVersionCustom, Mode=TwoWay}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                            <Path Data="{StaticResource IconFilter}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                  Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="{DynamicResource String_InstallModalVersionCustom}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="{DynamicResource String_InstallModalVersionCustomDesc}"
                                                   Style="{StaticResource Caption}" Foreground="{StaticResource SecondaryTextBrush}"
                                                   TextWrapping="Wrap" MinHeight="28" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </RadioButton>
                            </UniformGrid>

                            <!-- Detail panel depending on selected version mode -->
                            <!-- If Recommended is selected -->
                            <Border Background="{StaticResource SurfaceInputBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusMd}" Padding="12,8" Margin="0,0,0,14"
                                    Visibility="{Binding IsInstallModalVersionRecommended, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                            <TextBlock Text="{Binding CuratedBuildIdText, StringFormat='Build {0}'}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource PrimaryTextBrush}"/>
                                            <TextBlock Text="{Binding CuratedSummaryText, StringFormat=' · {0}'}" Style="{StaticResource Caption}" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding CuratedNotesText}" Style="{StaticResource Caption}" Foreground="{StaticResource SecondaryTextBrush}"
                                                   Visibility="{Binding HasCuratedNotes, Converter={StaticResource BoolToVisibilityConverter}}"
                                                   TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="{StaticResource AccentTranslucentBrush}" CornerRadius="{StaticResource RadiusXs}" Padding="8,3" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource String_InstallModalRecommendedBadge}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- If Latest is selected -->
                            <Border Background="{StaticResource SurfaceInputBrush}" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusMd}" Padding="12,8" Margin="0,0,0,14"
                                    Visibility="{Binding IsInstallModalVersionLatest, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Data="{StaticResource IconCheck}" Fill="{StaticResource SuccessBrush}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="1" TextWrapping="Wrap" Text="{DynamicResource String_InstallModalLatestInfo}" Style="{StaticResource Caption}" Foreground="{StaticResource SecondaryTextBrush}"/>
                                </Grid>
                            </Border>

                            <!-- If Custom is selected: Show Branch ComboBox -->
                            <Border Background="{StaticResource SurfaceInputBrush}" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusMd}" Padding="12,10" Margin="0,0,0,14"
                                    Visibility="{Binding IsInstallModalVersionCustom, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel AllowDrop="True" Drop="DepotDropZone_Drop" DragOver="DepotDropZone_DragOver">
                                    <TextBlock Text="{DynamicResource String_InstallModalCustomBranchLabel}" Style="{StaticResource Caption}" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,6"/>
                                    <ComboBox Style="{StaticResource DarkComboBox}"
                                              IsEditable="True"
                                              ItemsSource="{Binding InstallModalAvailableBranches}"
                                              SelectedItem="{Binding InstallModalSelectedBranch, UpdateSourceTrigger=PropertyChanged}"
                                              Text="{Binding InstallModalSelectedBranch, UpdateSourceTrigger=PropertyChanged}"/>

                                    <!-- Per-depot manifests, the same table the Game Version tab's
                                         Custom mode edits, so "Custom" means the same thing in both. -->
                                    <Separator Margin="0,14,0,12" Background="{StaticResource SubtleBorderBrush}"/>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MinWidth="110"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{DynamicResource String_VersionCustomBuildIdLabel}" Style="{StaticResource CaptionBold}"
                                                       TextTrimming="CharacterEllipsis" Margin="0,0,0,5"/>
                                            <TextBox Style="{StaticResource DarkTextBox}" MinHeight="32"
                                                     VerticalContentAlignment="Center"
                                                     Text="{Binding CustomVersionBuildId, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                                            <Button Content="{DynamicResource String_ImportFromManifestFilesBtn}"
                                                    Style="{StaticResource SecondaryButton}" Padding="12,7" MinHeight="32"
                                                    Command="{Binding ImportManifestFilesDirectlyCommand}"/>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="{DynamicResource String_VersionCustomNoDepots}"
                                               Style="{StaticResource Caption}" Foreground="{StaticResource MutedTextBrush}"
                                               HorizontalAlignment="Center" Margin="0,6,0,6" TextWrapping="Wrap"
                                               Visibility="{Binding Depots.Count, Converter={StaticResource ZeroToVisibilityConverter}}"/>

                                    <Border Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource SubtleBorderBrush}"
                                            BorderThickness="1" CornerRadius="{StaticResource RadiusMd}" MaxHeight="190"
                                            Visibility="{Binding Depots.Count, Converter={StaticResource NullToVisibilityConverter}}">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding Depots}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="0,0,0,1" Padding="10,8">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="1.1*" MinWidth="90"/>
                                                                    <ColumnDefinition Width="1.5*" MinWidth="120"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>

                                                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                                                    <TextBlock Text="{Binding DisplayName}" Style="{StaticResource BodySmall}" TextTrimming="CharacterEllipsis"/>
                                                                    <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis">
                                                                        <Run Text="{Binding Depot.DepotId, Mode=OneWay}"/>
                                                                        <Run Text=" · "/>
                                                                        <Run Text="{Binding PlatformTag, Mode=OneWay}"/>
                                                                    </TextBlock>
                                                                </StackPanel>

                                                                <ComboBox Grid.Column="1" Style="{StaticResource CompactDarkComboBox}"
                                                                          IsEditable="True" Margin="0,0,10,0" VerticalAlignment="Center"
                                                                          ItemsSource="{Binding KnownManifestVersions}"
                                                                          SelectedItem="{Binding SelectedManifestOption}"
                                                                          TextSearch.TextPath="ManifestIdString"
                                                                          Text="{Binding ManifestInputText, UpdateSourceTrigger=PropertyChanged}"
                                                                          ToolTip="{DynamicResource String_SelectManifestVersion}"/>

                                                                <Border Grid.Column="2" Background="{StaticResource SurfaceInputBrush}"
                                                                        BorderBrush="{Binding AvailabilityBadgeColor}" BorderThickness="1"
                                                                        CornerRadius="{StaticResource RadiusSm}" Padding="7,3" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding AvailabilityStatus}" FontSize="10" FontWeight="SemiBold"
                                                                               Foreground="{Binding AvailabilityBadgeColor}"/>
                                                                </Border>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>

                                    <TextBlock Text="{DynamicResource String_VersionCustomDropHint}" Style="{StaticResource Caption}"
                                               Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"
                                               HorizontalAlignment="Center" TextAlignment="Center" Margin="0,8,0,0"/>

                                    <Border CornerRadius="{StaticResource RadiusMd}" Padding="10,8" Margin="0,10,0,0" BorderThickness="1"
                                            Visibility="{Binding CustomBuildValidationMessage, Converter={StaticResource NullToVisibilityConverter}}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource DangerBgBrush}"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource DangerBorderBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCustomBuildValid}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource SuccessBgBrush}"/>
                                                        <Setter Property="BorderBrush" Value="{StaticResource SuccessBorderBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding CustomBuildValidationMessage}" TextWrapping="Wrap" FontSize="11">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Body}">
                                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCustomBuildValid}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Separator Margin="0,0,0,14" Background="{StaticResource SubtleBorderBrush}"/>

                            <!-- No depots found for this title -->
                            <Border Background="{StaticResource DangerBgBrush}" BorderBrush="{StaticResource DangerBorderBrush}" BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusMd}" Padding="12,10" Margin="0,0,0,14"
                                    Visibility="{Binding InstallModalHasNoDepots, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Path Grid.Column="0" Data="{StaticResource IconInfo}" Fill="{StaticResource DangerBrush}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Grid.Column="1" TextWrapping="Wrap" Text="{DynamicResource String_InstallModalNoDepotsTitle}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource DangerBrush}"/>
                                    </Grid>
                                    <TextBlock Text="{DynamicResource String_InstallModalNoDepotsDesc}"
                                               Style="{StaticResource Caption}" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- 3. Game Emulator -->
                            <TextBlock Text="{DynamicResource String_InstallModalEmulatorSelectorTitle}" Style="{StaticResource CaptionBold}" Margin="0,0,0,8"/>
                            <UniformGrid Rows="1" Margin="0,0,0,8">
                                <!-- Option 1: None / Vanilla -->
                                <RadioButton Style="{StaticResource VersionModeCard}"
                                             GroupName="InstallModalEmulatorGroup"
                                             controls:ToggleableRadio.AllowUncheck="True"
                                             IsChecked="{Binding IsInstallModalEmulatorNone, Mode=TwoWay}"
                                             Margin="0,0,4,0">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                            <Path Data="{StaticResource IconSteam}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                  Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="{DynamicResource String_InstallModalEmulatorNone}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="{DynamicResource String_InstallModalEmulatorNoneDesc}"
                                                   Style="{StaticResource Caption}" Foreground="{StaticResource SecondaryTextBrush}"
                                                   TextWrapping="Wrap" MinHeight="28" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </RadioButton>

                                <!-- Option 2: ReFix Online (Steam Spacewar) -->
                                <RadioButton Style="{StaticResource VersionModeCard}"
                                             GroupName="InstallModalEmulatorGroup"
                                             controls:ToggleableRadio.AllowUncheck="True"
                                             IsChecked="{Binding IsInstallModalEmulatorValve, Mode=TwoWay}"
                                             Margin="2,0,2,0">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                <Path Data="{StaticResource IconEmulator}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                      Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock Text="{DynamicResource String_InstallModalEmulatorValve}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                            </StackPanel>
                                            <Border Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="4,0,0,0"
                                                    Background="{StaticResource AccentTranslucentBrush}" CornerRadius="{StaticResource RadiusXs}" Padding="5,1"
                                                    Visibility="{Binding IsValveRecommendedForGame, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="{DynamicResource String_InstallModalRecommendedBadge}" FontSize="8" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{DynamicResource String_InstallModalEmulatorValveDesc}"
                                                   Style="{StaticResource Caption}" Foreground="{StaticResource SecondaryTextBrush}"
                                                   TextWrapping="Wrap" MinHeight="28" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </RadioButton>

                                <!-- Option 3: Re:Goldberg LAN -->
                                <RadioButton Style="{StaticResource VersionModeCard}"
                                             GroupName="InstallModalEmulatorGroup"
                                             controls:ToggleableRadio.AllowUncheck="True"
                                             IsChecked="{Binding IsInstallModalEmulatorGoldberg, Mode=TwoWay}"
                                             Margin="3,0,3,0">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                <Path Data="{StaticResource IconGamepad}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                      Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock Text="{DynamicResource String_InstallModalEmulatorGoldberg}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                            </StackPanel>
                                            <Border Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="4,0,0,0"
                                                    Background="{StaticResource AccentTranslucentBrush}" CornerRadius="{StaticResource RadiusXs}" Padding="5,1"
                                                    Visibility="{Binding IsGoldbergRecommendedForGame, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="{DynamicResource String_InstallModalRecommendedBadge}" FontSize="8" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{DynamicResource String_InstallModalEmulatorGoldbergDesc}"
                                                   Style="{StaticResource Caption}" Foreground="{StaticResource SecondaryTextBrush}"
                                                   TextWrapping="Wrap" MinHeight="28" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </RadioButton>

                                <!-- Option 4: Game-Specific Online Fix (Only visible if available) -->
                                <RadioButton Style="{StaticResource VersionModeCard}"
                                             GroupName="InstallModalEmulatorGroup"
                                             controls:ToggleableRadio.AllowUncheck="True"
                                             Visibility="{Binding HasModalSpecificOnlineFix, Converter={StaticResource BoolToVisibilityConverter}}"
                                             IsChecked="{Binding IsInstallModalEmulatorSpecific, Mode=TwoWay}"
                                             Margin="3,0,0,0">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                <Path Data="{StaticResource IconTerminal}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                      Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock Text="{DynamicResource String_InstallModalEmulatorSpecific}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                            </StackPanel>
                                            <Border Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="4,0,0,0"
                                                    Background="{StaticResource AccentTranslucentBrush}" CornerRadius="{StaticResource RadiusXs}" Padding="5,1">
                                                <TextBlock Text="{DynamicResource String_InstallModalEmulatorSpecificBadge}" FontSize="8" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{Binding SelectedModalSpecificGameFix.Name, FallbackValue='Online-Fix'}"
                                                   Style="{StaticResource Caption}" Foreground="{StaticResource SecondaryTextBrush}"
                                                   TextWrapping="Wrap" MinHeight="28" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </RadioButton>
                            </UniformGrid>

                            <!-- Emulator detail box depending on selection -->
                            <Border Background="{StaticResource SurfaceInputBrush}" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusMd}" Padding="12,8" Margin="0,0,0,14"
                                    Visibility="{Binding IsInstallModalEmulatorNone, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Data="{StaticResource IconInfo}" Fill="{StaticResource SecondaryTextBrush}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="1" TextWrapping="Wrap" Text="{DynamicResource String_InstallModalEmulatorNoneInfo}" Style="{StaticResource Caption}" Foreground="{StaticResource SecondaryTextBrush}"/>
                                </Grid>
                            </Border>

                            <Border Background="{StaticResource SurfaceInputBrush}" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusMd}" Padding="12,8" Margin="0,0,0,14"
                                    Visibility="{Binding IsInstallModalEmulatorValve, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Data="{StaticResource IconCheck}" Fill="{StaticResource SuccessBrush}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="1" TextWrapping="Wrap" Text="{DynamicResource String_InstallModalEmulatorValveInfo}" Style="{StaticResource Caption}" Foreground="{StaticResource SecondaryTextBrush}"/>
                                </Grid>
                            </Border>

                            <Border Background="{StaticResource SurfaceInputBrush}" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusMd}" Padding="12,8" Margin="0,0,0,14"
                                    Visibility="{Binding IsInstallModalEmulatorGoldberg, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Data="{StaticResource IconCheck}" Fill="{StaticResource SuccessBrush}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="1" TextWrapping="Wrap" Text="{DynamicResource String_InstallModalEmulatorGoldbergInfo}" Style="{StaticResource Caption}" Foreground="{StaticResource SecondaryTextBrush}"/>
                                </Grid>
                            </Border>

                            <Border Background="{StaticResource SurfaceInputBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusMd}" Padding="12,10" Margin="0,0,0,14"
                                    Visibility="{Binding IsInstallModalEmulatorSpecific, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6" Visibility="{Binding OnlineGameFixes.Count, Converter={StaticResource NullToVisibilityConverter}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{DynamicResource String_InstallModalSpecificFixSelectLabel}" Style="{StaticResource Caption}" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                            <ComboBox Style="{StaticResource DarkComboBox}"
                                                      ItemsSource="{Binding OnlineGameFixes}"
                                                      SelectedItem="{Binding SelectedModalSpecificGameFix, Mode=TwoWay}"
                                                      DisplayMemberPath="Name"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="{StaticResource AccentTranslucentBrush}" CornerRadius="{StaticResource RadiusXs}" Padding="8,3" VerticalAlignment="Bottom" Margin="10,0,0,0">
                                            <TextBlock Text="{Binding SelectedModalSpecificGameFix.TagsSummary, FallbackValue='ONLINE FIX'}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                        </Border>
                                    </Grid>
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Path Grid.Column="0" Data="{StaticResource IconCheck}" Fill="{StaticResource SuccessBrush}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Grid.Column="1" TextWrapping="Wrap" Text="{Binding SelectedModalSpecificGameFix.Name, StringFormat={StaticResource String_InstallModalSpecificFixInfo}}"
                                        Style="{StaticResource Caption}" Foreground="{StaticResource SecondaryTextBrush}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Layerable fixes: bypasses, hypervisor fixes and anything else
                                 that is not an online fix. These sit on top of whatever emulator
                                 was chosen above, ReFix included, and several can apply at once —
                                 so they are tick boxes, not another radio. -->
                            <StackPanel Visibility="{Binding InstallModalHasExtraFixes, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Separator Margin="0,0,0,14" Background="{StaticResource SubtleBorderBrush}"/>

                                <TextBlock Text="{DynamicResource String_InstallModalExtraFixesTitle}" Style="{StaticResource CaptionBold}" Margin="0,0,0,4"/>
                                <TextBlock Text="{DynamicResource String_InstallModalExtraFixesDesc}"
                                           Style="{StaticResource Caption}" Foreground="{StaticResource SecondaryTextBrush}"
                                           TextWrapping="Wrap" Margin="0,0,0,8"/>

                                <Border Background="{StaticResource SurfaceInputBrush}" CornerRadius="{StaticResource RadiusMd}" Padding="12,8" Margin="0,0,0,14" MaxHeight="130"
                                        BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding InstallModalExtraFixes}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,3,0,3">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" Style="{StaticResource DarkCheckBox}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                        <Border Grid.Column="1" Background="{StaticResource AccentTranslucentBrush}" CornerRadius="{StaticResource RadiusXs}" Padding="5,1" VerticalAlignment="Center" Margin="0,0,8,0">
                                                            <TextBlock Text="{Binding Kind}" FontSize="8" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                                        </Border>
                                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" Style="{StaticResource BodySmall}" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" Foreground="{StaticResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>

                            <Separator Margin="0,0,0,14" Background="{StaticResource SubtleBorderBrush}"/>

                            <!-- 4. Optional DLCs -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{DynamicResource String_InstallModalDlcsTitle}" Style="{StaticResource CaptionBold}" VerticalAlignment="Center"/>
                                <CheckBox Grid.Column="1" Content="{DynamicResource String_InstallModalSelectAllDlcs}"
                                          Style="{StaticResource DarkCheckBox}"
                                          IsChecked="{Binding InstallModalSelectAllDlcs, Mode=TwoWay}"
                                          Visibility="{Binding InstallModalDlcs.Count, Converter={StaticResource NullToVisibilityConverter}}"/>
                            </Grid>

                            <Border Background="{StaticResource SurfaceInputBrush}" CornerRadius="{StaticResource RadiusMd}" Padding="12,8" Margin="0,0,0,14" MaxHeight="130"
                                    BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource String_InstallModalNoDlcs}"
                                                   Style="{StaticResource Caption}" Foreground="{StaticResource SecondaryTextBrush}"
                                                   HorizontalAlignment="Center" Margin="0,10"
                                                   Visibility="{Binding InstallModalDlcs.Count, Converter={StaticResource ZeroToVisibilityConverter}}"/>
                                        <ItemsControl ItemsSource="{Binding InstallModalDlcs}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,3,0,3">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" Style="{StaticResource DarkCheckBox}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource BodySmall}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding FormattedSize}" Style="{StaticResource Caption}" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>

                            <Separator Margin="0,0,0,14" Background="{StaticResource SubtleBorderBrush}"/>

                            <!-- 5. DLC Unlocker Method -->
                            <TextBlock Text="{DynamicResource String_DlcMethodSettingTitle}" Style="{StaticResource CaptionBold}" Margin="0,0,0,8"/>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <RadioButton Grid.Column="0"
                                             GroupName="InstallModalDlcGroup"
                                             controls:ToggleableRadio.AllowUncheck="True"
                                             IsChecked="{Binding IsModalCreamApiSelected}"
                                             Style="{StaticResource VersionModeCard}"
                                             Margin="0,0,6,0">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                            <TextBlock Text="CreamAPI" FontWeight="Bold" FontSize="12" Foreground="{StaticResource PrimaryTextBrush}"/>
                                            <Border Background="{StaticResource AccentTranslucentBrush}" CornerRadius="{StaticResource RadiusXs}" Padding="5,1" Margin="6,0,0,0">
                                                <TextBlock Text="Default" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{DynamicResource String_InstallModalCreamApiDesc}"
                                                   FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Grid.Column="1"
                                             GroupName="InstallModalDlcGroup"
                                             controls:ToggleableRadio.AllowUncheck="True"
                                             IsChecked="{Binding IsModalSmokeApiSelected}"
                                             Style="{StaticResource VersionModeCard}"
                                             Margin="6,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="SmokeAPI" FontWeight="Bold" FontSize="12" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,2"/>
                                        <TextBlock Text="{DynamicResource String_InstallModalSmokeApiDesc}"
                                                   FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </RadioButton>
                            </Grid>

                            <TextBlock Text="{DynamicResource String_InstallModalDlcMethodNoneHint}"
                                       Style="{StaticResource Caption}" Foreground="{StaticResource MutedTextBrush}"
                                       TextWrapping="Wrap" Margin="0,-8,0,14"
                                       Visibility="{Binding InstallModalHasSelectedDlcs, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>

                            <Separator Margin="0,0,0,14" Background="{StaticResource SubtleBorderBrush}"/>

                            <!-- 5. Shortcuts -->
                            <TextBlock Text="{DynamicResource String_InstallModalShortcutsTitle}" Style="{StaticResource CaptionBold}" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <CheckBox Content="{DynamicResource String_InstallModalDesktopShortcut}"
                                          Style="{StaticResource DarkCheckBox}"
                                          IsChecked="{Binding InstallModalCreateDesktopShortcut}"
                                          Margin="0,0,24,0"/>
                                <CheckBox Content="{DynamicResource String_InstallModalStartMenuShortcut}"
                                          Style="{StaticResource DarkCheckBox}"
                                          IsChecked="{Binding InstallModalCreateStartMenuShortcut}"/>
                            </StackPanel>

                            <Separator Margin="0,0,0,14" Background="{StaticResource SubtleBorderBrush}"/>

                            <!-- 6. System Prerequisites -->
                            <TextBlock Text="{DynamicResource String_InstallModalPrereqsTitle}" Style="{StaticResource CaptionBold}" Margin="0,0,0,8"/>
                            <CheckBox Content="{DynamicResource String_InstallModalInstallPrereqsCheck}"
                                      Style="{StaticResource DarkCheckBox}"
                                      IsChecked="{Binding InstallModalInstallPrerequisites}"
                                      Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding InstallModalPrereqStatusText}"
                                       Style="{StaticResource Caption}"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       Margin="24,0,0,0"/>

                            <!-- Prereq install progress bar/message when installing -->
                            <Border Background="{StaticResource SurfaceInputBrush}" CornerRadius="{StaticResource RadiusMd}" Padding="12,8" Margin="0,10,0,0"
                                    Visibility="{Binding IsInstallingModalPrerequisites, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding InstallModalProgressStatusText}" Style="{StaticResource Caption}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/>
                                    <ProgressBar IsIndeterminate="True" Height="4" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- FOOTER ACTIONS -->
                    <Border Grid.Row="2" Background="{StaticResource SurfaceCardBrush}" CornerRadius="0,0,12,12" Padding="24,16" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{Binding InstallModalSubtitle}"
                                       Style="{StaticResource Caption}" Foreground="{StaticResource SecondaryTextBrush}"
                                       VerticalAlignment="Center" Margin="0,0,16,0"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding InstallModalSubtitle}"/>

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="{DynamicResource String_Cancel}" Style="{StaticResource SecondaryButton}"
                                        Command="{Binding CloseInstallModalCommand}" Margin="0,0,12,0"
                                        IsEnabled="{Binding IsInstallingModalPrerequisites, Converter={StaticResource InverseBoolConverter}}"/>
                                <Button Content="{DynamicResource String_InstallModalStartBtn}" Style="{StaticResource PrimaryButton}"
                                        Command="{Binding StartOneClickInstallCommand}"
                                        IsEnabled="{Binding IsInstallingModalPrerequisites, Converter={StaticResource InverseBoolConverter}}"
                                        Padding="20,10"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══ FORCE DLC UNLOCKER CONFIRMATION ═══ -->
        <Grid Visibility="{Binding IsForceDlcUnlockerConfirmOpen, Converter={StaticResource BoolToVisibilityConverter}}"
              Background="{StaticResource ModalOverlayBrush}"
              Panel.ZIndex="1200">
            <Border Background="{StaticResource SurfaceCardElevatedBrush}"
                    BorderBrush="{StaticResource WarningBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusLg}"
                    Width="480"
                    Padding="24,20"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Path Data="{StaticResource IconInfo}" Fill="{StaticResource WarningBrush}" Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,9,0"/>
                        <TextBlock Text="{DynamicResource String_InstallModalForceDlcTitle}" Style="{StaticResource H3}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{DynamicResource String_InstallModalForceDlcDesc}"
                               Style="{StaticResource Caption}" Foreground="{StaticResource SecondaryTextBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,18"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="{DynamicResource String_Cancel}" Style="{StaticResource SecondaryButton}"
                                Padding="14,8" Margin="0,0,10,0"
                                Command="{Binding CancelForceDlcUnlockerCommand}"/>
                        <Button Content="{DynamicResource String_InstallModalForceDlcConfirm}" Style="{StaticResource PrimaryButton}"
                                Padding="16,8"
                                Command="{Binding ConfirmForceDlcUnlockerCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
