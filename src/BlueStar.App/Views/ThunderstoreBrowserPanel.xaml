<UserControl x:Class="BlueStar.App.Views.ThunderstoreBrowserPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{StaticResource SurfaceCardElevatedBrush}"
            BorderBrush="{StaticResource AccentBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusLg}"
            Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ═══ HEADER: TITLE, PROVIDER SWITCH TABS & CLOSE ═══ -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource String_ThunderstoreBrowserTitle}" Style="{StaticResource H2}"/>
                        <!-- Community pill -->
                        <Border CornerRadius="{StaticResource RadiusSm}" Background="{StaticResource AccentBgBrush}"
                                BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" Padding="8,2" Margin="12,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding Community, StringFormat='@{0}'}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBrush}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{DynamicResource String_ThunderstoreBrowserHint}" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Provider Tabs Switcher (Visible when game also has Steam Workshop) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0"
                            Visibility="{Binding HasWorkshopSupport, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Border CornerRadius="{StaticResource RadiusSm}" Background="{StaticResource SurfaceInputBrush}"
                            BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1" Padding="2">
                        <StackPanel Orientation="Horizontal">
                            <!-- Active: Thunderstore -->
                            <Border CornerRadius="{StaticResource RadiusSm}" Background="{StaticResource AccentBrush}" Padding="10,5">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconBolt}" Fill="#FFFFFF" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Thunderstore" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Inactive button: Steam Workshop -->
                            <Button Style="{StaticResource GhostButton}" Padding="10,5" Margin="2,0,0,0"
                                    Command="{Binding SwitchToWorkshopCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconSteam}" Fill="{StaticResource SecondaryTextBrush}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Steam Workshop" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Close button -->
                <Button Grid.Column="2" Content="✕" Style="{StaticResource GhostButton}" Width="34" Height="34" Padding="0"
                        VerticalAlignment="Top" Command="{Binding CloseCommand}"/>
            </Grid>

            <!-- ═══ TOOLBAR: SEARCH, CATEGORY, SORT & REFRESH ═══ -->
            <Grid Grid.Row="1" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Live Search Box -->
                <Grid Grid.Column="0" Margin="0,0,12,0">
                    <TextBox Style="{StaticResource DarkTextBox}" Padding="32,8,10,8"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                    <Path Data="{StaticResource IconSearch}" Fill="{StaticResource MutedTextBrush}" Width="13" Height="13"
                          Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False"/>
                </Grid>

                <!-- Category Filter -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="Category:" Style="{StaticResource CaptionBold}" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox Width="160" Style="{StaticResource DarkComboBox}"
                              ItemsSource="{Binding AvailableCategories}"
                              SelectedItem="{Binding SelectedCategory}"/>
                </StackPanel>

                <!-- Sort Selector -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="Sort by:" Style="{StaticResource CaptionBold}" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox Width="140" Style="{StaticResource DarkComboBox}"
                              ItemsSource="{Binding SortOptions}"
                              SelectedItem="{Binding SelectedSort}"/>
                </StackPanel>

                <!-- Refresh Button -->
                <Button Grid.Column="3" Style="{StaticResource SecondaryButton}" Width="36" Padding="0"
                        Command="{Binding LoadPackagesCommand}" ToolTip="Refresh catalog">
                    <Path Data="{StaticResource IconRefresh}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Button>
            </Grid>

            <!-- ═══ CONTENT: MOD PACKAGES LIST ═══ -->
            <Border Grid.Row="2" Background="{StaticResource SurfaceCardBrush}"
                    BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource RadiusMd}" Padding="10">
                <Grid>
                    <!-- Scrollable Packages List -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Packages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="{StaticResource RadiusMd}" Background="{StaticResource SurfaceInputBrush}"
                                            BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1"
                                            Padding="14,12" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Thumbnail / Icon -->
                                            <Border Grid.Column="0" Width="60" Height="60" CornerRadius="{StaticResource RadiusMd}"
                                                    Background="{StaticResource AccentBgBrush}" BorderBrush="{StaticResource SubtleBorderBrush}"
                                                    BorderThickness="1" Margin="0,0,14,0" VerticalAlignment="Top" ClipToBounds="True">
                                                <Grid>
                                                    <Path Data="{StaticResource IconBolt}" Fill="{StaticResource AccentBrush}" Width="24" Height="24"
                                                          Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <Image Source="{Binding IconUrl, Converter={StaticResource CachedImageConverter}}"
                                                           Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                </Grid>
                                            </Border>

                                            <!-- Info Column -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                                                <!-- Title, author & date -->
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Owner, StringFormat='  by {0}'}" Style="{StaticResource Caption}" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding FormattedDate, StringFormat='  ·  {0}'}" Style="{StaticResource Caption}" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/>
                                                </StackPanel>

                                                <!-- Description -->
                                                <TextBlock Text="{Binding Description}" Style="{StaticResource BodySmall}" Foreground="{StaticResource SecondaryTextBrush}"
                                                           TextWrapping="Wrap" MaxHeight="36" TextTrimming="CharacterEllipsis" Margin="0,4,0,6"/>

                                                <!-- Categories Pills & Stats -->
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <!-- Downloads stat -->
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                                        <Path Data="{StaticResource IconDownload}" Fill="{StaticResource MutedTextBrush}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding FormattedDownloads}" Style="{StaticResource CaptionBold}" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                                    </StackPanel>

                                                    <!-- Rating score stat -->
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                                        <Path Data="{StaticResource IconStar}" Fill="{StaticResource WarningBrush}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding RatingScore}" Style="{StaticResource CaptionBold}" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                                    </StackPanel>

                                                    <!-- Category pills -->
                                                    <ItemsControl ItemsSource="{Binding Categories}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal"/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border CornerRadius="{StaticResource RadiusSm}" Background="{StaticResource SurfaceCardBrush}"
                                                                        BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1"
                                                                        Padding="6,2" Margin="0,0,4,0" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding}" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}"/>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Version Picker & Action Button -->
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" MinWidth="140" HorizontalAlignment="Right">
                                                <!-- Version dropdown -->
                                                <ComboBox Width="130" Margin="0,0,0,6" Style="{StaticResource DarkComboBox}"
                                                          ItemsSource="{Binding AvailableVersions}"
                                                          SelectedItem="{Binding SelectedVersion}">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding VersionNumber, StringFormat='v{0}'}"/>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>

                                                <!-- Install / Switch / Installed Button -->
                                                <Button Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch"
                                                        Command="{Binding InstallCommand}" IsEnabled="{Binding CanInstall}">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <Path Data="{StaticResource IconCheck}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                              Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"
                                                              Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                        <Path Data="{StaticResource IconDownload}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                              Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"
                                                              Visibility="{Binding IsInstalled, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                                        <TextBlock Text="{Binding ButtonLabel}" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </Button>

                                                <!-- Download Progress Bar (When downloading this mod) -->
                                                <ProgressBar Height="3" Minimum="0" Maximum="100" Value="{Binding DownloadProgress}" Margin="0,4,0,0"
                                                             Visibility="{Binding IsInstalling, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Loading State -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{DynamicResource String_ThunderstoreLoading}" Style="{StaticResource BodyMedium}" Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <ProgressBar IsIndeterminate="True" Width="200" Height="4"/>
                    </StackPanel>

                    <!-- Empty State -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding HasNoResults, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Path Data="{StaticResource IconSearch}" Fill="{StaticResource MutedTextBrush}" Width="36" Height="36" Stretch="Uniform" Margin="0,0,0,12" HorizontalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource String_ThunderstoreNoResults}" Style="{StaticResource BodyMedium}" Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
