<UserControl x:Class="BlueStar.App.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:BlueStar.App.ViewModels"
             d:DataContext="{d:DesignInstance vm:AboutViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{StaticResource BaseBackgroundBrush}"
             Foreground="{StaticResource PrimaryTextBrush}"
             FontFamily="{StaticResource MainFontFamily}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,24" MaxWidth="1100" HorizontalAlignment="Stretch">

            <!-- ═══ HEADER BANNER ═══ -->
            <Border Background="{StaticResource SurfaceCardBrush}"
                    BorderBrush="{StaticResource SubtleBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusLg}"
                    Padding="24"
                    Margin="0,0,0,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                        <Border Background="{StaticResource AccentTranslucentBrush}"
                                Width="56" Height="56"
                                CornerRadius="28"
                                BorderBrush="{StaticResource AccentBrush}"
                                BorderThickness="1.5">
                            <TextBlock Text="★" FontSize="26" Foreground="{StaticResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="BlueStar Launcher" Style="{StaticResource H1}" Margin="0,0,10,0"/>
                            <Border Background="{StaticResource AccentTranslucentBrush}"
                                    BorderBrush="{StaticResource AccentBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusSm}"
                                    Padding="8,2"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding AppVersion, StringFormat='v{0}'}"
                                           FontSize="11" FontWeight="Bold"
                                           Foreground="{StaticResource AccentBrush}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Universal Steam game instance manager, depot downloader, and multi-engine launcher."
                                   Style="{StaticResource Subtitle}" Margin="0,0,0,6"/>
                        <TextBlock Text="BlueStar is built on top of amazing open-source software and community projects. All credits and repositories are listed below."
                                   Style="{StaticResource Caption}"/>
                    </StackPanel>

                    <Button Grid.Column="2"
                            Content="★ BlueStar on GitHub"
                            Style="{StaticResource PrimaryButton}"
                            Padding="16,10"
                            VerticalAlignment="Center"
                            Command="{Binding OpenUrlCommand}"
                            CommandParameter="https://github.com/Coronitaa/BlueStar"/>
                </Grid>
            </Border>

            <!-- ═══ SECTION TITLE ═══ -->
            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="Integrated Open-Source Projects &amp; Repositories" Style="{StaticResource H2}" Margin="0,0,0,4"/>
                <TextBlock Text="Libraries, tools, emulators, and frameworks utilized in BlueStar:"
                           Style="{StaticResource Caption}"/>
            </StackPanel>

            <!-- ═══ PROJECTS GRID / LIST ═══ -->
            <ItemsControl ItemsSource="{Binding Projects}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource SurfaceCardBrush}"
                                BorderBrush="{StaticResource SubtleBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusMd}"
                                Padding="18"
                                Width="520"
                                Margin="0,0,16,16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Header: Title & Badges -->
                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding Name}" Style="{StaticResource H3}"
                                               FontWeight="Bold" TextTrimming="CharacterEllipsis"/>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Category badge -->
                                        <Border Background="{StaticResource PurpleBgBrush}"
                                                BorderBrush="{StaticResource PurpleBrush}"
                                                BorderThickness="1"
                                                CornerRadius="{StaticResource RadiusXs}"
                                                Padding="6,2" Margin="0,0,6,0">
                                            <TextBlock Text="{Binding CategoryBadge}" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{StaticResource PurpleBrush}"/>
                                        </Border>
                                        <!-- License badge -->
                                        <Border Background="{StaticResource SurfaceInputBrush}"
                                                BorderBrush="{StaticResource SubtleBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="{StaticResource RadiusXs}"
                                                Padding="6,2">
                                            <TextBlock Text="{Binding License}" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{StaticResource SecondaryTextBrush}"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <!-- Role -->
                                <TextBlock Grid.Row="1" Text="{Binding Role}"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentBrush}"
                                           Margin="0,0,0,6"/>

                                <!-- Description -->
                                <TextBlock Grid.Row="2" Text="{Binding Description}"
                                           Style="{StaticResource BodySmall}"
                                           TextWrapping="Wrap"
                                           LineHeight="18"
                                           Margin="0,0,0,12"/>

                                <!-- Footer: Author & Link -->
                                <Border Grid.Row="3" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding Author, StringFormat='Author: {0}'}"
                                                   Style="{StaticResource Caption}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>

                                        <Button Grid.Column="1"
                                                Content="View on GitHub ↗"
                                                Style="{StaticResource SecondaryButton}"
                                                Padding="12,6"
                                                FontSize="11"
                                                Command="{Binding DataContext.OpenUrlCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding GitHubUrl}"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
