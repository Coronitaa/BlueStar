<UserControl x:Class="BlueStar.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:BlueStar.App.ViewModels"
             d:DataContext="{d:DesignInstance vm:HomeViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{StaticResource BaseBackgroundBrush}"
             Foreground="{StaticResource PrimaryTextBrush}"
             FontFamily="{StaticResource MainFontFamily}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,24" MaxWidth="1100" HorizontalAlignment="Stretch">

            <!-- ═══ GREETING & HERO HEADER ═══ -->
            <Border Background="{StaticResource SurfaceCardBrush}"
                    BorderBrush="{StaticResource SubtleBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusLg}"
                    Padding="28,24"
                    Margin="0,0,0,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="{Binding GreetingText}" Style="{StaticResource H1}" Margin="0,0,8,0"/>
                            <TextBlock Text="★" FontSize="22" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Universal game instance manager and ecosystem launcher."
                                   Style="{StaticResource Subtitle}"/>

                        <!-- Quick Stats Row -->
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Border Background="{StaticResource SurfaceInputBrush}" CornerRadius="{StaticResource RadiusMd}" Padding="12,6" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding TotalInstancesCount}" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,6,0"/>
                                    <TextBlock Text="Instances" Style="{StaticResource Caption}"/>
                                </StackPanel>
                            </Border>

                            <Border Background="{StaticResource SuccessBgBrush}" CornerRadius="{StaticResource RadiusMd}" Padding="12,6" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding ReadyInstancesCount}" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" Margin="0,0,6,0"/>
                                    <TextBlock Text="Ready to Play" Style="{StaticResource Caption}" Foreground="{StaticResource SuccessBrush}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- Quick Action Buttons -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                        <Button Content="🧭 Explore DepotBox"
                                Style="{StaticResource SecondaryButton}"
                                Margin="0,0,10,0"
                                Padding="16,10"
                                Command="{Binding NavigateToCommand}"
                                CommandParameter="Explore"/>

                        <Button Content="🎮 My Instances"
                                Style="{StaticResource PrimaryButton}"
                                Padding="18,10"
                                Command="{Binding NavigateToCommand}"
                                CommandParameter="Library"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══ ACTIVE DOWNLOAD BANNER (Visible if downloading) ═══ -->
            <Border Background="{StaticResource SurfaceCardElevatedBrush}"
                    BorderBrush="{StaticResource AccentBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusLg}"
                    Padding="20,16"
                    Margin="0,0,0,24"
                    Visibility="{Binding CurrentActiveDownload, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Collapsed}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Path Grid.Column="0" Data="{StaticResource IconDownload}" Fill="{StaticResource AccentBrush}" Stretch="Uniform" Width="18" Height="18" Margin="0,0,12,0" VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Active Download:" Style="{StaticResource CaptionBold}" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding CurrentActiveDownload.Instance.Name}" Style="{StaticResource H3}" FontWeight="Bold"/>
                            </StackPanel>
                        </StackPanel>

                        <Button Grid.Column="2" Content="View Downloads ➔"
                                Style="{StaticResource GhostButton}"
                                Foreground="{StaticResource AccentBrush}"
                                Command="{Binding NavigateToCommand}"
                                CommandParameter="Downloads"/>
                    </Grid>

                    <ProgressBar Grid.Row="2"
                                 Value="{Binding CurrentActiveDownload.Percentage}"
                                 Maximum="100"
                                 Style="{StaticResource DownloadProgressBar}"/>

                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding CurrentActiveDownload.FormattedProgress}" Style="{StaticResource Caption}"/>
                        <TextBlock Grid.Column="1" Text="{Binding CurrentActiveDownload.FormattedSpeed}" Style="{StaticResource CaptionBold}" Foreground="{StaticResource AccentBrush}"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- ═══ RECENT INSTANCES SECTION ═══ -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Recent Instances" Style="{StaticResource H2}"/>

                <Button Grid.Column="1" Content="View All ➔"
                        Style="{StaticResource GhostButton}"
                        Command="{Binding NavigateToCommand}"
                        CommandParameter="Library"/>
            </Grid>

            <!-- Empty State for Instances -->
            <Border Background="{StaticResource SurfaceCardBrush}"
                    BorderBrush="{StaticResource SubtleBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusLg}"
                    Padding="32"
                    Visibility="{Binding RecentInstances.Count, Converter={StaticResource ZeroToVisibilityConverter}, FallbackValue=Collapsed}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Path Data="{StaticResource IconGamepad}" Fill="{StaticResource MutedTextBrush}" Stretch="Uniform" Width="48" Height="48" Margin="0,0,0,16" HorizontalAlignment="Center"/>
                    <TextBlock Text="No game instances yet" Style="{StaticResource H3}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Explore games in DepotBox or import a ZIP package to start playing."
                               Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,6,0,20"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="🧭 Explore Games"
                                Style="{StaticResource PrimaryButton}"
                                Margin="0,0,10,0"
                                Command="{Binding NavigateToCommand}"
                                CommandParameter="Explore"/>
                        <Button Content="📦 Go to Instances"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding NavigateToCommand}"
                                CommandParameter="Library"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Recent Cards Grid -->
            <ItemsControl ItemsSource="{Binding RecentInstances}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Width="330" Margin="0,0,18,18">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="130"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Game banner / cover image -->
                                <Border Grid.Row="0" CornerRadius="8"
                                        Background="{StaticResource SurfaceCardHoverBrush}"
                                        ClipToBounds="True"
                                        Margin="-16,-16,-16,12">
                                    <Grid>
                                        <Path Data="{StaticResource IconGamepad}" Fill="{StaticResource MutedTextBrush}" Stretch="Uniform" Width="36" Height="36" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Image Source="{Binding HeaderImageUrl}"
                                               Stretch="UniformToFill"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Grid>
                                </Border>

                                <!-- Title & AppId -->
                                <StackPanel Grid.Row="1">
                                    <TextBlock Text="{Binding Name}"
                                               Style="{StaticResource H3}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding AppId, StringFormat='Steam AppID: {0}'}"
                                               Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- Engine Badge & Status Row -->
                                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                                    <!-- Engine Badge -->
                                    <Border CornerRadius="{StaticResource RadiusSm}"
                                            Padding="8,3"
                                            Margin="0,0,6,0"
                                            Background="{StaticResource SurfaceInputBrush}"
                                            BorderBrush="{Binding Engine, Converter={StaticResource EngineTypeToBrushConverter}, FallbackValue={StaticResource SubtleBorderBrush}, TargetNullValue={StaticResource SubtleBorderBrush}}"
                                            BorderThickness="1">
                                        <TextBlock Text="{Binding Engine.DisplayText, FallbackValue='Generic Game', TargetNullValue='Generic Game'}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding Engine, Converter={StaticResource EngineTypeToBrushConverter}, FallbackValue={StaticResource SecondaryTextBrush}, TargetNullValue={StaticResource SecondaryTextBrush}}"/>
                                    </Border>

                                    <!-- Status Badge -->
                                    <Border CornerRadius="{StaticResource RadiusSm}"
                                            Padding="8,3"
                                            Background="{Binding Status, Converter={StaticResource InstanceStatusToBgBrushConverter}, FallbackValue={StaticResource SurfaceInputBrush}, TargetNullValue={StaticResource SurfaceInputBrush}}">
                                        <TextBlock Text="{Binding Status, FallbackValue='Ready', TargetNullValue='Ready'}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding Status, Converter={StaticResource InstanceStatusToBrushConverter}, FallbackValue={StaticResource SuccessBrush}, TargetNullValue={StaticResource SuccessBrush}}"/>
                                    </Border>

                                    <!-- Emulator Update Available Tag -->
                                    <Border CornerRadius="{StaticResource RadiusSm}"
                                            Padding="8,3"
                                            Margin="6,0,0,0"
                                            Background="{StaticResource WarningBgBrush}"
                                            BorderBrush="{StaticResource WarningBrush}"
                                            BorderThickness="1"
                                            ToolTip="Actualización del emulador ReFix disponible para esta instancia"
                                            Visibility="{Binding Converter={StaticResource InstanceEmulatorUpdateVisibilityConverter}}">
                                        <TextBlock Text="{Binding Converter={StaticResource InstanceEmulatorUpdateTextConverter}}"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource WarningBrush}"/>
                                    </Border>
                                </StackPanel>

                                <!-- Action Buttons Row -->
                                <Grid Grid.Row="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0" Content="Manage"
                                            Style="{StaticResource SecondaryButton}"
                                            Command="{Binding DataContext.ManageInstanceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"/>

                                    <Button Grid.Column="2" Content="▶ Play"
                                            Style="{StaticResource PrimaryButton}"
                                            Command="{Binding DataContext.PlayInstanceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
