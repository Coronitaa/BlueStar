<UserControl x:Class="BlueStar.App.Views.WorkshopBrowserPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:BlueStar.App.Views"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
    <UserControl.Resources>
        <Style x:Key="RoundNavButton" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                CornerRadius="17"
                                Background="{StaticResource SurfaceInputBrush}"
                                BorderBrush="{StaticResource SubtleBorderBrush}"
                                BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource SurfaceInputFocusedBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource StrongBorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentBgBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border>
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="{StaticResource SurfaceCardElevatedBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}"/>
                <Setter Property="Padding" Value="18"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding ShowHeader, RelativeSource={RelativeSource AncestorType=local:WorkshopBrowserPanel}}" Value="False">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderBrush" Value="{x:Null}"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="0"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header (hidden when embedded inside unified ModBrowserPanel) -->
            <Grid Grid.Row="0" Margin="0,0,0,12"
                  Visibility="{Binding ShowHeader, RelativeSource={RelativeSource AncestorType=local:WorkshopBrowserPanel}, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{DynamicResource String_WorkshopBrowserTitle}" Style="{StaticResource H2}"/>
                    <TextBlock Text="{DynamicResource String_WorkshopBrowserHint}" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Provider Tabs Switcher (Visible when game also has Thunderstore) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0"
                            Visibility="{Binding HasThunderstoreSupport, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Border CornerRadius="{StaticResource RadiusSm}" Background="{StaticResource SurfaceInputBrush}"
                            BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1" Padding="2">
                        <StackPanel Orientation="Horizontal">
                            <!-- Inactive button: Thunderstore -->
                            <Button Style="{StaticResource GhostButton}" Padding="10,5" Margin="0,0,2,0"
                                    Command="{Binding SwitchToThunderstoreCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconBolt}" Fill="{StaticResource SecondaryTextBrush}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Thunderstore" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Active: Steam Workshop -->
                            <Border CornerRadius="{StaticResource RadiusSm}" Background="{StaticResource AccentBrush}" Padding="10,5">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconSteam}" Fill="#FFFFFF" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Steam Workshop" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Button Grid.Column="2" Content="✕" Style="{StaticResource GhostButton}" Width="34" Height="34" Padding="0"
                        VerticalAlignment="Top" Command="{Binding CloseCommand}"/>
            </Grid>

            <!-- Toolbar: navigation on the left (round buttons), smaller search bar aligned right next to download button -->
            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Navigation Controls (round buttons) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource RoundNavButton}" Margin="0,0,6,0"
                            Click="OnBackClicked" ToolTip="{DynamicResource String_Back}">
                        <Path Data="{StaticResource IconChevronLeft}" Fill="{StaticResource PrimaryTextBrush}"
                              Width="12" Height="12" Stretch="Uniform"/>
                    </Button>
                    <Button Style="{StaticResource RoundNavButton}" Margin="0,0,6,0"
                            Click="OnForwardClicked" ToolTip="{DynamicResource String_Forward}">
                        <Path Data="{StaticResource IconChevronRight}" Fill="{StaticResource PrimaryTextBrush}"
                              Width="12" Height="12" Stretch="Uniform"/>
                    </Button>
                    <Button Style="{StaticResource RoundNavButton}" Margin="0,0,6,0"
                            Click="OnHomeClicked" ToolTip="Workshop home">
                        <Path Data="{StaticResource IconHome}" Fill="{StaticResource PrimaryTextBrush}"
                              Width="12" Height="12" Stretch="Uniform"/>
                    </Button>
                </StackPanel>

                <!-- Right-aligned smaller search box & Download/Install button -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Smaller Search / ID input box -->
                    <Border Width="240" Margin="0,0,10,0" Height="34"
                            Background="{StaticResource SurfaceInputBrush}"
                            BorderBrush="{StaticResource SubtleBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusMd}"
                            Padding="8,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Data="{StaticResource IconSearch}"
                                  Fill="{StaticResource MutedTextBrush}"
                                  Stretch="Uniform" Width="12" Height="12"
                                  Margin="2,0,8,0" VerticalAlignment="Center"/>
                            <Grid Grid.Column="1">
                                <TextBlock Text="{DynamicResource String_WorkshopManualLabel}"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="12" VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Visibility="{Binding ManualInput, Converter={StaticResource InverseNullToVisibilityConverter}}"/>
                                <TextBox Text="{Binding ManualInput, UpdateSourceTrigger=PropertyChanged}"
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="{StaticResource PrimaryTextBrush}"
                                         CaretBrush="{StaticResource PrimaryTextBrush}"
                                         FontSize="12" Padding="0,6"
                                         VerticalContentAlignment="Center"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Download & Install Button -->
                    <Button Style="{StaticResource PrimaryButton}" Height="34" Padding="14,0"
                            Command="{Binding DownloadCommand}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource String_WorkshopDownloadInstallBtn}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding CurrentItemId, StringFormat='  #{0}'}" Opacity="0.85" FontWeight="Normal"
                                       Visibility="{Binding HasItem, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Embedded Steam Workshop -->
            <Border Grid.Row="2" CornerRadius="{StaticResource RadiusMd}" ClipToBounds="True" Background="#1B2838">
                <Grid>
                    <wv2:WebView2 x:Name="WorkshopView"/>
                    <Border x:Name="WebViewFallback" Visibility="Collapsed" Padding="32" Background="#1B2838">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460">
                            <TextBlock Text="{DynamicResource String_WorkshopWebViewMissingTitle}" FontSize="17" FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryTextBrush}" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock Text="{DynamicResource String_WorkshopWebViewMissingDesc}" Style="{StaticResource BodySmall}"
                                       TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,16"/>
                            <Button Content="{DynamicResource String_WorkshopInstallWebViewBtn}" Style="{StaticResource PrimaryButton}"
                                    HorizontalAlignment="Center" Click="OnInstallWebViewClicked"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Status: progress and result -->
            <StackPanel Grid.Row="3" Margin="0,10,0,0">
                <ProgressBar Height="4" Minimum="0" Maximum="100" Value="{Binding Progress}" Margin="0,0,0,8"
                             Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <Border CornerRadius="{StaticResource RadiusSm}" Padding="12,10" Margin="0,0,0,6" BorderThickness="1"
                        Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibilityConverter}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource AccentBgBrush}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource WarningBgBrush}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock TextWrapping="Wrap" Text="{Binding StatusMessage}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource BodySmall}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>

                <TextBlock Text="{DynamicResource String_WorkshopNoItemHint}" Style="{StaticResource Muted}"
                           Visibility="{Binding HasItem, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
