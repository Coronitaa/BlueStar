<UserControl x:Class="BlueStar.App.Views.DownloadsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:BlueStar.App.ViewModels"
             d:DataContext="{d:DesignInstance vm:DownloadsViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{StaticResource BaseBackgroundBrush}"
             Foreground="{StaticResource PrimaryTextBrush}"
             FontFamily="{StaticResource MainFontFamily}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,24" MaxWidth="1180" HorizontalAlignment="Stretch">

            <!-- ═══ HEADER ═══ -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="Downloads" Style="{StaticResource H1}" Margin="0,0,10,0"/>
                        <Border Background="{StaticResource AccentTranslucentBrush}"
                                CornerRadius="{StaticResource RadiusPill}"
                                Padding="8,2" VerticalAlignment="Center"
                                Visibility="{Binding DownloadQueue.Count, Converter={StaticResource NullToVisibilityConverter}}">
                            <TextBlock Text="{Binding DownloadQueue.Count, StringFormat='{}{0} in queue'}"
                                       Style="{StaticResource CaptionBold}" Foreground="{StaticResource AccentBrush}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Manage active game downloads, queue priorities, and download history."
                               Style="{StaticResource Subtitle}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="🧹 Limpiar Completados"
                            Style="{StaticResource SecondaryButton}"
                            Padding="12,7" FontSize="12" Margin="0,0,8,0"
                            Command="{Binding ClearCompletedCommand}"/>
                    <Button Content="⚠ Limpiar Fallidos"
                            Style="{StaticResource SecondaryButton}"
                            Padding="12,7" FontSize="12" Margin="0,0,8,0"
                            Command="{Binding ClearFailedCommand}"/>
                    <Button Content="🗑 Limpiar Cola"
                            Style="{StaticResource DangerButton}"
                            Padding="12,7" FontSize="12"
                            Command="{Binding ClearAllCommand}"/>
                </StackPanel>
            </Grid>

            <!-- ═══ EMPTY STATE (No active downloads) ═══ -->
            <Border Background="{StaticResource SurfaceCardBrush}"
                    BorderBrush="{StaticResource SubtleBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusLg}"
                    Padding="48,36" Margin="0,0,0,24"
                    Visibility="{Binding DownloadQueue.Count, Converter={StaticResource ZeroToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center">
                    <Path Data="{StaticResource IconDownload}" Fill="{StaticResource MutedTextBrush}"
                          Stretch="Uniform" Width="48" Height="48" Margin="0,0,0,16" HorizontalAlignment="Center"/>
                    <TextBlock Text="No active downloads" Style="{StaticResource H2}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Downloads started from the Explore catalog or your instances library will appear here."
                               Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- ═══ ACTIVE DOWNLOADS QUEUE CARDS ═══ -->
            <ItemsControl ItemsSource="{Binding DownloadQueue}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="14"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Header: Game Name + Status Pill + Actions -->
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Game Thumbnail -->
                                    <Border Grid.Column="0" CornerRadius="6" Height="36" ClipToBounds="True" Background="{StaticResource SurfaceInputBrush}">
                                        <Image Source="{Binding Instance.HeaderImageUrl}" Stretch="UniformToFill"/>
                                    </Border>

                                    <!-- Title & Progress text -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Instance.Name}" Style="{StaticResource H3}" Margin="0,0,10,0"/>
                                            <Border CornerRadius="{StaticResource RadiusSm}" Padding="8,2"
                                                    Background="{Binding JobStatus, Converter={StaticResource DownloadStatusToBgBrushConverter}}">
                                                <TextBlock Text="{Binding StatusMessage}" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{Binding JobStatus, Converter={StaticResource DownloadStatusToBrushConverter}}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding FormattedProgress}" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- Action Buttons -->
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Pause -->
                                        <Button Content="⏸ Pause" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" Padding="10,6" FontSize="12"
                                                Visibility="{Binding CanPause, Converter={StaticResource BoolToVisibilityConverter}}"
                                                Command="{Binding DataContext.PauseDownloadCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding Instance.Id}"/>

                                        <!-- Resume -->
                                        <Button Content="▶ Resume" Style="{StaticResource PrimaryButton}" Margin="0,0,6,0" Padding="10,6" FontSize="12"
                                                Visibility="{Binding CanResume, Converter={StaticResource BoolToVisibilityConverter}}"
                                                Command="{Binding DataContext.ResumeDownloadCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding Instance.Id}"/>

                                        <!-- Retry -->
                                        <Button Content="🔄 Retry" Style="{StaticResource PrimaryButton}" Margin="0,0,6,0" Padding="10,6" FontSize="12"
                                                Visibility="{Binding CanRetry, Converter={StaticResource BoolToVisibilityConverter}}"
                                                Command="{Binding DataContext.RetryDownloadCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding Instance.Id}"/>

                                        <!-- Cancel -->
                                        <Button Content="✕ Cancel" Style="{StaticResource DangerButton}" Margin="0,0,6,0" Padding="10,6" FontSize="12"
                                                Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibilityConverter}}"
                                                Command="{Binding DataContext.CancelDownloadCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding Instance.Id}"/>

                                        <!-- Remove -->
                                        <Button Content="Remove" Style="{StaticResource SecondaryButton}" Padding="10,6" FontSize="12"
                                                Visibility="{Binding CanRemove, Converter={StaticResource BoolToVisibilityConverter}}"
                                                Command="{Binding DataContext.RemoveJobCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding Instance.Id}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Progress Bar -->
                                <ProgressBar Grid.Row="2" Value="{Binding Percentage}" Maximum="100" Style="{StaticResource DownloadProgressBar}"/>

                                <!-- Metrics Row -->
                                <Grid Grid.Row="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding Instance.InstallPath, StringFormat='📁 {0}'}"
                                               Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"/>

                                    <TextBlock Grid.Column="1" Text="{Binding FormattedTotalSize}" Style="{StaticResource Caption}" Margin="16,0,0,0"/>

                                    <TextBlock Grid.Column="2" Text="{Binding FormattedSpeed}" Style="{StaticResource CaptionBold}"
                                               Margin="16,0,0,0" Foreground="{StaticResource AccentBrush}"/>
                                </Grid>

                                <!-- Error Box (if failed) -->
                                <Border Grid.Row="5" Background="{StaticResource DangerBgBrush}" CornerRadius="{StaticResource RadiusSm}"
                                        Padding="10,6" Margin="0,10,0,0"
                                        Visibility="{Binding ErrorDetail, Converter={StaticResource NullToVisibilityConverter}}">
                                    <TextBlock Text="{Binding ErrorDetail}" Foreground="{StaticResource DangerBrush}" Style="{StaticResource Caption}"/>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ═══ HISTORY LOG SECTION ═══ -->
            <Border Background="{StaticResource SurfaceCardBrush}"
                    BorderBrush="{StaticResource SubtleBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusLg}"
                    Padding="20" Margin="0,8,0,0"
                    Visibility="{Binding HistoryLog.Count, Converter={StaticResource NullToVisibilityConverter}}">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Recent Download Activity" Style="{StaticResource H3}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="🧹 Completados" Style="{StaticResource GhostButton}" Padding="10,5" FontSize="11" Margin="0,0,4,0" Command="{Binding ClearCompletedCommand}"/>
                            <Button Content="⚠ Fallidos" Style="{StaticResource GhostButton}" Padding="10,5" FontSize="11" Margin="0,0,4,0" Command="{Binding ClearFailedCommand}"/>
                            <Button Content="🗑 Limpiar Todo" Style="{StaticResource GhostButton}" Foreground="{StaticResource DangerBrush}" Padding="10,5" FontSize="11" Command="{Binding ClearAllCommand}"/>
                        </StackPanel>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding HistoryLog}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{Binding Status, Converter={StaticResource DownloadStatusToBgBrushConverter}}"
                                        CornerRadius="{StaticResource RadiusMd}" Padding="14,10" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding StatusEmoji}" FontSize="16" VerticalAlignment="Center"/>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding GameName}" Style="{StaticResource BodyMedium}"/>
                                            <TextBlock Text="{Binding Message}" Style="{StaticResource Caption}"
                                                       Foreground="{Binding Status, Converter={StaticResource DownloadStatusToBrushConverter}}"/>
                                        </StackPanel>

                                        <TextBlock Grid.Column="3" Text="{Binding FormattedTime}" Style="{StaticResource Caption}"
                                                   VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
