<UserControl x:Class="BlueStar.App.Views.DownloadsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:BlueStar.App.ViewModels"
             xmlns:controls="clr-namespace:BlueStar.App.Controls"
             d:DataContext="{d:DesignInstance vm:DownloadsViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{StaticResource BaseBackgroundBrush}"
             Foreground="{StaticResource PrimaryTextBrush}"
             FontFamily="{StaticResource MainFontFamily}">

    <UserControl.RenderTransform>
        <TranslateTransform Y="0"/>
    </UserControl.RenderTransform>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     From="0.0" To="1.0" Duration="0:0:0.22">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                     From="12" To="0" Duration="0:0:0.22">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="32,24" MaxWidth="1180" HorizontalAlignment="Stretch">

            <!-- ═══ HEADER ═══ -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="{DynamicResource String_DownloadsTitle}" Style="{StaticResource H1}" Margin="0,0,10,0"/>
                        <Border Background="{StaticResource AccentTranslucentBrush}"
                                CornerRadius="{StaticResource RadiusSm}"
                                Padding="8,3" VerticalAlignment="Center"
                                Visibility="{Binding DownloadQueue.Count, Converter={StaticResource NullToVisibilityConverter}}">
                            <TextBlock Text="{Binding DownloadQueue.Count, StringFormat='{}{0} in queue'}"
                                       Style="{StaticResource Caption}" FontWeight="Medium" Foreground="{StaticResource AccentBrush}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{DynamicResource String_DownloadsSubtitle}"
                               Style="{StaticResource Subtitle}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{DynamicResource String_ClearCompleted}"
                            Style="{StaticResource SecondaryButton}"
                            Padding="12,7" FontSize="12" Margin="0,0,8,0"
                            Command="{Binding ClearCompletedCommand}"/>
                    <Button Content="{DynamicResource String_ClearFailed}"
                            Style="{StaticResource SecondaryButton}"
                            Padding="12,7" FontSize="12" Margin="0,0,8,0"
                            Command="{Binding ClearFailedCommand}"/>
                    <Button Content="{DynamicResource String_ClearQueue}"
                            Style="{StaticResource DangerButton}"
                            Padding="12,7" FontSize="12"
                            Command="{Binding ClearAllCommand}"/>
                </StackPanel>
            </Grid>

            <!-- ═══ EMPTY STATE (No active downloads) ═══ -->
            <Border Background="{StaticResource SurfaceCardBrush}"
                    BorderBrush="{StaticResource SubtleBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusLg}"
                    Padding="48,36" Margin="0,0,0,24"
                    Visibility="{Binding DownloadQueue.Count, Converter={StaticResource ZeroToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center">
                    <Path Data="{StaticResource IconDownload}" Fill="{StaticResource MutedTextBrush}"
                          Stretch="Uniform" Width="48" Height="48" Margin="0,0,0,16" HorizontalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource String_NoActiveDownloads}" Style="{StaticResource H2}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource String_NoActiveDownloadsDesc}"
                               Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- ═══ STEAM-STYLE DOWNLOAD & WRITE GRAPH ═══ -->
            <controls:SteamDownloadGraphControl Visibility="{Binding DownloadQueue.Count, Converter={StaticResource NullToVisibilityConverter}}"/>

            <!-- ═══ ACTIVE DOWNLOADS QUEUE CARDS ═══ -->
            <ItemsControl ItemsSource="{Binding DownloadQueue}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="14"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Header: Game Name + Status Pill + Actions -->
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Game Thumbnail (Clickable) -->
                                    <Button Grid.Column="0" Style="{StaticResource GhostButton}" Padding="0" Cursor="Hand"
                                            Command="{Binding DataContext.OpenInstanceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding Instance}" ToolTip="{DynamicResource String_ViewGameDetails}">
                                        <Border CornerRadius="6" Height="36" ClipToBounds="True" Background="{StaticResource SurfaceInputBrush}">
                                            <Image Source="{Binding Instance.HeaderImageUrl, Converter={StaticResource CachedImageConverter}}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Border>
                                    </Button>

                                    <!-- Title & Progress text (Clickable Title) -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource GhostButton}" Padding="0" Margin="0,0,10,0" Cursor="Hand"
                                                    Command="{Binding DataContext.OpenInstanceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding Instance}" ToolTip="{DynamicResource String_ViewGameDetails}">
                                                <TextBlock Text="{Binding Instance.Name}" Style="{StaticResource H3}" TextTrimming="CharacterEllipsis" MaxWidth="350"/>
                                            </Button>
                                            <Border CornerRadius="{StaticResource RadiusSm}" Padding="8,2"
                                                    Background="{Binding JobStatus, Converter={StaticResource DownloadStatusToBgBrushConverter}}">
                                                <TextBlock Text="{Binding StatusMessage}" FontSize="11" FontWeight="Normal"
                                                           Foreground="{Binding JobStatus, Converter={StaticResource DownloadStatusToBrushConverter}}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding FormattedProgress}" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- Action Buttons -->
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- View Game / Instance -->
                                        <Button Content="{DynamicResource String_ViewGame}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Padding="10,6" FontSize="12"
                                                Command="{Binding DataContext.OpenInstanceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding Instance}"/>

                                        <!-- Pause (⏸) -->
                                        <Button Style="{StaticResource SecondaryButton}" Padding="8" Margin="0,0,6,0" Width="34" Height="34"
                                                ToolTip="{DynamicResource String_Pause}"
                                                Visibility="{Binding CanPause, Converter={StaticResource BoolToVisibilityConverter}}"
                                                Command="{Binding DataContext.PauseDownloadCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding Instance.Id}">
                                            <Path Data="{StaticResource IconPause}" Fill="{StaticResource PrimaryTextBrush}" Width="12" Height="12" Stretch="Uniform"/>
                                        </Button>

                                        <!-- Resume / Play (▶) -->
                                        <Button Style="{StaticResource PrimaryButton}" Padding="8" Margin="0,0,6,0" Width="34" Height="34"
                                                ToolTip="{DynamicResource String_Resume}"
                                                Visibility="{Binding CanResume, Converter={StaticResource BoolToVisibilityConverter}}"
                                                Command="{Binding DataContext.ResumeDownloadCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding Instance.Id}">
                                            <Path Data="{StaticResource IconPlay}" Fill="White" Width="12" Height="12" Stretch="Uniform" Margin="1,0,0,0"/>
                                        </Button>

                                        <!-- Retry (🔄) -->
                                        <Button Style="{StaticResource PrimaryButton}" Padding="8" Margin="0,0,6,0" Width="34" Height="34"
                                                ToolTip="{DynamicResource String_RetryAction}"
                                                Visibility="{Binding CanRetry, Converter={StaticResource BoolToVisibilityConverter}}"
                                                Command="{Binding DataContext.RetryDownloadCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding Instance.Id}">
                                            <Path Data="{StaticResource IconRefresh}" Fill="White" Width="13" Height="13" Stretch="Uniform"/>
                                        </Button>

                                        <!-- Stop / Cancel (⏹) -->
                                        <Button Style="{StaticResource DangerButton}" Padding="8" Margin="0,0,6,0" Width="34" Height="34"
                                                ToolTip="{DynamicResource String_CancelAction}"
                                                Visibility="{Binding CanCancel, Converter={StaticResource BoolToVisibilityConverter}}"
                                                Command="{Binding DataContext.CancelDownloadCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding Instance.Id}">
                                            <Path Data="{StaticResource IconStop}" Fill="{StaticResource DangerBrush}" Width="11" Height="11" Stretch="Uniform"/>
                                        </Button>

                                        <!-- Trash / Remove (🗑) with Confirmation Modal -->
                                        <Button Style="{StaticResource SecondaryButton}" Padding="8" Width="34" Height="34"
                                                ToolTip="{DynamicResource String_RemoveAction}"
                                                Visibility="{Binding CanRemove, Converter={StaticResource BoolToVisibilityConverter}}"
                                                Command="{Binding DataContext.RequestRemoveJobCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding .}">
                                            <Path Data="{StaticResource IconTrash}" Fill="{StaticResource MutedTextBrush}" Width="13" Height="13" Stretch="Uniform"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- Progress Bar -->
                                <ProgressBar Grid.Row="2" Value="{Binding Percentage}" Maximum="100" Style="{StaticResource DownloadProgressBar}"/>

                                <!-- Metrics Row -->
                                <Grid Grid.Row="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding Instance.InstallPath, StringFormat='📁 {0}'}"
                                               Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"/>

                                    <TextBlock Grid.Column="1" Text="{Binding FormattedEta, StringFormat='⏱ {0}'}" Style="{StaticResource Caption}"
                                               Margin="12,0,0,0" Foreground="{StaticResource SecondaryTextBrush}"
                                               Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                    <TextBlock Grid.Column="2" Text="{Binding FormattedWriteSpeed, StringFormat='💾 {0}'}" Style="{StaticResource Caption}"
                                               Margin="12,0,0,0" Foreground="{StaticResource SecondaryTextBrush}"
                                               Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                    <TextBlock Grid.Column="3" Text="{Binding FormattedSpeed, StringFormat='⬇ {0}'}" Style="{StaticResource CaptionBold}"
                                               Margin="12,0,0,0" Foreground="{StaticResource AccentBrush}"/>
                                </Grid>

                                <!-- Error Box (if failed) -->
                                <Border Grid.Row="5" Background="{StaticResource DangerBgBrush}" CornerRadius="{StaticResource RadiusSm}"
                                        Padding="10,6" Margin="0,10,0,0"
                                        Visibility="{Binding ErrorDetail, Converter={StaticResource NullToVisibilityConverter}}">
                                    <TextBlock Text="{Binding ErrorDetail}" Foreground="{StaticResource DangerBrush}" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ═══ HISTORY LOG SECTION ═══ -->
            <Border Background="{StaticResource SurfaceCardBrush}"
                    BorderBrush="{StaticResource SubtleBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusLg}"
                    Padding="20" Margin="0,8,0,0"
                    Visibility="{Binding HistoryLog.Count, Converter={StaticResource NullToVisibilityConverter}}">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource String_RecentActivityTitle}" Style="{StaticResource H3}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="{DynamicResource String_Completed}" Style="{StaticResource GhostButton}" Padding="10,5" FontSize="11" Margin="0,0,4,0" Command="{Binding ClearCompletedCommand}"/>
                            <Button Content="{DynamicResource String_Failed}" Style="{StaticResource GhostButton}" Padding="10,5" FontSize="11" Margin="0,0,4,0" Command="{Binding ClearFailedCommand}"/>
                            <Button Content="{DynamicResource String_Clear}" Style="{StaticResource GhostButton}" Foreground="{StaticResource DangerBrush}" Padding="10,5" FontSize="11" Command="{Binding ClearAllCommand}"/>
                        </StackPanel>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding HistoryLog}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{Binding Status, Converter={StaticResource DownloadStatusToBgBrushConverter}}"
                                        CornerRadius="{StaticResource RadiusMd}" Padding="14,10" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding StatusEmoji}" FontSize="16" VerticalAlignment="Center"/>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding GameName}" Style="{StaticResource BodyMedium}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Message}" Style="{StaticResource Caption}" TextWrapping="Wrap"
                                                       Foreground="{Binding Status, Converter={StaticResource DownloadStatusToBrushConverter}}"/>
                                        </StackPanel>

                                        <TextBlock Grid.Column="3" Text="{Binding FormattedTime}" Style="{StaticResource Caption}"
                                                   VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>

    <!-- ═══ CONFIRM REMOVE DOWNLOAD MODAL OVERLAY ═══ -->
    <Grid Visibility="{Binding IsRemoveModalOpen, Converter={StaticResource BoolToVisibilityConverter}}"
          Background="{StaticResource ModalOverlayBrush}"
          Panel.ZIndex="1000">
        <Border Background="{StaticResource SurfaceCardElevatedBrush}"
                BorderBrush="{StaticResource SubtleBorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusLg}"
                Padding="28" Width="460"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{DynamicResource String_RemoveDownloadModalTitle}" Style="{StaticResource H2}"/>
                        <TextBlock Text="{Binding RemoveModalGameName}" Style="{StaticResource Caption}" Foreground="{StaticResource AccentBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="✕" Style="{StaticResource GhostButton}" Width="24" Height="24" Padding="0"
                            Command="{Binding CancelRemoveModalCommand}"/>
                </Grid>

                <TextBlock Text="{DynamicResource String_RemoveDownloadModalDesc}"
                           Style="{StaticResource BodyMedium}"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,24"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="{DynamicResource String_Cancel}"
                            Style="{StaticResource SecondaryButton}"
                            Padding="16,10"
                            Command="{Binding CancelRemoveModalCommand}"/>

                    <Button Grid.Column="2" Content="{DynamicResource String_RemoveDownloadConfirmBtn}"
                            Style="{StaticResource DangerButton}"
                            Padding="16,10"
                            Command="{Binding ConfirmRemoveJobCommand}"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Grid>
</UserControl>
