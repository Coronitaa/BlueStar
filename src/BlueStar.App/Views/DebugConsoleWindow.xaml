<Window x:Class="BlueStar.App.Views.DebugConsoleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:BlueStar.App.ViewModels"
        xmlns:models="clr-namespace:BlueStar.Core.Models;assembly=BlueStar.Core"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:DebugConsoleViewModel}"
        Title="BlueStar — Live Debug &amp; Diagnostic Console"
        Icon="pack://application:,,,/BlueStar;component/Assets/bluestar.ico"
        Width="1050" Height="680"
        MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="#0E1015"
        Foreground="{StaticResource PrimaryTextBrush}"
        FontFamily="{StaticResource MainFontFamily}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header / Brand & Badges -->
            <RowDefinition Height="Auto"/> <!-- Toolbar: Search, Filters & Actions -->
            <RowDefinition Height="*"/>    <!-- Main Console Log Stream -->
            <RowDefinition Height="Auto"/> <!-- Status & Guidance Bar -->
        </Grid.RowDefinitions>

        <!-- ═══ HEADER / BRAND & REALTIME BADGES ═══ -->
        <Border Grid.Row="0" Background="#14171F" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="0,0,0,1" Padding="16,10">
            <DockPanel LastChildFill="True">
                <!-- Right: Status Counter Pills (Docked right so they never clip) -->
                <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="8,0,0,0">
                    <!-- Total Logs -->
                    <Border Background="#1E232E" CornerRadius="6" Padding="10,4" Margin="0,2,8,2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Logs: " FontSize="12" Foreground="{StaticResource MutedTextBrush}"/>
                            <TextBlock Text="{Binding TotalCount}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Warnings -->
                    <Border Background="#3B2D0C" BorderBrush="#785B18" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,2,8,2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚠ " FontSize="12" Foreground="#FBBF24"/>
                            <TextBlock Text="{Binding WarningCount}" FontSize="12" FontWeight="SemiBold" Foreground="#FDE68A"/>
                        </StackPanel>
                    </Border>

                    <!-- Errors -->
                    <Border Background="#3B1515" BorderBrush="#7F1D1D" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,2,0,2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✖ " FontSize="12" Foreground="#F87171"/>
                            <TextBlock Text="{Binding ErrorCount}" FontSize="12" FontWeight="SemiBold" Foreground="#FECACA"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <!-- Left: Title & Subtitle -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="28" Height="28" CornerRadius="6" Background="{StaticResource AccentBrush}" Margin="0,0,10,0">
                        <TextBlock Text=">_" FontFamily="Consolas, Courier New, monospace" FontWeight="Bold" FontSize="13"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{DynamicResource String_DebugConsoleTitle}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}"/>
                            <TextBlock Text="•" Foreground="{StaticResource MutedTextBrush}" Margin="6,0"/>
                            <TextBlock Text="Live Stream" FontSize="11.5" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{DynamicResource String_DebugConsoleSubtitle}" Style="{StaticResource Muted}" FontSize="11"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ═══ TOOLBAR: ADAPTIVE / RESPONSIVE WRAPPANEL ═══ -->
        <Border Grid.Row="1" Background="#11131A" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="0,0,0,1" Padding="12,10,12,4">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Search Filter Box -->
                <TextBox Style="{StaticResource DarkTextBox}"
                         Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                         Width="200"
                         Height="32"
                         Padding="8,5"
                         FontSize="12"
                         Margin="0,0,8,6"/>

                <!-- Level Filter Dropdown -->
                <ComboBox Style="{StaticResource DarkComboBox}"
                          ItemsSource="{Binding LevelFilters}"
                          SelectedItem="{Binding SelectedLevelFilter}"
                          Width="140"
                          Height="32"
                          FontSize="12"
                          Margin="0,0,8,6"/>

                <!-- Auto-Scroll Checkbox -->
                <CheckBox IsChecked="{Binding IsAutoScrollEnabled, Mode=TwoWay}"
                          Content="Auto-scroll"
                          Style="{StaticResource DarkCheckBox}"
                          VerticalAlignment="Center"
                          FontSize="12"
                          Margin="4,0,12,6"/>

                <!-- Action: Generate Diagnostic Report -->
                <Button Style="{StaticResource PrimaryButton}"
                        Command="{Binding GenerateDiagnosticReportCommand}"
                        IsEnabled="{Binding IsGeneratingReport, Converter={StaticResource InverseBoolConverter}}"
                        Padding="11,5" FontSize="12" Margin="0,0,6,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚡ " FontSize="11"/>
                        <TextBlock Text="{DynamicResource String_GenerateDiagnosticReportBtn}"/>
                    </StackPanel>
                </Button>

                <!-- Action: Copy All Logs -->
                <Button Style="{StaticResource SecondaryButton}"
                        Command="{Binding CopyAllLogsCommand}"
                        Padding="11,5" FontSize="12" Margin="0,0,6,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📋 " FontSize="11"/>
                        <TextBlock Text="{DynamicResource String_CopyLogsBtn}"/>
                    </StackPanel>
                </Button>

                <!-- Action: Clear Console -->
                <Button Style="{StaticResource GhostButton}"
                        Command="{Binding ClearLogsCommand}"
                        Padding="10,5" FontSize="12" Margin="0,0,6,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🗑 " FontSize="11"/>
                        <TextBlock Text="{DynamicResource String_ClearLogsBtn}"/>
                    </StackPanel>
                </Button>

                <!-- Action: Open Logs Folder -->
                <Button Style="{StaticResource GhostButton}"
                        Command="{Binding OpenLogsFolderCommand}"
                        Padding="10,5" FontSize="12" Margin="0,0,6,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📁 " FontSize="11"/>
                        <TextBlock Text="{DynamicResource String_OpenLogFolderBtn}"/>
                    </StackPanel>
                </Button>
            </WrapPanel>
        </Border>

        <!-- ═══ MAIN CONSOLE LOG STREAM (FLUID & AUTO-WRAPPING) ═══ -->
        <Border Grid.Row="2" Background="#0A0B0E" Margin="0">
            <ListBox x:Name="LogsListBox"
                     ItemsSource="{Binding FilteredLogs}"
                     Background="Transparent"
                     BorderThickness="0"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     VirtualizingStackPanel.IsVirtualizing="True"
                     VirtualizingStackPanel.VirtualizationMode="Recycling"
                     ScrollViewer.CanContentScroll="True"
                     Padding="8,6">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="4,3"/>
                        <Setter Property="Margin" Value="0,1"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="4"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Stretch"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#171A23"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#202636"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:LogMessageItem}">
                        <StackPanel Margin="0,1" HorizontalAlignment="Stretch">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>   <!-- Timestamp -->
                                    <ColumnDefinition Width="46"/>   <!-- Severity Tag -->
                                    <ColumnDefinition Width="Auto"/> <!-- Source Context -->
                                    <ColumnDefinition Width="*"/>    <!-- Log Message (Takes all remaining width) -->
                                </Grid.ColumnDefinitions>

                                <!-- Timestamp -->
                                <TextBlock Grid.Column="0"
                                           Text="{Binding FormattedTime}"
                                           FontFamily="Consolas, Cascadia Code, Courier New, monospace"
                                           FontSize="11.5"
                                           Foreground="#64748B"
                                           VerticalAlignment="Top"
                                           Margin="0,1,0,0"/>

                                <!-- Severity Badge -->
                                <Border Grid.Column="1"
                                        Background="{Binding Severity, Converter={StaticResource LogSeverityToBgBrushConverter}}"
                                        CornerRadius="3"
                                        Padding="4,1"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Margin="0,1,0,0">
                                    <TextBlock Text="{Binding SeverityCode}"
                                               FontFamily="Consolas, Cascadia Code, monospace"
                                               FontSize="10.5"
                                               FontWeight="Bold"
                                               Foreground="{Binding Severity, Converter={StaticResource LogSeverityToBrushConverter}}"/>
                                </Border>

                                <!-- Source Context -->
                                <TextBlock Grid.Column="2"
                                           Text="{Binding SourceContext, StringFormat='[{0}] '}"
                                           Visibility="{Binding SourceContext, Converter={StaticResource NullToVisibilityConverter}}"
                                           FontFamily="Consolas, Cascadia Code, monospace"
                                           FontSize="11.5"
                                           Foreground="#818CF8"
                                           VerticalAlignment="Top"
                                           Margin="6,1,4,0"/>

                                <!-- Message Text (Wraps to viewport dynamically) -->
                                <TextBox Grid.Column="3"
                                         Text="{Binding Message, Mode=OneWay}"
                                         IsReadOnly="True"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         FontFamily="Consolas, Cascadia Code, monospace"
                                         FontSize="12"
                                         Foreground="#E2E8F0"
                                         TextWrapping="Wrap"
                                         VerticalAlignment="Top"
                                         Cursor="IBeam"/>
                            </Grid>

                            <!-- Exception Stack Trace (Visible only when present) -->
                            <Border Margin="90,4,0,2"
                                    HorizontalAlignment="Stretch"
                                    Background="#261010"
                                    BorderBrush="#591D1D"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="8,6"
                                    Visibility="{Binding Exception, Converter={StaticResource NullToVisibilityConverter}}">
                                <TextBox Text="{Binding Exception, Mode=OneWay}"
                                         IsReadOnly="True"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Foreground="#FCA5A5"
                                         FontFamily="Consolas, Cascadia Code, monospace"
                                         FontSize="11"
                                         TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- ═══ FOOTER: STATUS BAR ═══ -->
        <Border Grid.Row="3" Background="#11131A" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="0,1,0,0" Padding="14,8">
            <DockPanel LastChildFill="True">
                <!-- Right: Status Badge -->
                <Border DockPanel.Dock="Right" Background="#1E293B" CornerRadius="4" Padding="6,2" Margin="10,0,0,0">
                    <TextBlock Text="GitHub &amp; Bug Report Ready" FontSize="10.5" Foreground="#94A3B8"/>
                </Border>

                <!-- Left: Status Message -->
                <TextBlock Text="{Binding StatusMessage, FallbackValue='ℹ Ready. Generate Diagnostic Report exports a clean, deduplicated report for GitHub issues.'}"
                           FontSize="11.5"
                           Foreground="{StaticResource PrimaryTextBrush}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
