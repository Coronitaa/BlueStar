<UserControl x:Class="BlueStar.App.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:vm="clr-namespace:BlueStar.App.ViewModels"
             xmlns:controls="clr-namespace:BlueStar.App.Controls"
             d:DataContext="{d:DesignInstance vm:LibraryViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{StaticResource BaseBackgroundBrush}"
             Foreground="{StaticResource PrimaryTextBrush}"
             FontFamily="{StaticResource MainFontFamily}">



    <Grid>
        <!-- ═══ MAIN LIBRARY SURFACE ═══ -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,20" HorizontalAlignment="Stretch">

                <!-- ── HEADER TITLE & INSTANCE COUNT ── -->
                <Grid Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource String_LibraryTitle}" Style="{StaticResource H1}" Margin="0,0,10,0"/>
                        <Border Background="{StaticResource SurfaceInputBrush}"
                                CornerRadius="{StaticResource RadiusSm}"
                                Padding="8,3"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding FilteredInstances.Count, StringFormat='{}{0} games'}"
                                       Style="{StaticResource Caption}" FontWeight="Medium" Foreground="{StaticResource AccentBrush}"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- ── SEARCH BAR ROW (+ New group & + New instance) ── -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Search Input Box -->
                    <Border Grid.Column="0" Background="{StaticResource SurfaceInputBrush}"
                            BorderBrush="{StaticResource SubtleBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusMd}"
                            Padding="12,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Data="{StaticResource IconSearch}"
                                  Fill="{StaticResource MutedTextBrush}"
                                  Stretch="Uniform" Width="14" Height="14"
                                  Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <Grid Grid.Column="1">
                                <TextBlock Text="{DynamicResource String_SearchLibraryPlaceholder}"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="13" VerticalAlignment="Center" Margin="2,0,0,0"
                                           IsHitTestVisible="False"
                                           Visibility="{Binding SearchFilter, Converter={StaticResource InverseNullToVisibilityConverter}}"/>
                                <TextBox Text="{Binding SearchFilter, UpdateSourceTrigger=PropertyChanged}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Foreground="{StaticResource PrimaryTextBrush}"
                                         CaretBrush="{StaticResource PrimaryTextBrush}"
                                         FontSize="13"
                                         Padding="0,9"
                                         VerticalContentAlignment="Center"/>
                            </Grid>
                            <Button Grid.Column="2"
                                    Content="✕"
                                    Style="{StaticResource GhostButton}"
                                    Padding="4,2"
                                    FontSize="11"
                                    Foreground="{StaticResource MutedTextBrush}"
                                    Command="{Binding ClearSearchCommand}"
                                    Visibility="{Binding SearchFilter, Converter={StaticResource NullToVisibilityConverter}}"/>
                        </Grid>
                    </Border>

                    <!-- "+ New group" Button -->
                    <Button Grid.Column="2"
                            Style="{StaticResource SecondaryButton}"
                            Padding="14,9"
                            Command="{Binding OpenCreateGroupCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconPlus}" Fill="{StaticResource SecondaryTextBrush}"
                                  Stretch="Uniform" Width="12" Height="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource String_NewGroup}" FontWeight="SemiBold" FontSize="13"/>
                        </StackPanel>
                    </Button>

                    <!-- "+ New instance" Button -->
                    <Button Grid.Column="4"
                            Style="{StaticResource PrimaryButton}"
                            Background="#10B981"
                            BorderBrush="#059669"
                            Padding="16,9"
                            Command="{Binding OpenAddInstanceModalCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconPlus}" Fill="{StaticResource InverseTextBrush}"
                                  Stretch="Uniform" Width="13" Height="13" Margin="0,0,8,0"
                                  VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource String_NewInstance}" FontWeight="Bold" FontSize="13"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- ── COMPACT FILTERS & SELECTION TOOLBAR ROW ── -->
                <DockPanel Margin="0,0,0,24" LastChildFill="False">
                    <!-- Right Actions Bar (Anchored to the right, visible when IsSelectionModeActive) -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="{Binding IsSelectionModeActive, Converter={StaticResource BoolToVisibilityConverter}}">
                        <!-- Number of selected items text -->
                        <Border Background="{StaticResource SurfaceInputBrush}"
                                BorderBrush="{StaticResource SubtleBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusMd}"
                                Padding="12,6"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedInstancesCountText}"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <!-- Delete Button (active/enabled only if has at least 1 selected) -->
                        <Button Style="{StaticResource DangerButton}"
                                Padding="14,7"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                IsEnabled="{Binding HasSelectedInstances}"
                                Command="{Binding OpenBulkDeleteModalCommand}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconTrash}" Fill="#FFFFFF"
                                      Stretch="Uniform" Width="13" Height="13"
                                      Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource String_DeleteSelected}"
                                           FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Cancel cross button (anchored to the far right) -->
                        <Button Style="{StaticResource GhostButton}"
                                Padding="9,7"
                                ToolTip="{DynamicResource String_CancelSelection}"
                                Command="{Binding ExitSelectionModeCommand}"
                                VerticalAlignment="Center">
                            <TextBlock Text="✕" FontSize="13" FontWeight="Bold"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>

                                        <!-- View Mode Toggle Button (Anchored right, visible when NOT in selection mode) -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="{Binding IsSelectionModeActive, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <Button Style="{StaticResource SecondaryButton}"
                                Padding="10,7"
                                Command="{Binding CycleColumnCountCommand}"
                                ToolTip="Toggle view layout">
                            <Path Stretch="Uniform" Width="14" Height="14" Fill="{StaticResource SecondaryTextBrush}">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Data" Value="{StaticResource IconGridView3x3}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ColumnCount}" Value="4">
                                                <Setter Property="Data" Value="{StaticResource IconGridView4x4}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ColumnCount}" Value="5">
                                                <Setter Property="Data" Value="{StaticResource IconGridView5x5}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ColumnCount}" Value="0">
                                                <Setter Property="Data" Value="{StaticResource IconListView}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Button>
                    </StackPanel>

                    <!-- Left Toolbar Controls -->
                    <WrapPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 1. Sort Controls: Invert Sort Button + Sort Dropdown -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                        <!-- Invert Sort Direction Button (⇅) -->
                        <Button Style="{StaticResource SecondaryButton}"
                                Padding="9,7"
                                Margin="0,0,4,0"
                                ToolTip="{DynamicResource String_InvertSortOrder}"
                                Command="{Binding ToggleSortDirectionCommand}">
                            <TextBlock Text="⇅" FontWeight="Bold" FontSize="12" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                        </Button>

                        <!-- Sort Dropdown Pill Button (Name ⌄) -->
                        <Grid>
                            <Button Style="{StaticResource SecondaryButton}"
                                    Padding="12,7"
                                    Command="{Binding ToggleSortDropdownCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding SelectedSortDisplayName}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                    <TextBlock Text=" ⌄" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Popup IsOpen="{Binding IsSortDropdownOpen, Mode=TwoWay}"
                                   StaysOpen="False"
                                   Placement="Bottom"
                                   VerticalOffset="4"
                                   AllowsTransparency="True">
                                <Border Background="{StaticResource SurfaceCardElevatedBrush}"
                                        BorderBrush="{StaticResource StrongBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource RadiusMd}"
                                        Padding="6"
                                        MinWidth="170"
                                        SnapsToDevicePixels="True"
                                        UseLayoutRounding="True"
                                        TextOptions.TextFormattingMode="Display"
                                        TextOptions.TextRenderingMode="ClearType">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource String_SortByTitle}" Style="{StaticResource CaptionBold}"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   Margin="8,4,8,6" FontSize="10"/>

                                        <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Padding="10,6" Margin="0,1"
                                                Command="{Binding SelectSortCommand}" CommandParameter="Alphabetical">
                                            <TextBlock Text="{DynamicResource String_SortName}" FontSize="12" FontWeight="SemiBold"/>
                                        </Button>

                                        <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Padding="10,6" Margin="0,1"
                                                Command="{Binding SelectSortCommand}" CommandParameter="Recent">
                                            <TextBlock Text="{DynamicResource String_SortLastPlayed}" FontSize="12" FontWeight="SemiBold"/>
                                        </Button>

                                        <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Padding="10,6" Margin="0,1"
                                                Command="{Binding SelectSortCommand}" CommandParameter="PlayTime">
                                            <TextBlock Text="{DynamicResource String_SortHoursPlayed}" FontSize="12" FontWeight="SemiBold"/>
                                        </Button>

                                        <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Padding="10,6" Margin="0,1"
                                                Command="{Binding SelectSortCommand}" CommandParameter="Oldest">
                                            <TextBlock Text="{DynamicResource String_SortDateCreated}" FontSize="12" FontWeight="SemiBold"/>
                                        </Button>

                                        <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Padding="10,6" Margin="0,1"
                                                Command="{Binding SelectSortCommand}" CommandParameter="AlphabeticalDesc">
                                            <TextBlock Text="{DynamicResource String_SortDateModified}" FontSize="12" FontWeight="SemiBold"/>
                                        </Button>

                                        <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Padding="10,6" Margin="0,1"
                                                Command="{Binding SelectSortCommand}" CommandParameter="Loader">
                                            <TextBlock Text="{DynamicResource String_SortLoader}" FontSize="12" FontWeight="SemiBold"/>
                                        </Button>

                                        <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Padding="10,6" Margin="0,1"
                                                Command="{Binding SelectSortCommand}" CommandParameter="GameVersion">
                                            <TextBlock Text="{DynamicResource String_SortGameVersion}" FontSize="12" FontWeight="SemiBold"/>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>
                    </StackPanel>

                    <!-- 2. Custom Group Dropdown Pill Button (⊞ Custom group ⌄) -->
                    <Grid Margin="0,0,10,0">
                        <Button Style="{StaticResource SecondaryButton}"
                                Padding="12,7"
                                Command="{Binding ToggleGroupDropdownCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⊞ " FontWeight="Bold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding SelectedGroupDisplayName}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Text=" ⌄" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Popup IsOpen="{Binding IsGroupDropdownOpen, Mode=TwoWay}"
                               StaysOpen="False"
                               Placement="Bottom"
                               VerticalOffset="4"
                               AllowsTransparency="True">
                            <Border Background="{StaticResource SurfaceCardElevatedBrush}"
                                    BorderBrush="{StaticResource StrongBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusMd}"
                                    Padding="6"
                                    MinWidth="180"
                                    SnapsToDevicePixels="True"
                                    UseLayoutRounding="True"
                                    TextOptions.TextFormattingMode="Display"
                                    TextOptions.TextRenderingMode="ClearType">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource String_CustomGroupTitle}" Style="{StaticResource CaptionBold}"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               Margin="8,4,8,6" FontSize="10"/>

                                    <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Padding="10,6" Margin="0,1"
                                            Command="{Binding SelectGroupCommand}" CommandParameter="All">
                                        <TextBlock Text="{DynamicResource String_AllInstances}" FontSize="12" FontWeight="SemiBold"/>
                                    </Button>

                                    <ItemsControl ItemsSource="{Binding CustomGroups}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Button Grid.Column="0" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Padding="10,6"
                                                            Command="{Binding DataContext.SelectGroupCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}">
                                                        <TextBlock Text="{Binding}" FontSize="12" FontWeight="SemiBold"/>
                                                    </Button>
                                                    <Button Grid.Column="1" Style="{StaticResource GhostButton}" Padding="6,4" ToolTip="{DynamicResource String_DeleteGroupTooltip}"
                                                            Command="{Binding DataContext.DeleteGroupCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}">
                                                        <TextBlock Text="✕" FontSize="10" Foreground="{StaticResource MutedTextBrush}"/>
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Border Height="1" Background="{StaticResource SubtleBorderBrush}" Margin="4,4"/>

                                    <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Padding="10,6"
                                            Command="{Binding OpenCreateGroupCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="+ " FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"/>
                                            <TextBlock Text="{DynamicResource String_NewGroup}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                    <!-- Divider Separator | -->
                    <Border Width="1" Height="20" Background="{StaticResource SubtleBorderBrush}" Margin="2,0,10,0" VerticalAlignment="Center"/>

                    <!-- 3. Add Filter Dropdown Pill Button (▼ + Add filter) -->
                    <Grid Margin="0,0,10,0">
                        <Button Padding="12,7"
                                Command="{Binding ToggleFilterDropdownCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasActiveFilter}" Value="True">
                                            <Setter Property="BorderBrush" Value="#10B981"/>
                                            <Setter Property="Background" Value="#1a10B981"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="▼ + " FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource String_AddFilter}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                <Border Width="6" Height="6" CornerRadius="3" Background="#10B981" Margin="6,0,0,0" VerticalAlignment="Center"
                                        Visibility="{Binding HasActiveFilter, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </StackPanel>
                        </Button>

                        <Popup IsOpen="{Binding IsFilterDropdownOpen, Mode=TwoWay}"
                               StaysOpen="False"
                               Placement="Bottom"
                               VerticalOffset="4"
                               AllowsTransparency="True">
                            <Border Background="{StaticResource SurfaceCardElevatedBrush}"
                                    BorderBrush="{StaticResource StrongBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusMd}"
                                    Padding="10"
                                    Width="260"
                                    SnapsToDevicePixels="True"
                                    UseLayoutRounding="True"
                                    TextOptions.TextFormattingMode="Display"
                                    TextOptions.TextRenderingMode="ClearType">
                                <StackPanel>
                                    <!-- Engine Section -->
                                    <TextBlock Text="{DynamicResource String_EngineSection}" Style="{StaticResource CaptionBold}"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               Margin="4,0,4,6" FontSize="10"/>

                                    <WrapPanel Margin="0,0,0,10">
                                        <RadioButton GroupName="DropdownEngineFilters" Style="{StaticResource FilterChipRadioButton}" Content="{DynamicResource String_FilterAll}"
                                                     IsChecked="{Binding SelectedEngineFilter, Converter={StaticResource StringMatchConverter}, ConverterParameter=All}"
                                                     Command="{Binding SelectEngineFilterCommand}" CommandParameter="All"/>
                                        <RadioButton GroupName="DropdownEngineFilters" Style="{StaticResource FilterChipPurple}" Content="Unreal"
                                                     IsChecked="{Binding SelectedEngineFilter, Converter={StaticResource StringMatchConverter}, ConverterParameter=Unreal}"
                                                     Command="{Binding SelectEngineFilterCommand}" CommandParameter="Unreal"/>
                                        <RadioButton GroupName="DropdownEngineFilters" Style="{StaticResource FilterChipCyan}" Content="Unity"
                                                     IsChecked="{Binding SelectedEngineFilter, Converter={StaticResource StringMatchConverter}, ConverterParameter=Unity}"
                                                     Command="{Binding SelectEngineFilterCommand}" CommandParameter="Unity"/>
                                        <RadioButton GroupName="DropdownEngineFilters" Style="{StaticResource FilterChipBlue}" Content="Godot"
                                                     IsChecked="{Binding SelectedEngineFilter, Converter={StaticResource StringMatchConverter}, ConverterParameter=Godot}"
                                                     Command="{Binding SelectEngineFilterCommand}" CommandParameter="Godot"/>
                                        <RadioButton GroupName="DropdownEngineFilters" Style="{StaticResource FilterChipAmber}" Content="Source"
                                                     IsChecked="{Binding SelectedEngineFilter, Converter={StaticResource StringMatchConverter}, ConverterParameter=Source}"
                                                     Command="{Binding SelectEngineFilterCommand}" CommandParameter="Source"/>
                                        <RadioButton GroupName="DropdownEngineFilters" Style="{StaticResource FilterChipSlate}" Content="Other"
                                                     IsChecked="{Binding SelectedEngineFilter, Converter={StaticResource StringMatchConverter}, ConverterParameter=Other}"
                                                     Command="{Binding SelectEngineFilterCommand}" CommandParameter="Other"/>
                                    </WrapPanel>

                                    <Border Height="1" Background="{StaticResource SubtleBorderBrush}" Margin="0,0,0,10"/>

                                    <!-- Status Section -->
                                    <TextBlock Text="{DynamicResource String_StatusSection}" Style="{StaticResource CaptionBold}"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               Margin="4,0,4,6" FontSize="10"/>

                                    <WrapPanel Margin="0,0,0,10">
                                        <RadioButton GroupName="DropdownStatusFilters" Style="{StaticResource FilterChipRadioButton}" Content="{DynamicResource String_FilterAll}"
                                                     IsChecked="{Binding SelectedStatusFilter, Converter={StaticResource StringMatchConverter}, ConverterParameter=All}"
                                                     Command="{Binding SelectStatusFilterCommand}" CommandParameter="All"/>
                                        <RadioButton GroupName="DropdownStatusFilters" Style="{StaticResource FilterChipGreen}" Content="{DynamicResource String_StatusReady}"
                                                     IsChecked="{Binding SelectedStatusFilter, Converter={StaticResource StringMatchConverter}, ConverterParameter=Ready}"
                                                     Command="{Binding SelectStatusFilterCommand}" CommandParameter="Ready"/>
                                        <RadioButton GroupName="DropdownStatusFilters" Style="{StaticResource FilterChipSky}" Content="{DynamicResource String_StatusDownloading}"
                                                     IsChecked="{Binding SelectedStatusFilter, Converter={StaticResource StringMatchConverter}, ConverterParameter=Downloading}"
                                                     Command="{Binding SelectStatusFilterCommand}" CommandParameter="Downloading"/>
                                        <RadioButton GroupName="DropdownStatusFilters" Style="{StaticResource FilterChipRose}" Content="{DynamicResource String_StatusNotInstalled}"
                                                     IsChecked="{Binding SelectedStatusFilter, Converter={StaticResource StringMatchConverter}, ConverterParameter=NotInstalled}"
                                                     Command="{Binding SelectStatusFilterCommand}" CommandParameter="NotInstalled"/>
                                        <RadioButton GroupName="DropdownStatusFilters" Style="{StaticResource FilterChipAmber}" Content="{DynamicResource String_StatusUpdateAvailable}"
                                                     IsChecked="{Binding SelectedStatusFilter, Converter={StaticResource StringMatchConverter}, ConverterParameter=UpdateAvailable}"
                                                     Command="{Binding SelectStatusFilterCommand}" CommandParameter="UpdateAvailable"/>
                                    </WrapPanel>

                                    <!-- Clear Filters Button -->
                                    <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Center" Padding="8,5"
                                            Command="{Binding ClearFiltersCommand}"
                                            Visibility="{Binding HasActiveFilter, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="✕ " FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}"/>
                                            <TextBlock Text="{DynamicResource String_ClearFilters}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                    <!-- 4. Select Mode Toggle Button (tick with box icon only) -->
                    <Button Margin="0,0,10,0"
                            Padding="10,7"
                            ToolTip="{DynamicResource String_SelectInstances}"
                            Command="{Binding ToggleSelectionModeCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelectionModeActive}" Value="True">
                                        <Setter Property="BorderBrush" Value="#10B981"/>
                                        <Setter Property="Background" Value="#1a10B981"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Path Data="{StaticResource IconCheckSquare}"
                              Stretch="Uniform" Width="14" Height="14"
                              VerticalAlignment="Center">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Fill" Value="{StaticResource SecondaryTextBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelectionModeActive}" Value="True">
                                            <Setter Property="Fill" Value="#10B981"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Button>

                    <!-- 5. Clear Selection Button (red cross + "clear selection" / "borrar selección", visible when active) -->
                    <Button Style="{StaticResource GhostButton}"
                            Margin="0,0,10,0"
                            Padding="10,7"
                            VerticalAlignment="Center"
                            ToolTip="{DynamicResource String_ClearSelection}"
                            Command="{Binding ClearSelectionCommand}"
                            Visibility="{Binding IsSelectionModeActive, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✕ " FontSize="12" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource String_ClearSelection}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </DockPanel>

                <!-- ── ERROR BANNER ── -->
                <Border Background="{StaticResource DangerBgBrush}"
                        BorderBrush="{StaticResource DangerBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusMd}"
                        Padding="14,10"
                        Margin="0,0,0,16"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"
                                   Style="{StaticResource BodyMedium}" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="✕" Style="{StaticResource GhostButton}"
                                Command="{Binding LoadInstancesCommand}"/>
                    </Grid>
                </Border>

                <!-- ── SKELETON LOADING PLACEHOLDERS (Pulsing shimmer while loading) ── -->
                <ItemsControl Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                              HorizontalAlignment="Center">
                    <ItemsControl.ItemsSource>
                        <x:Array Type="{x:Type sys:Int32}">
                            <sys:Int32>1</sys:Int32>
                            <sys:Int32>2</sys:Int32>
                            <sys:Int32>3</sys:Int32>
                            <sys:Int32>4</sys:Int32>
                            <sys:Int32>5</sys:Int32>
                            <sys:Int32>6</sys:Int32>
                        </x:Array>
                    </ItemsControl.ItemsSource>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource SkeletonCard}" Width="360" Margin="0,0,16,16">
                                <StackPanel>
                                    <!-- Banner Placeholder -->
                                    <Border Style="{StaticResource SkeletonBlock}" Height="168" Margin="-16,-16,-16,12" CornerRadius="8,8,0,0"/>
                                    
                                    <!-- Title & AppId Placeholder -->
                                    <Border Style="{StaticResource SkeletonBlock}" Height="18" Width="180" HorizontalAlignment="Left" Margin="0,0,0,6"/>
                                    <Border Style="{StaticResource SkeletonBlock}" Height="12" Width="100" HorizontalAlignment="Left" Margin="0,0,0,12"/>
                                    
                                    <!-- Badge Pills Placeholder -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                        <Border Style="{StaticResource SkeletonBlock}" Height="20" Width="70" Margin="0,0,8,0" CornerRadius="4"/>
                                        <Border Style="{StaticResource SkeletonBlock}" Height="20" Width="60" CornerRadius="4"/>
                                    </StackPanel>
                                    
                                    <!-- Action Buttons Placeholder -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Style="{StaticResource SkeletonBlock}" Height="34" CornerRadius="6"/>
                                        <Border Grid.Column="2" Style="{StaticResource SkeletonBlock}" Height="34" CornerRadius="6"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- ── LOADED STATE CONTAINER (Hidden while loading) ── -->
                <StackPanel Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <!-- ── EMPTY STATE ── -->
                    <Border Background="{StaticResource SurfaceCardBrush}"
                            BorderBrush="{StaticResource SubtleBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusLg}"
                            Padding="48,36"
                            Visibility="{Binding FilteredInstances.Count, Converter={StaticResource ZeroToVisibilityConverter}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconGamepad}" Fill="{StaticResource MutedTextBrush}"
                                  Stretch="Uniform" Width="56" Height="56" Margin="0,0,0,16"
                                  HorizontalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource String_NoGameInstancesFound}" Style="{StaticResource H2}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource String_NoGameInstancesFoundDesc}"
                                       Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,8,0,24"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Style="{StaticResource PrimaryButton}"
                                        Margin="0,0,12,0" Command="{Binding OpenAddInstanceModalCommand}" CommandParameter="Zip">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📦 "/>
                                        <TextBlock Text="{DynamicResource String_ImportZipArchiveBtn}"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource SecondaryButton}"
                                        Margin="0,0,12,0" Command="{Binding OpenAddInstanceModalCommand}" CommandParameter="Folder">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📁 "/>
                                        <TextBlock Text="{DynamicResource String_AddGameFolderBtn}"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource SecondaryButton}"
                                        Command="{Binding ExplorePlatformGamesCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🌐 "/>
                                        <TextBlock Text="{DynamicResource String_ExploreCatalogBtn}"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ── INSTANCES GRID ── -->
                    <ItemsControl ItemsSource="{Binding FilteredInstances}" HorizontalAlignment="Stretch">
<ItemsControl.Resources>
                        <DataTemplate x:Key="InstanceListRowTemplate">
                            <Border Padding="0" Margin="0,0,0,10" Cursor="Hand" HorizontalAlignment="Stretch">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource InteractiveCard}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="BorderBrush" Value="#10B981"/>
                                                <Setter Property="Background" Value="#1410B981"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick"
                                                  Command="{Binding DataContext.ManageInstanceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                  CommandParameter="{Binding}"/>
                                </Border.InputBindings>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <Border Grid.Column="0" CornerRadius="8,0,0,8" ClipToBounds="True">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding HeaderImageUrl, Converter={StaticResource CachedImageConverter}}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Border.Background>
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="16,10,16,10" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource H3}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" VerticalAlignment="Center" MaxWidth="700"/>
                                            <!-- Steam Game Icon -->
                                            <Path Data="{StaticResource IconSteam}" Fill="#66C0F4"
                                                  Stretch="Uniform" Width="14" Height="14"
                                                  Margin="8,0,0,0"
                                                  VerticalAlignment="Center"
                                                  Visibility="{Binding IsSteamGame, Converter={StaticResource BoolToVisibilityConverter}}"
                                                  ToolTip="{DynamicResource String_SteamGameImportedTooltip}"/>
                                            <!-- Imported Folder Icon -->
                                            <Path Data="{StaticResource IconFolder}" Fill="#10B981"
                                                  Stretch="Uniform" Width="14" Height="14"
                                                  Margin="8,0,0,0"
                                                  VerticalAlignment="Center"
                                                  Visibility="{Binding IsImportedFolder, Converter={StaticResource BoolToVisibilityConverter}}"
                                                  ToolTip="{DynamicResource String_ImportedFolderTooltip}"/>
                                            <!-- Orange Update Indicator Dot -->
                                            <Ellipse Width="7" Height="7" Fill="#F59E0B"
                                                     Margin="8,0,0,0"
                                                     VerticalAlignment="Center"
                                                     Visibility="{Binding HasUpdateAvailable, Converter={StaticResource BoolToVisibilityConverter}}"
                                                     ToolTip="{DynamicResource String_UpdateAvailableDepotBox}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Text="{Binding EngineName}" Style="{StaticResource CaptionBold}" Foreground="{Binding Type, Converter={StaticResource TagTypeToBrushConverter}, FallbackValue={StaticResource SecondaryTextBrush}}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding AppId, StringFormat=' • Steam AppID: {0}'}" Style="{StaticResource Caption}" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <ItemsControl ItemsSource="{Binding Tags}" Margin="0,6,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border CornerRadius="{StaticResource RadiusSm}"
                                                            Padding="7,2"
                                                            Margin="0,0,5,4"
                                                            Background="{Binding Type, Converter={StaticResource TagTypeToBgBrushConverter}}"
                                                            BorderBrush="{Binding Type, Converter={StaticResource TagTypeToBorderBrushConverter}}"
                                                            BorderThickness="1"
                                                            ToolTip="{Binding Tooltip}">
                                                        <TextBlock Text="{Binding Text}"
                                                                    FontSize="10"
                                                                    FontWeight="Normal"
                                                                    Foreground="{Binding Type, Converter={StaticResource TagTypeToBrushConverter}}"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="16" VerticalAlignment="Center">
                                        <!-- Update Available (DepotBox) Button -->
                                        <Button Margin="0,0,8,0" Padding="10,8"
                                                ToolTip="{DynamicResource String_UpdateAvailableDepotBox}"
                                                Visibility="{Binding HasUpdateAvailable, Converter={StaticResource BoolToVisibilityConverter}}"
                                                Command="{Binding DataContext.CheckDepotBoxUpdatesCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                                    <Setter Property="BorderBrush" Value="#F59E0B"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                    <Setter Property="Background" Value="#26F59E0B"/>
                                                </Style>
                                            </Button.Style>
                                            <Path Data="{StaticResource IconDownload}" Fill="#F59E0B"
                                                  Stretch="Uniform" Width="14" Height="14" VerticalAlignment="Center"/>
                                        </Button>

                                        <!-- Start / Play Button -->
                                        <Button Margin="0,0,8,0" Padding="16,8"
                                                Command="{Binding DataContext.PlayInstanceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="{DynamicResource String_PlayTooltip}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource PlayButton}">
                                                    <Setter Property="Content">
                                                        <Setter.Value>
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                                <Path Data="{StaticResource IconPlay}" Fill="#FFFFFF" Stretch="Uniform" Width="10" Height="10" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{DynamicResource String_Play}" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsNotInstalled}" Value="True">
                                                            <Setter Property="Content" Value="📥 Install"/>
                                                            <Setter Property="Background" Value="{StaticResource AccentHoverBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <!-- Open Folder Button -->
                                        <Button Style="{StaticResource SecondaryButton}" Padding="10,8"
                                                Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="{DynamicResource String_OpenFolderTooltip}">
                                            <Path Data="{StaticResource IconFolder}" Fill="{StaticResource SecondaryTextBrush}" Stretch="Uniform" Width="14" Height="14" VerticalAlignment="Center"/>
                                        </Button>
                                    </StackPanel>

                                    <!-- FULL-ROW SELECTION CLICK INTERCEPTOR OVERLAY -->
                                    <Button Grid.Column="0" Grid.ColumnSpan="3"
                                            Margin="0"
                                            Cursor="Hand"
                                            Panel.ZIndex="50"
                                            Command="{Binding DataContext.ToggleInstanceSelectionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding DataContext.IsSelectionModeActive, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <!-- SELECTION CIRCLE (Top-left, visible in selection mode) -->
                                    <Border Grid.Column="0" Grid.ColumnSpan="3"
                                            HorizontalAlignment="Left" VerticalAlignment="Top"
                                            Margin="10,10,0,0"
                                            Width="28" Height="28"
                                            CornerRadius="14"
                                            Panel.ZIndex="52"
                                            IsHitTestVisible="False"
                                            Visibility="{Binding DataContext.IsSelectionModeActive, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#000000" BlurRadius="6" ShadowDepth="2" Opacity="0.6"/>
                                        </Border.Effect>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#D9161822"/>
                                                <Setter Property="BorderBrush" Value="#80FFFFFF"/>
                                                <Setter Property="BorderThickness" Value="2"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Background" Value="#10B981"/>
                                                        <Setter Property="BorderBrush" Value="#FFFFFF"/>
                                                        <Setter Property="BorderThickness" Value="2"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Path Data="{StaticResource IconCheck}" Fill="#FFFFFF"
                                              Stretch="Uniform" Width="13" Height="13"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    </Border>
                                    
                                    <!-- Overlay Selection Border -->
                                    <Border Grid.Column="0" Grid.ColumnSpan="3"
                                            CornerRadius="12"
                                            BorderThickness="2"
                                            IsHitTestVisible="False"
                                            Panel.ZIndex="51">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="BorderBrush" Value="#10B981"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>

                        <DataTemplate x:Key="InstanceCardTemplate">
                            <Viewbox Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="8,0,8,16">
                                  <Border Width="360" Height="308" Padding="0" ClipToBounds="True" Cursor="Hand">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource InteractiveCard}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="BorderBrush" Value="#10B981"/>
                                                <Setter Property="Background" Value="#1410B981"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick"
                                                  Command="{Binding DataContext.ManageInstanceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                  CommandParameter="{Binding}"/>
                                </Border.InputBindings>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="168"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- ── SELECTION CIRCLE (Top-left, visible in selection mode) ── -->
                                    <Border Grid.Row="0" Grid.RowSpan="5"
                                            HorizontalAlignment="Left" VerticalAlignment="Top"
                                            Margin="10,10,0,0"
                                            Width="28" Height="28"
                                            CornerRadius="14"
                                            Panel.ZIndex="52"
                                            IsHitTestVisible="False"
                                            Visibility="{Binding DataContext.IsSelectionModeActive, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#000000" BlurRadius="6" ShadowDepth="2" Opacity="0.6"/>
                                        </Border.Effect>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#D9161822"/>
                                                <Setter Property="BorderBrush" Value="#80FFFFFF"/>
                                                <Setter Property="BorderThickness" Value="2"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Background" Value="#10B981"/>
                                                        <Setter Property="BorderBrush" Value="#FFFFFF"/>
                                                        <Setter Property="BorderThickness" Value="2"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Path Data="{StaticResource IconCheck}" Fill="#FFFFFF"
                                              Stretch="Uniform" Width="13" Height="13"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    </Border>

                                    <!-- ── FULL-CARD SELECTION CLICK INTERCEPTOR OVERLAY ── -->
                                    <!-- In Selection Mode: blocks all button clicks underneath and toggles card selection -->
                                    <Button Grid.Row="0" Grid.RowSpan="5"
                                            Margin="0"
                                            Cursor="Hand"
                                            Panel.ZIndex="50"
                                            ToolTip="{Binding Name}"
                                            Command="{Binding DataContext.ToggleInstanceSelectionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding DataContext.IsSelectionModeActive, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <!-- Game banner / cover image (460x215 aspect ratio, 360x168).
                                         The artwork is the Border's own background so it follows the
                                         card's corner radius instead of spilling over it. -->
                                    <Border Grid.Row="0" CornerRadius="11,11,0,0"
                                            Background="{StaticResource SurfaceCardHoverBrush}">
                                        <Grid>
                                            <Path Data="{StaticResource IconGamepad}" Fill="{StaticResource MutedTextBrush}"
                                                  Stretch="Uniform" Width="36" Height="36"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Border CornerRadius="11,11,0,0">
                                                <Border.Background>
                                                    <ImageBrush ImageSource="{Binding HeaderImageUrl, Converter={StaticResource CachedImageConverter}}"
                                                                Stretch="UniformToFill"
                                                                RenderOptions.BitmapScalingMode="HighQuality"/>
                                                </Border.Background>
                                            </Border>

                                            <!-- 🔔 TOP-RIGHT GAME UPDATE BADGE -->
                                            <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                                    Margin="0,8,8,0"
                                                    Background="#EA580C"
                                                    BorderBrush="#F59E0B"
                                                    BorderThickness="1"
                                                    CornerRadius="{StaticResource RadiusSm}"
                                                    Padding="7,2"
                                                    Visibility="{Binding HasUpdateAvailable, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    ToolTip="{Binding UpdateDescription, FallbackValue='Game update available'}">
                                                <Border.Effect>
                                                    <DropShadowEffect Color="#000000" BlurRadius="6" ShadowDepth="2" Opacity="0.6"/>
                                                </Border.Effect>
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{StaticResource IconRefresh}" Fill="#FFFFFF" Stretch="Uniform" Width="9" Height="9" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Update" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- Title & Steam AppId -->
                                    <StackPanel Grid.Row="1" Margin="16,12,16,0">
                                        <DockPanel LastChildFill="True">
                                            <!-- Origin Icons docked right of title -->
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                <!-- Steam Game Icon -->
                                                <Path Data="{StaticResource IconSteam}" Fill="#66C0F4"
                                                      Stretch="Uniform" Width="14" Height="14"
                                                      Margin="6,0,0,0"
                                                      VerticalAlignment="Center"
                                                      Visibility="{Binding IsSteamGame, Converter={StaticResource BoolToVisibilityConverter}}"
                                                      ToolTip="{DynamicResource String_SteamGameImportedTooltip}"/>
                                                <!-- Imported Folder Icon -->
                                                <Path Data="{StaticResource IconFolder}" Fill="#10B981"
                                                      Stretch="Uniform" Width="14" Height="14"
                                                      Margin="6,0,0,0"
                                                      VerticalAlignment="Center"
                                                      Visibility="{Binding IsImportedFolder, Converter={StaticResource BoolToVisibilityConverter}}"
                                                      ToolTip="{DynamicResource String_ImportedFolderTooltip}"/>
                                            </StackPanel>

                                            <TextBlock Text="{Binding Name}" Style="{StaticResource H3}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"/>
                                        </DockPanel>
                                        <TextBlock Text="{Binding AppId, StringFormat=' • AppID: {0}'}"
                                                   Style="{StaticResource Caption}" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- Dynamic Badges from ITagsService: Only show first row -->
                                    <ItemsControl Grid.Row="2" ItemsSource="{Binding Tags}" Margin="16,8,16,0"
                                                  MaxHeight="24" ClipToBounds="True">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="{StaticResource RadiusSm}"
                                                        Padding="7,2"
                                                        Margin="0,0,5,4"
                                                        Background="{Binding Type, Converter={StaticResource TagTypeToBgBrushConverter}}"
                                                        BorderBrush="{Binding Type, Converter={StaticResource TagTypeToBorderBrushConverter}}"
                                                        BorderThickness="1"
                                                        ToolTip="{Binding Tooltip}">
                                                    <TextBlock Text="{Binding Text}"
                                                                FontSize="10"
                                                                FontWeight="Normal"
                                                                Foreground="{Binding Type, Converter={StaticResource TagTypeToBrushConverter}}"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Action Buttons -->
                                    <DockPanel Grid.Row="4" Margin="16,0,16,16" LastChildFill="False">
                                        <!-- Play or Install Button (Right-aligned) -->
                                        <Button DockPanel.Dock="Right"
                                                Padding="20,8"
                                                Command="{Binding DataContext.PlayInstanceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="{DynamicResource String_PlayTooltip}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource PlayButton}">
                                                    <Setter Property="Content" Value="▶ Play"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsNotInstalled}" Value="True">
                                                            <Setter Property="Content" Value="📥 Install"/>
                                                            <Setter Property="Background" Value="{StaticResource AccentHoverBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <!-- Left Action Buttons (Update + Folder) -->
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- Update Available (DepotBox) Button — only shown when update is available -->
                                            <Button Margin="0,0,6,0"
                                                    ToolTip="Update Available (DepotBox)"
                                                    Visibility="{Binding HasUpdateAvailable, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    Command="{Binding DataContext.CheckDepotBoxUpdatesCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                                        <Setter Property="BorderBrush" Value="#F59E0B"/>
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                        <Setter Property="Background" Value="#26F59E0B"/>
                                                    </Style>
                                                </Button.Style>
                                                <Path Data="{StaticResource IconDownload}" Fill="#F59E0B"
                                                      Stretch="Uniform" Width="13" Height="13"/>
                                            </Button>

                                            <!-- Open Game Folder Button -->
                                            <Button Style="{StaticResource IconButton}"
                                                    ToolTip="{DynamicResource String_OpenFolderTooltip}"
                                                    Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <Path Data="{StaticResource IconFolder}" Fill="{StaticResource SecondaryTextBrush}"
                                                      Stretch="Uniform" Width="14" Height="14"/>
                                            </Button>
                                        </StackPanel>
                                    </DockPanel>
                                </Grid>
                            </Border>
                        </Viewbox>
                        </DataTemplate>
                    </ItemsControl.Resources>
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Setter Property="ItemsPanel">
                                <Setter.Value>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="{Binding ColumnCount}" HorizontalAlignment="Stretch" VerticalAlignment="Top"/>
                                    </ItemsPanelTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ColumnCount}" Value="0">
                                    <Setter Property="ItemsPanel">
                                        <Setter.Value>
                                            <ItemsPanelTemplate>
                                                <VirtualizingStackPanel Orientation="Vertical"/>
                                            </ItemsPanelTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ContentControl Content="{Binding}">
                                <ContentControl.Style>
                                    <Style TargetType="ContentControl">
                                        <Setter Property="ContentTemplate" Value="{DynamicResource InstanceCardTemplate}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.ColumnCount, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="0">
                                                <Setter Property="ContentTemplate" Value="{DynamicResource InstanceListRowTemplate}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentControl.Style>
                            </ContentControl>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>

                    
                </ItemsControl>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- ═══ UNIFIED EXPANDABLE ADD INSTANCE MODAL OVERLAY ═══ -->
        <controls:ModalOverlay IsOpen="{Binding IsAddInstanceModalOpen}"
                               CloseCommand="{Binding CloseAddInstanceModalCommand}"
                               CloseOnBackdropClick="True"
                               CloseOnEscape="True"
                               Panel.ZIndex="1000">
            <Border Background="{StaticResource SurfaceCardElevatedBrush}"
                    BorderBrush="{StaticResource StrongBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusLg}"
                    Padding="26"
                    MinWidth="560"
                    MaxWidth="720"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <!-- ── MODAL HEADER WITH BACK & CLOSE BUTTONS ── -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Back Button (Shown when not on SelectSource) -->
                        <Button Grid.Column="0"
                                Padding="8,4"
                                Margin="0,0,10,0"
                                Command="{Binding BackToAddInstanceSourceCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AddModalStep}" Value="Steam">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding AddModalStep}" Value="Zip">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding AddModalStep}" Value="Folder">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="←" FontWeight="Bold" FontSize="15" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Back" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Dynamic Title -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Add Game Instance">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource H2}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AddModalStep}" Value="Steam">
                                                <Setter Property="Text" Value="Import from Steam"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding AddModalStep}" Value="Zip">
                                                <Setter Property="Text" Value="Import Depot ZIP Archive"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding AddModalStep}" Value="Folder">
                                                <Setter Property="Text" Value="Import Game Folder"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <!-- Close ✕ Button -->
                        <Button Grid.Column="2" Content="✕" Style="{StaticResource ModalCloseButton}"
                                Command="{Binding CloseAddInstanceModalCommand}"/>
                    </Grid>

                    <!-- ── STEP 1: SELECT SOURCE (Default View) ── -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AddModalStep}" Value="SelectSource">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <TextBlock Text="Choose how you want to add or import your game into BlueStar:"
                                   Style="{StaticResource BodySmall}"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   Margin="0,0,0,16"/>

                        <!-- 1. Steam Option Card -->
                        <Button Style="{StaticResource SecondaryButton}"
                                Margin="0,0,0,10"
                                Padding="16,14"
                                HorizontalContentAlignment="Stretch"
                                Command="{Binding OpenSteamStepCommand}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{StaticResource AccentTranslucentBrush}"
                                        CornerRadius="{StaticResource RadiusMd}" Width="40" Height="40">
                                    <Path Data="{StaticResource IconGamepad}" Fill="{StaticResource AccentBrush}"
                                          Stretch="Uniform" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource String_AddModalSteamTitle}" Style="{StaticResource BodyMedium}" FontWeight="Bold"/>
                                    <TextBlock Text="{DynamicResource String_AddModalSteamDesc}"
                                               Style="{StaticResource Caption}" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <TextBlock Grid.Column="3" Text="➔" FontWeight="Bold" FontSize="14" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <!-- 2. Depot ZIP Option Card -->
                        <Button Style="{StaticResource SecondaryButton}"
                                Margin="0,0,0,10"
                                Padding="16,14"
                                HorizontalContentAlignment="Stretch"
                                Command="{Binding OpenZipStepCommand}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{StaticResource AccentTranslucentBrush}"
                                        CornerRadius="{StaticResource RadiusMd}" Width="40" Height="40">
                                    <Path Data="{StaticResource IconDownload}" Fill="{StaticResource AccentBrush}"
                                          Stretch="Uniform" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource String_AddModalZipTitle}" Style="{StaticResource BodyMedium}" FontWeight="Bold"/>
                                    <TextBlock Text="{DynamicResource String_AddModalZipDesc}"
                                               Style="{StaticResource Caption}" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <TextBlock Grid.Column="3" Text="➔" FontWeight="Bold" FontSize="14" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <!-- 3. Existing Folder Option Card -->
                        <Button Style="{StaticResource SecondaryButton}"
                                Margin="0,0,0,10"
                                Padding="16,14"
                                HorizontalContentAlignment="Stretch"
                                Command="{Binding OpenFolderStepCommand}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{StaticResource AccentTranslucentBrush}"
                                        CornerRadius="{StaticResource RadiusMd}" Width="40" Height="40">
                                    <Path Data="{StaticResource IconFolder}" Fill="{StaticResource SuccessBrush}"
                                          Stretch="Uniform" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource String_AddModalFolderTitle}" Style="{StaticResource BodyMedium}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{DynamicResource String_AddModalFolderDesc}"
                                               Style="{StaticResource Caption}" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <TextBlock Grid.Column="3" Text="➔" FontSize="14" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <!-- ── Separator for Online Platform Discovery ── -->
                        <Grid Margin="0,8,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Height="1" Background="{StaticResource SubtleBorderBrush}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="OR EXPLORE ONLINE" Style="{StaticResource CaptionBold}"
                                       Foreground="{StaticResource MutedTextBrush}" Margin="12,0" FontSize="10"/>
                            <Border Grid.Column="2" Height="1" Background="{StaticResource SubtleBorderBrush}" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- 4. Explore / Search Platform Games Option Card -->
                        <Button Style="{StaticResource SecondaryButton}"
                                Padding="16,14"
                                HorizontalContentAlignment="Stretch"
                                BorderBrush="{StaticResource AccentBrush}"
                                Command="{Binding ExplorePlatformGamesCommand}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{StaticResource AccentTranslucentBrush}"
                                        CornerRadius="{StaticResource RadiusMd}" Width="40" Height="40">
                                    <Path Data="{StaticResource IconExplore}" Fill="{StaticResource AccentBrush}"
                                          Stretch="Uniform" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource String_AddModalExploreTitle}" Style="{StaticResource BodyMedium}" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                                    <TextBlock Text="{DynamicResource String_AddModalExploreDesc}"
                                               Style="{StaticResource Caption}" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <TextBlock Grid.Column="3" Text="➔" FontSize="14" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>
                    </StackPanel>

                    <!-- ── STEP 2: STEAM SUB-VIEW ── -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AddModalStep}" Value="Steam">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <!-- Steam Search Bar -->
                        <Border Background="{StaticResource SurfaceInputBrush}"
                                BorderBrush="{StaticResource SubtleBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusMd}"
                                Padding="12,0"
                                Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0" Data="{StaticResource IconSearch}"
                                      Fill="{StaticResource MutedTextBrush}"
                                      Stretch="Uniform" Width="14" Height="14"
                                      Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding SteamSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Foreground="{StaticResource PrimaryTextBrush}"
                                         CaretBrush="{StaticResource PrimaryTextBrush}"
                                         FontSize="13"
                                         Padding="0,9"
                                         VerticalContentAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Scanning Shimmer or Error -->
                        <Border Background="{StaticResource SurfaceInputBrush}"
                                CornerRadius="{StaticResource RadiusMd}"
                                Padding="20"
                                Margin="0,0,0,10"
                                Visibility="{Binding IsScanningSteam, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="⏳ Scanning Steam libraries..." Style="{StaticResource BodyMedium}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Text="Detecting games across all installed Steam library drives" Style="{StaticResource Caption}" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource DangerBgBrush}"
                                BorderBrush="{StaticResource DangerBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusMd}"
                                Padding="12"
                                Margin="0,0,0,12"
                                Visibility="{Binding SteamScanError, Converter={StaticResource NullToVisibilityConverter}}">
                            <TextBlock Text="{Binding SteamScanError}" Foreground="{StaticResource DangerBrush}" Style="{StaticResource BodySmall}"/>
                        </Border>

                        <!-- Duplicate Steam Game Confirmation Alert -->
                        <Border Background="#2A1B1E" BorderBrush="#F43F5E" BorderThickness="1"
                                CornerRadius="{StaticResource RadiusMd}" Padding="12" Margin="0,0,0,12"
                                Visibility="{Binding IsDuplicateSteamPromptOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0">
                                    <TextBlock Text="⚠️ Game Already in Library" FontWeight="Bold" FontSize="13" Foreground="#F43F5E"/>
                                    <TextBlock Text="{Binding DuplicateSteamGame.Name, StringFormat='An instance for \'{0}\' already exists. Do you want to import it as a duplicate instance?'}"
                                               Style="{StaticResource Caption}" Foreground="{StaticResource PrimaryTextBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Padding="12,5" FontSize="11" Margin="0,0,8,0"
                                            Command="{Binding CancelDuplicateSteamGameCommand}"/>
                                    <Button Content="Confirm Import" Style="{StaticResource PrimaryButton}" Background="#F43F5E" BorderBrush="#E11D48" Padding="12,5" FontSize="11"
                                            Command="{Binding ConfirmDuplicateSteamGameCommand}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Steam Games Scrollable List -->
                        <Border Background="{StaticResource SurfaceInputBrush}"
                                BorderBrush="{StaticResource SubtleBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusMd}"
                                MaxHeight="320"
                                Padding="6"
                                Margin="0,0,0,16">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding InstalledSteamGames}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="10,8" Margin="0,0,0,4"
                                                    Background="{StaticResource SurfaceCardBrush}"
                                                    CornerRadius="{StaticResource RadiusSm}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="10"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="10"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    
                                                    <!-- Game Banner Thumbnail -->
                                                    <Border Grid.Column="0" Width="80" Height="36" CornerRadius="4" Background="#161822" ClipToBounds="True">
                                                        <Grid>
                                                            <TextBlock Text="🎮" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            <Image Source="{Binding HeaderImageUrlFormatted}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                        </Grid>
                                                    </Border>

                                                    <!-- Game Details -->
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" Style="{StaticResource BodyMedium}" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                            <TextBlock Text="{Binding AppId, StringFormat=' • AppID: {0}'}" Style="{StaticResource Caption}" Foreground="{StaticResource SecondaryTextBrush}"/>
                                                            <TextBlock Text="{Binding FormattedSize, StringFormat=' • {0}'}" Style="{StaticResource Caption}" Foreground="{StaticResource AccentBrush}"/>
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <!-- Import Action Button -->
                                                    <Button Grid.Column="4" Content="+ Import"
                                                            Style="{StaticResource PrimaryButton}"
                                                            Background="#10B981" BorderBrush="#059669"
                                                            Padding="12,6" FontSize="11"
                                                            Command="{Binding DataContext.ImportSteamGameCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>

                    <!-- ── STEP 3: DEPOT ZIP SUB-VIEW (Expandable with Drag & Drop) ── -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AddModalStep}" Value="Zip">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <!-- Case A: No ZIP Selected yet -> Large Drag & Drop Box -->
                        <Border Background="{StaticResource SurfaceInputBrush}"
                                BorderBrush="{StaticResource AccentBrush}"
                                BorderThickness="2"
                                CornerRadius="{StaticResource RadiusMd}"
                                Padding="32,28"
                                Margin="0,0,0,16"
                                AllowDrop="True"
                                Drop="ZipDropZone_Drop"
                                DragOver="ZipDropZone_DragOver">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PendingZipPath}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding PendingZipPath, Converter={StaticResource NullToVisibilityConverter}}" Value="Visible">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel HorizontalAlignment="Center">
                                <Border Background="{StaticResource AccentTranslucentBrush}"
                                        CornerRadius="24" Width="48" Height="48"
                                        HorizontalAlignment="Center" Margin="0,0,0,12">
                                    <Path Data="{StaticResource IconDownload}" Fill="{StaticResource AccentBrush}"
                                          Stretch="Uniform" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{DynamicResource String_AddModalDragZipTitle}"
                                           Style="{StaticResource H3}" FontWeight="Bold"
                                           HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                <TextBlock Text="Supports .zip archives containing game depots and DLC manifests"
                                           Style="{StaticResource Caption}" Foreground="{StaticResource SecondaryTextBrush}"
                                           HorizontalAlignment="Center" Margin="0,0,0,16"/>
                                <Button Content="Browse ZIP File..."
                                        Style="{StaticResource SecondaryButton}"
                                        Padding="16,8"
                                        HorizontalAlignment="Center"
                                        Command="{Binding BrowseZipFileCommand}"/>
                            </StackPanel>
                        </Border>

                        <!-- Error Message if any -->
                        <Border Background="{StaticResource DangerBgBrush}"
                                BorderBrush="{StaticResource DangerBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusMd}"
                                Padding="12"
                                Margin="0,0,0,12"
                                Visibility="{Binding ZipErrorMessage, Converter={StaticResource NullToVisibilityConverter}}">
                            <TextBlock Text="{Binding ZipErrorMessage}" Foreground="{StaticResource DangerBrush}" Style="{StaticResource BodySmall}"/>
                        </Border>

                        <!-- Case B: ZIP Parsed & Expanded Details -->
                        <StackPanel Visibility="{Binding PendingZipPath, Converter={StaticResource NullToVisibilityConverter}}">
                            <!-- Preview Header Banner (Well proportioned, without cut-off) -->
                            <Border CornerRadius="8" Height="135"
                                    Background="#121218"
                                    BorderBrush="{StaticResource SubtleBorderBrush}"
                                    BorderThickness="1"
                                    ClipToBounds="True" Margin="0,0,0,14">
                                <Grid>
                                    <Path Data="{StaticResource IconGamepad}" Fill="{StaticResource MutedTextBrush}"
                                          Stretch="Uniform" Width="36" Height="36" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Image Source="{Binding PreviewHeaderImageUrl}" Stretch="UniformToFill" VerticalAlignment="Center"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Grid>
                            </Border>

                            <!-- Game Details Card (with Manifest Date instead of Engine) -->
                            <Border Background="{StaticResource SurfaceInputBrush}"
                                    CornerRadius="{StaticResource RadiusMd}"
                                    Padding="14" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="6"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="6"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Game Name:" Style="{StaticResource CaptionBold}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding PreviewGameName}" Style="{StaticResource BodyMedium}" FontWeight="Bold"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Steam AppID:" Style="{StaticResource CaptionBold}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding PreviewAppId}" Style="{StaticResource Body}"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Manifest Date:" Style="{StaticResource CaptionBold}"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding PreviewManifestDateFormatted}" Style="{StaticResource BodySmall}" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                                </Grid>
                            </Border>

                            <!-- Depots & DLCs Interactive Buttons -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Depots Button / Card -->
                                <Button Grid.Column="0" Style="{StaticResource GhostButton}" Padding="0" HorizontalContentAlignment="Stretch"
                                        Command="{Binding ToggleDepotsListCommand}">
                                    <Border Background="{StaticResource SurfaceInputBrush}" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusMd}" Padding="10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Depots Found" Style="{StaticResource Caption}"/>
                                                <TextBlock Text="{Binding PreviewDepotsCount}" Style="{StaticResource H3}" FontWeight="Bold" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="▾ View" Style="{StaticResource CaptionBold}" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </Button>

                                <!-- DLCs Button / Card -->
                                <Button Grid.Column="2" Style="{StaticResource GhostButton}" Padding="0" HorizontalContentAlignment="Stretch"
                                        Command="{Binding ToggleDlcsListCommand}">
                                    <Border Background="{StaticResource SurfaceInputBrush}" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusMd}" Padding="10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="DLCs Included" Style="{StaticResource Caption}"/>
                                                <TextBlock Text="{Binding PreviewDlcsCount}" Style="{StaticResource H3}" FontWeight="Bold" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="▾ View" Style="{StaticResource CaptionBold}" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </Button>
                            </Grid>

                            <!-- Expanded Depots List -->
                            <Border Background="{StaticResource SurfaceInputBrush}" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusMd}" Padding="8" Margin="0,0,0,12"
                                    Visibility="{Binding IsDepotsListExpanded, Converter={StaticResource BoolToVisibilityConverter}}" MaxHeight="140">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding PreviewDepots}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="8,4" Margin="0,0,0,3" Background="{StaticResource SurfaceCardBrush}" CornerRadius="4">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Name}" Style="{StaticResource CaptionBold}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding DepotId, StringFormat='ID: {0}'}" Style="{StaticResource Caption}" Foreground="{StaticResource SecondaryTextBrush}"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>

                            <!-- Expanded DLCs List -->
                            <Border Background="{StaticResource SurfaceInputBrush}" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusMd}" Padding="8" Margin="0,0,0,12"
                                    Visibility="{Binding IsDlcsListExpanded, Converter={StaticResource BoolToVisibilityConverter}}" MaxHeight="140">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding PreviewDlcs}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="8,4" Margin="0,0,0,3" Background="{StaticResource SurfaceCardBrush}" CornerRadius="4">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Name}" Style="{StaticResource CaptionBold}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding AppId, StringFormat=' • AppID: {0}'}" Style="{StaticResource Caption}" Foreground="{StaticResource AccentBrush}"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>

                            <!-- Install Path -->
                            <TextBlock Text="Target Installation Directory:" Style="{StaticResource CaptionBold}" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Style="{StaticResource DarkTextBox}"
                                         Text="{Binding PreviewInstallPath, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Grid.Column="2"
                                         Content="Browse..."
                                         Style="{StaticResource SecondaryButton}"
                                         Command="{Binding BrowsePreviewInstallPathCommand}"/>
                            </Grid>

                            <!-- Action Buttons -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" Content="Change ZIP"
                                         Style="{StaticResource SecondaryButton}"
                                         Padding="14,9"
                                         Command="{Binding BrowseZipFileCommand}"/>

                                <Button Grid.Column="2" Content="Confirm Import ➔"
                                         Style="{StaticResource PrimaryButton}"
                                         Background="#10B981" BorderBrush="#059669"
                                         Padding="14,9"
                                         Command="{Binding ConfirmZipImportCommand}"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>

                    <!-- ── STEP 4: EXISTING FOLDER SUB-VIEW ── -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AddModalStep}" Value="Folder">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="440">
                            <StackPanel>
                                <!-- Large Drop Box when no folder selected -->
                                <Border x:Name="LibraryFolderDropBox"
                                        Background="{StaticResource SurfaceCardBrush}"
                                        BorderBrush="{StaticResource SubtleBorderBrush}"
                                        BorderThickness="2"
                                        CornerRadius="{StaticResource RadiusLg}"
                                        Padding="32,24"
                                        Margin="0,0,0,14"
                                        AllowDrop="True"
                                        Drop="FolderDropZone_Drop"
                                        DragEnter="FolderDropZone_DragEnter"
                                        DragOver="FolderDropZone_DragOver"
                                        DragLeave="FolderDropZone_DragLeave"
                                        Visibility="{Binding FolderPath, Converter={StaticResource InverseNullToVisibilityConverter}}">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Border Background="{StaticResource SuccessBgBrush}"
                                                Width="56" Height="56"
                                                CornerRadius="28"
                                                HorizontalAlignment="Center"
                                                Margin="0,0,0,12">
                                            <Path Data="{StaticResource IconFolder}" Fill="{StaticResource SuccessBrush}" Stretch="Uniform" Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <TextBlock Text="Drag &amp; drop game folder here"
                                                   Style="{StaticResource H3}"
                                                   Foreground="{StaticResource WhiteBrush}"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,0,0,4"/>
                                        <TextBlock Text="BlueStar will auto-detect executable, engine and Steam AppID"
                                                   Style="{StaticResource Caption}"
                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,0,0,16"/>

                                        <Button Content="📁 Browse Game Folder..."
                                                Style="{StaticResource PrimaryButton}"
                                                Padding="20,9"
                                                HorizontalAlignment="Center"
                                                Command="{Binding BrowseFolderCommand}"/>
                                    </StackPanel>
                                </Border>

                                <!-- Selected Folder Details -->
                                <StackPanel Visibility="{Binding FolderPath, Converter={StaticResource NullToVisibilityConverter}}">
                                    <!-- Selected Folder Path Bar -->
                                    <Border Background="{StaticResource SurfaceInputBrush}"
                                            BorderBrush="{StaticResource SubtleBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource RadiusMd}"
                                            Padding="12,8"
                                            Margin="0,0,0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Path Grid.Column="0" Data="{StaticResource IconFolder}" Fill="{StaticResource SuccessBrush}" Stretch="Uniform" Width="18" Height="18" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FolderPath}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="Folder selected" Style="{StaticResource Caption}" Foreground="{StaticResource SuccessBrush}"/>
                                            </StackPanel>
                                            <Button Grid.Column="3" Content="Change..." Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="11" VerticalAlignment="Center"
                                                    Command="{Binding BrowseFolderCommand}"/>
                                        </Grid>
                                    </Border>

                                    <!-- Artwork & Engine Row -->
                                    <Border Background="{StaticResource SurfaceCardBrush}"
                                            BorderBrush="{StaticResource SubtleBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource RadiusMd}"
                                            Padding="12"
                                            Margin="0,0,0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" CornerRadius="6" ClipToBounds="True" Height="48" Background="{StaticResource SurfaceInputBrush}">
                                                <Grid>
                                                    <TextBlock Text="🎮" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <Image Source="{Binding FolderHeaderImageUrl}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                </Grid>
                                            </Border>

                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Engine: " Style="{StaticResource CaptionBold}"/>
                                                    <TextBlock Text="{Binding FolderEngine.DisplayText, FallbackValue='Generic Game'}"
                                                               Foreground="{Binding FolderEngine, Converter={StaticResource EngineTypeToBrushConverter}, FallbackValue={StaticResource SecondaryTextBrush}}"
                                                               FontWeight="SemiBold"/>
                                                </StackPanel>
                                                
                                                <!-- Executable row with Browse button -->
                                                <Grid Margin="0,4,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="8"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding FolderExecutablePath, StringFormat='Executable: {0}', FallbackValue='Executable: None detected'}"
                                                               Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                    <Button Grid.Column="2" Content="Browse .exe..." Style="{StaticResource GhostButton}"
                                                            Padding="8,2" FontSize="11" Command="{Binding BrowseFolderExecutableCommand}"/>
                                                </Grid>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Game Name (Editable) -->
                                    <TextBlock Text="Game Name (Editable)" Style="{StaticResource CaptionBold}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding FolderGameName, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource DarkTextBox}"
                                             Padding="10,7"
                                             Margin="0,0,0,10"/>

                                    <!-- Steam AppID (Editable) + Search on Steam button -->
                                    <TextBlock Text="Steam AppID (Editable)" Style="{StaticResource CaptionBold}" Margin="0,0,0,4"/>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0"
                                                 Text="{Binding FolderAppId, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource DarkTextBox}"
                                                 Padding="10,7"/>
                                        <Button Grid.Column="2" Content="🔍 Search on Steam"
                                                Style="{StaticResource SecondaryButton}"
                                                Padding="12,7" FontSize="11"
                                                Command="{Binding OpenSteamSearchModalCommand}"/>
                                    </Grid>
                                    <TextBlock Text="If no AppID was found or if Spacewar (480) was detected, search was performed automatically."
                                               Style="{StaticResource Caption}" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,14"/>
                                </StackPanel>

                                <!-- Error Message -->
                                <Border Background="{StaticResource DangerBgBrush}"
                                        BorderBrush="{StaticResource DangerBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource RadiusMd}"
                                        Padding="12,8"
                                        Margin="0,0,0,12"
                                        Visibility="{Binding FolderErrorMessage, Converter={StaticResource NullToVisibilityConverter}}">
                                    <TextBlock Text="{Binding FolderErrorMessage}" Foreground="{StaticResource DangerBrush}" Style="{StaticResource CaptionBold}"/>
                                </Border>

                                <!-- Scanning State -->
                                <StackPanel HorizontalAlignment="Center" Margin="0,10"
                                            Visibility="{Binding IsScanningFolder, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="Inspecting game folder, engine and Steam AppID..." Style="{StaticResource CaptionBold}" Foreground="{StaticResource PrimaryTextBrush}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Action Buttons -->
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Content="Cancel"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="14,9"
                                    Command="{Binding CloseAddInstanceModalCommand}"/>

                            <Button Grid.Column="2" Content="Confirm Import ➔"
                                    Style="{StaticResource PrimaryButton}"
                                    Background="#10B981" BorderBrush="#059669"
                                    Padding="14,9"
                                    Command="{Binding ConfirmFolderImportCommand}"
                                    IsEnabled="{Binding FolderPath, Converter={StaticResource NullToBoolConverter}}"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>
        </controls:ModalOverlay>

        <!-- ═══ STEAM STORE SEARCH SUB-MODAL OVERLAY ═══ -->
        <controls:ModalOverlay IsOpen="{Binding IsSteamSearchModalOpen}"
                               CloseCommand="{Binding CloseSteamSearchModalCommand}"
                               CloseOnBackdropClick="True"
                               CloseOnEscape="True"
                               Panel.ZIndex="1005">
            <Border Background="{StaticResource SurfaceCardElevatedBrush}"
                    BorderBrush="{StaticResource StrongBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusLg}"
                    Padding="22"
                    Width="480" MaxHeight="460"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="🔍 Search Game on Steam" Style="{StaticResource H3}"/>
                        <Button Grid.Column="1" Content="✕" Style="{StaticResource ModalCloseButton}" Command="{Binding CloseSteamSearchModalCommand}"/>
                    </Grid>

                    <!-- Search Input -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Style="{StaticResource DarkTextBox}"
                                 Text="{Binding SteamSearchStoreQuery, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Grid.Column="2" Content="Search" Style="{StaticResource PrimaryButton}"
                                 Command="{Binding SearchSteamStoreCommand}" Padding="14,7"/>
                    </Grid>

                    <!-- Search Results List -->
                    <Border Grid.Row="4" Background="{StaticResource SurfaceInputBrush}"
                            BorderBrush="{StaticResource SubtleBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusMd}"
                            Padding="6" MinHeight="160">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Searching Steam Store..." Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,20"
                                           Visibility="{Binding IsSearchingSteamStore, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <ItemsControl ItemsSource="{Binding SteamStoreSearchResults}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="8,6" Margin="0,0,0,4" Background="{StaticResource SurfaceCardBrush}" CornerRadius="{StaticResource RadiusSm}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="60"/>
                                                        <ColumnDefinition Width="10"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Height="28" CornerRadius="3" ClipToBounds="True" Background="#121218">
                                                        <Image Source="{Binding FormattedThumbnail}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" Style="{StaticResource BodySmall}" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding AppId, StringFormat=' • AppID: {0}'}" Style="{StaticResource Caption}" Foreground="{StaticResource SecondaryTextBrush}"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="3" Content="Select" Style="{StaticResource PrimaryButton}" Padding="10,4" FontSize="11"
                                                            Command="{Binding DataContext.SelectSteamSearchResultCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Close Button -->
                    <Button Grid.Row="6" Content="Close" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" Padding="14,6"
                            Command="{Binding CloseSteamSearchModalCommand}"/>
                </Grid>
            </Border>
        </controls:ModalOverlay>

        <!-- ═══ CREATE GROUP MODAL OVERLAY ═══ -->
        <controls:ModalOverlay IsOpen="{Binding IsCreateGroupOpen}"
                               CloseCommand="{Binding CloseCreateGroupCommand}"
                               CloseOnEscape="True"
                               Panel.ZIndex="1000">
            <Border Background="{StaticResource SurfaceCardElevatedBrush}"
                    BorderBrush="{StaticResource StrongBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusLg}"
                    Padding="24"
                    Width="460"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Create group" Style="{StaticResource H2}"/>
                        <Button Grid.Column="1" Content="✕" Style="{StaticResource GhostButton}"
                                Command="{Binding CloseCreateGroupCommand}"/>
                    </Grid>

                    <!-- Group Name Input -->
                    <TextBlock Text="Group name" Style="{StaticResource CaptionBold}" Margin="0,0,0,6"/>
                    <TextBox Style="{StaticResource DarkTextBox}"
                             Text="{Binding NewGroupName, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,16"/>

                    <!-- Instances Checklist -->
                    <TextBlock Text="Add instances to group" Style="{StaticResource CaptionBold}" Margin="0,0,0,6"/>
                    <Border Background="{StaticResource SurfaceInputBrush}"
                            BorderBrush="{StaticResource SubtleBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusMd}"
                            MaxHeight="220"
                            Padding="8"
                            Margin="0,0,0,20">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding GroupSelectableInstances}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="8,6" Margin="0,0,0,4"
                                                Background="{StaticResource SurfaceCardBrush}"
                                                CornerRadius="{StaticResource RadiusSm}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="52"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                
                                                <!-- Game Cover Thumbnail -->
                                                <Border Grid.Column="0" Width="44" Height="26" CornerRadius="4" Background="#161822" ClipToBounds="True">
                                                    <Grid>
                                                        <TextBlock Text="🎮" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        <Image Source="{Binding Instance.HeaderImageUrl}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                    </Grid>
                                                </Border>

                                                <TextBlock Grid.Column="1" Text="{Binding Instance.Name}" Style="{StaticResource BodySmall}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0,0,0" TextTrimming="CharacterEllipsis"/>
                                                <Button Grid.Column="2"
                                                        Padding="10,4" FontSize="11"
                                                        Command="{Binding DataContext.ToggleGroupItemSelectionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                                            <Setter Property="Content" Value="+ Add"/>
                                                            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter Property="Content" Value="✓ Added"/>
                                                                    <Setter Property="Foreground" Value="#10B981"/>
                                                                    <Setter Property="Background" Value="#2610B981"/>
                                                                    <Setter Property="BorderBrush" Value="#10B981"/>
                                                                    <Setter Property="BorderThickness" Value="1"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <!-- Bottom Buttons -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="✕ Cancel" Style="{StaticResource SecondaryButton}"
                                Padding="16,10" Command="{Binding CloseCreateGroupCommand}"/>
                        <Button Grid.Column="2" Content="+ Create group" Style="{StaticResource PrimaryButton}"
                                Background="#10B981" BorderBrush="#059669"
                                Padding="16,10" Command="{Binding SaveNewGroupCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </controls:ModalOverlay>

        <!-- ═══ STEAM REQUIRED FOR ONLINE FEATURES MODAL OVERLAY ═══ -->
        <controls:ModalOverlay IsOpen="{Binding IsSteamRequiredModalOpen}"
                               CloseCommand="{Binding CloseSteamRequiredModalCommand}"
                               CloseOnEscape="True"
                               Panel.ZIndex="1000">
            <Border Width="480"
                    Background="{StaticResource SurfaceCardElevatedBrush}"
                    BorderBrush="{StaticResource StrongBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusLg}"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="🎮 Steam Required for Online Features" Style="{StaticResource H2}" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding PendingLaunchInstance.Name, StringFormat='{}Launching {0} with ReFix Online (Spacewar 480).'}"
                               FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,6"/>
                    <TextBlock Text="Steam is currently not running in the background. To access online multiplayer lobbies and invitations via Spacewar (AppID 480), Steam must be running."
                               Style="{StaticResource Body}" TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,16"/>

                    <!-- Loading / Waiting for Steam indicator -->
                    <Border Background="{StaticResource SurfaceInputBrush}"
                            BorderBrush="{StaticResource AccentBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusMd}"
                            Padding="12,10" Margin="0,0,0,16"
                            Visibility="{Binding IsStartingSteam, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ProgressBar Style="{StaticResource LoadingSpinner}" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding SteamLaunchStatusText, FallbackValue='Starting Steam and waiting for user profile to load...'}"
                                       Style="{StaticResource CaptionBold}" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                                Command="{Binding CloseSteamRequiredModalCommand}"
                                IsEnabled="{Binding IsStartingSteam, Converter={StaticResource InverseBoolConverter}}"/>
                        <Button Content="Launch Anyway" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                                Command="{Binding LaunchAnywayCommand}"
                                IsEnabled="{Binding IsStartingSteam, Converter={StaticResource InverseBoolConverter}}"/>
                        <Button Content="Start Steam &amp; Play" Style="{StaticResource PrimaryButton}"
                                Command="{Binding StartSteamAndLaunchCommand}"
                                IsEnabled="{Binding IsStartingSteam, Converter={StaticResource InverseBoolConverter}}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </controls:ModalOverlay>

        <!-- ═══ MODAL: BULK INSTANCE DELETION CONFIRMATION ═══ -->
        <controls:ModalOverlay IsOpen="{Binding IsBulkDeleteModalOpen}"
                               CloseCommand="{Binding CloseBulkDeleteModalCommand}"
                               CloseOnEscape="True"
                               Panel.ZIndex="1000">
            <Border Background="{StaticResource SurfaceCardBrush}"
                    BorderBrush="{StaticResource SubtleBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusLg}"
                    Padding="28"
                    MaxWidth="540"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{DynamicResource String_DeleteModalTitle}" Style="{StaticResource H1}" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding BulkDeleteModalSubtitle}"
                               Style="{StaticResource Body}" TextWrapping="Wrap" Margin="0,0,0,20"/>

                    <!-- Option 1: Only Unlink from BlueStar -->
                    <Border Background="{StaticResource SurfaceInputBrush}"
                            BorderBrush="{StaticResource SubtleBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusMd}"
                            Padding="16" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="{DynamicResource String_UnlinkFromBlueStarOnlyTitle}" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="{DynamicResource String_UnlinkFromBlueStarOnlyDesc}"
                                           Style="{StaticResource BodySmall}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="{DynamicResource String_UnlinkActionBtn}"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="16,9"
                                    VerticalAlignment="Center"
                                    Command="{Binding ConfirmBulkDeleteInstancesCommand}"
                                    CommandParameter="false"
                                    IsEnabled="{Binding IsDeletingBulkInstances, Converter={StaticResource InverseBoolConverter}}"/>
                        </Grid>
                    </Border>

                    <!-- Option 2: Delete Instances and Purge Data Files -->
                    <Border Background="{StaticResource DangerBgBrush}"
                            BorderBrush="{StaticResource DangerBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusMd}"
                            Padding="16" Margin="0,0,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="{DynamicResource String_DeleteInstanceAndPurgeTitle}" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource DangerBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="{DynamicResource String_DeleteInstanceAndPurgeDesc}"
                                           Style="{StaticResource BodySmall}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="{DynamicResource String_DeleteAllActionBtn}"
                                    Style="{StaticResource DangerButton}"
                                    Padding="16,9"
                                    VerticalAlignment="Center"
                                    Command="{Binding ConfirmBulkDeleteInstancesCommand}"
                                    CommandParameter="true"
                                    IsEnabled="{Binding IsDeletingBulkInstances, Converter={StaticResource InverseBoolConverter}}"/>
                        </Grid>
                    </Border>

                    <!-- Cancel Button -->
                    <Button Content="{DynamicResource String_Cancel}"
                            Style="{StaticResource GhostButton}"
                            HorizontalAlignment="Right"
                            Padding="18,8"
                            Command="{Binding CloseBulkDeleteModalCommand}"
                            IsEnabled="{Binding IsDeletingBulkInstances, Converter={StaticResource InverseBoolConverter}}"/>
                </StackPanel>
            </Border>
        </controls:ModalOverlay>
    </Grid>
</UserControl>



