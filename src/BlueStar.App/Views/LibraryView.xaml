<UserControl x:Class="BlueStar.App.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:BlueStar.App.ViewModels"
             d:DataContext="{d:DesignInstance vm:LibraryViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{StaticResource BaseBackgroundBrush}"
             Foreground="{StaticResource PrimaryTextBrush}"
             FontFamily="{StaticResource MainFontFamily}">

    <Grid>
        <!-- ═══ MAIN LIBRARY SURFACE ═══ -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="32,24" MaxWidth="1180" HorizontalAlignment="Stretch">

                <!-- ── HEADER & SEARCH / ADD TOOLBAR ── -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Title & Instance Count -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Instances" Style="{StaticResource H1}" Margin="0,0,10,0"/>
                        <Border Background="{StaticResource SurfaceInputBrush}"
                                CornerRadius="{StaticResource RadiusPill}"
                                Padding="8,2"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding FilteredInstances.Count, StringFormat='{}{0} games'}"
                                       Style="{StaticResource CaptionBold}" Foreground="{StaticResource AccentBrush}"/>
                        </Border>
                    </StackPanel>

                    <!-- Search Input Box -->
                    <Grid Grid.Column="1" Margin="24,0" MaxWidth="440" HorizontalAlignment="Right">
                        <Border Background="{StaticResource SurfaceInputBrush}"
                                BorderBrush="{StaticResource SubtleBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusMd}"
                                Padding="10,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0" Data="{StaticResource IconSearch}"
                                      Fill="{StaticResource MutedTextBrush}"
                                      Stretch="Uniform" Width="14" Height="14"
                                      Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <Grid Grid.Column="1">
                                    <TextBlock Text="Search instances by title, AppID, engine..."
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="13" VerticalAlignment="Center" Margin="2,0,0,0"
                                               IsHitTestVisible="False"
                                               Visibility="{Binding SearchFilter, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                    <TextBox Text="{Binding SearchFilter, UpdateSourceTrigger=PropertyChanged}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Foreground="{StaticResource PrimaryTextBrush}"
                                             CaretBrush="{StaticResource PrimaryTextBrush}"
                                             FontSize="13"
                                             Padding="0,8"
                                             VerticalContentAlignment="Center"/>
                                </Grid>
                                <Button Grid.Column="2"
                                        Content="✕"
                                        Style="{StaticResource GhostButton}"
                                        Padding="4,2"
                                        FontSize="11"
                                        Foreground="{StaticResource MutedTextBrush}"
                                        Command="{Binding ClearSearchCommand}"
                                        Visibility="{Binding SearchFilter, Converter={StaticResource NullToVisibilityConverter}}"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- "+ Add Instance" Button & Dropdown -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal">
                        <Button Style="{StaticResource PrimaryButton}"
                                Padding="16,10"
                                Command="{Binding ToggleAddMenuCommand}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconPlus}" Fill="{StaticResource InverseTextBrush}"
                                      Stretch="Uniform" Width="14" Height="14" Margin="0,0,8,0"
                                      VerticalAlignment="Center"/>
                                <TextBlock Text="Add Instance" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- ── FILTER PILLS BAR (Engines & Status) ── -->
                <Border Background="{StaticResource SurfaceCardBrush}"
                        BorderBrush="{StaticResource SubtleBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusMd}"
                        Padding="14,10"
                        Margin="0,0,0,24">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Engine Filters -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Engine:" Style="{StaticResource CaptionBold}"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>

                            <RadioButton GroupName="EngineFilters" Style="{StaticResource PillFilterButton}" Content="All Engines"
                                         IsChecked="{Binding SelectedEngineFilter, Converter={StaticResource StringMatchConverter}, ConverterParameter=All}"/>
                            <RadioButton GroupName="EngineFilters" Style="{StaticResource PillFilterButton}" Content="Unreal Engine"
                                         IsChecked="{Binding SelectedEngineFilter, Converter={StaticResource StringMatchConverter}, ConverterParameter=Unreal}"/>
                            <RadioButton GroupName="EngineFilters" Style="{StaticResource PillFilterButton}" Content="Unity"
                                         IsChecked="{Binding SelectedEngineFilter, Converter={StaticResource StringMatchConverter}, ConverterParameter=Unity}"/>
                            <RadioButton GroupName="EngineFilters" Style="{StaticResource PillFilterButton}" Content="Godot"
                                         IsChecked="{Binding SelectedEngineFilter, Converter={StaticResource StringMatchConverter}, ConverterParameter=Godot}"/>
                            <RadioButton GroupName="EngineFilters" Style="{StaticResource PillFilterButton}" Content="Source"
                                         IsChecked="{Binding SelectedEngineFilter, Converter={StaticResource StringMatchConverter}, ConverterParameter=Source}"/>
                            <RadioButton GroupName="EngineFilters" Style="{StaticResource PillFilterButton}" Content="Other"
                                         IsChecked="{Binding SelectedEngineFilter, Converter={StaticResource StringMatchConverter}, ConverterParameter=Other}"/>
                        </StackPanel>

                        <!-- Status Filter -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Status:" Style="{StaticResource CaptionBold}"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>

                            <RadioButton GroupName="StatusFilters" Style="{StaticResource PillFilterButton}" Content="All"
                                         IsChecked="{Binding SelectedStatusFilter, Converter={StaticResource StringMatchConverter}, ConverterParameter=All}"/>
                            <RadioButton GroupName="StatusFilters" Style="{StaticResource PillFilterButton}" Content="Ready / Running"
                                         IsChecked="{Binding SelectedStatusFilter, Converter={StaticResource StringMatchConverter}, ConverterParameter=Ready}"/>
                            <RadioButton GroupName="StatusFilters" Style="{StaticResource PillFilterButton}" Content="Downloading"
                                         IsChecked="{Binding SelectedStatusFilter, Converter={StaticResource StringMatchConverter}, ConverterParameter=Downloading}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ── ERROR BANNER ── -->
                <Border Background="{StaticResource DangerBgBrush}"
                        BorderBrush="{StaticResource DangerBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusMd}"
                        Padding="14,10"
                        Margin="0,0,0,16"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"
                                   Style="{StaticResource BodyMedium}" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="✕" Style="{StaticResource GhostButton}"
                                Command="{Binding LoadInstancesCommand}"/>
                    </Grid>
                </Border>

                <!-- ── EMPTY STATE ── -->
                <Border Background="{StaticResource SurfaceCardBrush}"
                        BorderBrush="{StaticResource SubtleBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusLg}"
                        Padding="48,36"
                        Visibility="{Binding FilteredInstances.Count, Converter={StaticResource ZeroToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconGamepad}" Fill="{StaticResource MutedTextBrush}"
                              Stretch="Uniform" Width="56" Height="56" Margin="0,0,0,16"
                              HorizontalAlignment="Center"/>
                        <TextBlock Text="No game instances found" Style="{StaticResource H2}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Import a DepotBox ZIP archive or add an existing installed game folder to get started."
                                   Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,8,0,24"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="📦 Import ZIP Archive" Style="{StaticResource PrimaryButton}"
                                    Margin="0,0,12,0" Command="{Binding StartImportZipCommand}"/>
                            <Button Content="📁 Add Game Folder" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding AddExistingFolderCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ── INSTANCES GRID ── -->
                <ItemsControl ItemsSource="{Binding FilteredInstances}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Width="350" Margin="0,0,20,20">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="140"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="14"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Game Banner Artwork -->
                                    <Border Grid.Row="0" CornerRadius="8"
                                            Background="{StaticResource SurfaceCardHoverBrush}"
                                            ClipToBounds="True"
                                            Margin="-16,-16,-16,12">
                                        <Grid>
                                            <Path Data="{StaticResource IconGamepad}" Fill="{StaticResource MutedTextBrush}"
                                                  Stretch="Uniform" Width="36" Height="36"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Image Source="{Binding HeaderImageUrl}"
                                                   Stretch="UniformToFill"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Grid>
                                    </Border>

                                    <!-- Title & Steam AppId -->
                                    <StackPanel Grid.Row="1">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource H3}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding AppId, StringFormat='Steam AppID: {0}'}"
                                                   Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- Badges: Engine & Status -->
                                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                                        <!-- Engine Badge -->
                                        <Border CornerRadius="{StaticResource RadiusSm}"
                                                Padding="8,3"
                                                Margin="0,0,6,0"
                                                Background="{StaticResource SurfaceInputBrush}"
                                                BorderBrush="{Binding Engine, Converter={StaticResource EngineTypeToBrushConverter}, FallbackValue={StaticResource SubtleBorderBrush}, TargetNullValue={StaticResource SubtleBorderBrush}}"
                                                BorderThickness="1">
                                            <TextBlock Text="{Binding Engine.DisplayText, FallbackValue='Generic Game', TargetNullValue='Generic Game'}"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{Binding Engine, Converter={StaticResource EngineTypeToBrushConverter}, FallbackValue={StaticResource SecondaryTextBrush}, TargetNullValue={StaticResource SecondaryTextBrush}}"/>
                                        </Border>

                                        <!-- Status Badge -->
                                        <Border CornerRadius="{StaticResource RadiusSm}"
                                                Padding="8,3"
                                                Background="{Binding Status, Converter={StaticResource InstanceStatusToBgBrushConverter}, FallbackValue={StaticResource SurfaceInputBrush}, TargetNullValue={StaticResource SurfaceInputBrush}}">
                                            <TextBlock Text="{Binding Status, FallbackValue='Ready', TargetNullValue='Ready'}"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{Binding Status, Converter={StaticResource InstanceStatusToBrushConverter}, FallbackValue={StaticResource SuccessBrush}, TargetNullValue={StaticResource SuccessBrush}}"/>
                                        </Border>

                                        <!-- Emulator Update Available Tag -->
                                        <Border CornerRadius="{StaticResource RadiusSm}"
                                                Padding="8,3"
                                                Margin="6,0,0,0"
                                                Background="{StaticResource WarningBgBrush}"
                                                BorderBrush="{StaticResource WarningBrush}"
                                                BorderThickness="1"
                                                ToolTip="Actualización del emulador ReFix disponible para esta instancia"
                                                Visibility="{Binding Converter={StaticResource InstanceEmulatorUpdateVisibilityConverter}}">
                                            <TextBlock Text="{Binding Converter={StaticResource InstanceEmulatorUpdateTextConverter}}"
                                                       FontSize="11" FontWeight="Bold"
                                                       Foreground="{StaticResource WarningBrush}"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- Action Buttons -->
                                    <Grid Grid.Row="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Button Grid.Column="0" Content="Manage"
                                                Style="{StaticResource SecondaryButton}"
                                                Command="{Binding DataContext.ManageInstanceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"/>

                                        <Button Grid.Column="2" Style="{StaticResource IconButton}"
                                                ToolTip="Open Game Folder"
                                                Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                            <Path Data="{StaticResource IconFolder}" Fill="{StaticResource SecondaryTextBrush}"
                                                  Stretch="Uniform" Width="14" Height="14"/>
                                        </Button>

                                        <Button Grid.Column="4" Content="▶ Play"
                                                Style="{StaticResource PrimaryButton}"
                                                Padding="16,8"
                                                Command="{Binding DataContext.PlayInstanceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>

        <!-- ═══ ADD INSTANCE POPUP MENU OVERLAY ═══ -->
        <Grid Visibility="{Binding IsAddMenuOpen, Converter={StaticResource BoolToVisibilityConverter}}"
              Background="{StaticResource ModalOverlayBrush}">
            <Border Background="{StaticResource SurfaceCardElevatedBrush}"
                    BorderBrush="{StaticResource StrongBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusLg}"
                    Padding="24"
                    Width="480"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Add Game Instance" Style="{StaticResource H2}"/>
                        <Button Grid.Column="1" Content="✕" Style="{StaticResource GhostButton}"
                                Command="{Binding CloseAddMenuCommand}"/>
                    </Grid>

                    <Button Style="{StaticResource SecondaryButton}"
                            Margin="0,0,0,12"
                            Padding="18,14"
                            HorizontalContentAlignment="Stretch"
                            Command="{Binding StartImportZipCommand}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Data="{StaticResource IconDownload}" Fill="{StaticResource AccentBrush}"
                                  Stretch="Uniform" Width="20" Height="20" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Import DepotBox ZIP" Style="{StaticResource BodyMedium}" FontWeight="SemiBold"/>
                                <TextBlock Text="Inspect metadata, engine, and preview before confirming"
                                           Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Button>

                    <Button Style="{StaticResource SecondaryButton}"
                            Padding="18,14"
                            HorizontalContentAlignment="Stretch"
                            Command="{Binding AddExistingFolderCommand}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Data="{StaticResource IconFolder}" Fill="{StaticResource SuccessBrush}"
                                  Stretch="Uniform" Width="20" Height="20" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Add Existing Game Folder" Style="{StaticResource BodyMedium}" FontWeight="SemiBold"/>
                                <TextBlock Text="Auto-detect engine and executable from local directory"
                                           Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══ ZIP IMPORT PREVIEW MODAL DIALOG ═══ -->
        <Grid Visibility="{Binding IsZipPreviewOpen, Converter={StaticResource BoolToVisibilityConverter}}"
              Background="{StaticResource ModalOverlayBrush}">
            <Border Background="{StaticResource SurfaceCardElevatedBrush}"
                    BorderBrush="{StaticResource AccentBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusLg}"
                    Padding="28"
                    Width="520"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <!-- Modal Header -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconDownload}" Fill="{StaticResource AccentBrush}"
                                  Stretch="Uniform" Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Import Instance Preview" Style="{StaticResource H2}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="✕" Style="{StaticResource GhostButton}"
                                Command="{Binding CancelZipImportCommand}"/>
                    </Grid>

                    <!-- Preview Header Banner -->
                    <Border CornerRadius="8" Height="130"
                            Background="{StaticResource SurfaceInputBrush}"
                            ClipToBounds="True" Margin="0,0,0,16">
                        <Grid>
                            <Path Data="{StaticResource IconGamepad}" Fill="{StaticResource MutedTextBrush}"
                                  Stretch="Uniform" Width="36" Height="36" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image Source="{Binding PreviewHeaderImageUrl}" Stretch="UniformToFill"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Grid>
                    </Border>

                    <!-- Game Details Card -->
                    <Border Background="{StaticResource SurfaceInputBrush}"
                            CornerRadius="{StaticResource RadiusMd}"
                            Padding="16" Margin="0,0,0,18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Game Name:" Style="{StaticResource CaptionBold}"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding PreviewGameName}" Style="{StaticResource BodyMedium}"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Steam AppID:" Style="{StaticResource CaptionBold}"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding PreviewAppId}" Style="{StaticResource Body}"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Detected Engine:" Style="{StaticResource CaptionBold}"/>
                            <Border Grid.Row="4" Grid.Column="1" HorizontalAlignment="Left"
                                    Background="{StaticResource BaseBackgroundBrush}"
                                    BorderBrush="{Binding PreviewEngine, Converter={StaticResource EngineTypeToBrushConverter}}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusSm}"
                                    Padding="8,2">
                                <TextBlock Text="{Binding PreviewEngine.DisplayText, FallbackValue='Generic Game'}"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{Binding PreviewEngine, Converter={StaticResource EngineTypeToBrushConverter}}"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Depots & DLCs Summary -->
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{StaticResource SurfaceInputBrush}"
                                CornerRadius="{StaticResource RadiusMd}" Padding="12">
                            <StackPanel>
                                <TextBlock Text="Depots Found" Style="{StaticResource Caption}"/>
                                <TextBlock Text="{Binding PreviewDepotsCount}" Style="{StaticResource H3}" FontWeight="Bold" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="{StaticResource SurfaceInputBrush}"
                                CornerRadius="{StaticResource RadiusMd}" Padding="12">
                            <StackPanel>
                                <TextBlock Text="DLCs Included" Style="{StaticResource Caption}"/>
                                <TextBlock Text="{Binding PreviewDlcsCount}" Style="{StaticResource H3}" FontWeight="Bold" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Install Path -->
                    <TextBlock Text="Target Installation Directory:" Style="{StaticResource CaptionBold}" Margin="0,0,0,4"/>
                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Style="{StaticResource DarkTextBox}"
                                 Text="{Binding PreviewInstallPath, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Grid.Column="2"
                                Content="Browse..."
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding BrowsePreviewInstallPathCommand}"/>
                    </Grid>

                    <!-- Action Buttons -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="Cancel"
                                Style="{StaticResource SecondaryButton}"
                                Padding="16,10"
                                Command="{Binding CancelZipImportCommand}"/>

                        <Button Grid.Column="2" Content="Confirm Import ➔"
                                Style="{StaticResource PrimaryButton}"
                                Padding="16,10"
                                Command="{Binding ConfirmZipImportCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
