<UserControl x:Class="BlueStar.App.Controls.SteamDownloadGraphControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="230" d:DesignWidth="850"
             FontFamily="{StaticResource MainFontFamily}">

    <Border Background="{StaticResource SurfaceCardBrush}"
            BorderBrush="{StaticResource SubtleBorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusLg}"
            Padding="20,16,20,16"
            Margin="0,0,0,20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="130"/>
            </Grid.RowDefinitions>

            <!-- ═══ TOP METRICS BAR ═══ -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="28"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 1. NETWORK DOWNLOAD TELEMETRY -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Icon -->
                    <Border Width="38" Height="38" CornerRadius="8" Background="#1400D2FF" Margin="0,0,12,0" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconDownload}" Fill="#00D2FF" Stretch="Uniform" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                            <TextBlock Text="{DynamicResource String_GraphNetwork}" FontSize="11" FontWeight="Bold" Foreground="#8FA3BF" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtCurrentNetSpeed" Text="0 B/s" FontSize="18" FontWeight="Bold" Foreground="#00D2FF" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{DynamicResource String_GraphPeak}" FontSize="11" FontWeight="SemiBold" Foreground="#6B7C96"/>
                            <TextBlock x:Name="TxtPeakNetSpeed" Text="0 B/s" FontSize="11" FontWeight="Bold" Foreground="#C5D1E0" Margin="0,0,12,0"/>
                            <TextBlock Text="{DynamicResource String_GraphTotal}" FontSize="11" FontWeight="SemiBold" Foreground="#6B7C96"/>
                            <TextBlock x:Name="TxtTotalDownloaded" Text="0 B" FontSize="11" FontWeight="Bold" Foreground="#C5D1E0"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Divider -->
                <Rectangle Grid.Column="1" Width="1" Height="34" Fill="{StaticResource SubtleBorderBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <!-- 2. DISK WRITE TELEMETRY -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Icon -->
                    <Border Width="38" Height="38" CornerRadius="8" Background="#145CD65C" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="💾" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                            <TextBlock Text="{DynamicResource String_GraphDiskUsage}" FontSize="11" FontWeight="Bold" Foreground="#8FA3BF" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtCurrentDiskSpeed" Text="0 B/s" FontSize="18" FontWeight="Bold" Foreground="#5CD65C" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{DynamicResource String_GraphPeak}" FontSize="11" FontWeight="SemiBold" Foreground="#6B7C96"/>
                            <TextBlock x:Name="TxtPeakDiskSpeed" Text="0 B/s" FontSize="11" FontWeight="Bold" Foreground="#C5D1E0"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- 3. RIGHT LEGEND & SCALE -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Network Legend Pill -->
                    <Border Background="#1000D2FF" BorderBrush="#3300D2FF" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Line X1="0" Y1="0" X2="12" Y2="0" Stroke="#00D2FF" StrokeThickness="2.5" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource String_GraphDownload}" FontSize="11" FontWeight="SemiBold" Foreground="#00D2FF"/>
                        </StackPanel>
                    </Border>

                    <!-- Disk Write Legend Pill (Dashed line) -->
                    <Border Background="#105CD65C" BorderBrush="#335CD65C" BorderThickness="1" CornerRadius="6" Padding="8,4">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Line X1="0" Y1="0" X2="12" Y2="0" Stroke="#5CD65C" StrokeThickness="2.5" StrokeDashArray="2 1.5" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource String_GraphDiskWrite}" FontSize="11" FontWeight="SemiBold" Foreground="#5CD65C"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- ═══ GRAPH CANVAS AREA ═══ -->
            <Border Grid.Row="2" Background="#0A0C10" BorderBrush="#1C212D" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                <Grid x:Name="GraphGrid">
                    <!-- Grid Background Lines (horizontal) -->
                    <Grid VerticalAlignment="Stretch" Margin="0,8,0,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="0"/>
                        </Grid.RowDefinitions>

                        <!-- Top line (100% scale) -->
                        <Border Grid.Row="0" BorderBrush="#14283C" BorderThickness="0,1,0,0">
                            <TextBlock x:Name="TxtScaleMax" Text="50 MB/s" FontSize="10" Foreground="#4A5C75" Margin="8,2,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                        </Border>

                        <!-- Middle line (50% scale) -->
                        <Border Grid.Row="1" BorderBrush="#14283C" BorderThickness="0,1,0,0">
                            <TextBlock x:Name="TxtScaleMid" Text="25 MB/s" FontSize="10" Foreground="#4A5C75" Margin="8,2,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                        </Border>

                        <!-- Low line (25% scale) -->
                        <Border Grid.Row="2" BorderBrush="#14283C" BorderThickness="0,1,0,0"/>
                    </Grid>

                    <!-- Waveform Canvas -->
                    <Canvas x:Name="WaveformCanvas" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="0,8,0,0">
                        <!-- 1. Disk Area Fill (Base Layer) -->
                        <Path x:Name="DiskAreaPath">
                            <Path.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#205CD65C" Offset="0"/>
                                    <GradientStop Color="#025CD65C" Offset="1"/>
                                </LinearGradientBrush>
                            </Path.Fill>
                        </Path>

                        <!-- 2. Network Area Fill (Middle Layer) -->
                        <Path x:Name="NetAreaPath">
                            <Path.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#4000D2FF" Offset="0"/>
                                    <GradientStop Color="#0200D2FF" Offset="1"/>
                                </LinearGradientBrush>
                            </Path.Fill>
                        </Path>

                        <!-- 3. Network Solid Line (Cyan) -->
                        <Path x:Name="NetLinePath" Stroke="#00D2FF" StrokeThickness="2.4" StrokeLineJoin="Round"/>

                        <!-- 4. Disk Dashed Line (Green - rendered on top with dashes so overlapping lines show both) -->
                        <Path x:Name="DiskLinePath" Stroke="#5CD65C" StrokeThickness="2.2" StrokeDashArray="3 2" StrokeDashCap="Round" StrokeLineJoin="Round"/>
                    </Canvas>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
