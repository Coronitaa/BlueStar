<Project>
  <PropertyGroup>
    <Version>1.6.6</Version>
    <AssemblyVersion>1.6.6.0</AssemblyVersion>
    <FileVersion>1.6.6.0</FileVersion>
    <InformationalVersion>1.6.6</InformationalVersion>
    <Company>Corøna (BlueStar Developers)</Company>
    <Product>BlueStar</Product>
    <Copyright>Copyright (C) 2026 Corøna</Copyright>
    <Authors>Corøna &amp; BlueStar Developers</Authors>
  </PropertyGroup>

  <!-- Per-build key for the encrypted API keys file (bluestar.dat). Passed by build scripts; never committed. -->
  <ItemGroup Condition="'$(BundledSecretsKey)' != ''">
    <AssemblyMetadata Include="BundledSecretsKey" Value="$(BundledSecretsKey)" />
  </ItemGroup>
</Project>
